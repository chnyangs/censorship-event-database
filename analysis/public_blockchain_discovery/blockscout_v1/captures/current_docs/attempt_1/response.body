",\"autogeneratedByOpenApi\":true},{\"title\":\"List token transfers involving a specific address with filtering options\",\"description\":\"Retrieves token transfers involving a specific address, with optional filtering by token type, direction, and specific token.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi-specs/Master-pro-api.json get /{chain_id}/api/v2/addresses/{address_hash_param}/token-transfers\",\"href\":\"/api-reference/addresses/list-token-transfers-involving-a-specific-address-with-filtering-options\",\"autogeneratedByOpenApi\":true},{\"title\":\"Export token transfers as CSV\",\"description\":\"Exports token transfers for a specific address as a CSV file.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi-specs/Master-pro-api.json get /{chain_id}/api/v2/addresses/{address_hash_param}/token-transfers/csv\",\"href\":\"/api-reference/addresses/export-token-transfers-as-csv\",\"autogeneratedByOpenApi\":true},{\"title\":\"List token balances for an address with pagination and type filtering\",\"description\":\"Retrieves token balances for a specific address with pagination and filtering by token type. Useful for displaying large token portfolios.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi-specs/Master-pro-api.json get /{chain_id}/api/v2/addresses/{address_hash_param}/tokens\",\"href\":\"/api-reference/addresses/list-token-balances-for-an-address-with-pagination-and-type-filtering\",\"autogeneratedByOpenApi\":true},{\"title\":\"List transactions involving a specific address with to-from filtering\",\"description\":\"Retrieves transactions involving a specific address, with optional filtering for transactions sent from or to the address.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/openapi-specs/Master-pro-api.json get /{chain_id}/api/v2/addresses/{address_hash_param}/transactions\",\"href\":\"/api-reference/addresses/list-transactions-involving-a-specific-address-with-to-from-filtering\",\"autogenerate