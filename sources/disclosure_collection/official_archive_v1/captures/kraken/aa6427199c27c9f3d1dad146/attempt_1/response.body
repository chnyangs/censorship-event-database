0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-81S","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/GAIB-blog-header.png?fit=1999%2C912&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30868","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=30868"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30868\/revisions"}],"predecessor-version":[{"id":30869,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30868\/revisions\/30869"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30870"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30868"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30868"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30868"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30868"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":30858,"date":"2025-11-19T09:00:07","date_gmt":"2025-11-19T14:00:07","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=30858"},"modified":"2025-11-19T09:00:09","modified_gmt":"2025-11-19T14:00:09","slug":"custody-europe-mica","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/kraken-institutional\/custody-europe-mica","title":{"rendered":"Expanding Kraken Custody to Europe under MiCA"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\" id=\"h-tl-dr\"><strong>TL;DR<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>MiCA-regulated custody in the EEA:<\/strong> Kraken\u2019s European entity, Payward Europe Solutions Limited (PESL), is authorized and regulated by the Central Bank of Ireland<br><\/li>\n\n\n\n<li><strong>Institutional-grade protection:<\/strong> PESL delivers compliant, transparent <a href=\"https:\/\/custody.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">digital asset custody<\/a> for institutions across the EEA under the EU\u2019s Markets in Crypto-Assets (MiCA) regulation<br><\/li>\n\n\n\n<li><strong>Global reach and unified standards:<\/strong> Together with Kraken Financial in the U.S., PESL anchors Kraken\u2019s regulated custody network across key global jurisdictions<br><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-a-new-chapter-for-institutional-custody-in-europe\"><strong>A new chapter for institutional custody in Europe<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">As Europe\u2019s Markets in Crypto-Assets (MiCA) regulation comes into force, institutions now have a clear path to engage with digital assets under a harmonized, regulated framework.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Through <strong>PESL<\/strong> \u2014 Kraken\u2019s MiCA-regulated European entity \u2014 institutions across the EEA can now safeguard their assets with <a href=\"https:\/\/custody.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">a custody solution<\/a> designed for compliance, transparency and operational assurance.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This milestone extends Kraken\u2019s institutional footprint, pairing MiCA oversight in Europe with the existing U.S. framework operated through <strong>Kraken Financial<\/strong>, creating a unified global custody network.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-regulated-protection-under-mica\"><strong>Regulated protection under MiCA<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">PESL\u2019s authorization by the <strong>Central Bank of Ireland<\/strong> brings the rigor of traditional financial supervision to digital assets.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Under MiCA, clients benefit from:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Segregated custody:<\/strong> Client assets are fully segregated from PESL\u2019s and Kraken exchange\u2019s assets<br><\/li>\n\n\n\n<li><strong>Independent audits and transparent reserves:<\/strong> Assets are supported by independent collateral verification and robust reporting<br><\/li>\n\n\n\n<li><strong>MiCA-compliant governance:<\/strong> Oversight aligned with the EU\u2019s highest regulatory standards<br><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">The result is a custody environment that delivers both institutional security and regulatory clarity across the EEA.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-seamless-integration-across-jurisdictions\"><strong>Seamless integration across jurisdictions<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken\u2019s custody network now provides clients with <strong>true jurisdictional flexibility<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Institutions based in the EEA can onboard through PESL under MiCA while clients in the U.S. continue to access custody through <strong>Kraken Financial<\/strong> \u2014 both built on a unified technical and operational architecture.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This shared foundation ensures:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Consistent reporting and security standards<br><\/li>\n\n\n\n<li>A harmonized client experience<br><\/li>\n\n\n\n<li>Cross-jurisdictional coordination for global portfolios<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-operational-assurance-institutions-can-trust\"><strong>Operational assurance institutions can trust<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken Custody combines <strong>institutional-grade security<\/strong> with the transparency and speed of blockchain technology. PESL\u2019s framework applies the same principles that guide Kraken Financial \u2014 including secure cold storage, rigorous key management and independent audits \u2014 to ensure operational maturity across every layer of the custody stack.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This alignment enables institutions to confidently custody digital assets under a <strong>regulated, resilient and independently verified structure<\/strong> purpose-built for fiduciaries, funds and corporate treasuries.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-strengthening-kraken-s-global-custody-network\"><strong>Strengthening Kraken\u2019s global custody network<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">With the addition of PESL in Ireland, Kraken now offers regulated digital asset custody under two major regimes \u2014 <strong>MiCA in Europe<\/strong> and <strong>state and federal oversight in the U.S.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This expansion reflects Kraken\u2019s long-standing commitment to operating transparently and compliantly across global markets, empowering institutions to engage in the digital asset ecosystem with confidence.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-learn-more\"><strong>Learn more<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">To explore how <a href=\"https:\/\/custody.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Custody<\/a> can support your organization\u2019s digital asset strategy, visit <a href=\"https:\/\/www.kraken.com\/institutions\/custody\">kraken.com\/institutions\/custody<\/a> or get in touch with your account manager.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/institutions#contact\" target=\"_blank\" rel=\"noopener\">Get started with Kraken Institutional<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>Payward Europe Solutions Limited (PESL) now brings Kraken\u2019s trusted digital asset custody to the European Economic Area (EEA) \u2014 regulated by the Central Bank of Ireland under the EU\u2019s new MiCA framework.<\/p>\n","protected":false},"author":230089386,"featured_media":30860,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1969],"tags":[],"language":[],"class_list":["post-30858","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-kraken-institutional"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Expanding Kraken Custody to Europe under MiCA - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/kraken-institutional\/custody-europe-mica\" \/>\n<meta property=\"og:locale\" content=\"en_US