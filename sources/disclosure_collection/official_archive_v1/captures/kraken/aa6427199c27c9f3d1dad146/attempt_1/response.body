24\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-82V","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/MON-blog-header.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30933","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=30933"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30933\/revisions"}],"predecessor-version":[{"id":30939,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30933\/revisions\/30939"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30935"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30933"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30933"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30933"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30933"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":30975,"date":"2025-11-25T09:00:07","date_gmt":"2025-11-25T14:00:07","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=30975"},"modified":"2025-11-25T09:29:36","modified_gmt":"2025-11-25T14:29:36","slug":"make-krak-your-everything-account","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/krak\/make-krak-your-everything-account","title":{"rendered":"Say goodbye to your bank: make Krak your everything account"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><strong>Introducing the new Krak Card with up to 1% cashback,<strong><sup>1<\/sup><\/strong> Krak Vaults<sup>2<\/sup> with up to 10%+ APY<\/strong><sup><strong>3<\/strong><\/sup> <strong>and global transfers under one account for you to spend, send and grow your assets without limits.&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">For decades, traditional banks have set the rules for how we spend, save and earn. But those rules were written for another era \u2014 before global, digital, always-on lives. The modern world needs something faster, smarter and more flexible.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s why we\u2019re reimagining what a primary account can be. With Krak, your financial life lives in one place \u2014 designed to move with you, across borders, currencies and time zones.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Starting today, Krak users in the UK and EU can unlock the next generation of personal finance: a complete account experience built around three simple ideas \u2014 <strong>Spend, Send, and Grow.<\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/m.krak.app\/Qq7r\/dtjmfpdl\" target=\"_blank\" rel=\"noopener\">UK and EU users: Get your Krak Card<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-spend-a-card-that-pays-up-to-1-back-nbsp\"><strong>\ud83d\udcb3 SPEND: A card that pays up to 1% back&nbsp;<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Meet the new <strong>Krak Debit Card<\/strong>, a card that pays you back up to 1%<strong>\u00b9<\/strong> every time you spend.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Spend anywhere Mastercard is accepted \u2014 from your local caf\u00e9 to a beach in Lisbon \u2014 and earn up to <strong>1% cashback\u00b9<\/strong> on every purchase, in your local currency or in Bitcoin. No caps, no hoops. Just genuine rewards for spending the assets you actually want to hold.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"30982\" data-permalink=\"https:\/\/blog.kraken.com\/product\/krak\/make-krak-your-everything-account\/attachment\/krak_card_supportingimg_spend_1200x675\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?fit=2400%2C1350&amp;ssl=1\" data-orig-size=\"2400,1350\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Krak_Card_SupportingImg_Spend_1200x675\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-30982\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=2048%2C1152&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675.png?resize=178%2C100&amp;ssl=1 178w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">You can spend over <strong>400 different fiat and crypto assets<\/strong> using your Krak card. Buy a dinner in Paris paying with any assets from your balance across different currencies both cash and crypto \u2014 Krak handles the conversion instantly at checkout, with no transaction fees. You even earn up to 1% back<sup>1<\/sup> in EUR or Bitcoin for that meal.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Choose a sleek physical card for your wallet or a virtual one that lives in your mobile wallet. Every option gives you full control: pick which assets to spend, which to save and track everything in real time.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">And yes \u2014 <strong>no ATM withdrawal fees<\/strong>,<sup>4<\/sup> anywhere in the world.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Krak isn\u2019t just helping you spend differently; it\u2019s helping you <strong>live differently<\/strong> \u2014 a life where your assets are spent freely, globally, and instantly.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-send-move-assets-freely\"><strong>\ud83c\udf10 SEND: Move assets freely<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Sending cash and crypto shouldn\u2019t feel like a relic from the 1990s.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With Krak you can <strong>send funds to anyone, anywhere<\/strong>. Whether that\u2019s splitting a dinner bill with a friend, paying a freelancer across borders or transferring between your own bank accounts.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"30983\" data-permalink=\"https:\/\/blog.kraken.com\/product\/krak\/make-krak-your-everything-account\/attachment\/krak_card_supportingimg_spend_1200x675-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?fit=2400%2C1350&amp;ssl=1\" data-orig-size=\"2400,1350\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Krak_Card_SupportingImg_Spend_1200x675-1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-30983\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=2048%2C1152&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Spend_1200x675-1.png?resize=178%2C100&amp;ssl=1 178w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">You\u2019ll be able to transfer cash, stablecoins or crypto with a single tap \u2014 instantly with any other Krak customers without waiting days for settlement or worrying about high exchange rates.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">And with <strong>salary deposits<\/strong> coming soon, you can get <strong>paid directly into Krak<\/strong>, skipping the middlemen entirely. No delays, no extra transfers\u2026 just instant access to your paycheck, ready to spend, send or grow from the moment it lands.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Your Krak account becomes your hub for everyday life: money in, money out, all in one place.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-grow-let-your-assets-work-while-you-rest\"><strong>\ud83d\udcb0 GROW: Let your assets work while you rest<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Coming soon. Earn up to <strong>10%+ APY<\/strong><sup>3<\/sup> with strategies built for every kind of investor; from steady growth to advanced, high-yield opportunities, all powered by decentralised finance protocols.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Krak changes that with <strong>Krak Vaults<\/strong><sup>2<\/sup> \u2014&nbsp; the simplest way to put your assets to work; automatically, continuously.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"30984\" data-permalink=\"https:\/\/blog.kraken.com\/product\/krak\/make-krak-your-everything-account\/attachment\/krak_card_supportingimg_grow_1200x675\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?fit=2400%2C1350&amp;ssl=1\" data-orig-size=\"2400,1350\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Krak_Card_SupportingImg_Grow_1200x675\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-30984\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=2048%2C1152&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Krak_Card_SupportingImg_Grow_1200x675.png?resize=178%2C100&amp;ssl=1 178w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">No minimums, no lockups.<sup>5<\/sup> Just market-leading returns paid continuously as your vault compounds around the clock.<br><br>You can choose from flexible, risk-adjusted Vaults that match your comfort level:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Balanced Yield<\/strong> | Up to 5.5% APY \u2014 For users who want steady growth with lower risk.<br><\/li>\n\n\n\n<li><strong>Boosted Yield<\/strong> | Up to 9.5% APY \u2014 For users comfortable with moderate risk and seeking higher returns.<br><\/li>\n\n\n\n<li><strong>Advanced Strategies<\/strong> | Up to 10%+ APY \u2014 For experienced users ready to manage core risks applying leverage for highest returns.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Launching soon.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-the-connected-account-experience\"><strong>The connected account experience<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Spend. Send. Grow.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Each feature is powerful on its own, but together they create something bigger \u2014 a connected account experience where your assets finally work the way you do.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With Krak, your financial life isn\u2019t scattered across banks, cards, apps and wallets. It\u2019s unified \u2014 in one ecosystem that\u2019s borderless, digital and built entirely around your choices.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you\u2019re tapping to pay, sending across continents, or earning while you sleep, Krak is your new <strong>primary account<\/strong> for everything.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The future of money isn\u2019t coming \u2014 it\u2019s already here. And it starts with Krak.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/m.krak.app\/Qq7r\/3gnal82l\" target=\"_blank\" rel=\"noopener\">Get Krak today<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><sup><br><\/sup><strong><em>\u00b9 <\/em><\/strong><em>ATM withdrawals not included, \u00a3\/<\/em><em>\u20ac<\/em><em>0.50 min. transaction amount for cashback. Your cashback rate depends on the average assets you hold with Krak, Kraken and Kraken Pro. Geo restrictions apply. Check <\/em><a href=\"https:\/\/support.kraken.com\/articles\/krak-card-cashback-overview\"><em>this Support Center Article<\/em><\/a><em> for more information.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em><sup>2 <\/sup><\/em><em>Geo restrictions apply<\/em><em><br><\/em><em><br><\/em><em><sup>3 <\/sup><\/em><em>Rewards are variable and not guaranteed; you can lose some or all of your assets. Interacting with on-chain smart contracts involves risks which are further detailed in the terms of service, including technological risk (bugs, exploits, and oracle\/MEV\/bridge failures), market risk (price volatility, de-pegs, and liquidation where relevant), and operational risk (irreversible transactions, gas fees, network congestion). Kraken does not control third-party protocols. Offered by Payward Wallet, LLC. Fees apply. Availability varies by jurisdiction.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em><sup>4 <\/sup><\/em><em>A variable spread will apply when spending across assets. Third-party ATM fees may apply.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em><sup>5 <\/sup><\/em><em>Withdrawal timing depends on selected strategy and network conditions.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Using cryptocurrency for purchases may be a taxable event. When you spend crypto, it\u2019s converted to fiat currency, which may create capital gains or losses based on its value change. Consult a tax advisor to understand your individual circumstances. <\/em><a href=\"https:\/\/support.kraken.com\/articles\/krak-card-cashback-overview\"><em>Learn more<\/em><\/a><em>.<\/em><em><br><\/em><em><br><\/em><em>Receiving cashback is generally not considered a taxable event. Consult a tax advisor to understand your individual circumstances. <\/em><a href=\"https:\/\/support.kraken.com\/articles\/krak-card-cashback-overview\"><em>Learn more<\/em><\/a><em>.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Krak Card is issued by Monavate (Company Number: 12472532) authorised in the UK by the Financial Conduct Authority to issue electronic money (e-money) and provide payment services (Firm Reference Number 901097).<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>In the EEA; the Card is issued by Monavate UAB (Company No. 305628001, authorised in Lithuania by the Bank of Lithuania to issue electronic money (e-money) and provide payment services (license number 92).&nbsp;&nbsp;<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Mastercard\u00ae is a registered trademark of Mastercard International Incorporated. The card is issued by Monavate pursuant to license by Mastercard International Inc.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>What if your assets could keep up with your life, not the other way around? Introducing the new Krak Card.<\/p>\n","protected":false},"author":230089386,"featured_media":30979,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1957],"tags":[],"language":[],"class_list":["post-30975","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-krak"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title