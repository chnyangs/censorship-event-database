.png?fit=3600%2C1642&ssl=1","datePublished":"2025-12-05T17:28:22+00:00","dateModified":"2025-12-05T17:28:23+00:00","breadcrumb":{"@id":"https:\/\/blog.kraken.com\/product\/promotions\/win-3-bitcoins-holiday-2025#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/blog.kraken.com\/product\/promotions\/win-3-bitcoins-holiday-2025"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/product\/promotions\/win-3-bitcoins-holiday-2025#primaryimage","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BLOG_Xmas-BTC-Sweepstakes_email-1.png?fit=3600%2C1642&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BLOG_Xmas-BTC-Sweepstakes_email-1.png?fit=3600%2C1642&ssl=1","width":3600,"height":1642},{"@type":"BreadcrumbList","@id":"https:\/\/blog.kraken.com\/product\/promotions\/win-3-bitcoins-holiday-2025#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"Win 3 bitcoins this holiday season"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-86a","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BLOG_Xmas-BTC-Sweepstakes_email-1.png?fit=3600%2C1642&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31134","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=31134"}],"version-history":[{"count":7,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31134\/revisions"}],"predecessor-version":[{"id":31142,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31134\/revisions\/31142"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/31140"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=31134"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=31134"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=31134"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=31134"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31143,"date":"2025-12-08T05:25:53","date_gmt":"2025-12-08T10:25:53","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31143"},"modified":"2025-12-08T05:28:05","modified_gmt":"2025-12-08T10:28:05","slug":"dentoshi-qt-ends-rate-cuts-loom","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom","title":{"rendered":"Trading Spaces recap: QT ends, rate cuts loom and why the charts still aren\u2019t ready"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Kraken VP Growth <strong>Matt Howells-Barby<\/strong> and pro trader <strong>Dentoshi (Den)<\/strong> <a href=\"https:\/\/youtu.be\/ECBqxWEcvH0\" target=\"_blank\" rel=\"noreferrer noopener\">were back on Trading Spaces this week<\/a> to tackle a big question: <em>If QT is over and rate cuts are on deck\u2026 why do the charts still look so fragile?<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">As always, nothing in this recap is financial advice \u2014 just market commentary and education.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-tl-dr\"><strong>TL;DR<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">In this episode of Trading Spaces:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>QT is officially over<\/strong> as of December 1 and a <strong>25 bps cut on December 10 is heavily priced in<\/strong> \u2014 but the market <em>isn\u2019t<\/em> pricing a clean follow-up cut in January.<\/li>\n\n\n\n<li><strong>BTC just printed a rejection<\/strong> at a major confluence level (yearly open, monthly open, daily trend). Best case: chop. Worst case: a deeper markdown.<\/li>\n\n\n\n<li><strong>ETH looks \u201cless bad\u201d than BTC<\/strong> on lower timeframes and ETH\/BTC is trying to grind higher \u2014 but Den still wants to see real follow-through before trusting any rotation.<\/li>\n\n\n\n<li>Recent outperformers like <strong>ZEC and HYPE are flashing fatigue<\/strong>, while extreme laggards like <strong>XPL<\/strong> still can\u2019t catch a bid \u2014 a sign this market is not ready to trend hard yet.<\/li>\n\n\n\n<li>Heading into <strong>December 10 (Fed)<\/strong> and <strong>December 16 (jobs data)<\/strong>, Den is firmly in <strong>\u201cdefense first\u201d mode<\/strong>: let the macro play out and make the market prove it\u2019s ready before sizing up risk.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-macro-the-end-of-qt-a-near-inevitable-cut-and-a-big-gap-in-january\"><strong>Macro: the end of QT, a near-inevitable cut\u2026 and a big gap in January<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Matt opened with the macro, because that\u2019s what\u2019s been steering BTC all quarter.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-rate-cut-odds-are-driving-everything\"><strong>Rate cut odds are driving everything<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">BTC has been trading in lockstep with the <strong>probability of a rate cut<\/strong>, especially for the <strong>December and January<\/strong> meetings.<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Fed futures are currently implying <strong>~87\u201388% odds<\/strong> of a 25 bps cut at the December meeting.<\/li>\n\n\n\n<li>What\u2019s <em>different<\/em> this time:\n<ul class=\"wp-block-list\">\n<li>The market is basically treating it as <strong>\u201ceither December or January\u201d<\/strong>, not both.<\/li>\n\n\n\n<li>The probability of seeing <strong>back-to-back cuts in December <\/strong><strong><em>and<\/em><\/strong><strong> January is still under 10%<\/strong> \u2014 a number Matt thinks is likely underpriced if the data stays friendly.<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">That asymmetry matters:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>If the Fed cuts in December <em>and<\/em> data into January stays soft, there\u2019s room for the market to <strong>reprice more cuts next year<\/strong>, which could be supportive for risk.<\/li>\n\n\n\n<li>If they <em>don\u2019t<\/em> cut next week, that\u2019s where Matt sees the biggest downside risk: the bearish surprise is much larger than the bullish surprise.<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-pce-data-lag-and-why-powell-will-likely-stay-neutral\"><strong>PCE, data lag and why Powell will likely stay neutral<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Because of the earlier government shutdown, the latest <strong>PCE inflation data<\/strong> that just dropped is still <strong>September<\/strong> data \u2014 already somewhat stale by the time of this meeting.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Key takeaways from Matt:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Core PCE<\/strong> (the Fed\u2019s preferred measure) is running at <strong>2.8% YoY<\/strong>, down from 2.9%.<\/li>\n\n\n\n<li>Consumer spending has slowed as expected.<\/li>\n\n\n\n<li>The print was <strong>\u201cin line to slightly better than expected\u201d<\/strong>, which is good mainly because there were no nasty surprises.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s why Matt doesn\u2019t think this PCE release meaningfully shifts the December 10 outcome.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">More importantly, look at what comes <em>after<\/em> the meeting:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Dec 16<\/strong>: jobs data (non-farm payrolls)<\/li>\n\n\n\n<li>Then a full run of <strong>CPI, PPI and PCE<\/strong> before the <strong>January<\/strong> decision<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">There\u2019s a <strong>ton of fresh data<\/strong> arriving <em>after<\/em> Powell speaks next week, which is why Matt expects the Fed\u2019s messaging to remain <strong>very neutral<\/strong> \u2013 low incentive to commit to an aggressive easing path before that information lands.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-qt-ends-potential-new-fed-chair-chatter-and-vanguard-s-etf-move\"><strong>QT ends, potential new Fed chair chatter and Vanguard\u2019s ETF move<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">A few more macro levers Matt flagged:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>QT officially ended on December 1<\/strong>\n<ul class=\"wp-block-list\">\n<li>That doesn\u2019t mean \u201cfull send money printing.\u201d<\/li>\n\n\n\n<li>But it <em>does<\/em> mean we\u2019ve shifted from liquidity-negative to at least <strong>mildly liquidity-positive<\/strong>, which historically supports risk assets (crypto included).<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li><strong>Kevin Hassett being floated as a possible next Fed chair<\/strong> under Trump:\n<ul class=\"wp-block-list\">\n<li>Seen as <strong>dovish and pro-cut<\/strong>, and notably more crypto-friendly.<\/li>\n\n\n\n<li>Good optics for risk sentiment, even if the bond market isn\u2019t thrilled.<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li><strong>Vanguard opening up access to crypto ETFs<\/strong> (BTC, ETH, SOL, XRP and others):\n<ul class=\"wp-block-list\">\n<li>Matt framed this as <strong>\u201cmore symbolic than seismic\u201d<\/strong> in the short term.<\/li>\n\n\n\n<li>Structural access improves, but it\u2019s unlikely to be a near-term flows bomb.<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Taken together, the backdrop is <strong>quietly supportive<\/strong> but still fragile. There\u2019s more upside in how 2026\u2019s cuts get repriced than in the December decision itself \u2014 and that\u2019s where Matt is steering his focus.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-btc-first-real-rejection-at-a-key-confluence-chop-is-best-case-down-is-worst-case\"><strong>BTC: first real rejection at a key confluence \u2014 \u201cchop is best case, down is worst case\u201d<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Den then zoomed into the charts, starting with BTC.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-the-first-real-level-gets-tagged-and-rejected\"><strong>The first \u201creal\u201d level gets tagged\u2026 and rejected<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">On the BTC chart, we\u2019ve just seen price tag and reject a confluence zone:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Yearly open<\/strong><\/li>\n\n\n\n<li>A key <strong>daily trend \/ EMA cluster<\/strong><\/li>\n\n\n\n<li>On the 4H, attempts to <strong>reclaim EMAs<\/strong> failed for now<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"527\" data-attachment-id=\"31160\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/btc-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?fit=2880%2C1482&amp;ssl=1\" data-orig-size=\"2880,1482\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?fit=1024%2C527&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=1024%2C527&#038;ssl=1\" alt=\"\" class=\"wp-image-31160\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=1024%2C527&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=300%2C154&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=768%2C395&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=1536%2C790&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=2048%2C1054&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=1200%2C618&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC.png?resize=194%2C100&amp;ssl=1 194w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Den had been watching for a \u201cbullish shift\u201d pattern she\u2019s seen many times:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Reclaim -&gt; consolidate (\u201csandwich\u201d) -&gt; expand higher.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Instead, BTC tried to reclaim, <strong>immediately rejected<\/strong>, and slid back below those levels.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"523\" data-attachment-id=\"31161\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/btc4\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?fit=2880%2C1472&amp;ssl=1\" data-orig-size=\"2880,1472\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC4\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?fit=1024%2C523&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=1024%2C523&#038;ssl=1\" alt=\"\" class=\"wp-image-31161\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=1024%2C523&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=300%2C153&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=768%2C393&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=1536%2C785&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=2048%2C1047&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=1200%2C613&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC4.png?resize=196%2C100&amp;ssl=1 196w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Her read:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>This was <strong>the first real resistance<\/strong> on the way up from Monday\u2019s bounce \u2014 and BTC failed there on the first attempt.<\/li>\n\n\n\n<li>That strongly suggests <strong>\u201cchop is the best case, down is the worst case\u201d<\/strong> unless and until we see a fresh, convincing reclaim.<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-daily-emas-flip-bearish-for-the-first-time-since-2022\"><strong>Daily EMAs flip bearish for the first time since 2022<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">On higher timeframes, BTC\u2019s <strong>daily EMAs have now crossed bearish<\/strong> \u2014 something we haven\u2019t seen since 2022.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Den is not treating that as a standalone trading signal, but as a <strong>structural tell<\/strong>:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Throughout the prior uptrend, BTC had <strong>dipped below EMAs<\/strong> but never flipped the stack fully bearish.<\/li>\n\n\n\n<li>Now that we\u2019ve lost that configuration, she\u2019s on high alert for a <strong>\u201cfake reclaim then die\u201d<\/strong> structure similar to what we saw around the 2021 cycle highs, where:\n<ul class=\"wp-block-list\">\n<li>Price deviated above a key range<\/li>\n\n\n\n<li>Failed to reclaim with strength<\/li>\n\n\n\n<li>Then rolled over into a much deeper downtrend<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"528\" data-attachment-id=\"31162\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/btc3-3\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?fit=2880%2C1484&amp;ssl=1\" data-orig-size=\"2880,1484\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC3\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?fit=1024%2C528&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=1024%2C528&#038;ssl=1\" alt=\"\" class=\"wp-image-31162\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=1024%2C528&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=300%2C155&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=768%2C396&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=1536%2C791&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=2048%2C1055&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=1200%2C618&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC3.png?resize=194%2C100&amp;ssl=1 194w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">A repeat of that pattern would look something like:<\/p>\n\n\n\n<ol class=\"wp-block-list\">\n<li>We (eventually) print a \u201chopeful\u201d rally back toward the <strong>January all-time high area<\/strong><\/li>\n\n\n\n<li>Rejects or deviates above that level<\/li>\n\n\n\n<li>Then starts a much more serious markdown<\/li>\n<\/ol>\n\n\n\n<p class=\"wp-block-paragraph\">She\u2019s not saying this <em>will<\/em> happen \u2014 but this is a scenario she\u2019ll be actively watching.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"528\" data-attachment-id=\"31164\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/btc2-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?fit=2880%2C1486&amp;ssl=1\" data-orig-size=\"2880,1486\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC2\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?fit=1024%2C528&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=1024%2C528&#038;ssl=1\" alt=\"\" class=\"wp-image-31164\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=1024%2C528&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=300%2C155&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=768%2C396&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=1536%2C793&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=2048%2C1057&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=1200%2C619&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BTC2.png?resize=194%2C100&amp;ssl=1 194w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-sentiment-10-10-and-the-mountain-to-climb\"><strong>Sentiment, 10\/10 and the \u201cmountain to climb\u201d<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Matt added a sentiment overlay:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Since the October 10 washout, <strong>buyer exhaustion<\/strong> has been obvious.<\/li>\n\n\n\n<li>Even from where we started the day (~91.5k), a move back to <strong>104k<\/strong> now feels like a <strong>huge climb<\/strong>, with major levels stacked all the way up:\n<ul class=\"wp-block-list\">\n<li><strong>94k<\/strong> needs to be reclaimed and held<\/li>\n\n\n\n<li>Then a chunky band of resistance between <strong>98k\u2013100k<\/strong><\/li>\n<\/ul>\n<\/li>\n\n\n\n<li>It\u2019s <em>not<\/em> that new highs are impossible \u2014 but the path likely isn\u2019t a \u201cstraight line, all at once\u201d move.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Between restrictive (but easing) rates and the usual <strong>2\u20133 month lag<\/strong> between policy changes and liquidity effects, both Matt and Den expect <strong>any bottoming structure to take some time<\/strong> to build.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Until then, Den\u2019s stance is simple:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cPlay defense, have your checklist, and don\u2019t get excited until price actually does what you said you wanted to see.\u201d<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-eth-slightly-prettier-than-btc-but-still-needs-to-prove-it\"><strong>ETH: \u201cslightly prettier\u201d than BTC, but still needs to prove it<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">If BTC is the problem child right now, <strong>ETH is at least behaving slightly better<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">On the USD chart:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>ETH <strong>hasn\u2019t yet tagged \u2014 or rejected from \u2014 its yearly open<\/strong>, which gives it a bit more room structurally.<\/li>\n\n\n\n<li>It\u2019s still trading above <strong>monthly open<\/strong> and key short-term support.<\/li>\n\n\n\n<li>Crucially, ETH has <strong>not yet lost its EMAs in the same way BTC has<\/strong>, which is why Den called it \u201cless bad\u201d on the lower timeframes.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"523\" data-attachment-id=\"31165\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/eth2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?fit=2880%2C1472&amp;ssl=1\" data-orig-size=\"2880,1472\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"ETH2\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?fit=1024%2C523&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=1024%2C523&#038;ssl=1\" alt=\"\" class=\"wp-image-31165\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=1024%2C523&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=300%2C153&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=768%2C393&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=1536%2C785&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=2048%2C1047&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=1200%2C613&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH2.png?resize=196%2C100&amp;ssl=1 196w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">On <strong>ETH\/BTC<\/strong>:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>The pair has been <strong>trying to base and grind higher<\/strong> since late August.<\/li>\n\n\n\n<li>There <em>was<\/em> a \u201ccute\u201d little breakout attempt recently, helped along by narrative flows (Tom Lee\u2019s calls, ETF speculation, etc.).<\/li>\n\n\n\n<li>But Den pointed out this <strong>\u201cattempt to move\u201d has been going on for months<\/strong> without decisive follow-through.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"528\" data-attachment-id=\"31166\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/eth-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?fit=2880%2C1486&amp;ssl=1\" data-orig-size=\"2880,1486\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"ETH\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?fit=1024%2C528&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=1024%2C528&#038;ssl=1\" alt=\"\" class=\"wp-image-31166\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=1024%2C528&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=300%2C155&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=768%2C396&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=1536%2C793&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=2048%2C1057&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=1200%2C619&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ETH.png?resize=194%2C100&amp;ssl=1 194w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Her bottom line on ETH:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Structure is cleaner than BTC.<\/li>\n\n\n\n<li>ETH\/BTC is <em>trying<\/em> to rotate.<\/li>\n\n\n\n<li>But given how long this has dragged, she wants to see <strong>something as convincing as the prior strong impulse<\/strong> before treating it as a real, sustained rotation.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-oxygen-tests-and-altcoins-what-zec-hype-and-friends-are-telling-us\"><strong>Oxygen tests and altcoins: what ZEC, HYPE and friends are telling us<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">One theme that came up repeatedly: <strong>\u201cthe market needs oxygen to move up.\u201d<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">When macro gives it oxygen (rate-cut odds rising, equities ripping), we see <strong>attempts<\/strong> at strength.<br>The moment that oxygen is taken away, those attempts <strong>stall or fully unwind<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Den uses a basket of names as <strong>\u201coxygen tests\u201d<\/strong> \u2014 if they can\u2019t follow through in good conditions, the market isn\u2019t ready yet.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-zec-the-privacy-outperformer-showing-real-fatigue\"><strong>ZEC: the privacy outperformer showing real fatigue<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">ZEC has been one of the standout <strong>privacy coin outperformers<\/strong> since the October volatility spike:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>For weeks, it <strong>ignored BTC\u2019s swings<\/strong> and even <strong>rallied into some of BTC\u2019s big red candles<\/strong>.<\/li>\n\n\n\n<li>It rode a <strong>beautiful, clean daily uptrend<\/strong>, with price hugging and respecting the trend the entire way.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Now, though, the cracks are obvious:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>That daily trend has <strong>finally broken<\/strong>.<\/li>\n\n\n\n<li>Breakout attempts at the highs have turned into <strong>wicky failed expansions<\/strong>.<\/li>\n\n\n\n<li>The first break of structure saw a <strong>violent move from the 500s down into the 300s<\/strong>.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"526\" data-attachment-id=\"31168\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/zec\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?fit=2880%2C1478&amp;ssl=1\" data-orig-size=\"2880,1478\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"ZEC\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?fit=1024%2C526&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=1024%2C526&#038;ssl=1\" alt=\"\" class=\"wp-image-31168\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=1024%2C526&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=300%2C154&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=768%2C394&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=1536%2C788&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=2048%2C1051&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=1200%2C616&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/ZEC.png?resize=195%2C100&amp;ssl=1 195w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Den\u2019s read:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>ZEC looks <strong>\u201ctired\u201d<\/strong><\/li>\n\n\n\n<li>A reclaim of that lost daily trend and a strong push back above the <strong>2021 all-time high area<\/strong> would be needed to revive the bull case.<\/li>\n\n\n\n<li>On the downside, she\u2019s eyeing the <strong>1D 200 EMA zone<\/strong> as a potential \u201cinteresting\u201d level <em>if<\/em> structure and lower-timeframe price action align there.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Matt added that ZEC is exactly the kind of <strong>narrative-heavy, momentum-driven asset<\/strong> that can:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Rip back above 500<\/li>\n\n\n\n<li>Or nuke through 250<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">\u2026with almost equal probability in the very short term. For him, the key is how it behaves into Q1 2026 if broader crypto catches a bid \u2014 he still expects <strong>prior cycle darlings to feature in any renewed momentum phase.<\/strong><\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-hype-one-of-the-best-market-tells-is-unable-to-show-strength-at-important-levels\"><strong>HYPE: one of the best \u201cmarket tells\u201d is unable to show strength at important levels<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">HYPE has been one of Den\u2019s favorite <strong>market barometers<\/strong> this cycle:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Structurally, it\u2019s often moved cleaner and further than most alts.<\/li>\n\n\n\n<li>After the October 10 chaos, it <strong>rallied all the way back to range highs<\/strong>, outperforming many peers that barely bounced to logical levels.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\" id=\"h-that-s-why-its-current-structure-is-so-important\">That\u2019s why its current structure is so important:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Price is now <strong>rejecting from the previous all-time high region<\/strong>.<\/li>\n\n\n\n<li>There\u2019s a dense <strong>cluster of resistance<\/strong>:\n<ul class=\"wp-block-list\">\n<li>Daily EMAs<\/li>\n\n\n\n<li>A key diagonal<\/li>\n\n\n\n<li>Prior lows now acting as resistance<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li>The chart, in Den\u2019s words, looks <strong>\u201cvery toppy\u201d<\/strong> from a long perspective.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"526\" data-attachment-id=\"31169\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/hype\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?fit=2880%2C1478&amp;ssl=1\" data-orig-size=\"2880,1478\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"HYPE\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?fit=1024%2C526&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=1024%2C526&#038;ssl=1\" alt=\"\" class=\"wp-image-31169\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=1024%2C526&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=300%2C154&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=768%2C394&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=1536%2C788&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=2048%2C1051&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=1200%2C616&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/HYPE.png?resize=195%2C100&amp;ssl=1 195w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">If one of the strongest horses in the race is <strong>cleanly rejecting<\/strong>, that tells her:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cWe\u2019re far from ready. If HYPE can\u2019t push through here as the previous strongest horse, the other, weaker altcoins probably can\u2019t either.\u201d<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-xpl-the-anti-hype-index-and-why-it-still-matters\"><strong>XPL: the \u201canti-hype\u201d index and why it still matters<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">On the opposite end of the spectrum from things like HYPE sits <strong>XPL<\/strong> \u2014 a coin Den jokingly dubbed the <strong>\u201canti-hype\u201d index.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Why bother watching a chart that looks this bad? Because:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>When <strong>even the weakest horses start to show strength<\/strong>, it often signals a broad risk-on phase.<\/li>\n\n\n\n<li>The fact that XPL <strong>still can\u2019t reclaim even its 4H 100 EMA<\/strong>, and continues to drip lower, underlines how far we are from that kind of environment.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"526\" data-attachment-id=\"31170\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\/attachment\/xpl\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?fit=2880%2C1478&amp;ssl=1\" data-orig-size=\"2880,1478\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"XPL\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?fit=1024%2C526&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=1024%2C526&#038;ssl=1\" alt=\"\" class=\"wp-image-31170\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=1024%2C526&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=300%2C154&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=768%2C394&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=1536%2C788&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=2048%2C1051&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=1200%2C616&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/XPL.png?resize=195%2C100&amp;ssl=1 195w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Den had briefly hoped XPL might break above that 4H 100 EMA during the recent bounce \u2014 but renewed selling quickly crushed that attempt.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If charts like XPL begin to <strong>base, reclaim key moving averages and put in higher lows<\/strong>, she\u2019d take that as a strong secondary sign that <strong>the market is ready for a more durable uptrend<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re nowhere near that yet.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-strategy-into-december-10-and-16-defense-not-hero-trades\"><strong>Strategy into December 10 and 16: defense, not hero trades<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">With only days until the <strong>December 10 Fed decision<\/strong> and another crucial data point on <strong>December 16<\/strong> (non-farm payrolls), both Matt and Den are focused less on <strong>calling the exact bottom<\/strong> and more on <strong>being alive and flexible when the real move comes.<\/strong><\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-den-s-framework-going-into-the-next-two-weeks\"><strong>Den\u2019s framework going into the next two weeks:<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>On BTC:<\/strong>\n<ul class=\"wp-block-list\">\n<li>She is <em>not<\/em> blindly bidding the recent lows.<\/li>\n\n\n\n<li>The \u201cauto-bid\u201d levels for BTC are <strong>lower down<\/strong> for her.<\/li>\n\n\n\n<li>On the upside, she wants to see:\n<ul class=\"wp-block-list\">\n<li>A proper <strong>reclaim and hold<\/strong> of the yearly\/monthly open confluence<\/li>\n\n\n\n<li><strong>4H 200 EMA<\/strong> reclaimed with conviction<\/li>\n\n\n\n<li>Then structure that looks like a true trend shift, not just a reactive bounce.<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li><strong>On ETH:<\/strong>\n<ul class=\"wp-block-list\">\n<li>Watch whether ETH can <strong>hold above its key support cluster<\/strong> and avoid the same EMA breakdown BTC has suffered.<\/li>\n\n\n\n<li>If ETH\/BTC can finally push out of its months-long \u201ctrying\u201d phase, that\u2019s where she\u2019ll start to get more constructive.<\/li>\n<\/ul>\n<\/li>\n\n\n\n<li><strong>On alts:<\/strong>\n<ul class=\"wp-block-list\">\n<li>Let <strong>ZEC, HYPE, FARTCOIN-type names<\/strong> be your tells.<\/li>\n\n\n\n<li>If they start to show sustained strength on good macro days <em>and<\/em> hold structure when macro wobbles, that\u2019s when rotation risk starts to look more attractive.<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-matt-s-closing-macro-notes\"><strong>Matt\u2019s closing macro notes:<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Don\u2019t over-index on the <strong>event day candles<\/strong>.<\/li>\n\n\n\n<li>Recent cuts have been <strong>100% priced in by the time the announcement hits<\/strong>, with the bigger moves coming in the <strong>weeks <\/strong><strong><em>before<\/em><\/strong><strong> and <\/strong><strong><em>after<\/em><\/strong> as probabilities adjust.<\/li>\n\n\n\n<li>The bigger optionality now lies in <strong>how the market reprices cuts for 2026<\/strong>, especially if January\u2019s meeting starts to look like another live cut.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-housekeeping-amp-how-to-watch-the-replay\"><strong>Housekeeping &amp; how to watch the replay<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Thanks to everyone who joined live; catch the replay here:<\/p>\n\n\n\n<iframe loading=\"lazy\" width=\"560\" height=\"315\" src=\"https:\/\/www.youtube.com\/embed\/ECBqxWEcvH0?si=9nd6SXMJXyyXBJJ5\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Trading Spaces runs <strong>every two weeks<\/strong>, hosted by <strong>Matt Howells-Barby<\/strong> with pro trader <strong>Dentoshi (Den)<\/strong>.<\/li>\n\n\n\n<li>We\u2019ll be back on <strong>December 19<\/strong>, just after the <strong>Fed decision and key data releases<\/strong> \u2014 expect a very different set of charts by then.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">In the meantime:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Follow <strong><a href=\"https:\/\/x.com\/@krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenfx<\/a><\/strong>, <strong><a href=\"https:\/\/x.com\/krakenpro\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenpro<\/a><\/strong> and <strong><a href=\"https:\/\/x.com\/Dentoshi\" target=\"_blank\" rel=\"noreferrer noopener\">@Dentoshi<\/a><\/strong> on X for stream times, live charts and clips.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-trade-the-levels-with-kraken-pro\"><strong>Trade the levels with Kraken Pro<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Want to put Den\u2019s framework into practice?<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Build custom <strong>watchlists<\/strong> for BTC, ETH, ZEC, privacy coins and your favorite outperformers.<\/li>\n\n\n\n<li>Set <strong>price and volume alerts<\/strong> around the key levels discussed in this session.<\/li>\n\n\n\n<li>Use advanced order types in <strong><a href=\"https:\/\/pro.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Pro<\/a><\/strong> to plan your entries and invalidation in advance.<\/li>\n<\/ul>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/kraken.pxf.io\/c\/5984839\/1589189\/10583\" target=\"_blank\" rel=\"noopener\">Trade with Dentoshi on Kraken Pro<\/a><\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Past Performance is not a reliable indicator of future results.&nbsp;<\/em><a href=\"https:\/\/assets-cms.kraken.com\/files\/51n36hrp\/facade\/b0183f2a11a80bb2b79cf5cab244b6faf58b421b.pdf\" target=\"_blank\" rel=\"noreferrer noopener\"><em>Learn more about asset risks.<\/em><\/a><em>&nbsp;Pricing data is provided by Kraken. Returns may increase or decrease as a result of currency fluctuations, and does not account for trading fees. Visit our fee schedule for more information.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>With the Fed\u2019s Dec.10 rate decision only days away, PCE data hitting the tape and majors stalling into key resistance, let&#8217;s connect the macro backdrop with the levels that actually matter on BTC, ETH and the current crop of outperformers and laggards.<\/p>\n","protected":false},"author":230089386,"featured_media":31172,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1391],"tags":[1946],"language":[],"class_list":["post-31143","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-crypto-education","tag-dentoshi"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading Spaces recap: QT ends, rate cuts loom and why the charts still aren\u2019t ready - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Trading Spaces recap: QT ends, rate cuts loom and why the charts still aren\u2019t ready\" \/>\n<meta property=\"og:description\" content=\"With the Fed\u2019s Dec.10 rate decision only days away, PCE data hitting the tape and majors stalling into key resistance, let&#039;s connect the macro backdrop with the levels that actually matter on BTC, ETH and the current crop of outperformers and laggards.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-qt-ends-rate-cuts-loom\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-12-08T10:25:53+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-12-08T10:2