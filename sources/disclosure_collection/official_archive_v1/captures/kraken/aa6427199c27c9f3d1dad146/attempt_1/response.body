,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-84o","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/xStocksxBacked_Blog_Hero_1535x700%402x.jpg?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31024","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=31024"}],"version-history":[{"count":8,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31024\/revisions"}],"predecessor-version":[{"id":31102,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31024\/revisions\/31102"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30737"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=31024"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=31024"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=31024"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=31024"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31042,"date":"2025-12-03T09:06:32","date_gmt":"2025-12-03T14:06:32","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31042"},"modified":"2025-12-03T09:06:33","modified_gmt":"2025-12-03T14:06:33","slug":"bsu-is-available-for-trading","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/bsu-is-available-for-trading","title":{"rendered":"BSU is available for trading!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that BSU is available for trading on Kraken!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-funding-and-trading\"><strong>Funding and trading<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/app.kraken.com\/JDNW\/BSU\" target=\"_blank\" rel=\"noreferrer noopener\">BSU trading<\/a> is live as of December 3, 2025.<\/p>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-8f761849 wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp;<\/p>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">Make sure to deposit your tokens into networks supported by Kraken. Deposits made using other networks will be lost.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/app.kraken.com\/JDNW\/BSU\" target=\"_blank\" rel=\"noopener\">Trade on Kraken<\/a><\/div>\n<div><\/div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-this-asset\">Here\u2019s some more information about this asset<strong>:<\/strong><\/h2>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-baby-shark-universe-bsu\">Baby Shark Universe (BSU)<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Baby Shark Universe<\/strong> is a hybrid entertainment and digital-asset platform that uses the globally recognized Baby Shark brand to connect Web2 audiences with Web3 games, NFTs and metaverse experiences. The project offers an open-world RPG and metaverse where players explore, complete quests and engage in user-generated content around the Baby Shark universe.\u00a0<br><br>The <strong>BSU<\/strong> token powers payments, in-game economies and broader ecosystem incentives.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Please note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li><strong>Geographic restrictions may apply<\/strong><\/li>\n<\/ul>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>, and all future tokens will be announced on our <a href=\"http:\/\/kraken.com\/listings\" target=\"_blank\" rel=\"noreferrer noopener\">Listings Roadmap<\/a> and <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">social media profiles<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that BSU is available for trading on Kraken! Funding and trading BSU trading is live as of December 3, 2025. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens into networks supported by Kraken. Deposits [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":31107,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789],"tags":[1403,1476],"language":[],"class_list":["post-31042","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","tag-kraken","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>BSU is available for trading! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/asset-listings\/bsu-is-available-for-trading\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"BSU is available for trading!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that BSU is available for trading on Kraken! Funding and trading BSU trading is live as of December 3, 2025. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens into networks supported by Kraken. Deposits [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/asset-listings\/bsu-is-available-for-trading\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-12-03T14:06:32+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-12-03T14:06:33+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BSU-blog-header.png\" \/>\n\t<meta property=\"og:image:width\" content=\"3070\" \/>\n\t<meta property=\"og:image:height\" content=\"1400\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"2 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\"},\"headline\":\"BSU is available for trading!\",\"datePublished\":\"2025-12-03T14:06:32+00:00\",\"dateModified\":\"2025-12-03T14:06:33+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading\"},\"wordCount\":263,\"commentCount\":0,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/11\\\/BSU-blog-header.png?fit=3070%2C1400&ssl=1\",\"keywords\":[\"Kraken\",\"trading\"],\"articleSection\":[\"Asset Listings\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/bsu-is-available-for-trading\",\"name\":\"BSU is available for trading! - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\