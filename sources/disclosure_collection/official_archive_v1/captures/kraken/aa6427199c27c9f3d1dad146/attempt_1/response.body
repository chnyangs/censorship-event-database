\/wp-json\/wp\/v2\/posts\/30723\/revisions"}],"predecessor-version":[{"id":31210,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30723\/revisions\/31210"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30734"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30723"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30723"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30723"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30723"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31212,"date":"2025-12-10T09:20:37","date_gmt":"2025-12-10T14:20:37","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31212"},"modified":"2025-12-16T11:15:00","modified_gmt":"2025-12-16T16:15:00","slug":"usdt0-now-available-on-plasma","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/new-features\/usdt0-now-available-on-plasma","title":{"rendered":"USDT0 deposits and withdrawals now available on Plasma!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of Tether (USDT0) on Plasma!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-funding\"><strong>Funding<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">USDT0 funding via Plasma\u00a0is already live. You can transfer USDT0 to your Kraken account by navigating to Funding, selecting USDT0 and choosing the desired deposit method (network) from the drop-down box:\u00a0<strong>Plasma<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Make sure to deposit your tokens into networks supported by Kraken. Deposits made using other networks will be lost.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/proapp.kraken.com\/9f1e\/PLASMA\" target=\"_blank\" rel=\"noopener\">Trade on Kraken<\/a><\/div>\n<div><\/div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-these-assets\">Here\u2019s some more information about these assets<strong>:<\/strong><\/h2>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-usdt0\"><strong>USDT0<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">USDT0, the unified liquidity network for USDT, simplifies cross-chain movement without fragmented pools or complex bridges. As the unified gateway for USDT interoperability and expansion, USDT0 simplifies cross-chain liquidity, enhances accessibility, and unlocks new use cases for Tether holders, businesses, and DeFi platforms. With a focus on efficiency and scalability, USDT0 is redefining how USDT operates across networks.&nbsp;<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-plasma-nbsp\"><strong>Plasma&nbsp;<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\" id=\"h-\">Plasma is a blockchain purpose built for high-volume, low-cost stablecoin activity. It serves as the core settlement layer for a new financial system where digital dollars can move instantly, power real-world payments, and support products for consumers, businesses, and financial institutions.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Please note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li><strong>Geographic restrictions may apply<\/strong><\/li>\n<\/ul>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>, and all future tokens will be announced on our <a href=\"http:\/\/kraken.com\/listings\" target=\"_blank\" rel=\"noreferrer noopener\">Listings Roadmap<\/a> and <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">social media profiles<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Although the term &#8220;stablecoin&#8221; is commonly used, there is no guarantee that the asset will maintain a stable value in relation to the value of the reference asset when traded on secondary markets or that the reserve of assets, if there is one, will be adequate to satisfy all redemptions.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of Tether (USDT0) on Plasma! Funding USDT0 funding via Plasma\u00a0is already live. You can transfer USDT0 to your Kraken account by navigating to Funding, selecting USDT0 and choosing the desired deposit method (network) from the drop-down box:\u00a0Plasma. Make sure to deposit your tokens into [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":31213,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1790],"tags":[1403,1901,1476],"language":[],"class_list":["post-31212","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-new-features","tag-kraken","tag-stablecoins","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>USDT0 deposits and withdrawals now available on Plasma! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/new-features\/usdt0-now-available-on-plasma\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"USDT0 deposits and withdrawals now available on Plasma!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of Tether (USDT0) on Plasma! Funding USDT0 funding via Plasma\u00a0is already live. You can transfer USDT0 to your Kraken 