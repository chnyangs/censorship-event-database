ew-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-85L","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Blog-Lock.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31109","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=31109"}],"version-history":[{"count":9,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31109\/revisions"}],"predecessor-version":[{"id":31133,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31109\/revisions\/31133"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/31110"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=31109"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=31109"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=31109"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=31109"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31103,"date":"2025-12-04T11:00:06","date_gmt":"2025-12-04T16:00:06","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31103"},"modified":"2025-12-04T11:00:08","modified_gmt":"2025-12-04T16:00:08","slug":"expanding-access-in-colombia","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/expanding-access-in-colombia","title":{"rendered":"Kraken expands access in Colombia with local payment integration"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We are excited to announce we are expanding services in Colombia through the activation of local payment rails. The introduction of COP funding reflects Kraken\u2019s continued investment in building infrastructure enabling individuals to have secure and frictionless access to crypto around the world.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With local payment integration now live, clients in Colombia can deposit COP directly through trusted domestic payment methods. Deposits are automatically converted to USD at competitive, transparent exchange rates \u2013 eliminating the need for international wire transfers and streamlining the overall user experience.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cColombia is one of the most dynamic crypto markets in Latin America, with a digitally engaged population and a growing appetite for decentralized financial tools,\u201d said Mark Greenberg, Kraken Global Head of Consumer. \u201cThis integration marks an important step in giving Colombian clients more accessible, secure entry points into the global crypto economy.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Crypto adoption in Colombia continues to grow steadily, driven by increased financial digitization, strong interest in stablecoins, and demand for cross-border remittance options. Kraken\u2019s local funding support reduces onboarding friction and brings institutional-grade infrastructure to one of the region\u2019s most active digital asset communities.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This milestone is part of Kraken\u2019s broader strategy to scale its presence across Latin America, beginning with foundational infrastructure in key markets including Argentina, Mexico, and Colombia.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken\u2019s expansion in Colombia is underpinned by a commitment to delivering relevant, local solutions to clients. Colombian clients now benefit from:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Local COP payment rails<br><\/li>\n\n\n\n<li>Access to 500+ digital assets and global liquidity<br><\/li>\n\n\n\n<li>Competitive FX rates and transparent pricing<br><\/li>\n\n\n\n<li>Industry-leading security and 24\/7 support<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">This rollout positions Kraken to support a wide range of Colombian clients \u2013\u00a0from first-time crypto participants to advanced traders.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div><\/div>\n","protected":false},"excerpt":{"rendered":"<p>Colombian clients can now fund their Kraken accounts in Colombian pesos (COP), improving ease of access to digital assets and further aligning with the platform\u2019s localized strategy across Latin America.<\/p>\n","protected":false},"author":230089386,"featured_media":31106,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[],"language":[],"class_list":["post-31103","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken expands access in Colombia with local payment integration - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/expanding-access-in-colombia\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Kraken expands access in Colombia with local payment integration\" \/>\n<meta property=\"og:description\" content=\"Colombian clients can now fund their Kraken accounts in Colombian pesos (COP), improving ease of access to digital assets and further aligning with the platform\u2019s localized strategy across Latin America.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/expanding-access-in-colombia\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-12-04T16:00:06+00:00\" \/>\n<meta property=\"article:modified_time\" cont