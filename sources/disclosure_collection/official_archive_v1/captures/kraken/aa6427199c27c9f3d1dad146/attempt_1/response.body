"target\":[\"https:\\\/\\\/blog.kraken.com\\\/product\\\/promotions\\\/win-3-bitcoins-holiday-2025\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/promotions\\\/win-3-bitcoins-holiday-2025#primaryimage\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/12\\\/BLOG_Xmas-BTC-Sweepstakes_email-1.png?fit=3600%2C1642&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/12\\\/BLOG_Xmas-BTC-Sweepstakes_email-1.png?fit=3600%2C1642&ssl=1\",\"width\":3600,\"height\":1642},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/promotions\\\/win-3-bitcoins-holiday-2025#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\\/\\\/blog.kraken.com\\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Win 3 bitcoins this holiday season\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"name\":\"Kraken Blog\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\\/\\\/blog.kraken.com\\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\",\"name\":\"Kraken Blog\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Win 3 bitcoins this holiday season - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/product\/promotions\/win-3-bitcoins-holiday-2025","og_locale":"en_US","og_type":"article","og_title":"Win 3 bitcoins this holiday season","og_description":"From Dec. 4-Jan. 5, every eligible client who opts in and trades $1 (or its equivalent in another currency) will earn one sweepstakes entry to win 3 BTC.","og_url":"https:\/\/blog.kraken.com\/product\/promotions\/win-3-bitcoins-holiday-2025","og_site_name":"Kraken Blog","article_published_time":"2025-12-05T17:28:22+00:00","article_modified_time":"2025-12-05T17:28:23+00:00","og_image":[{"width":1024,"height":467,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/BLOG_Xmas-BTC-Sweepstakes_em