:19:05+00:00","dateModified":"2025-12-18T13:19:07+00:00","breadcrumb":{"@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/vooi-is-available-for-trading#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/blog.kraken.com\/product\/asset-listings\/vooi-is-available-for-trading"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/vooi-is-available-for-trading#primaryimage","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/hearder-blog-VOOI.png?fit=3070%2C1400&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/hearder-blog-VOOI.png?fit=3070%2C1400&ssl=1","width":3070,"height":1400},{"@type":"BreadcrumbList","@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/vooi-is-available-for-trading#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"VOOI is available for trading!"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-8b0","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/hearder-blog-VOOI.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31434","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=31434"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31434\/revisions"}],"predecessor-version":[{"id":31437,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31434\/revisions\/31437"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/31435"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=31434"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=31434"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=31434"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=31434"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31207,"date":"2025-12-18T09:01:04","date_gmt":"2025-12-18T14:01:04","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31207"},"modified":"2025-12-18T09:07:16","modified_gmt":"2025-12-18T14:07:16","slug":"krak-holiday-quest-2025","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/krak-holiday-quest-2025","title":{"rendered":"Turn your holiday spending into a \u20ac25,000 adventure: join Krak\u2019s Holiday Quest"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">This holiday season, forget passive scrolling or sitting indoors watching TV. Krak is turning your everyday purchases into real-world quests this holiday season. Every completed task becomes an entry, and every entry becomes a shot at serious rewards\u2026 including our \u20ac25,000 grand prize.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Introducing our 6 Days of Krakmas Holiday Quest Challenge, running December 18, 9:00 a.m. UTC to December 23, 11:59 p.m. UTC.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Six quests. Six days. All you need is your Krak Card. <strong>Haven\u2019t claimed your Krak Card yet? No problem. You can sign up for Krak <\/strong><a href=\"https:\/\/m.krak.app\/Qq7r\/1io9gqir\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>here<\/strong><\/a> or scan the QR code below, then immediately activate a virtual card and start playing right away.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full is-resized\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"936\" height=\"936\" data-attachment-id=\"31417\" data-permalink=\"https:\/\/blog.kraken.com\/product\/promotions\/krak-holiday-quest-2025\/attachment\/dec17_krakmas_qr-white3x\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?fit=936%2C936&amp;ssl=1\" data-orig-size=\"936,936\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Dec17_Krakmas_QR &amp;#8211; White@3x\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?fit=936%2C936&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=936%2C936&#038;ssl=1\" alt=\"\" class=\"wp-image-31417\" style=\"width:355px;height:auto\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?w=936&amp;ssl=1 936w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=300%2C300&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=150%2C150&amp;ssl=1 150w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=768%2C768&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=800%2C800&amp;ssl=1 800w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=600%2C600&amp;ssl=1 600w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=400%2C400&amp;ssl=1 400w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=200%2C200&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Dec17_Krakmas_QR-White%403x.png?resize=100%2C100&amp;ssl=1 100w\" sizes=\"auto, (max-width: 936px) 100vw, 936px\" \/><\/figure>\n<\/div>\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em><strong>Scan to sign up for Krak and activate your virtual card so you play right away!<\/strong><\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-your-6-winter-quests\"><strong>Your 6 winter quests<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Complete these missions in any order, at any pace, using your Krak Card. Every quest you complete enters you into our Daily Drop: Each day, 10 winners will get their purchase fully refunded (up to \u20ac100 each).<br><br><strong>Finish all six<\/strong> at any point during the promotion period and you\u2019ll unlock your entry for the <strong>\u20ac25,000 grand prize<\/strong> raffle.&nbsp;<\/p>\n\n\n\n<ol class=\"wp-block-list\">\n<li><strong>Fuel Up <\/strong>\u2013 Grab something delicious to keep you moving. This can be coffee, hot cocoa, roasted nuts, or Poffertjes\u2026 even groceries. Whatever powers your adventure.&nbsp;&nbsp;<\/li>\n<\/ol>\n\n\n\n<ol start=\"2\" class=\"wp-block-list\">\n<li><strong>Get Around \u2013 <\/strong>Turn your travels into a reward. Call an Uber, fill up on gas, grab an e-bike or scooter.&nbsp;<\/li>\n<\/ol>\n\n\n\n<ol start=\"3\" class=\"wp-block-list\">\n<li><strong>Holiday Glow-Up \u2013 <\/strong>Treat yourself to something that makes you feel fresh for the festive season. This could be a fresh haircut, some new clothing, or a new accessory.&nbsp;<\/li>\n<\/ol>\n\n\n\n<ol start=\"4\" class=\"wp-block-list\">\n<li><strong>Health Is Wealth \u2013 <\/strong>Do something good for your overall health and well-being. Whether it&#8217;s picking up some supplements, replacing your gym clothes, or grabbing a protein bar, anything that boosts your well-being counts.&nbsp;&nbsp;<\/li>\n<\/ol>\n\n\n\n<ol start=\"5\" class=\"wp-block-list\">\n<li><strong>Touch Grass <\/strong>\u2013 Get out there and live in the moment. Whether it&#8217;s attending a sporting event, watching a movie, visiting a museum, or enjoying a theme park. Any IRL experience counts. Go make a memory.&nbsp;&nbsp;<\/li>\n<\/ol>\n\n\n\n<ol start=\"6\" class=\"wp-block-list\">\n<li><strong>Pay It Forward \u2013 <\/strong>Buy something small to brighten someone else\u2019s day. The final quest: a simple act of kindness to end your quest on a high note.&nbsp;<\/li>\n<\/ol>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-the-rewards-nbsp\"><strong>The rewards&nbsp;<\/strong><\/h2>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-daily-drops\"><strong>Daily Drops<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Every quest you complete enters you into our Daily Drop: Each day, 10 winners will get their purchase fully refunded (up to \u20ac100 each). The most creative entries have a better chance to win.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-the-grand-prize-25-000\"><strong>The Grand Prize: \u20ac25,000<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Complete <strong>all six quests<\/strong> at any point during the promotion period to unlock your single entry into the Grand Prize Raffle. <strong>One winner, chosen at random, winning \u20ac25,000.<\/strong><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-to-enter\"><strong>How to enter<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">For every quest you complete:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Take a photo proving you completed your task<\/li>\n\n\n\n<li>Respond to the Daily Drop post with 1) The quest that was completed and 2) A picture related to the quest with something Krak related.<\/li>\n\n\n\n<li>Send @Krak a DM containing:\n<ul class=\"wp-block-list\">\n<li>A link to your X post&nbsp;<\/li>\n\n\n\n<li>Your Kraktag;<\/li>\n\n\n\n<li>A screenshot of the Krak Card transaction showing the transaction details.<\/li>\n\n\n\n<li>Make sure you\u2019re following <a href=\"https:\/\/x.com\/krak\">@<\/a><a href=\"https:\/\/x.com\/krak\" target=\"_blank\" rel=\"noreferrer noopener\">Krak<\/a>!<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s it. Each post (up to 6 per day) that includes all of the above equals a Daily Drop entry. And yes \u2014 you can repeat quests across days.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-who-can-participate-nbsp\"><strong>Who can participate?&nbsp;<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Krak customers located in the EU can participate. A full list of eligible countries can be found <a href=\"https:\/\/www.kraken.com\/krakmasterms\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We also know holiday budgets can be tight, so there\u2019s also a free alternate method of entry (AMOE) using Sweeppea. Full details are available in <a href=\"http:\/\/www.kraken.com\/krakmasterms\" target=\"_blank\" rel=\"noreferrer noopener\">the official rules<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-play-your-way-through-the-holidays\">Play your way through the holidays<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Krak is more than a card. It\u2019s a tool for living, exploring, gifting, sharing, and discovering new experiences. Our 6 Days of Krakmas Holiday Quest Challenge brings that philosophy to life by blending real-world adventure with meaningful rewards.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A snack becomes a quest. A dinner becomes a win. A market stroll becomes a chance at \u20ac25,000. So grab your Krak Card, step outside, and turn your holiday period into chances to earn rewards.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ready to play? The Krak Holiday Quests are live today.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Don\u2019t have Krak yet? Get it <\/strong><a href=\"https:\/\/m.krak.app\/Qq7r\/1io9gqir\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>here<\/strong><\/a><strong>. Have Krak In the EU but don\u2019t have your Krak card yet? Get it <\/strong><a href=\"https:\/\/m.krak.app\/Qq7r\/1io9gqir\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>here<\/strong><\/a><strong>.<\/strong> Terms &amp; conditions apply. See full terms <a href=\"http:\/\/www.kraken.com\/krakmasterms\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/m.krak.app\/Qq7r\/1io9gqir\" target=\"_blank\" rel=\"noopener\">Krak Holiday Quests: get Krakin&#8217;<\/a><\/div>\n<div><\/div>\n","protected":false},"excerpt":{"rendered":"<p>Krak EU customers, welcome to the 6 Days of Krakmas, our festive challenge where everyday purchases become quests and every quest brings you closer to real rewards<\/p>\n","protected":false},"author":230089386,"featured_media":31362,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1793],"tags":[],"language":[],"class_list":["post-31207","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-promotions"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Turn your holiday spending into a \u20ac25,000 adventure: join Krak\u2019s Holiday Quest - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/promotions\/krak-holiday-quest-2025\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Turn your holiday spending into a \u20ac25,000 adventure: join Krak\u2019s Holiday Quest\" \/>\n<meta property=\"og:description\" content=\"Krak EU customers, welcome to the 6 Days of Krakmas, our festive challenge where everyday purchases become quests and every quest brings you closer to real rewards\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/promotions\/krak-holiday-quest-2025\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-12-18T14:01:04+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-12-18T14:07:16+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Blog-3070x1400-1-1024x467.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1024\" \/>\n\t<meta property=\"og:image:height\" content=\"467\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<me