l":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/blog-header-12.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31328","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=31328"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31328\/revisions"}],"predecessor-version":[{"id":31407,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/31328\/revisions\/31407"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/31330"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=31328"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=31328"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=31328"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=31328"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31408,"date":"2025-12-17T09:12:00","date_gmt":"2025-12-17T14:12:00","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31408"},"modified":"2025-12-17T09:12:01","modified_gmt":"2025-12-17T14:12:01","slug":"maker-fee-program-update-6-pairs","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/maker-fee-program-update-6-pairs","title":{"rendered":"Maker fee program update: optimizing liquidity incentives"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We are updating the pairs eligible for <a href=\"https:\/\/blog.kraken.com\/product\/promotions\/maker-rebates-select-spot-pairs\" target=\"_blank\" rel=\"noreferrer noopener\">our maker fee incentive program<\/a> to optimize liquidity support across our trading pairs. Effective Jan. 2, 2026, 4:00 p.m. UTC, we will be moving 6 trading pairs that have successfully achieved sufficient liquidity and trading volume to the regular spot crypto maker schedule:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>ZEC\/EUR<\/li>\n\n\n\n<li>PUMP\/USD<\/li>\n\n\n\n<li>USELESS\/USD<\/li>\n\n\n\n<li>HBAR\/USD<\/li>\n\n\n\n<li>DOGE\/EUR<\/li>\n\n\n\n<li>WLFI\/USD<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">These pairs have demonstrated both high trading volume ($50M+ 30-day) with strong market depth ($100k+), and improved depth-to-volume ratios, reflecting a self-sustaining liquidity profile that no longer requires rebate incentives.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This change allows us to focus our rebate program on pairs that still benefit from liquidity support.<br>Maker rebates will continue on <a href=\"https:\/\/support.kraken.com\/articles\/pairs-eligible-for-maker-fee-rebates\" target=\"_blank\" rel=\"noreferrer noopener\">425+ other trading pairs<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Updates like this one ensure our rebate program remains effective and sustainable while continuing to support liquidity development across our platform.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If you have questions, please contact your relationship manager, or <a href=\"https:\/\/support.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">visit our support center<\/a> for more information.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>We are updating the pairs eligible for our maker fee incentive program to optimize liquidity support across our trading pairs. Effective Jan. 2, 2026, 4:00 p.m. UTC, we will be moving 6 trading pairs that have successfully achieved sufficient liquidity and trading volume to the regular spot crypto maker schedule: These pairs have demonstrated both [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":31410,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1476],"language":[],"class_list":["post-31408","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Maker fee program update: optimizing liquidity incentives - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/maker-fee-program-update-6-pairs\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Maker fee program update: optimizing liquidity incentives\" \/>\n<meta property=\"og:description\" content=\"We are updating the pairs eligible for our maker fee incentive program to optimize liquidity support across our trading pairs. Effective Jan. 2, 2026, 4:00 p.m. UTC, we will be moving 6 trading pairs that have successfully achieved sufficient liquidity and trading volume to the regular spot crypto maker schedule: These pairs have demonstrated both [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/maker-fee-program-update-6-pairs\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-12-17T14:12:00+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-12-17T14:12:01+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/12\/Blog_Coins2-1024x467.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1024\" \/>\n\t<meta property=\"og:image:height\" content=\"467\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"1 minute\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/maker-fee-program-update-6-pairs#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/maker-fee-program-update-6-pairs\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\"},\"headline\":\"Maker fee program update: optimizing liquidity incentives\",\"datePublished\":\"2025-12-17T14:12:00+00:00\",\"dateModified\":\"