/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-836","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/RVV-blog-header.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30944","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=30944"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30944\/revisions"}],"predecessor-version":[{"id":30947,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30944\/revisions\/30947"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30945"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30944"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30944"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30944"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30944"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":31001,"date":"2025-11-25T12:04:54","date_gmt":"2025-11-25T17:04:54","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=31001"},"modified":"2025-11-25T12:16:53","modified_gmt":"2025-11-25T17:16:53","slug":"dentoshi-dead-cat-bounce-or-start-of-recovery","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery","title":{"rendered":"Trading spaces recap: Is this a dead cat bounce or the start of a recovery?"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">With BTC plunging toward&nbsp;<strong>$80k<\/strong>&nbsp;on Friday \u2014 leaving many U.S. traders waking up to carnage \u2014 and then sharply rebounding across the weekend toward&nbsp;<strong>$90k<\/strong>, the question on everyone\u2019s mind is simple:<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-is-this-a-true-recovery-or-just-a-dead-cat-bounce\"><strong>Is this a true recovery or just a dead cat bounce?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken VP of growth Matt Howells-Barby and pro trader Dentoshi (Den) spent <a href=\"https:\/\/www.youtube.com\/watch?v=w2aN8huXQG0\" target=\"_blank\" rel=\"noreferrer noopener\">the session<\/a> digging into the macro catalysts, the key technical levels and what traders should realistically expect in the weeks ahead.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">As always, nothing discussed is financial advice \u2014 only market commentary and education.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-macro-why-everything-hinges-on-the-december-rate-cut\"><strong>Macro: why everything hinges on the December rate cut<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Before diving into charts, Matt unpacked the macro environment behind last week\u2019s huge swings. In short, it\u2019s all about rate cuts and the lack of reliable data.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-here-s-what-happened\"><strong>Here\u2019s what happened:<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>The market\u2019s expectation for a December rate cut dropped as low as <strong>33%<\/strong> last Thursday \u2014 the lowest since the previous Fed meeting<\/li>\n\n\n\n<li>A series of hawkish remarks from non-voting Fed officials spooked markets<\/li>\n\n\n\n<li>The U.S. government shutdown meant missing datasets including no October non-farm payrolls report<\/li>\n\n\n\n<li>September\u2019s jobs report was mixed:\n<ul class=\"wp-block-list\">\n<li>Unemployment ticked up (rate-cut friendly)<\/li>\n\n\n\n<li>Payrolls surged far above expectations (rate-cut unfriendly)<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-then-sentiment-flipped\"><strong>Then sentiment flipped<\/strong>:<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>NY Fed President John Williams voiced support for a December cut<\/li>\n\n\n\n<li>Governor Waller, historically dovish, echoed the same<\/li>\n\n\n\n<li>Within hours, the market swung back to <strong>~77% odds<\/strong> of a December cut<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">The result: equities rallied and crypto followed. BTC\u2019s weekend rebound is almost a mirror image of these shifts.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Why this matters for crypto<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Crypto sits at the furthest end of the risk curve. If money is pulling out of AI equities, it\u2019s pulling out of crypto twice as fast \u2014 and when liquidity returns, crypto feels it twice as strongly.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The next major catalysts:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>PPI on Tuesday<\/strong> (the big one to watch)<\/li>\n\n\n\n<li><strong>PCE later in the week<\/strong><\/li>\n\n\n\n<li><strong>Initial jobless claims<\/strong> (a key proxy while other data is missing)<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">A low PPI print could push rate-cut expectations toward&nbsp;<strong>90%+<\/strong>, and a hot inflation surprise could trigger another wobble across risk assets.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>\u201cTime to clear the charts\u201d \u2013 Den on why the structure has changed<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Den made a strong point early: this is the first true structural breakdown of the bull trend.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Specifically, BTC has lost the&nbsp;<strong>3-day 100 EMA<\/strong>&nbsp;\u2014 a level that held throughout the entire bull market so far.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Previous pulls back to this EMA had always produced clean bounces. This time, we got a clean break.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"608\" data-attachment-id=\"31015\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\/attachment\/btc3-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?fit=2880%2C1710&amp;ssl=1\" data-orig-size=\"2880,1710\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC3\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?fit=1024%2C608&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=1024%2C608&#038;ssl=1\" alt=\"\" class=\"wp-image-31015\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=1024%2C608&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=300%2C178&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=768%2C456&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=1536%2C912&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=2048%2C1216&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=1200%2C713&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC3-1.png?resize=168%2C100&amp;ssl=1 168w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">According to Den:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cWhen something that has worked all the way through the cycle suddenly stops working, that\u2019s your signal to start fresh. Clear the charts. Reset the bias.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The speed and shape of the recent dump also stood out:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>No reaction at several major levels (yearly open, ETF cost basis, prior supports)<\/li>\n\n\n\n<li>No \u201cstandard\u201d bull-market bounces<\/li>\n\n\n\n<li>A type of breakdown more reminiscent of capitulation than controlled retrace<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">This doesn\u2019t mean the cycle is over, but it does mean the market we\u2019re in now is not the same market we were in three weeks ago.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>BTC: a strong bounce but with heavy work ahead<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">BTC has moved sharply off the lows, but context is key.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">The monthly chart<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Den calls it \u201csuper rejection-y.\u201d The first obvious magnet is the cluster of lows below.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">The new range<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Starting fresh, Den mapped BTC into a wide structural range defined by:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Support zone: low\u2013mid $70ks<\/li>\n\n\n\n<li>Major resistance 1: yearly open<\/li>\n\n\n\n<li>Major resistance 2: around $100k (mid-range confluence plus psychological level)<\/li>\n\n\n\n<li>Major resistance 3: 2024 highs and the local cluster of equal highs<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"607\" data-attachment-id=\"31003\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\/attachment\/btc\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?fit=2880%2C1706&amp;ssl=1\" data-orig-size=\"2880,1706\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?fit=1024%2C607&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=1024%2C607&#038;ssl=1\" alt=\"\" class=\"wp-image-31003\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=1024%2C607&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=300%2C178&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=768%2C455&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=1536%2C910&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=2048%2C1213&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=1200%2C711&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC.png?resize=169%2C100&amp;ssl=1 169w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">BTC is now pushing off support, but according to Den:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cWe have a lot of resistance above us. It would be more logical to see a move toward $100k and reject than to expect a straight reclaim \u2014 unless risk assets go absolutely wild.\u201d<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>A positive sign: the first 4h trend shift<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">For the first time since late October, BTC has:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Broken above the 4h EMAs<\/li>\n\n\n\n<li>Established early low-timeframe bullish structure<\/li>\n\n\n\n<li>Pulled a clean deviation-and-reclaim out of Den\u2019s support zone<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">This supports a relief bounce but doesn\u2019t confirm a full recovery.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"607\" data-attachment-id=\"31007\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\/attachment\/btc2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?fit=2880%2C1708&amp;ssl=1\" data-orig-size=\"2880,1708\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BTC2\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?fit=1024%2C607&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=1024%2C607&#038;ssl=1\" alt=\"\" class=\"wp-image-31007\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=1024%2C607&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=300%2C178&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=768%2C455&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=1536%2C911&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=2048%2C1215&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=1200%2C712&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/BTC2.png?resize=169%2C100&amp;ssl=1 169w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>The psychological challenge<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Four consecutive red weekly candles have people shaken. Den\u2019s advice:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Look for strength (reclaiming levels)<\/li>\n\n\n\n<li>Or look for logical sweeps of key levels<\/li>\n\n\n\n<li>But don\u2019t blindly knife-catch<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cZoom into the lower timeframes. Find structure that makes sense. Let it align with your higher timeframe thesis.\u201d<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>ETH: oversold mid-range bounce but still a long road back<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Den joked that looking at ETH \u201churts,\u201d but the chart is cleaner than BTC\u2019s.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">ETH\u2019s range is extremely well-defined. The mid-range in the&nbsp;<strong>$2,800s<\/strong>&nbsp;held \u2014 exactly where Den expected a mean-reversion bounce.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"607\" data-attachment-id=\"31008\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\/attachment\/eth\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?fit=2880%2C1708&amp;ssl=1\" data-orig-size=\"2880,1708\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"ETH\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?fit=1024%2C607&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=1024%2C607&#038;ssl=1\" alt=\"\" class=\"wp-image-31008\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=1024%2C607&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=300%2C178&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=768%2C455&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=1536%2C911&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=2048%2C1215&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=1200%2C712&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/ETH.png?resize=169%2C100&amp;ssl=1 169w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">She noted that:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>The stochastic RSI<\/li>\n\n\n\n<li>Cuban\u2019s reversion bands<\/li>\n\n\n\n<li>Pure price structure<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">All pointed toward oversold conditions.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">ETH is now pushing a local trend shift faster than BTC, but:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cIt\u2019s a long way to go. The more you dump, the more work you need&nbsp;to get back to the same place.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The real test for ETH is reclaiming level-to-level resistance looming above us; starting with the Yearly Open, 1D EMA&#8217;s, and quarterly range levels (not shown in this stream).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We want to have a conservative approach and not directly aim towards cycle highs; it&#8217;s a step-by-step approach. Until then, everything is provisional.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>What broke? Why 10 October changed everything<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Both Matt and Den agreed something changed in mid-October.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Den\u2019s observations:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Zero bounce at key high-probability levels, which is rare in past cycles<\/li>\n\n\n\n<li>Yearly open ignored, despite being untouched since early in the year<\/li>\n\n\n\n<li>Speed of breakdown inconsistent with prior bull-market pullbacks<\/li>\n\n\n\n<li>Daily EMAs about to cross bearish for the first time since the FTX collapse<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">That doesn\u2019t confirm a macro top, but it absolutely confirms a behavioral shift.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">BTC is acting differently. Alts are acting differently.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>The bear case: what would confirm a cycle top?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Den laid out her criteria carefully.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">1. Daily EMAs crossing bearish<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">This is already in motion, and the last time we saw it was during the FTX period.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">2. Rejections at key reclaim levels<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">If BTC tags the yearly open or $100k and gets slammed straight back down, that would be a very bearish signal.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">3. Sweeping into the mid-$60ks to mid-$70ks and dumping straight through<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">These levels hold enormous structural significance (2021 highs, untested liquidity). A clean break through them would imply:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Structure fully broken<\/li>\n\n\n\n<li>Likely cycling into a multi-month accumulation phase<\/li>\n\n\n\n<li>A path toward high-$40ks forming over many months<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Importantly, Den does not see an immediate collapse to $60k or $40k happening in one shot.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cIf we ever get to the $40ks again, it will be a long bleed-out, not a fast V-reversal.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">There is a lot of liquidity between $60k\u2013$70k that has not been revisited since the 2022\u201323 base.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Total market charts: still holding\u2026 barely<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Den walked through TOTAL and TOTAL3:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>TOTAL is sandwiched between the 2021 ATH and rejected highs<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"608\" data-attachment-id=\"31009\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\/attachment\/total\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?fit=2876%2C1708&amp;ssl=1\" data-orig-size=\"2876,1708\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"TOTAL\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?fit=1024%2C608&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=1024%2C608&#038;ssl=1\" alt=\"\" class=\"wp-image-31009\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=1024%2C608&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=300%2C178&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=768%2C456&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=1536%2C912&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=2048%2C1216&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=1200%2C713&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL.png?resize=168%2C100&amp;ssl=1 168w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<ul class=\"wp-block-list\">\n<li>The attempted breakdown last week did not continue, which is slightly bullish<\/li>\n\n\n\n<li>If TOTAL re-enters the prior range from below, that would be a strong structural breakdown signal<\/li>\n\n\n\n<li>TOTAL3 (alts excluding BTC and ETH) still clings to trend support despite many alts looking awful individually<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"609\" data-attachment-id=\"31011\" data-permalink=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\/attachment\/total3-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?fit=2880%2C1714&amp;ssl=1\" data-orig-size=\"2880,1714\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"TOTAL3\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?fit=1024%2C609&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=1024%2C609&#038;ssl=1\" alt=\"\" class=\"wp-image-31011\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=1024%2C609&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=300%2C179&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=768%2C457&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=1536%2C914&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=2048%2C1219&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=1200%2C714&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/TOTAL3.png?resize=168%2C100&amp;ssl=1 168w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">On all charts, the story is the same:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re holding for now, but the next move decides everything.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Macro momentum: the case for optimism<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Matt wrapped with a cautiously optimistic outlook.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If December brings a rate cut, even a small one, it may not send BTC to all-time highs immediately, but:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>It restores momentum<\/li>\n\n\n\n<li>It unlocks risk appetite<\/li>\n\n\n\n<li>It creates a path toward Q1 and Q2 follow-through, especially with data returning after months of silence<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Between a new Fed chair, pent-up economic releases and the renewed correlation between BTC and the Nasdaq 100, the next few inflation prints will decide the fate of the first half of 2025.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>So\u2026 dead cat bounce or recovery?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The honest answer:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We won\u2019t know this week.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We need to see:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>How BTC behaves at the yearly open<\/li>\n\n\n\n<li>Whether ETH can hold the midrange and reclaim some levels to the upside<\/li>\n\n\n\n<li>If TOTAL can hold 2021 ATHs<\/li>\n\n\n\n<li>How markets digest PPI, PCE and jobless claims<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Den summed it up:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cSomething has clearly changed. The question is: how different, and for how long?\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The next few weeks will define that. Catch the whole stream here:<\/p>\n\n\n\n<iframe loading=\"lazy\" width=\"560\" height=\"315\" src=\"https:\/\/www.youtube.com\/embed\/w2aN8huXQG0?si=ozjCJX3-hsxmxQec\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Stay updated<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019ll be back to our regular schedule after Thanksgiving with the next full episode on&nbsp;<strong>December 5<\/strong>&nbsp;(or sooner if volatility demands emergency deployment).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Make sure you\u2019re following:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong><a href=\"https:\/\/x.com\/krakenpro\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenpro<\/a><\/strong><\/li>\n\n\n\n<li><strong><a href=\"https:\/\/x.com\/@krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenfx<\/a><\/strong><\/li>\n\n\n\n<li><strong><a href=\"https:\/\/x.com\/Dentoshi\" target=\"_blank\" rel=\"noreferrer noopener\">@Dentoshi<\/a><\/strong><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\" id=\"h-\">And try&nbsp;<strong><a href=\"https:\/\/www.kraken.com\/desktop\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken desktop<\/a><\/strong>&nbsp;if you want the charting setups Den and Matt used in this session. It\u2019s free for all Kraken users.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/kraken.pxf.io\/c\/5984839\/1589189\/10583\" target=\"_blank\" rel=\"noopener\">Trade with Dentoshi on Kraken Pro<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Past Performance is not a reliable indicator of future results. <\/em><a href=\"https:\/\/assets-cms.kraken.com\/files\/51n36hrp\/facade\/b0183f2a11a80bb2b79cf5cab244b6faf58b421b.pdf\" target=\"_blank\" rel=\"noreferrer noopener\"><em>Learn more about asset risks.<\/em><\/a><em> Pricing data is provided by Kraken. Returns may increase or decrease as a result of currency fluctuations, and does not account for trading fees. Visit our fee schedule for more information.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>After one of the most volatile weeks the market has seen this cycle, we jumped on for an ad-hoc episode of trading spaces to break down the chaos in real time.<\/p>\n","protected":false},"author":230089386,"featured_media":31022,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1391],"tags":[1946],"language":[],"class_list":["post-31001","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-crypto-education","tag-dentoshi"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading spaces recap: Is this a dead cat bounce or the start of a recovery? - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Trading spaces recap: Is this a dead cat bounce or the start of a recovery?\" \/>\n<meta property=\"og:description\" content=\"After one of the most volatile weeks the market has seen this cycle, we jumped on for an ad-hoc episode of trading spaces to break down the chaos in real time.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/crypto-education\/dentoshi-dead-cat-bounce-or-start-of-recovery\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-11-25T17:04:54+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-11-25T17:16:53+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/11\/Blog-2.png\" \/>\n\t<meta property=\"og:image:width\" content=\"3070\" \/>\n\t<meta property=\"og:image:height\" content=\"1400\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"8 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.