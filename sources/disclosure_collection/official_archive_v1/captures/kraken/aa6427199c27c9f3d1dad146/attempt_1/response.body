idth\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"MON is available for trading! - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/product\/asset-listings\/mon-is-available-for-trading","og_locale":"en_US","og_type":"article","og_title":"MON is available for trading!","og_description":"We\u2019re thrilled to announce that MON is available for trading on Kraken! Funding and trading MON trading is live as of November 24, 2025. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens into networks supported by Kraken. Deposits [&hellip;]","og_url":"https:\/\/blog.kraken.com\/product\/asset-listings\/mon-is-available-for-trading","og_site_name":"Kraken Blog","article_published_time":"2025-11-24T15:03:10+00:00","article_modified_time":"2025-11-24T15:03:11+00:00","og_image":[{"width":3070,"height":1