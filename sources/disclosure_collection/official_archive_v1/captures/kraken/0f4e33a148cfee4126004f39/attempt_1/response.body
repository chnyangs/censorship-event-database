/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Kraken at the SEC-CFTC Roundtable: Building the rulebook for tokenized markets - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/industry-news\/sec-cftc-roundtable","og_locale":"en_US","og_type":"article","og_title":"Kraken at the SEC-CFTC Roundtable: Building the rulebook for tokenized markets","og_description":"On Monday, Kraken Co-CEO Arjun Sethi joined leaders from ICE, CME, Nasdaq, Cboe, Kalshi, DRW and Polymarket at the SEC\u2013CFTC Roundtable on platforms and market structure. Moderated by former CFTC Commissioner Jill Sommers and SEC Division of Trading and Markets Director Jamie Selway, the panel brought together some of the most influential voices in global [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/industry-news\/sec-cftc-roundtable","og_site_name":"Kraken Blog","artic