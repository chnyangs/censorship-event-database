log.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7N0","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Hero_1535x700%402x.jpg?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29946","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29946"}],"version-history":[{"count":12,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29946\/revisions"}],"predecessor-version":[{"id":29962,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29946\/revisions\/29962"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29951"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29946"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29946"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29946"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29946"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29927,"date":"2025-09-18T10:11:50","date_gmt":"2025-09-18T14:11:50","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29927"},"modified":"2025-09-18T10:22:38","modified_gmt":"2025-09-18T14:22:38","slug":"introducing-launch","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/launch\/introducing-launch","title":{"rendered":"Introducing Kraken Launch, powered by Legion"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">For 14 years, we have been one of the most trusted crypto platforms. Our vision is for <a href=\"http:\/\/kraken.com\/launch\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Launch<\/a> to support project teams throughout their token journey by offering services before, during and after token sales.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-why-kraken-launch\"><strong>Why Kraken Launch?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Crypto started with an ethos of open access for all. However, the first chance retail has to buy a token is often once it\u2019s already trading on the open market, long after many others have had the opportunity to do so.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The worlds of crypto and traditional finance are colliding. As this convergence accelerates, we believe offchain businesses will increasingly choose to raise funds through onchain token sales. This shift represents more than a technological upgrade: It\u2019s a reimagining of capital markets as open, global and permissionless by default.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With this vision of the future in mind, we think token sales should work differently.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-does-kraken-launch-raise-the-bar-nbsp\"><strong>How does Kraken Launch raise the bar?&nbsp;<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Transparency<\/strong>: No hidden round allocations, no insider deals; instead, you have all the information required to make an informed decision.<\/li>\n\n\n\n<li><strong>Built on trust<\/strong>: Participate safely in token sales within the familiarity and security of our platform.<\/li>\n\n\n\n<li><strong>Compliance-first<\/strong>: Sales adhere to clear regulatory frameworks like <a href=\"https:\/\/blog.kraken.com\/news\/all-30-eea-countries-mica\" target=\"_blank\" rel=\"noreferrer noopener\">MiCA<\/a> in Europe.<\/li>\n\n\n\n<li><strong>Smarter technology: <\/strong>Working with Legion\u2019s reputational features, sales will increasingly reward genuine community engagement, while also recognizing the contributions of long-time Kraken clients.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cKraken is building the foundation of tomorrow\u2019s financial infrastructure with crypto at its core,\u201d said Brett McLain, Kraken Head of Payments and Blockchain. \u201cTogether with <a href=\"https:\/\/legion.cc\/\" target=\"_blank\" rel=\"noreferrer noopener\">Legion<\/a>, we\u2019re scaling a product that democratizes token sales and aligns communities with builders. It\u2019s not just better fundraising, it&#8217;s better infrastructure for the next generation of finance.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This is not just another launchpad; through this partnership with Legion, Kraken is improving how early token sales and ICOs are conducted &#8212; with higher standards for disclosures, compliance and fair access &#8212; pairing an exchange sale with a native onchain sale to cater to everyone.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Why Legion?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Legion has built the most advanced fundraising platform in crypto. It combines retail-friendly access and institutional-grade protections, with an emphasis on <strong>clear disclosures, fair allocations and regulatory compliance<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The most high-profile Legion sales will deploy simultaneously on both Kraken Launch and Legion, and will be available for trading on Kraken shortly after the sale.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The Legion technology allows projects to evaluate users across social activity, developer contributions, onchain history and more to hand-select users that most deserve to be among their early token holders and supporters. A portion of each sale on Legion will be reserved for users based on this merit score. The remainder will be available via first-come, first-serve rounds on Legion and Kraken Launch.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">&#8220;Crypto gave us the tools to rebuild capital markets from first principles. This partnership combines Legion\u2019s approach to regulation and merit-based access with Kraken\u2019s global distribution, compliance infrastructure and deep liquidity,&#8221; said Legion co-founder Matt O\u2019Connor. \u201cThe next Figma or Reddit won\u2019t IPO. It\u2019ll launch to its community onchain. This partnership is another step toward making that possible.\u201d<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>What\u2019s next<\/strong><\/h2>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-be-ready\"><strong>Be ready.<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/sign-in\" target=\"_blank\" rel=\"noreferrer noopener\">Log in to your Kraken account<\/a> or <a href=\"https:\/\/www.kraken.com\/features\/cryptocurrency-apps#:~:text=apps%0AOne%20Kraken-,Kraken,-Use%20the%20Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">the Kraken app<\/a> and stay tuned for details on the first sale.<br>\ud83d\udc49 Turn on notifications on <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenfx<\/a> so you don\u2019t miss launch day<br>\ud83d\udc49 Keep an eye on <strong><a href=\"http:\/\/kraken.com\/launch\" target=\"_blank\" rel=\"noreferrer noopener\">kraken.com\/launch<\/a><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/launch\" target=\"_blank\" rel=\"noopener\">Explore Kraken Launch<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Built in exclusive partnership with Legion, we\u2019re opening the door for something new: Kraken Launch, your gateway to participate in ICOs and early token sales, directly from your Kraken account.<\/p>\n","protected":false},"author":230089386,"featured_media":29928,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1963],"tags":[],"language":[],"class_list":["post-29927","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-launch"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast 