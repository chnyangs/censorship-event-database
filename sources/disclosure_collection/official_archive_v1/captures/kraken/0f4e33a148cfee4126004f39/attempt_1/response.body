tUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7NU","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/NewAsset_Blog-11.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30002","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=30002"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30002\/revisions"}],"predecessor-version":[{"id":30004,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30002\/revisions\/30004"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30005"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30002"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30002"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30002"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30002"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29983,"date":"2025-09-22T10:00:02","date_gmt":"2025-09-22T14:00:02","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29983"},"modified":"2025-11-06T08:40:42","modified_gmt":"2025-11-06T13:40:42","slug":"diversify-your-crypto-portfolio","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio","title":{"rendered":"Let\u2019s get ready to Bundle: A smarter, effortless way to diversify your crypto portfolio"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">The crypto landscape is evolving faster than ever before, drawing in a new wave of mainstream investors. We\u2019re here to simplify that journey, making crypto investing smarter, more accessible and easier for everyone.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s why we\u2019re excited to launch <strong><a href=\"https:\/\/www.kraken.com\/features\/bundles\" target=\"_blank\" rel=\"noreferrer noopener\">Bundles<\/a><\/strong> \u2013 an innovative new feature in the Kraken platform that lets you buy diversified portfolios in just a few clicks.&nbsp;<\/p>\n\n\n\n\t\t<figure class=\"wp-block-jetpack-videopress jetpack-videopress-player\" style=\"\" >\n\t\t\t<div class=\"jetpack-videopress-player__wrapper\"> <iframe title=\"VideoPress Video Player\" aria-label='VideoPress Video Player' width='500' height='283' src='https:\/\/videopress.com\/embed\/wpfrJIRt?cover=1&amp;autoPlay=1&amp;controls=1&amp;loop=1&amp;muted=0&amp;persistVolume=1&amp;playsinline=0&amp;preloadContent=metadata&amp;useAverageColor=1&amp;hd=0' frameborder='0' allowfullscreen data-resize-to-parent=\"true\" allow='clipboard-write'><\/iframe><script src='https:\/\/v0.wordpress.com\/js\/next\/videopress-iframe.js?m=1739540970'><\/script><\/div>\n\t\t\t\n\t\t\t\n\t\t<\/figure>\n\t\t\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>Overwhelmed by crypto&#8217;s nearly endless investment choices?<\/em> <em>Bundles to the rescue.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you\u2019re just starting your crypto journey, or a seasoned investor seeking weighted exposure, Bundles gives you a simple way to instantly invest in a range of cryptoassets &#8212; without the hassle of managing multiple trades.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Better yet, each Bundle automatically rebalances for you, with no trading fees, so your allocation stays on course with your intended weightings. And with recurring buys, you can make repeated investments with zero effort &#8212; just set it and stack for the future.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/features\/bundles\" target=\"_blank\" rel=\"noopener\">Explore Bundles on Kraken<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-so-what-bundles-can-i-buy-now-nbsp\"><strong>So what Bundles can I buy now?&nbsp;<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">At launch, we\u2019re offering Bundle options specifically tailored to different investment preferences and strategies. This is just the beginning; we\u2019ll continue to expand our suite of Bundles over time to meet evolving market trends.&nbsp;&nbsp;<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-the-btc-eth-duo\"><strong>The BTC-ETH Duo<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">For those who believe in the long-term strength of the crypto market\u2019s two giants. This Bundle is weighted 70:30 between BTC and ETH, providing exposure to the two largest cryptoassets by market cap.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-the-crypto-blue-chip-nbsp-nbsp\"><strong>The Crypto Blue-Chip&nbsp;&nbsp;<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Looking for broad exposure to the largest assets by market cap? This Bundle offers equal weighting for some of the top cryptoassets by market cap (excluding stablecoins and wrapped tokens) and rebalances each quarter to keep pace with market movements. At launch, it will include: BTC, ETH, SOL, DOGE, XRP, TRX, ADA, HYPE, LINK and AVAX.&nbsp;&nbsp;<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-u-s-strategic-reserve-nbsp\"><strong>U.S. Strategic Reserve&nbsp;<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Inspired by the U.S. strategic reserve and national stockpile strategies, this Bundle offers equally weighted exposure to the range of assets outlined by the U.S. administration in March 2025 which will form the basis of the U.S.\u2019 future digital asset economy. At launch, the bundle will include equal weighting of BTC, ETH, XRP, SOL and ADA.\u00a0<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-major-memes-nbsp\"><strong>Major Memes&nbsp;<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Into crypto memes? This Bundle gives you broad exposure to top memecoins by market cap &#8212; including DOGE, PEPE, SHIB, BONK and FARTCOIN &#8212; all equally weighted. Perfect for those with a sense of humor, and who want broad exposure to the memecoin category.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-and-many-more-nbsp-nbsp\"><strong>And many more\u2026&nbsp;&nbsp;<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re also launching with a range of exciting additional Bundles including: the Inflation Hedge, Relive DeFi Summer, AI x Crypto, World Liberty Financials Holdings and the Bitcoin memes bundle. The full list of Bundles is available in <a href=\"https:\/\/www.kraken.com\/features\/bundles#app\" target=\"_blank\" rel=\"noreferrer noopener\">the Kraken app<\/a>.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"467\" data-attachment-id=\"29989\" data-permalink=\"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio\/attachment\/body_kb_3070x1400\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?fit=3070%2C1400&amp;ssl=1\" data-orig-size=\"3070,1400\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"BODY_KB_3070x1400\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?fit=1024%2C467&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=1024%2C467&#038;ssl=1\" alt=\"\" class=\"wp-image-29989\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=1024%2C467&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=300%2C137&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=768%2C350&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=1536%2C700&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=2048%2C934&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=1200%2C547&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?resize=200%2C91&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BODY_KB_3070x1400.png?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Why invest with Bundles?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Crypto investing can feel overwhelming, especially while navigating thousands of digital assets and market volatility. Our <a href=\"https:\/\/www.kraken.com\/learn\/dca-strategy-crypto\" target=\"_blank\" rel=\"noreferrer noopener\">research<\/a> shows that 59% of crypto investors use Dollar-Cost Averaging (DCA) as their primary investment strategy, helping them to stay consistent and remove emotion from their investment decisions.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Our Bundles align with this \u201cset it and forget it\u201d mentality, providing you with a simple, effective way to build long-term positions without the complexity of managing multiple trades.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Key benefits of bundles<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u2705<strong> Simple way to build your portfolio<\/strong> \u2013 Easily invest in a basket of crypto assets with just a few taps in the Kraken app, helping you spread your assets and build a well-rounded crypto portfolio.&nbsp;&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2705 <strong>Exposure that matches your investment approach<\/strong> \u2013 Choose a Bundle that matches your investment goals and let Kraken handle the rest.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2705 <strong>Helps you<\/strong> <strong>manage market volatility<\/strong> &#8211; If you\u2019re worried about mistiming trades, investing in Bundles can be a simple way to gain broad exposure over a sustained period.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2705 <strong>Autopilot your trading experience <\/strong>\u2013 Kraken automatically rebalances your Bundle, and you can set up recurring buys to stay consistent with market movements\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2705 <strong>Stay in control <\/strong>&#8211;<strong> <\/strong>Sell any amount anytime, or unbundle your assets to make individual balances your Kraken wallet.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>How to get started with Bundles&nbsp;<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Getting started with Bundles is simple:<\/p>\n\n\n\n<ol class=\"wp-block-list\">\n<li><a href=\"https:\/\/www.kraken.com\/features\/cryptocurrency-apps#:~:text=apps%0AOne%20Kraken-,Kraken,-Use%20the%20Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">Download the Kraken mobile app<\/a> and create an account (or log in if you already have an account).<\/li>\n\n\n\n<li>Fund your account with fiat or crypto.<\/li>\n\n\n\n<li>Choose the right Bundle that fits your investment strategy.&nbsp;<\/li>\n\n\n\n<li>Buy once or set a recurring buy to automatically buy on a recurring schedule.<\/li>\n\n\n\n<li>Sit back \u2013 Your Bundle will automatically rebalance as assets within it fluctuate in value.<\/li>\n\n\n\n<li>Track your Bundle\u2019s performance in real-time within the Kraken app.<\/li>\n<\/ol>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-join-the-future-of-crypto-investing-today-nbsp\"><strong>Join the future of crypto investing today&nbsp;<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Bundles are part of Kraken\u2019s broader mission of making investing accessible and intuitive for everyone, regardless of your experience.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">From offering equities to U.S. clients to launching <a href=\"http:\/\/kraken.com\/krak\">Krak<\/a> &#8212; our innovative all-in-one global money app for sending, saving and spending across 300 different currencies (crypto and fiat) &#8212; we\u2019re building a future where everyone can grow and manage their finances on their terms.&nbsp;&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re excited to bring Bundles to you and can\u2019t wait to expand our Bundles offerings to help you build a smarter, more diversified portfolio to serve your long-term investing needs.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/features\/bundles\" target=\"_blank\" rel=\"noopener\">Explore Bundles on Kraken<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>The crypto landscape is evolving faster than ever before, drawing in a new wave of mainstream investors. We\u2019re here to simplify that journey, making crypto investing smarter, more accessible and easier for everyone.\u00a0 That\u2019s why we\u2019re excited to launch Bundles \u2013 an innovative new feature in the Kraken platform that lets you buy diversified portfolios [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":30008,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1964],"tags":[1397,1476],"language":[],"class_list":["post-29983","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-bundles","tag-new-features","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Let\u2019s get ready to Bundle: A smarter, effortless way to diversify your crypto portfolio - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Let\u2019s get ready to Bundle: A smarter, effortless way to diversify your crypto portfolio\" \/>\n<meta property=\"og:description\" content=\"The crypto landscape is evolving faster than ever before, drawing in a new wave of mainstream investors. We\u2019re here to simplify that journey, making crypto investing smarter, more accessible and easier for everyone.\u00a0 That\u2019s why we\u2019re excited to launch Bundles \u2013 an innovative new feature in the Kraken platform that lets you buy diversified portfolios [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-09-22T14:00:02+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-11-06T13:40:42+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/Header-v1-_-Photo-Blog-@2x.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1535\" \/>\n\t<meta property=\"og:image:height\" content=\"700\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"5 minutes\" \/>\n<script typ