review":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio","og_locale":"en_US","og_type":"article","og_title":"Let\u2019s get ready to Bundle: A smarter, effortless way to diversify your crypto portfolio","og_description":"The crypto landscape is evolving faster than ever before, drawing in a new wave of mainstream investors. We\u2019re here to simplify that journey, making crypto investing smarter, more accessible and easier for everyone.\u00a0 That\u2019s why we\u2019re excited to launch Bundles \u2013 an innovative new feature in the Kraken platform that lets you buy diversified portfolios [&hellip;]","og_url":"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio","og_site_name":"Kraken Blog","article_published_time":"2025-09-22T14:00:02+00:00","article_modified_time":"2025-11-06T13:40:42+00:00","og_image":[{"width":1535,"height":700,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/Header-v1-_-Photo-Blog-@2x.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"5 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"Let\u2019s get ready to Bundle: A smarter, effortless way to diversify your crypto portfolio","datePublished":"2025-09-22T14:00:02+00:00","dateModified":"2025-11-06T13:40:42+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/product\/bundles\/diversify-your-crypto-portfolio"},"wordCount":881,"commentCount":0,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.c