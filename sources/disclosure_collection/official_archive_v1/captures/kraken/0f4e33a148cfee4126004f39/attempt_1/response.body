":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=30302"}],"version-history":[{"count":5,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30302\/revisions"}],"predecessor-version":[{"id":30309,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30302\/revisions\/30309"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30303"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30302"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30302"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30302"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30302"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":30296,"date":"2025-10-14T13:48:52","date_gmt":"2025-10-14T17:48:52","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=30296"},"modified":"2025-10-14T13:57:58","modified_gmt":"2025-10-14T17:57:58","slug":"yb-will-be-available-for-trading","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/yb-will-be-available-for-trading","title":{"rendered":"YB will be available for trading!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that YB will be available for trading on Kraken!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-funding-and-trading\"><strong>Funding and trading<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that <strong>YieldBasis (YB)<\/strong>, the first-ever Kraken Launch token, will be live for trading on Kraken.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Deposits open on October 15, 2025, at approximately 10:00 UTC, with trading following at 11:00 UTC.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">To add YB to your Kraken account, navigate to Funding, select YieldBasis (YB) and hit <em>Deposit<\/em>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Be sure to deposit YB on the supported network(s). Deposits made using other networks will be lost.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-about-yield-basis\"><strong>About Yield Basis<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">YieldBasis is a DeFi protocol created by the founder of Curve Finance. It introduces a new way for BTC and ETH holders to earn sustainable yield by eliminating impermanent loss through a 2x leveraged Curve LP strategy.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The YB token powers this system, enabling participants to access liquidity provision strategies and unlock tokenized yield-bearing assets like ybBTC and ybETH.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Please note:<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>If you participated in the token sale, your YB tokens have already been credited to your Kraken portfolio. They will become tradable once markets are live.<\/strong><\/li>\n\n\n\n<li><strong>Trading via the Kraken App and Instant Buy will be available once liquidity conditions are met.<\/strong><\/li>\n\n\n\n<li><strong>Geographic restrictions may apply.<\/strong><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-about-kraken-launch\"><strong>About <\/strong><a href=\"http:\/\/kraken.com\/launch\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Kraken Launch<\/strong><\/a><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">YieldBasis marks the very first project on Kraken Launch \u2014 our new platform for compliant, fair and transparent token sales powered by <a href=\"https:\/\/legion.cc\/\" target=\"_blank\" rel=\"noreferrer noopener\">Legion<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With Kraken Launch, you can:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Get early access to projects before they trade anywhere else<\/li>\n\n\n\n<li>Buy tokens at a fixed price<\/li>\n\n\n\n<li>Pay no trading fees when you subscribe to <a href=\"https:\/\/www.kraken.com\/kraken-plus\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Kraken+<\/strong><\/a><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Future sales will be announced via <a href=\"http:\/\/kraken.com\/launch\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Launc<\/a>h and <a href=\"http:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken X account<\/a>.<\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><a href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noreferrer noopener\"><em>Sign up today<\/em><\/a><em>!<\/em><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>, and all future tokens will be announced on our <a href=\"http:\/\/kraken.com\/listings\" target=\"_blank\" rel=\"noreferrer noopener\">Listings Roadmap<\/a> and <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">social media profiles<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that YB will be available for trading on Kraken! Funding and trading We\u2019re thrilled to announce that YieldBasis (YB), the first-ever Kraken Launch token, will be live for trading on Kraken. Deposits open on October 15, 2025, at approximately 10:00 UTC, with trading following at 11:00 UTC. To add YB to [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":30298,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789],"tags":[1403,1476],"language":[],"class_list":["post-30296","post","type-post","status-publish","format-standard","has