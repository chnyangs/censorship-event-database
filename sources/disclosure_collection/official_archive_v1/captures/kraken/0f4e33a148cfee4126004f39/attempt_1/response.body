.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=30150"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30150\/revisions"}],"predecessor-version":[{"id":30153,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/30150\/revisions\/30153"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/30151"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=30150"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=30150"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=30150"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=30150"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":30112,"date":"2025-10-02T10:00:03","date_gmt":"2025-10-02T14:00:03","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=30112"},"modified":"2025-10-02T10:00:04","modified_gmt":"2025-10-02T14:00:04","slug":"odm","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/odm","title":{"rendered":"October Deposit Match: Earn up to 2% back on new deposits"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Uptober is here &#8212; and with it, <a href=\"https:\/\/www.kraken.com\/odm\" target=\"_blank\" rel=\"noreferrer noopener\">one of the simplest, most rewarding opportunities we\u2019ve ever offered<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-how-it-works\"><strong>Here\u2019s how it works<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https:\/\/k.k.xyz\/JDNW\/2o9z0zis\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Opt in<\/strong> using the Kraken app<\/a>, deposit <strong>$1,000 or more (cash or crypto, with no maximum)<\/strong> during October to qualify.<br><\/li>\n\n\n\n<li>Every deposit you make adds to your total and at the end of the promotion your total net deposit amount will be eligible for the match reward.<br><\/li>\n\n\n\n<li>At the end of the promotion, your final <strong>match rate<\/strong> is set.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">The rate starts at <strong>1%<\/strong> and can <strong>boost up to 2%<\/strong> as the community reaches milestones together.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/k.k.xyz\/JDNW\/2o9z0zis\" target=\"_blank\" rel=\"noopener\">Join now<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-community-milestones\"><strong>Community milestones<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">As net deposits add up across the community, the match rate can boost for everyone:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Less than $250M in total deposits \u2192 <strong>1% match<\/strong><strong><br><\/strong><\/li>\n\n\n\n<li>$250M\u2013$499,999,999 in total deposits \u2192 <strong>1.5% match<\/strong><strong><br><\/strong><\/li>\n\n\n\n<li>$500M or more in total deposits \u2192 <strong>2% match<\/strong> (promo ends immediately)<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">You\u2019ll be able to follow progress in <a href=\"https:\/\/k.k.xyz\/JDNW\/2o9z0zis\" target=\"_blank\" rel=\"noreferrer noopener\">the Kraken app<\/a>, in real time, but don\u2019t wait too long. <strong>Once community deposits hit $500M, the promo ends immediately<\/strong> and if you haven\u2019t deposited, you\u2019ll miss out on the match bonus.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Why deposit in October<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">This isn\u2019t a one-time perk. It\u2019s a <strong>scalable reward<\/strong> that grows with you &#8212; and with everyone else.<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>$1,000 in crypto or cash deposits unlocks your match.<\/strong> Every deposit after that grows your reward.<br><\/li>\n\n\n\n<li><strong>Community boost.<\/strong> As total deposits climb, your match rate can rise too \u2013 up to 2%.<br><\/li>\n\n\n\n<li><strong>No individual cap.<\/strong> The more you deposit, the bigger your matched amount.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Remember, the $500M community milestone ends the promo early &#8212; and locks in a <strong>2% match for everybody who deposited over $1,000 during the promotion<\/strong>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>How to join<\/strong><\/h2>\n\n\n\n<ol class=\"wp-block-list\">\n<li><strong><a href=\"https:\/\/k.k.xyz\/JDNW\/2o9z0zis\" target=\"_blank\" rel=\"noreferrer noopener\">Opt in<\/a><\/strong> through the Kraken app.<br><\/li>\n\n\n\n<li><strong>Deposit cash or crypto<\/strong> during the promo period (October 1-31, or until the $500M milestone is reached).<br><\/li>\n\n\n\n<li>Sit back and wait for your match reward, or start trading your deposited funds within the Kraken app.<\/li>\n<\/ol>\n\n\n\n<p class=\"wp-block-paragraph\">Your match bonus will be credited <strong>within 14 days after the promo ends<\/strong>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>The bottom line<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Deposit $1,000+ in cash or crypto on Kraken this October, and watch your reward grow. Every net deposit for cash or crypto you make counts toward your match. Together, the community can boost the reward for everyone &#8212; up to 2%.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Don\u2019t wait. <strong><a href=\"https:\/\/k.k.xyz\/JDNW\/2o9z0zis\" target=\"_blank\" rel=\"noreferrer noopener\">Opt in now in the Kraken app<\/a> before the $500M milestone is hit. Once it\u2019s gone, it\u2019s gone.<\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/k.k.xyz\/JDNW\/2o9z0zis\" target=\"_blank\" rel=\"noopener\">Join now<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/kraken.com\/legal\/october-deposit-match-terms\" target=\"_blank\" rel=\"noreferrer noopener\"><em>Terms apply<\/em><\/a><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Deposit cash or crypto with Kraken this month, and we\u2019ll match up to 2% on your total net deposits.<\/p>\n","protected":false},"author":230089386,"featured_media":30122,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1793],"tags":[1517],"language":[],"class_list":["post-30112","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-promotions","tag-funding"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>October Deposit Match: Earn up to 2% back on new deposits - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/promotions\/odm\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"October Deposit Match: Earn up to 2% back on new deposits\" \/>\n<meta property=\"og:description\" content=\"Deposit cash or crypto with Kraken this month, and we\u2019ll match up to 2% on your total net deposits.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/promotions\/odm\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-10-02T14:00:03+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-10-02T14:00:04+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/BLOG_Deposit-match_3070x1400-1-1024x467.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1024\" \/>\n\t<meta property=\"og:image:height\" content=\"467\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"2 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/promotions\\\/odm#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\