true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29941"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29941\/revisions"}],"predecessor-version":[{"id":29945,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29941\/revisions\/29945"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29943"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29941"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29941"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29941"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29941"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29946,"date":"2025-09-18T06:39:10","date_gmt":"2025-09-18T10:39:10","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29946"},"modified":"2025-09-18T06:39:11","modified_gmt":"2025-09-18T10:39:11","slug":"tokenized-equities-kraken-pro","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/xstocks\/tokenized-equities-kraken-pro","title":{"rendered":"xStocks now available on Kraken Pro"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Trade popular U.S. stocks and ETFs 24\/5 \u2013 self-custodial, and on your terms.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that tokenized U.S. equities \u2013 powered by Backed\u2019s groundbreaking xStocks innovation \u2013 are now live on <a href=\"https:\/\/pro.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Pro<\/a>.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"29952\" data-permalink=\"https:\/\/blog.kraken.com\/product\/xstocks\/tokenized-equities-kraken-pro\/attachment\/xstockspro_blog_inner1_1920x10802x\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?fit=3840%2C2160&amp;ssl=1\" data-orig-size=\"3840,2160\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"xStocksPro_Blog_Inner1_1920x1080@2x\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-29952\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=2048%2C1152&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?resize=178%2C100&amp;ssl=1 178w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x.jpg?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">For the first time, <strong>eligible non-U.S. clients<\/strong> can get instant, flexible exposure to some of America\u2019s most iconic stocks and ETFs, directly from Kraken Pro\u2019s advanced web,\u00a0mobile app &amp; <a href=\"https:\/\/www.kraken.com\/desktop\" target=\"_blank\" rel=\"noreferrer noopener\">desktop<\/a>.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/proapp.kraken.com\/OBT6\/hoe8qklv\" target=\"_blank\" rel=\"noopener\">Trade xStocks on Kraken Pro<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-a-new-way-to-trade-u-s-equities\"><strong>A new way to trade U.S. equities<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"http:\/\/kraken.com\/pro\/xstocks\" target=\"_blank\" rel=\"noreferrer noopener\">xStocks<\/a> are tokenized representations of real-world equities, backed 1:1 by the underlying stock or ETF. Meaning you can trade them 24\/5 on Kraken Pro, or withdraw them anytime to your wallet, and use them across DeFi protocols &#8212; all while benefiting from tight spreads.<\/p>\n\n\n\n<iframe loading=\"lazy\" width=\"560\" height=\"315\" src=\"https:\/\/www.youtube.com\/embed\/OpiyVve5URM?si=vnmQ_3z8Et3KyDkS\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019ve launched with 60 tokenized assets &#8212; including names like Apple (AAPLx), Tesla (TSLAx), and the S&amp;P 500 ETF (SPYx) &#8212; and we&#8217;ll continue expanding the list over time.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-why-trade-xstocks-on-kraken-pro\"><strong>Why trade xStocks on Kraken Pro?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">With xStocks now in Kraken Pro, clients can:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trade xStocks like crypto<\/strong>: Buy and sell tokenized U.S. equities alongside digital assets, derivatives, and more.<\/li>\n\n\n\n<li><strong>Use all the Pro tools<\/strong>: Access <a href=\"https:\/\/blog.kraken.com\/product\/pro\/charting-updates\" target=\"_blank\" rel=\"noreferrer noopener\">advanced charting<\/a>, price alerts and <a href=\"https:\/\/pro.kraken.com\/app\/trade\/btc-usd#dialog\/learn-order-types\" target=\"_blank\" rel=\"noreferrer noopener\">9+ order types<\/a> including Iceberg, Trailing Stop and Take Profit.<\/li>\n\n\n\n<li><strong>Execute strategies with precision<\/strong>: Tap into full market depth, live order books and low-latency trade feeds.<\/li>\n\n\n\n<li><strong>Access markets beyond market hours<\/strong>: Trade 24\/5, Sunday 8:00 p.m. ET through Friday 8:00 p.m. ET, and self-custody for 24\/7 onchain use.<\/li>\n\n\n\n<li><strong>Invest flexibly<\/strong>: Get started with as little as $1 and withdraw xStocks to a self-hosted wallet for maximum control.<\/li>\n\n\n\n<li><a href=\"https:\/\/www.kraken.com\/features\/fee-schedule#pro-xstocks\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Competitive fees<\/strong><\/a>: At 0.1% for taker and rebate of -0.02% for maker volume.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"29954\" data-permalink=\"https:\/\/blog.kraken.com\/product\/xstocks\/tokenized-equities-kraken-pro\/attachment\/xstockspro_blog_inner1_1920x10802x-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?fit=3840%2C2160&amp;ssl=1\" data-orig-size=\"3840,2160\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"xStocksPro_Blog_Inner1_1920x1080@2x-1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-29954\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=2048%2C1152&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?resize=178%2C100&amp;ssl=1 178w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner1_1920x1080%402x-1.jpg?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">With fractional shares, and no FX conversion required, Kraken Pro is now one of the most efficient ways to gain exposure to U.S. equities &#8212; with none of the legacy frictions.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-one-platform-all-of-your-assets\"><strong>One platform. All of your assets.<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">xStocks make Kraken Pro the ultimate platform for traders and investors who want it all &#8212; tokenized stocks, crypto, derivatives, and more &#8212; in one seamless experience.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"29956\" data-permalink=\"https:\/\/blog.kraken.com\/product\/xstocks\/tokenized-equities-kraken-pro\/attachment\/xstockspro_blog_inner2_1920x10802x\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?fit=3840%2C2160&amp;ssl=1\" data-orig-size=\"3840,2160\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"xStocksPro_Blog_Inner2_1920x1080@2x\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-29956\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=2048%2C1152&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?resize=178%2C100&amp;ssl=1 178w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/09\/xStocksPro_Blog_Inner2_1920x1080%402x.jpg?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you&#8217;re placing trades on the go, managing your portfolio from your desktop or using our <a href=\"https:\/\/docs.kraken.com\/api\/\" target=\"_blank\" rel=\"noreferrer noopener\">APIs<\/a> for advanced strategies, Kraken Pro empowers you to:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Build a diversified portfolio of tokenized assets<\/li>\n\n\n\n<li>Trade fast, with low latency and minimal slippage<\/li>\n\n\n\n<li>Control your assets via self-custody &#8212; anytime, anywhere<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">And with the addition of xStocks, you can now plan and execute multi-asset strategies from a single, professional-grade interface.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Get started today and experience the next frontier of finance &#8212; right inside Kraken Pro.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/proapp.kraken.com\/OBT6\/hoe8qklv\" target=\"_blank\" rel=\"noopener\">Trade xStocks on Kraken Pro<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>xStocks are issued by Backed Assets (JE) Limited (a Jersey private limited company) and offered to eligible Kraken customers via Payward Digital Solutions Ltd. (\u201cPDSL\u201d), a company licensed to conduct digital asset business by the Bermuda Monetary Authority. xStocks are not nor will be registered with any local securities regulators. PDSL (Kraken) does not provide investment advice and\/or recommendations, and, no communication, through any Kraken App or website or otherwise, should be construed as such. Individual investors should make their own decisions or seek professional independent advice if they are unsure as to the suitability\/appropriateness of any investment for their circumstances or needs, including potential tax treatment. Investing in xStocks involves an element of risk. The value of an investment may go down as well as up, and past performance is not a reliable indicator of future results. Not available in the U.S. or to U.S. persons. Geo restrictions apply. Read Kraken\u2019s xStocks Risk Disclosure at <a href=\"https:\/\/www.kraken.com\/legal\/xstocks\" target=\"_blank\" rel=\"noreferrer noopener\">kraken.com\/legal\/xstocks<\/a> as well as the Base Prospectus and related Final Terms for xStocks at <a href=\"https:\/\/assets.backed.fi\/legal-documentation\" target=\"_blank\" rel=\"noreferrer noopener\">https:\/\/assets.backed.fi\/legal-documentation<\/a> to learn more.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Get fast, flexible exposure to U.S. stocks and ETFs &#8212; now in Kraken Pro for eligible non-U.S. clients. <\/p>\n","protected":false},"author":230089386,"featured_media":29951,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1947],"tags":[1915,1722,1937,1476,1951],"language":[],"class_list":["post-29946","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-xstocks","tag-equities","tag-kraken-pro","tag-tokenized","tag-trading","tag-xstocks"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>xStocks now available on Kraken Pro - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\