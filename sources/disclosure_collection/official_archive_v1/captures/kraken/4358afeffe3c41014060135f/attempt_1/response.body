/wp-json\/wp\/v2\/tags?post=22183"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=22183"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22184,"date":"2023-05-31T17:08:42","date_gmt":"2023-05-31T21:08:42","guid":{"rendered":"https:\/\/blog.kraken.com\/kraken-is-recognized-as-a-newsweek-top-100-global-most-loved-workplace"},"modified":"2023-06-02T11:41:30","modified_gmt":"2023-06-02T15:41:30","slug":"kraken-is-recognized-as-a-newsweek-top-100-global-most-loved-workplace","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/kraken-is-recognized-as-a-newsweek-top-100-global-most-loved-workplace","title":{"rendered":"Kraken is recognized as a Newsweek Top 100 Global Most Loved Workplace"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">Kraken is excited to announce that we have been named #16 in <a href=\"https:\/\/www.newsweek.com\/rankings\/global-most-loved-workplaces-2023\">Newsweek&#8217;s Top 100 Global Most Loved Workplaces\u00ae list<\/a>. We are also the only crypto company on the list. This recognition reflects Kraken&#8217;s ongoing commitment to building a flexible workplace that prioritizes employee well-being.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Newsweek&#8217;s rankings, backed by the rigorous analysis of the Best Practice Institute, are based on survey results of more than two million employees from different industries and company sizes. Newsweek publishes its annual list of top-100 global companies that build their business models around respect, care, and employee appreciation.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">&#8220;We&#8217;re proud to tell the world that our unique company culture enables Krakenites to both love their work and excel in what they do,&#8221; said Pranesh Anthapur, Kraken&#8217;s Chief People Officer. &#8220;We know our Krakenites value the autonomy and flexibility we offer, and are inspired by our company\u2019s global crypto mission. I\u2019m pleased our teams value the dedication that has gone into building a world-class remote-first workplace.&#8221;<\/span><\/p>\n<p><span style=\"font-weight: 400;\">What makes Kraken such a great place to work? In addition to compelling career growth and learning opportunities, we offer holistic health and wellness benefits. These include truly flexible PTO practices, access to in-house fitness and well-being coaches, as well as a generous grant to build a customized in-home office. Krakenites are also invested in the success of the company and the broader industry. Nearly 40% receive a part of their salary in digital assets and many of our roles come with company share options included in the compensation package.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We&#8217;re honored to be part of the list and we thank all our Krakenites for telling the world how much they love where they work.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Ready to join the revolution? Find the role for you at Kraken today!<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/topworkplace\/\" target=\"_blank\" rel=\"noopener\">View Open Roles<\/a><\/div>\n<div><\/div>\n<p><span style=\"font-weight: 400;\">Click <a href=\"https:\/\/www.newsweek.com\/rankings\/global-most-loved-workplaces-2023\">here<\/a> to see Newsweek\u2019s full list of 2023&#8217;s Top 100 Most Loved Workplaces\u00ae<\/span><span style=\"font-weight: 400;\">.<\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Kraken is excited to announce that we have been named #16 in Newsweek&#8217;s Top 100 Global Most Loved Workplaces\u00ae list. We are also the only crypto company on the list. This recognition reflects Kraken&#8217;s ongoing commitment to building a flexible workplace that prioritizes employee well-being. Newsweek&#8217;s rankings, backed by the rigorous analysis of the Best [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":22205,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1805],"language":[],"class_list":["post-22184","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-newsweek"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken is recognized as a Newsweek Top 100 Global Most Loved Workplace - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/kraken-is-recognized-as-a-newsweek-top-100-global-most-loved-workplace\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Kraken is recognized as a Newsweek Top 100 Global Most Loved Workplace\" \/>\n<meta property=\"og:description\" content=\"Kraken is excited to announce that we have been named #16 in Newsweek&#8217;s Top 100 Global Most Loved Workplaces\u00ae list. We are also the only crypto company on the lis