b?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-5MJ","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/Vishnu-Patankar-Kraken.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22241","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=22241"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22241\/revisions"}],"predecessor-version":[{"id":22247,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22241\/revisions\/22247"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/22248"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=22241"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=22241"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=22241"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=22241"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22299,"date":"2023-06-08T13:05:22","date_gmt":"2023-06-08T17:05:22","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=22299"},"modified":"2024-04-10T16:07:59","modified_gmt":"2024-04-10T20:07:59","slug":"kraken-launches-your-gateway-to-the-world-of-nfts","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/kraken-launches-your-gateway-to-the-world-of-nfts","title":{"rendered":"Kraken launches your gateway to the world of NFTs"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Since first opening <\/span><a href=\"https:\/\/nft.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\"> to beta testers, we\u2019ve been building new features, adding more collections, and simplifying the NFT trading experience for all. Now, we\u2019re pleased to announce that Kraken NFT is officially ready to launch.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">That\u2019s right: <\/span><b>we are no longer in Beta<\/b><span style=\"font-weight: 400;\">. Presenting Kraken NFT \u2014 your gateway to buying, selling, and learning about NFTs!<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">What can you expect? As we\u2019ve expanded the number of NFT collections available on Kraken NFT from 70 to over 250 (with no plans to slow down), we\u2019ve also integrated one of the fastest growing blockchains for NFTs in the space. The ultra-fast and efficient <\/span><a href=\"https:\/\/www.kraken.com\/prices\/polygon\"><span style=\"font-weight: 400;\">Polygon network<\/span><\/a><span style=\"font-weight: 400;\"> \u2014 along with its red-hot <a href=\"https:\/\/www.kraken.com\/learn\/what-are-reddit-collectible-avatar-nfts\">Reddit Collectible Avatars<\/a> collection \u2014 is now accessible from Kraken NFT.<\/span><\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter\"><a href=\"https:\/\/www.kraken.com\/sign-up?nft\"><img data-recalc-dims=\"1\" decoding=\"async\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/NFT-Launch-Modal-Wide.png?ssl=1\" alt=\"NFT Launch - Modal Wide\" class=\"wp-image-18920\"\/><\/a><\/figure>\n<\/div>\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">And that\u2019s not all. Let\u2019s explore some of the things we\u2019ve been building for you.<\/span><\/p>\n\n\n\n<div>\n<h2><span style=\"font-weight: 400;\">Over 250 NFT collections to explore, collect, and trade<\/span><\/h2>\n<p><span style=\"font-weight: 400;\">We\u2019ve long understood that <\/span><a href=\"https:\/\/blog.kraken.com\/post\/18612\/why-buy-an-nft-community-membership\/\"><span style=\"font-weight: 400;\">the communities behind the NFTs<\/span><\/a><span style=\"font-weight: 400;\"> are often even more significant than the collectibles themselves. That\u2019s why we\u2019ve been curating many of the most active NFT collections the market has to offer.&nbsp;<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We launched Kraken NFT with ecosystem defining collections \u2014 from groundbreaking projects like <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NCZRVRU-7YGFA-QWP5VE&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">CryptoPunks<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NCL24XT-MDL23-ME56PF\"><span style=\"font-weight: 400;\">Bored Ape Yacht Club<\/span><\/a><span style=\"font-weight: 400;\"> to cult-favorites like <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NC2ZIEK-DBKZT-72YDHC&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">Mfers<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NCQIJ3W-SJPWG-HESLMF&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">CrypToadz<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Since then, we kept our finger on the market\u2019s pulse and added the hottest collections redefining the space. With anime-inspired collections like <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NCTATCV-YZYBB-NCYHMT&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">uwucrew<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NC6KMK7-HNX4H-4ECY7M&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">DigiDaigaku<\/span><\/a><span style=\"font-weight: 400;\"> as well as pixel-art collections like <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NCGZFR5-TIBKE-3FR2OO&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">Nakamigos<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/nft.kraken.com\/explore\/collections?collectionId=NC2QYLS-Z2T7E-EKCXUW&amp;sort=PriceLowToHigh\"><span style=\"font-weight: 400;\">Solana Monkey Business<\/span><\/a><span style=\"font-weight: 400;\">, it is easy to find an NFT for you on Kraken NFT.<\/span><\/p>\n<figure><a href=\"https:\/\/www.kraken.com\/sign-up?nft\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-18962 aligncenter\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/Screenshot-2023-06-05-at-11.22.47-AM.png?resize=1000%2C395&#038;ssl=1\" alt=\"NFTs for every wallet on Kraken NFT\" width=\"1000\" height=\"395\"><\/a><\/figure><p><\/p>\n<p><span style=\"font-weight: 400;\">With thousands of NFTs available today for less than $100, Kraken NFT has once and for all <\/span><a href=\"https:\/\/blog.kraken.com\/post\/18746\/busting-crypto-myths-nfts-are-only-for-the-wealthy\/\"><span style=\"font-weight: 400;\">busted the myth that NFTs are only for wealthy collectors<\/span><\/a><span style=\"font-weight: 400;\">. Check out the hundreds of NFTs available for less than $100 on Kraken NFT today.<\/span><br>\n<\/p><\/div>\n\n\n\n<figure class=\"wp-block-video wp-block-embed is-type-video is-provider-videopress\"><div class=\"wp-block-embed__wrapper\">\n<iframe title=\"VideoPress Video Player\" aria-label='VideoPress Video Player' width='500' height='281' src='https:\/\/videopress.com\/embed\/znB8zdRS?cover=1&amp;preloadContent=metadata&amp;useAverageColor=1&amp;hd=0' frameborder='0' allowfullscreen data-resize-to-parent=\"true\" allow='clipboard-write'><\/iframe><script src='https:\/\/v0.wordpress.com\/js\/next\/videopress-iframe.js?m=1674852142'><\/script>\n<\/div><\/figure>\n\n\n\n<div style=\"height:30px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up?nft\" target=\"_blank\" rel=\"noopener\">Try Kraken NFT<\/a><\/div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-zero-gas-fee-trading\"><span style=\"font-weight: 400;\">Zero gas fee trading*<\/span><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">All too often, <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\"><span style=\"font-weight: 400;\">gas fees<\/span><\/a><span style=\"font-weight: 400;\"> stand between you and the NFT collections of your dreams. Thankfully, Kraken NFT helps your money go further by not charging gas fees for <\/span><b>buying and selling<\/b><span style=\"font-weight: 400;\"> on the platform.&nbsp;<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Whether there is a FOMO-inducing drop or a record-breaking spike in DeFi trading, gas fees will not stand between you and your new NFT on Kraken.&nbsp;<\/span><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-pay-your-way\"><span style=\"font-weight: 400;\">Pay your way<\/span><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Kraken NFT makes it easy to buy and sell NFTs using the cash or cryptocurrency of your choice.&nbsp;<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">With Kraken NFT, there is no need to set up a Web3 crypto wallet or wrap your tokens just to get started in the space. No matter what cash or cryptocurrency a seller choses when listing an NFT, Kraken NFT makes it easy to bid on NFTs your way by choosing from more than 200 different cryptocurrencies and cash options.<\/span><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-start-your-engines\"><span style=\"font-weight: 400;\">Start your engines<\/span><\/h2>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter\"><a href=\"https:\/\/www.kraken.com\/williamsracing\"><img data-recalc-dims=\"1\" decoding=\"async\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/New-NFT-Back-Car.png?ssl=1\" alt=\"NFT rear wing\" class=\"wp-image-18928\"\/><\/a><\/figure>\n<\/div>\n\n\n<div>\n<p><span style=\"font-weight: 400;\">To celebrate the launch of Kraken NFT, we\u2019ll bring the true potential of NFT ownership to life by giving our clients the opportunity to showcase their NFTs on the world stage.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">In partnership with the <\/span><a href=\"https:\/\/www.kraken.com\/williamsracing\"><span style=\"font-weight: 400;\">Williams Racing Formula 1 team<\/span><\/a><span style=\"font-weight: 400;\">, we will be announcing details on <\/span><b>how you can win the opportunity to feature your favorite NFT on the rear wing of an F1 car<\/b><span style=\"font-weight: 400;\"><span style=\"font-weight: 400;\"> during a race this year. If you are interested in seeing your NFT flying around the track at 200 mph, now is the time to get started with Kraken NFT<\/span><\/span>.<\/p>\n<\/div>\n\n\n\n<div><\/div>\n\n\n\n<div>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up?nft\" target=\"_blank\" rel=\"noopener\">Sign up for Kraken NFT<\/a><\/div>\n<\/div>\n\n\n\n<div>\n<h2><span style=\"font-weight: 400;\">More to come!<\/span><\/h2>\n<p><span style=\"font-weight: 400;\">Just because we are out of Beta doesn\u2019t mean we stopped building. We have an endless list of exciting perks and features you\u2019ll love while getting started in the world of NFTs.&nbsp;<\/span><\/p>\n<p><span style=\"font-weight: 400;\">From exclusive, client-only drops with Williams Racing to gas-free floor sweeping, we are still building the secure, easy, and innovative way to interact with the ever-evolving NFT ecosystem.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Follow the <\/span><a href=\"https:\/\/blog.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\"> and our <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">@KrakenNFT social account<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know when we add new features and NFT collections.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Until then, don\u2019t miss out! Get started with Kraken NFT today. <\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up?nft\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<\/div>\n\n\n\n<div><\/div>\n\n\n\n<div>\n<hr>\n<\/div>\n\n\n\n<div>\n<div><i><span style=\"font-weight: 400;\"><em><span style=\"font-size: 14.1667px;\">*<\/span>G<\/em>as fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform.<\/span><\/i><\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Since first opening Kraken NFT to beta testers, we\u2019ve been building new features, adding more collections, and simplifying the NFT trading experience for all. Now, we\u2019re pleased to announce that Kraken NFT is officially ready to launch. That\u2019s right: we are no longer in Beta. Presenting Kraken NFT \u2014 your gateway to buying, selling, and [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":22489,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460,1426],"tags":[],"language":[],"class_list":["post-22299","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-nft","category-product"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken launches your gateway to the world of NFTs - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/kraken-launches-your-gateway-to-the-world-of-nfts\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Kraken launches your gateway to the world of NFTs\" \/>\n<meta property=\"og:description\" content=\"Since first opening Kraken NFT to beta testers, we\u2019ve been building new features, adding more collections, and simplifying the NFT trading experience for all. Now, we\u2019re pleased to announce that Kraken NFT is officially ready to launch. That\u2019s right: we are no longer in Beta. Presenting Kraken NFT \u2014 your gateway to buying, selling, and [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/kraken-launches-your-gateway-to-the-world-of-nfts\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-06-08T17:05:22+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2024-04-10T20:07:59+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/NFT-Announcement-featuredimage-1.webp\" \/>\n\t<meta property=\"og:image:width\" content=\"1535\" \/>\n\t<meta property=\"og:image:height\" content=\"700\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/webp\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@typ