":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-5R7","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/NFT_Listing_Jun09_BlogInner.png?fit=1536%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22513","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=22513"}],"version-history":[{"count":10,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22513\/revisions"}],"predecessor-version":[{"id":22779,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22513\/revisions\/22779"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/22516"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=22513"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=22513"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=22513"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=22513"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22575,"date":"2023-06-23T10:04:06","date_gmt":"2023-06-23T14:04:06","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=22575"},"modified":"2023-07-07T09:42:11","modified_gmt":"2023-07-07T13:42:11","slug":"otherdeed-expanded-pixelady-maker-ocm-karma-killabears-and-more-collections-added-to-kraken-nft","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/nft\/otherdeed-expanded-pixelady-maker-ocm-karma-killabears-and-more-collections-added-to-kraken-nft","title":{"rendered":"Otherdeed Expanded, Pixelady Maker, OCM Karma, KILLABEARS and more collections added to Kraken NFT"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019ve just added <strong>five new NFT collections<\/strong> to <a href=\"https:\/\/www.kraken.com\/nft\">Kraken NFT<\/a> for our clients to explore, collect and trade.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">After revealing <a href=\"https:\/\/blog.kraken.com\/category\/product\/nft\">dozens of NFT collections over the past few weeks<\/a>, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\">gas fees<\/a>.*\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We will continue to add a wide range of new NFT collections every week \u2014 from the hottest <a href=\"https:\/\/blog.kraken.com\/nfts-101-identity-expression-with-pfps\">profile picture NFT collection<\/a> to the most dedicated <a href=\"https:\/\/krakenfx.wpcomstaging.com\/post\/18612\/why-buy-an-nft-community-membership\/\">NFT communities<\/a> \u2014 across the <a href=\"https:\/\/www.kraken.com\/prices\/ethereum\">Ethereum<\/a>, <a href=\"https:\/\/www.kraken.com\/prices\/solana\">Solana<\/a> and <a href=\"https:\/\/www.kraken.com\/prices\/polygon\">Polygon<\/a> blockchains.&nbsp;<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">Here are the new collections launching on Kraken NFT today:<\/h3>\n\n\n\n<figure class=\"wp-block-table\"><table><tbody><tr><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0)\" class=\"has-inline-color has-vivid-purple-color\">Collection name<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0)\" class=\"has-inline-color has-vivid-purple-color\">Blockchain network<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0)\" class=\"has-inline-color has-vivid-purple-color\">Token standard<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0)\" class=\"has-inline-color has-vivid-purple-color\"># of NFTs in collection<\/mark><\/strong><\/td><\/tr><tr><td>Otherdeed Expanded<\/td><td>Ethereum<\/td><td>ERC-721<\/td><td>43,801<\/td><\/tr><tr><td>Banners NFT<\/td><td>Ethereum<\/td><td>ERC-721<\/td><td>2,000<\/td><\/tr><tr><td>Pixelady Maker<\/td><td>Ethereum<\/td><td>ERC-721<\/td><td>7,996<\/td><\/tr><tr><td>OCM Karma<\/td><td>Ethereum<\/td><td>ERC-721<\/td><td>12,428<\/td><\/tr><tr><td>KILLABEARS<\/td><td>Ethereum<\/td><td>ERC-721<\/td><td>3,333<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Check out these collections on Kraken NFT.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/nft-listing-june-23\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n\n\n\n<h3 class=\"wp-block-heading\">Your opinion matters<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Your opinion will help shape Kraken NFT as we expand across the global market. Please check out our Support Center for any FAQs about <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\">using the marketplace<\/a>, or contact <a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\">Kraken Support<\/a> for 24\/7 assistance.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If you\u2019re new to the world of NFTs, you can check out our <a href=\"https:\/\/www.kraken.com\/learn\">Kraken Learn Center<\/a> article, <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\">What is an NFT?<\/a> to discover what all the excitement is about.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">In addition to these latest NFT collections that have just been added, you can also browse the full list of <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\">all 250+ NFT collections available for you to explore, collect and trade on Kraken NFT<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Follow the <a href=\"https:\/\/blog.kraken.com\/\">Kraken Blog<\/a> and our <a href=\"https:\/\/twitter.com\/krakennft\">@KrakenNFT social account<\/a> to be the first to know when we add new features and NFT collections.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Follow our Kraken NFT Twitter!<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s right, we have a dedicated Twitter account for all things NFTs! Follow us on Twitter at <a href=\"https:\/\/twitter.com\/krakennft\">KrakenNFT<\/a> to be the first to know about all of the exciting things happening on Kraken NFT.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Will Kraken make more NFTs available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken can be found on <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\">our website<\/a>, and all future NFTs will be announced on <a href=\"https:\/\/twitter.com\/krakennft\">Kraken NFT\u2019s Twitter<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Trade with caution<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Specific asset availability and liquidity are not guaranteed. When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019ve just added five new NFT collections to Kraken NFT for our clients to explore, collect and trade.&nbsp; After revealing dozens of NFT collections over the past few weeks, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas fees.*\u00a0 We will continue to [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":22576,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460],"tags":[1459,1421],"language":[],"class_list":["post-22575","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-nft","tag-kraken-nft","tag-nft"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Otherdeed Expanded, Pixelady Maker, OCM Karma, KILLABEARS and more collections added to Kraken NFT - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/nft\/otherdeed-expanded-pixelady-maker-ocm-karma-killabears-and-more-collections-added-to-kraken-n