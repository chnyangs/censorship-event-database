blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"Kraken launches your gateway to the world of NFTs"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21","name":"krakenfx","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-5NF","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/06\/NFT-Announcement-featuredimage-1.webp?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22299","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=22299"}],"version-history":[{"count":12,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22299\/revisions"}],"predecessor-version":[{"id":24906,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22299\/revisions\/24906"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/22489"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=22299"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=22299"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=22299"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=22299"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22347,"date":"2023-06-12T14:16:01","date_gmt":"2023-06-12T18:16:01","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=22347"},"modified":"2023-06-12T14:20:39","modified_gmt":"2023-06-12T18:20:39","slug":"polygon-lands-on-kraken-nft-trade-reddit-collectible-avatars-today","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/polygon-lands-on-kraken-nft-trade-reddit-collectible-avatars-today","title":{"rendered":"Polygon lands on Kraken NFT \u2014 trade Reddit Collectible Avatars today"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Did you catch the exciting news in our <a href=\"https:\/\/blog.kraken.com\/kraken-launches-your-gateway-to-the-world-of-nfts\">Kraken launches your gateway to the world of NFTs<\/a> post last week? <\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Polygon NFTs are now available on <a href=\"https:\/\/www.kraken.com\/nft\">Kraken NFT<\/a> \u2014 the secure marketplace to explore, collect and trade <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\">non-fungible tokens<\/a> with zero gas fees.*&nbsp;Clients can now use the <a href=\"https:\/\/www.kraken.com\/prices\/polygon\">Polygon network<\/a> to deposit and withdraw supported Polygon NFTs from Kraken, including Reddit Collectible Avatars.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/reddit-avatars\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\">Introducing Reddit Collectible Avatars on Kraken NFT<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/learn\/what-are-reddit-collectible-avatar-nfts\">Reddit Collectible Avatars<\/a> are one of the most significant collections ever to hit the NFT market. With more than a billion monthly users on Reddit and a diverse offering of millions of different collectibles, Reddit Collectible Avatars represent an important opportunity to bring mass adoption to the NFT space.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s why we are thrilled to celebrate the launch of Polygon NFTs on Kraken NFT with this ground-breaking collection.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">On Kraken NFT, you&#8217;ll have access to several unique Reddit collections, crafted in partnership with a global network of independent artists. Each NFT can be purchased for cash or crypto without having to worry about any <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\">gas fees<\/a>!*\u00a0To learn more about Reddit Avatars, check out our article <a href=\"https:\/\/www.kraken.com\/learn\/what-are-reddit-collectible-avatar-nfts\">What are Reddit Collectible Avatars?<\/a> on Kraken Learn Center!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Polygon \u2014 a scalability focused blockchain for NFTs<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Polygon quickly established itself as one of the most complete blockchain networks for NFTs. Between its scalability and all the exciting collections that have chosen to make it their home, Polygon offers the perfect addition to the Kraken NFT marketplace.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">By supporting Polygon NFTs on Kraken NFT, we are not only giving clients access to some of the hottest collections on the market today, we are also helping to minimize blockchain network fees while depositing and withdrawing NFTs.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/reddit-avatars\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\">Stay tuned for more exciting Polygon collections on Kraken NFT<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Our team at Kraken NFT is committed to bringing even more popular Polygon NFT collections to our platform soon. With all the hottest Polygon NFT dropping on Kraken NFT in the coming weeks, be sure to follow the <a href=\"https:\/\/blog.kraken.com\/nft\/\">Kraken NFT blog<\/a> and <a href=\"https:\/\/twitter.com\/KrakenNFT\">@KrakenNFT<\/a> on Twitter to be the first to know when new Polygon NFT collections are added.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Want to learn more about Polygon?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/polygon\">Polygon<\/a> is a Layer 2 scaling solution and <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-decentralized-application-dapp\">decentralized application<\/a> development infrastructure for <a href=\"https:\/\/www.kraken.com\/prices\/ethereum\">Ethereum<\/a>. Polygon uses sidechains to help increase scalability while still retaining the security and decentralization of the Ethereum mainnet. Polygon ultimately allows NFTs to be transacted faster and more cost-efficiently as compared to Ethereum.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Check out the <a href=\"https:\/\/www.kraken.com\/learn\">Kraken Learn Center<\/a> guides <a href=\"https:\/\/www.kraken.com\/learn\/what-is-polygon-matic\">What is Polygon (MATIC)?<\/a> and <a href=\"https:\/\/www.kraken.com\/learn\/buy-polygon-matic\">How to buy Polygon (MATIC)<\/a> to learn more.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Your opinion matters<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Your opinion will help shape Kraken NFT as we take it to the global market. Please check out our Support Center for any FAQs about <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\">using the marketplace<\/a>, or contact <a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\">Kraken Support<\/a> for 24\/7 assistance.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If you\u2019re new to the world of NFTs, you can check out our <a href=\"https:\/\/www.kraken.com\/learn\">Kraken Learn Center<\/a> article, <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\">What is an NFT?<\/a> to discover what all the excitement is about.In addition to these latest NFT collections that have just been added, you can also browse the full list of <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\">all 250+ NFT collections available for you to explore, collect and trade on Kraken NFT<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Follow our Kraken NFT Twitter!<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">That\u2019s right, we launched a new Twitter account for all things NFTs! Follow us on Twitter at <a href=\"https:\/\/twitter.com\/krakennft\">KrakenNFT<\/a> to be the first to know about all of the exciting things happening on Kraken NFT.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Will Kraken make more NFTs available?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken can be found on<a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"> our website<\/a>, and all future NFTs will be announced on <a href=\"https:\/\/twitter.com\/krakennft\">Kraken NFT\u2019s Twitter<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Trade with caution<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Specific asset availability and liquidity are not guaranteed. When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Did you catch the exciting news in our Kraken launches your gateway to the world of NFTs post last week? Polygon NFTs are now available on Kraken NFT \u2014 the secure marketplace to explore, collect and trade non-fungible tokens with zero gas fees.*&nbsp;Clients can now use the Polygon network to deposit and withdraw supported Polygon [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":22491,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460,1426],"tags":[1459,1421],"language":[],"class_list":["post-22347","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-nft","category-product","tag-kraken-nft","tag-nft"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Polygon lands on Kraken NFT \u2014 trade Reddit Collectible Avatars today - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/polygon-lands-on-kraken-nft-trade-reddit-collectible-avatars-today\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Polygon lands on Kraken NFT \u2014 trade Reddit Collectible Avatars today\" \/>\n<meta property=\"og:description\" content=\"Did you catch the 