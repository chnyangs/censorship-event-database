40:38+00:00","article_modified_time":"2023-06-02T15:42:34+00:00","og_image":[{"width":1460,"height":822,"url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/Artboard-4-22.webp?fit=1460%2C822&ssl=1","type":"image\/webp"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"5 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/crypto-education\/what-is-pepe-pepe-meet-the-latest-viral-meme-coin-phenomenon#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/what-is-pepe-pepe-meet-the-latest-viral-meme-coin-phenomenon"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"What is Pepe (PEPE)? Meet the latest viral meme coin phenomenon","datePublished":"2023-05-16T21:40:38+00:00","dateModified":"2023-06-02T15:42:34+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/what-is-pepe-pepe-meet-the-latest-viral-meme-coin-phenomenon"},"wordCount":1090,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/what-is-pepe-pepe-meet-the-latest-viral-meme-coin-phenomenon#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/Artboard-4-22.webp?fit=1460%2C822&ssl=1","keywords":["Meme Coin","Pepe"],"articleSection":["Crypto Education"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/crypto-education\/what-is-pepe-pepe-meet-the-latest-viral-meme-coin-phenomenon","url":"https:\/\/blog.kraken.com\/crypto-education\/what-is-pepe-pepe-meet-the-latest-viral-meme-coin-phenomenon","name":"What is Pepe (PEPE)? Meet the latest viral meme coin phenomenon - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/crypto-