[{"id":22176,"date":"2023-05-15T14:47:45","date_gmt":"2023-05-15T18:47:45","guid":{"rendered":"https:\/\/blog.kraken.com\/trading-for-limewire-token-lmwr-starts-may-16-deposit-now"},"modified":"2023-06-12T12:03:52","modified_gmt":"2023-06-12T16:03:52","slug":"trading-for-limewire-token-lmwr-starts-may-16-deposit-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/trading-for-limewire-token-lmwr-starts-may-16-deposit-now","title":{"rendered":"Trading for LimeWire Token (LMWR) starts May 16 \u2013 deposit now!"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that <\/span><b>LimeWire Token (LMWR)<\/b><span style=\"font-weight: 400;\"> is now available on Kraken!<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">LMWR funding is live and trading starts on May 16th at approximately 12 pm UTC<\/span><span style=\"font-weight: 400;\">.<\/span> <span style=\"font-weight: 400;\">A<\/span><span style=\"font-weight: 400;\">dd LMWR to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n<p><b><i>Already have LMWR and a Kraken account? Click below to get started \u2935\ufe0f<\/i><\/b><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/lmwr-funding\/\" target=\"_blank\" rel=\"noopener\">Deposit now<\/a><\/div>\n<div>\n<p><span style=\"font-weight: 400;\">LMWR is tradeable via spot markets on <\/span><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/pro.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> with the following parameters:<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Asset<\/b><\/td>\n<td><b>Pair<\/b><\/td>\n<td><b>Price decimal precision<\/b><\/td>\n<td><b>Minimum order size<\/b><\/td>\n<td><b>Minimum deposit<\/b><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">LMWR<\/span><\/td>\n<td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3<\/span><\/td>\n<td><span style=\"font-weight: 400;\">15<\/span><\/td>\n<td><span style=\"font-weight: 400;\">15<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><b>Note:\u00a0\u00a0<\/b><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Not available in Canada and in the United States<\/b><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/b><i><span style=\"font-weight: 400;\"> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/span><\/i><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the tokens:<\/span><\/p>\n<p><span style=\"font-weight: 400;\">LimeWire is a blockchain-based membership platform that allows content creators to form exclusive communities and profit from any secondary market sales of their work. Members buy subscriptions to join these communities and receive NFTs of videos, audio files, and articles from their favorite content creators. LMWR is the platform&#8217;s native utility token which allows fans to earn exclusive rewards and vote on proposed changes to the platform.<\/span><\/p>\n<p><b><i>Ready to trade but don&#8217;t have a Kraken account yet? <\/i><\/b><a href=\"https:\/\/www.kraken.com\/sign-up\"><b><i>Sign up today<\/i><\/b><\/a><b><i>!\u00a0<\/i><\/b><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/lmwr-sign-up\/\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n<h3><\/h3>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\"><span style=\"font-weight: 400;\">here<\/span><\/a><span style=\"font-weight: 400;\">, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<\/div>\n<div>\n<p><a href=\"https:\/\/blog.kraken.com\/go\/lmwr-referral\/\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15784\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\