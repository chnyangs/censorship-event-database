x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\",\"name\":\"krakenfx\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"caption\":\"krakenfx\"},\"sameAs\":[\"https:\\\/\\\/blog.kraken.com\"],\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/krakenfx\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Can bitcoin be used for cross-border payments? - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments","og_locale":"en_US","og_type":"article","og_title":"Can bitcoin be used for cross-border payments?","og_description":"In 2008, an anonymous researcher (or team of researchers) called Satoshi Nakamoto published a nine-page research paper entitled &#8220;Bitcoin: A Peer-to-Peer Electronic Cash System.&#8221; The document, known as&nbsp;the Bitcoin white paper, presented a new type of&nbsp;digital currency&nbsp;that users could use to transact without relying on financial intermediaries. Soon, people around the world discovered that blockchain [&hellip;]","og_url":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments","og_site_name":"Kraken Blog","article_published_time":"2023-01-25T23:00:57+00:00","article_modified_time":"2023-05-08T20:38:01+00:00","og_image":[{"width":1536,"height":701,"url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/blog-cross-border.jpg?fit=1536%2C701&ssl=1","type":"image\/jpeg"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"5 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"Can bitcoin be used for cross-border payments?","datePublished":"2023-01-25T23:00:57+00:00","dateModified":"2023-05-08T20:38:01+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments"},"wordCount":1062,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/blog-cross-border.jpg?fit=1536%2C701&ssl=1","keywords":["blockchain","cross-border","featured"],"articleSection":["Crypto Education"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments","url":"https:\/\/blog.kraken.com\/crypto-education\/can-bitcoin-be-used-for-cross-border-payments","name":"Can bitcoin be used for cross-border payments? - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\