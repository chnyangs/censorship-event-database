Url":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-4Bi","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/01\/Blog-Inner-Behind-The-Build_-Kraken-NFT.png?fit=1536%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17688","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=17688"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17688\/revisions"}],"predecessor-version":[{"id":21040,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17688\/revisions\/21040"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/17235"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17688"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17688"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17688"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17688"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17739,"date":"2023-02-22T14:36:49","date_gmt":"2023-02-22T19:36:49","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17739"},"modified":"2023-06-13T08:12:01","modified_gmt":"2023-06-13T12:12:01","slug":"zoofrenz-by-zombot-studio-createra-genesis-land-huxley-comics-turtles-and-more-collections-added-to-kraken-nft","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/zoofrenz-by-zombot-studio-createra-genesis-land-huxley-comics-turtles-and-more-collections-added-to-kraken-nft","title":{"rendered":"Zoofrenz by Zombot Studio, Createra Genesis Land, Huxley Comics, Turtles, and more collections added to Kraken NFT"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that we have added <\/span><b>eight<\/b><b> new NFT collections<\/b><span style=\"font-weight: 400;\"> to <\/span><a href=\"https:\/\/www.kraken.com\/nft\"><span style=\"font-weight: 400;\">Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\"> for our clients to explore, collect and trade.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">After revealing <\/span><a href=\"https:\/\/blog.kraken.com\/nft\/\"><span style=\"font-weight: 400;\">dozens of NFT collections over the past few weeks<\/span><\/a><span style=\"font-weight: 400;\">, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\"><span style=\"font-weight: 400;\">gas fees<\/span><\/a><span style=\"font-weight: 400;\">.*\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We will continue to add a wide range of new NFT collections every week \u2014 from the hottest profile picture communities to the latest gaming experiences \u2014 across the <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-ethereum-eth\"><span style=\"font-weight: 400;\">Ethereum<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-solana-sol\"><span style=\"font-weight: 400;\">Solana<\/span><\/a><span style=\"font-weight: 400;\"> blockchains.\u00a0<\/span><\/p>\n<h2><span style=\"font-weight: 400;\">Here are the new collections launching on Kraken NFT today:<\/span><\/h2>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Bubblegoose Ballers<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Createra Genesis Land<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Froots<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Huxley Comics<\/span><\/li>\n<li>Jikan Studios<\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">MistleToadz by GREMPLIN<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Turtles<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Zoofrenz by Zombot Studio<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Check out these collections on Kraken NFT.<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/nft-listing-batch-feb-23\/\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<div><\/div>\n<div>\n<h2><span style=\"font-weight: 400;\">Your opinion matters<\/span><\/h2>\n<p><span style=\"font-weight: 400;\">Your opinion will help shape Kraken NFT as we take it to the global market. Please check out our Support Center for any FAQs about <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\"><span style=\"font-weight: 400;\">using the marketplace<\/span><\/a><span style=\"font-weight: 400;\">, or contact <\/span><a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\"><span style=\"font-weight: 400;\">Kraken Support<\/span><\/a><span style=\"font-weight: 400;\"> for 24\/7 assistance.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you\u2019re new to the world of NFTs, you can check out our <\/span><a href=\"https:\/\/www.kraken.com\/learn\"><span style=\"font-weight: 400;\">Kraken Learn Center<\/span><\/a><span style=\"font-weight: 400;\"> article, <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\"><span style=\"font-weight: 400;\">What is an NFT?<\/span><\/a><span style=\"font-weight: 400;\"> to discover what all the excitement is about.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">In addition to these latest NFT collections that have just been added, you can also browse the full list of <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">all 200+ NFT collections available for you to explore, collect and trade on Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Follow the <\/span><a href=\"https:\/\/blog.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\"> and our <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">@KrakenNFT social account<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know when we add new features and NFT collections.<\/span><\/p>\n<h2>Follow our Kraken NFT Twitter!<\/h2>\n<p><span style=\"font-weight: 400;\">That\u2019s right, we launched a new Twitter account for all things NFTs! Follow us on Twitter at <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">KrakenNFT<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know about all of the exciting things happening on Kraken NFT.<\/span><\/p>\n<h2>Will Kraken make more NFTs available?<\/h2>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken can be found on <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">our website<\/span><\/a><span style=\"font-weight: 400;\">, and all future NFTs will be announced on <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">Kraken NFT\u2019s Twitter<\/span><\/a><span style=\"font-weight: 400;\">. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h2>Trade with caution<\/h2>\n<p><span style=\"font-weight: 400;\">Specific asset availability and liquidity are not guaranteed.<\/span> <span style=\"font-weight: 400;\">When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/span><\/p>\n<p><i><span style=\"font-weight: 400;\">*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform. <\/span><\/i><\/p>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that we have added eight new NFT collections to Kraken NFT for our clients to explore, collect and trade.\u00a0 After revealing dozens of NFT collections over the past few weeks, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":17762,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standar