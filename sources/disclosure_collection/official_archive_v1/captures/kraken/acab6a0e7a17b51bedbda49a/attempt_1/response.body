kraken.com\/wp-content\/uploads\/2023\/01\/24Artboard-1-copy-22%402x.png?fit=5302%2C3059&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17395","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=17395"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17395\/revisions"}],"predecessor-version":[{"id":21099,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17395\/revisions\/21099"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/17399"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17395"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17395"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17395"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17395"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17440,"date":"2023-02-01T14:18:50","date_gmt":"2023-02-01T14:18:50","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17440"},"modified":"2023-05-05T06:11:13","modified_gmt":"2023-05-05T10:11:13","slug":"white-hearts-wolf-game-farmer-dooplicator-cryptobirbs-by-vodnik-and-more-collections-added-to-kraken-nft","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/nft\/white-hearts-wolf-game-farmer-dooplicator-cryptobirbs-by-vodnik-and-more-collections-added-to-kraken-nft","title":{"rendered":"White Hearts, Wolf Game &#8211; Farmer, Dooplicator, Cryptobirbs by Vodnik and more collections added to Kraken NFT"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that we have added <\/span><b>seven<\/b><b> new NFT collections<\/b><span style=\"font-weight: 400;\"> to <\/span><a href=\"https:\/\/www.kraken.com\/nft\"><span style=\"font-weight: 400;\">Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\"> for our current beta testers to explore, collect and trade.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">After revealing <\/span><a href=\"https:\/\/blog.kraken.com\/nft\/\"><span style=\"font-weight: 400;\">dozens of NFT collections over the past few weeks<\/span><\/a><span style=\"font-weight: 400;\">, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\"><span style=\"font-weight: 400;\">gas fees<\/span><\/a><span style=\"font-weight: 400;\">.*\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We will continue to add a wide range of new NFT collections every week \u2014 from the hottest profile picture communities to the latest gaming experiences \u2014 across the <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-ethereum-eth\"><span style=\"font-weight: 400;\">Ethereum<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-solana-sol\"><span style=\"font-weight: 400;\">Solana<\/span><\/a><span style=\"font-weight: 400;\"> blockchains.\u00a0<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Here are the new collections launching on Kraken NFT today:<\/span><\/h3>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\">Cel Mates Crime Reports<\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\">CryptoBirbs by Vodnik<\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\">Dooplicator<\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\">Feetpix.wtf<\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\">&#8220;SHiELD:AGE&#8221; by Cotoh Tsumi<\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\">White Hearts 1.0<\/li>\n<li aria-level=\"1\">Wolf Game &#8211; Farmer<\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Check out these collections on Kraken NFT<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/nft-listing-batch\/\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<h3><span style=\"font-weight: 400;\">Your opinion matters<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Kraken NFT clients&#8217; opinions will help shape Kraken NFT before we take it to the global market. Please check out our Support Center for any FAQs about <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\"><span style=\"font-weight: 400;\">using the marketplace<\/span><\/a><span style=\"font-weight: 400;\">, or contact <\/span><a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\"><span style=\"font-weight: 400;\">Kraken Support<\/span><\/a><span style=\"font-weight: 400;\"> for 24\/7 assistance.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you\u2019re new to the world of NFTs, you can visit our <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\"><span style=\"font-weight: 400;\">Learn Center<\/span><\/a><span style=\"font-weight: 400;\"> to discover what all the excitement is about.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">In addition to the latest NFT collections that have been added, you can also <\/span><a href=\"https:\/\/blog.kraken.com\/post\/14252\/70-nft-collections-for-kraken-nft-beta-testers\"><span style=\"font-weight: 400;\">browse the list of the first 70 carefully selected NFT collections<\/span><\/a><span style=\"font-weight: 400;\"> that are available to explore, collect and trade in the beta testing phase.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Follow the <\/span><a href=\"https:\/\/blog.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\"> and our <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">@KrakenNFT social account<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know when the full public beta launches.<\/span><\/p>\n<h3><b>Follow our Kraken NFT Twitter!<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">That\u2019s right, we launched a new Twitter account for all things NFTs! Follow us on Twitter at <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">KrakenNFT<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know about all of the exciting things happening on Kraken NFT.<\/span><\/p>\n<h3><b>Will Kraken make more NFTs available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken can be found on <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">our website<\/span><\/a><span style=\"font-weight: 400;\">, and all future NFTs will be announced on <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">Kraken NFT\u2019s Twitter<\/span><\/a><span style=\"font-weight: 400;\">. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Specific asset availability and liquidity are not guaranteed.<\/span> <span style=\"font-weight: 400;\">When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/span><\/p>\n<p><i><span style=\"font-weight: 400;\">*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform.\u00a0<\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that we have added seven new NFT collections to Kraken NFT for our current beta testers to explore, collect and trade.\u00a0 After revealing dozens of NFT collections over the past few weeks, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":17454,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460],"tags":[1459,1421],"language":[],"class_list":["post-17440","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-nft","tag-kraken-nft","tag-nft"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>White Hearts, Wolf Game - Farmer, Dooplicator, Cryptobirbs by Vodnik and more collections added to Kraken NFT - Kraken Blog<\/title>\n<meta name=\"r