m\\\/author\\\/krakenfx\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Kraken to end on-chain staking services for U.S. clients - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/settlement","og_locale":"en_US","og_type":"article","og_title":"Kraken to end on-chain staking services for U.S. clients","og_description":"Today, two Kraken subsidiaries announced a settlement with the U.S. Securities and Exchange Commission (SEC) concerning Kraken&#8217;s on-chain staking program. Because of this settlement, Kraken has agreed to end its on-chain staking services for U.S. clients. Starting today, Kraken will automatically unstake all U.S. client assets enrolled in the on-chain staking program. These assets will [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/settlement","og_site_name":"Kraken Blog","article_published_time":"2023-02-09T20:24:50+00:00","article_modified_time":"2023-05-09T11:54:27+00:00","og_image":[{"width":1536,"height":701,"url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/blog-KrakenGeneric.png?fit=1536%2C701&ssl=1","type":"image\/png"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"1 minute"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/settlement#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/settlement"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"Kraken to end on-chain staking services for U.S. clients","datePublished":"2023-02-09T20:24:50+00:00","dateModified":"2023-05-09T11:54:27+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/settlement"},"wordCount":274,"pu