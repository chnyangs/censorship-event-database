n.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=17442"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17442\/revisions"}],"predecessor-version":[{"id":21096,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17442\/revisions\/21096"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/17459"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17442"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17442"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17442"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17442"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17492,"date":"2023-02-02T18:50:31","date_gmt":"2023-02-02T18:50:31","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17492"},"modified":"2025-03-04T06:32:30","modified_gmt":"2025-03-04T11:32:30","slug":"announcing-kraken-otc-portal-v-2-0-featuring-automated-settlement","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/announcing-kraken-otc-portal-v-2-0-featuring-automated-settlement","title":{"rendered":"Announcing Kraken OTC Portal v 2.0 featuring automated settlement"},"content":{"rendered":"<p><em>Note: Since this blog was published, the OTC portal link has moved to the top-of-page navigation:<\/em><\/p>\n<p style=\"text-align: center;\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17703\" data-permalink=\"https:\/\/blog.kraken.com\/otc_top_nav\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?fit=1668%2C220&amp;ssl=1\" data-orig-size=\"1668,220\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"OTC_top_nav\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?fit=1024%2C135&amp;ssl=1\" class=\"alignnone  wp-image-17703\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?resize=713%2C95&#038;ssl=1\" alt=\"\" width=\"713\" height=\"95\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?resize=300%2C40&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?resize=1024%2C135&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?resize=768%2C101&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?resize=1536%2C203&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?resize=200%2C26&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_top_nav.png?w=1668&amp;ssl=1 1668w\" sizes=\"auto, (max-width: 713px) 100vw, 713px\" \/><\/p>\n<p><span style=\"font-weight: 400;\">The <\/span><a href=\"https:\/\/www.kraken.com\/features\/otc-exchange\"><span style=\"font-weight: 400;\">Kraken OTC<\/span><\/a><span style=\"font-weight: 400;\"> desk is constantly exploring new ways to deliver a great trading experience to our clients. Our new, fast, reliable, and easy-to-use automated settlement service seamlessly integrates with our <\/span><a href=\"https:\/\/blog.kraken.com\/post\/14282\/kraken-announces-new-autorfq-and-otc-portal-for-instant-block-trading\/\"><span style=\"font-weight: 400;\">RFQ<\/span><\/a><span style=\"font-weight: 400;\">, providing access to automated trade quotes <\/span><b>and<\/b><span style=\"font-weight: 400;\"> instant settlement of executed trades, all from a self-service portal\u2026 in addition to the personalized, white-glove service Kraken OTC is known for.<\/span><\/p>\n<h2>What is automated settlement?<\/h2>\n<p><span style=\"font-weight: 400;\">Automated settlement allows you to trade via OTC\u2019s RFQ with the available balances in your Kraken account in three simple steps: request a quote, accept that quote and confirm the trade. Go from initial quote to final settlement <\/span><b>within seconds<\/b><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17537\" data-permalink=\"https:\/\/blog.kraken.com\/automated_settlements_1-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?fit=1136%2C840&amp;ssl=1\" data-orig-size=\"1136,840\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Automated_Settlements_1-1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?fit=1024%2C757&amp;ssl=1\" class=\"alignnone size-full wp-image-17537\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?resize=1136%2C840&#038;ssl=1\" alt=\"Automated_Settlements_1\" width=\"1136\" height=\"840\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?w=1136&amp;ssl=1 1136w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?resize=300%2C222&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?resize=1024%2C757&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?resize=768%2C568&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Automated_Settlements_1-1-1.png?resize=135%2C100&amp;ssl=1 135w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<h2>What if I like the flexible settlement I already use?<\/h2>\n<p><span style=\"font-weight: 400;\">If you already enjoy access to flexible settlement \u2013 the ability to trade now and settle later \u2013 nothing has to change. Our one-on-one, person-to-person settlement experience and our global team of traders remain at your service around the clock.<\/span><\/p>\n<h2>How can I start using automated settlement?<\/h2>\n<p><span style=\"font-weight: 400;\">Clients must first be onboarded onto RFQ. Our OTC desk traders will work with you to assess your trading needs and determine suitable settlement eligibility. Clients eligible for flexible settlement can simply select either settlement option in the OTC portal prior to quoting.<\/span><\/p>\n<p><b>Automated settlement = instant settlement<\/b><span style=\"font-weight: 400;\"> for clients who want an exact, finalized, up-to-the-second snapshot of their trade status.<\/span><\/p>\n<p style=\"text-align: center;\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17524\" data-permalink=\"https:\/\/blog.kraken.com\/unnamed-3-6\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-3.png?fit=474%2C323&amp;ssl=1\" data-orig-size=\"474,323\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"unnamed (3)\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-3.png?fit=474%2C323&amp;ssl=1\" class=\"alignnone wp-image-17524\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-3.png?resize=435%2C297&#038;ssl=1\" alt=\"\" width=\"435\" height=\"297\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-3.png?resize=300%2C204&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-3.png?resize=147%2C100&amp;ssl=1 147w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-3.png?w=474&amp;ssl=1 474w\" sizes=\"auto, (max-width: 435px) 100vw, 435px\" \/><\/p>\n<h2>OTC Portal v 2.0<\/h2>\n<h3><span style=\"font-weight: 400;\">Our OTC Portal v 2.0 is also loaded with upgrades:<\/span><\/h3>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17538\" data-permalink=\"https:\/\/blog.kraken.com\/unnamed-8-3\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?fit=1200%2C598&amp;ssl=1\" data-orig-size=\"1200,598\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"OTC image\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?fit=1024%2C510&amp;ssl=1\" class=\"alignnone size-full wp-image-17538\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?resize=1200%2C598&#038;ssl=1\" alt=\"OTC image\" width=\"1200\" height=\"598\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?w=1200&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?resize=300%2C150&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?resize=1024%2C510&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?resize=768%2C383&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/unnamed-8-1.png?resize=200%2C100&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<p><span style=\"font-weight: 400;\">Your automated OTC trading experience now has more to offer than ever:<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"2\"><span style=\"font-weight: 400;\">Exposure panel to monitor outstanding exposure<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"2\"><span style=\"font-weight: 400;\">Price charts based on your three most-traded coins<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"2\"><span style=\"font-weight: 400;\">Enhanced visibility to your:<\/span>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"3\"><span style=\"font-weight: 400;\">Recent transactions<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"3\"><span style=\"font-weight: 400;\">Most-traded coins by volume<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"3\"><span style=\"font-weight: 400;\">OTC trading history<\/span><\/li>\n<\/ul>\n<\/li>\n<\/ul>\n<h3><span style=\"font-weight: 400;\">Recent transactions (can also still be generated via email):<\/span><\/h3>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17498\" data-permalink=\"https:\/\/blog.kraken.com\/recent_transactions_1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?fit=1083%2C526&amp;ssl=1\" data-orig-size=\"1083,526\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Recent_transactions_1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?fit=1024%2C497&amp;ssl=1\" class=\"alignnone size-full wp-image-17498\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?resize=1083%2C526&#038;ssl=1\" alt=\"\" width=\"1083\" height=\"526\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?w=1083&amp;ssl=1 1083w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?resize=300%2C146&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?resize=1024%2C497&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?resize=768%2C373&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/Recent_transactions_1.png?resize=200%2C97&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<h3><span style=\"font-weight: 400;\">OTC spot trade history:<\/span><\/h3>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17539\" data-permalink=\"https:\/\/blog.kraken.com\/otc_spot_trades_history_1-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_spot_trades_history_1-1.png?fit=1083%2C674&amp;ssl=1\" data-orig-size=\"1083,674\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"OTC_spot_trades_history_1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_spot_trades_history_1-1.png?fit=1024%2C637&amp;ssl=1\" class=\"alignnone size-full wp-image-17539\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_spot_trades_history_1-1.png?resize=1083%2C674&#038;ssl=1\" alt=\"OTC_spot_trades_history_1\" width=\"1083\" height=\"674\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/OTC_spot_trades_history_1-1.png?w=1083&amp;ssl=1