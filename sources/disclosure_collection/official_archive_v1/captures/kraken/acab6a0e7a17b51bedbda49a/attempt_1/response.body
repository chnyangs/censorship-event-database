2023\/05\/blog-KrakenGeneric.png?fit=1536%2C701&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17384","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=17384"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17384\/revisions"}],"predecessor-version":[{"id":21109,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17384\/revisions\/21109"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/21092"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17384"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17384"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17384"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17384"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17266,"date":"2023-01-25T14:14:05","date_gmt":"2023-01-25T14:14:05","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17266"},"modified":"2023-10-31T13:29:51","modified_gmt":"2023-10-31T17:29:51","slug":"dai-usdc-and-usdt-deposits-and-withdrawals-available-on-the-polygon-network","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/dai-usdc-and-usdt-deposits-and-withdrawals-available-on-the-polygon-network","title":{"rendered":"DAI, USDC and USDT deposits and withdrawals available on the Polygon Network!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of <\/span><b>Dai (DAI), USD Coin (USDC) and Tether (USDT) on the Polygon Network<\/b><span style=\"font-weight: 400;\">!<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/polygon\"><span style=\"font-weight: 400;\">Polygon<\/span><\/a><span style=\"font-weight: 400;\"> is a Layer 2 scaling solution for Ethereum that aims to improve the speed and reduce the costs and complexities of transactions on its network. Polygon is a sidechain which helps to increase transaction throughput while still maintaining security through the use of a decentralized network of proof-of-stake (PoS) validators. Check out the Kraken Learn Center guide <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-polygon-matic\"><span style=\"font-weight: 400;\">What is Polygon?<\/span><\/a><span style=\"font-weight: 400;\"> to learn more.<\/span><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><span style=\"font-weight: 400;\">Funding<\/span><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Funding is already live. You can transfer <a href=\"https:\/\/www.kraken.com\/learn\/what-are-stablecoins\" target=\"_blank\" rel=\"noopener\">stablecoins<\/a> (DAI, USDC and USDT) to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting <\/span><b>DAI or USDC or USDT, <\/b><span style=\"font-weight: 400;\">and then use the drop-down box to select the desired deposit method (network): <\/span><b>Polygon network<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Kraken currently supports two versions of USDC: USDC.e and Polygon\u2019s native USDC<\/strong><\/li>\n\n\n\n<li><strong>Kraken will continue to support USDC.e until further notice<\/strong><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><b><i>Already have stablecoins on the Polygon Network and a Kraken account? <\/i>\u2935\ufe0f<\/b><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/polygon-stablecoin-support-1\/\" rel=\"noopener\">Deposit now<\/a><\/div>\n\n\n\n<div>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the assets:<\/span><\/p>\n<p><a href=\"https:\/\/www.kraken.com\/prices\/multi-collateral-dai\"><b>Dai (DAI)<\/b><\/a> <span style=\"font-weight: 400;\">is a collateral-backed stablecoin pegged to the U.S. Dollar. Dai (DAI) is the first decentralized stablecoin built on top of the Ethereum blockchain. Because the price of Dai is pegged to the US Dollar, it experiences relatively little market volatility. As a result, it is most often used as a method of payment or hedging mechanism. Every Dai is backed by a surplus of collateral that is escrowed into publicly reviewable Ethereum smart contracts. Learn how to add DAI to your crypto portfolio with our Learn Center article <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-dai\"><span style=\"font-weight: 400;\">How to Buy Dai (DAI)<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><a href=\"https:\/\/www.kraken.com\/prices\/usd-coin\"><b>USD Coin (USDC)<\/b><\/a><span style=\"font-weight: 400;\"> is a digital stablecoin that is pegged to the U.S. Dollar (USD). USDC tokens in circulation are backed by verifiable cash or cash equivalents, such as short-term U.S. Treasury bonds. USDC is used to hedge against price volatility in the crypto market as well as to purchase goods and services within decentralized applications (dApps). Learn how to add USDC to your crypto portfolio with our Learn Center article <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-usd-coin-usdc\"><span style=\"font-weight: 400;\">How to buy USD Coin (USDC)<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><a href=\"https:\/\/www.kraken.com\/prices\/tether\"><b>Tether (USDT)<\/b><\/a> <span style=\"font-weight: 400;\">is one of the world&#8217;s first stablecoin. Tether (USDT) was created in 2014 as a &#8220;stablecoin,&#8221; a digital asset that is fully backed 1:1 by traditional fiat currency, in this case the U.S. Dollar. Tether is designed to be used as a means of converting cash to digital currency, and claims that all Tethers in circulation reflect the amount of their reserves in U.S. Dollars. This results in Tether&#8217;s value remaining close to 1 dollar at all times. Learn how to add USDT to your crypto portfolio with our Learn Center article <\/span><a href=\"https:\/\/www.kraken.com\/learn\/buy-tether-usdt\"><span style=\"font-weight: 400;\">How to Buy Tether (USDT)<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<\/div>\n\n\n\n<div>&nbsp;<\/div>\n\n\n\n<div><b><i>Ready to deposit but don&#8217;t have a Kraken account yet? <\/i><\/b><a href=\"https:\/\/www.kraken.com\/sign-up\"><b><i>Sign up today<\/i><\/b><\/a><b><i>!<\/i><\/b><\/div>\n\n\n\n<div>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/polygon-stablecoin-support-2\/\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<div>\n<h3>&nbsp;<\/h3>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">here<\/span><\/a><span style=\"font-weight: 400;\">, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<figure><a href=\"https:\/\/www.kraken.com\/referrals\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15784\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1200%2C250&amp;ssl=1\" data-orig-size=\"1200,250\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"subhead_reflink (1)\" data-image-description=\"\" data-im