":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/17601"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17590"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17590"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17590"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17590"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17643,"date":"2023-02-14T12:52:40","date_gmt":"2023-02-14T12:52:40","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17643"},"modified":"2023-06-07T09:49:14","modified_gmt":"2023-06-07T13:49:14","slug":"trading-for-blur-blur-starts-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/trading-for-blur-blur-starts-now","title":{"rendered":"Trading for Blur (BLUR) starts February 14 &#8211; deposit now!"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that <\/span><b>Blur (BLUR)<\/b><span style=\"font-weight: 400;\"> is now available on Kraken!<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Funding is live, and trading will begin on February 14 at approximately 18:30 UTC. <\/span><span style=\"font-weight: 400;\">A<\/span><span style=\"font-weight: 400;\">dd BLUR to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n<p><b><i>Already have BLUR and a Kraken account? Click below to get started \u2935\ufe0f<\/i><\/b><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/blur-listing-funding\/\" target=\"_blank\" rel=\"noopener\">Deposit now<\/a><\/div>\n<div><\/div>\n<div>\n<p><span style=\"font-weight: 400;\">Both tokens are tradeable on <\/span><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/pro.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> with the following parameters:<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Asset<\/b><\/td>\n<td><b>Pair<\/b><\/td>\n<td><b>Price Decimal Precision<\/b><\/td>\n<td><b>Minimum Order Size<\/b><\/td>\n<td><b>Minimum deposit<\/b><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">BLUR<\/span><\/td>\n<td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3<\/span><\/td>\n<td><span style=\"font-weight: 400;\">15<\/span><\/td>\n<td><span style=\"font-weight: 400;\">15<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><b>Note:\u00a0 Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/b><i><span style=\"font-weight: 400;\"> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/span><\/i><\/p>\n<\/div>\n<div>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the tokens:<\/span><\/p>\n<p><b>Blur (BLUR) <\/b><span style=\"font-weight: 400;\">is a community-driven NFT marketplace and aggregator built for professional traders. It combines advanced trading tools with real time data feeds to let users trade and list NFTs across marketplaces, snipe reveals, and manages their portfolio. BLUR is an ERC-20 token that governs key parameters of the Blur protocol.<\/span><\/p>\n<\/div>\n<div>\n<p><b><i>Ready to deposit but don&#8217;t have a Kraken account yet? <\/i><\/b><a href=\"https:\/\/www.kraken.com\/sign-up\"><b><i>Sign up today<\/i><\/b><\/a><b><i>!\u00a0<\/i><\/b><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/blur-listing-sign-up\/\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n<h3><\/h3>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\"><span style=\"font-weight: 400;\">here<\/span><\/a><span style=\"font-weight: 400;\">, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future. <\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15784\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1200%2C250&amp;ssl=1\" data-orig-size=\"1200,250\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"subhead_reflink (1)\" data-image-description=\"\" data-image-caption=\"&lt;p&gt;Referral cta image&lt;\/p&gt;\n\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1024%2C213&amp;ssl=1\" class=\"size-full wp-image-15784\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1200%2C250&#038;ssl=1\" alt=\"Referral link image\" width=\"1200\" height=\"250\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?w=1200&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=300%2C63&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1024%2C213&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=768%2C160&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=200%2C42&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<hr \/>\n<\/div>\n<div><i><span style=\"font-weight: 400;\">These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell or ho