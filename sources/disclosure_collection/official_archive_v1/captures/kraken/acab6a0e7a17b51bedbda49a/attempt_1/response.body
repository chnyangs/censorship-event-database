,\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/05fd1aef04d178f2231400ddb85550a2\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/danielpintokraken\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Kraken\u2019s OTC Portal is now part of Kraken Pro - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro","og_locale":"en_US","og_type":"article","og_title":"Kraken\u2019s OTC Portal is now part of Kraken Pro","og_description":"We\u2019re thrilled to announce that Kraken\u2019s OTC Portal is now integrated within Kraken Pro. This integration allows OTC clients to access the features and functionality they know and love from our OTC Desk via a fully automated, self-service UI.\u00a0 Access the OTC Portal by logging in to Pro and selecting &#8220;OTC&#8221; in the top navigation: [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro","og_site_name":"Kraken Blog","article_published_time":"2023-03-02T19:15:33+00:00","article_modified_time":"2025-03-04T11:31:43+00:00","og_image":[{"width":1024,"height":467,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/blog_header-3-1-1024x467.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"4 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/05fd1aef04d178f2231400ddb85550a2"},"headline":"Kraken\u2019s OTC Portal is now part of Kraken Pro","datePublished":"2023-03-02T19:15:33+00:00","dateModified":"2025-03-04T11:31:43+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro"},"wordCount":624,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/blog_header-3-1.png?fit=3072%2C1400&ssl=1","keywords":["OTC"],"articleSection":["News","Product"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro","url":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro","name":"Kraken\u2019s OTC Portal is now part of Kraken Pro - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/news\