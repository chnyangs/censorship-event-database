aken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=17875"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17875\/revisions"}],"predecessor-version":[{"id":23266,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17875\/revisions\/23266"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/17879"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17875"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17875"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17875"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17875"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17911,"date":"2023-03-02T19:15:33","date_gmt":"2023-03-02T19:15:33","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17911"},"modified":"2025-03-04T06:31:43","modified_gmt":"2025-03-04T11:31:43","slug":"krakens-otc-portal-is-now-part-of-kraken-pro","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro","title":{"rendered":"Kraken\u2019s OTC Portal is now part of Kraken Pro"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that Kraken\u2019s OTC Portal is now integrated within Kraken Pro. This integration allows OTC clients to access the features and functionality they know and love from our OTC Desk via a fully automated, self-service UI.\u00a0<\/span><\/p>\n<p><a href=\"https:\/\/pro.kraken.com\/app\/otc\/quote\"><span style=\"font-weight: 400;\">Access the OTC Portal<\/span><\/a><span style=\"font-weight: 400;\"> by logging in to Pro and selecting &#8220;OTC&#8221; in the top navigation:<\/span><\/p>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17926\" data-permalink=\"https:\/\/blog.kraken.com\/screenshot-2023-03-02-at-18-35-24\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?fit=1250%2C193&amp;ssl=1\" data-orig-size=\"1250,193\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Kraken Pro OTC image\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?fit=1024%2C158&amp;ssl=1\" class=\"alignnone size-full wp-image-17926\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?resize=1250%2C193&#038;ssl=1\" alt=\"\" width=\"1250\" height=\"193\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?w=1250&amp;ssl=1 1250w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?resize=300%2C46&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?resize=1024%2C158&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?resize=768%2C119&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.35.24.png?resize=200%2C31&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<p><span style=\"font-weight: 400;\">Not a Kraken OTC client yet? No problem. You can preview the OTC Portal when logged out and get an inside look at some of the advanced functionality Kraken OTC clients enjoy. Only existing and eligible* OTC clients will see the OTC tab in the navigation when logged in to Kraken Pro.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Once you\u2019re in, OTC clients can take advantage of the OTC Portal\u2019s features and latest upgrades.<\/span><\/p>\n<h2><b>Request for Quote (RFQ) functionality<\/b><\/h2>\n<p><span style=\"font-weight: 400;\">Our RFQ functionality gives OTC clients a fully automated trading experience for orders between $50,000 and $1M (or more on a case-by-case basis). Get a quote and confirm a trade within seconds \u2013 no more worrying about partial fills, illiquid tokens, or rapidly changing prices.<\/span><\/p>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"17927\" data-permalink=\"https:\/\/blog.kraken.com\/screenshot-2023-03-02-at-18-36-20\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?fit=1276%2C944&amp;ssl=1\" data-orig-size=\"1276,944\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Kraken Pro OTC RFQ\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?fit=1024%2C758&amp;ssl=1\" class=\"alignnone size-full wp-image-17927\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?resize=1276%2C944&#038;ssl=1\" alt=\"Kraken Pro OTC RFQ\" width=\"1276\" height=\"944\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?w=1276&amp;ssl=1 1276w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?resize=300%2C222&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?resize=1024%2C758&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?resize=768%2C568&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/Screenshot-2023-03-02-at-18.36.20.png?resize=135%2C100&amp;ssl=1 135w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<p><span style=\"font-weight: 400;\">RFQ features:<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Simple, intuitive UI<\/b><span style=\"font-weight: 400;\">: Execute your trades with ease, right away<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Breadth of assets<\/b><span style=\"font-weight: 400;\">: Get quotes for 20+ cryptoassets across 5 quote currencies (EUR, GBP, USD, USDC and USDT), including stablecoin trading pairs (USDT\/USD, USDT\/EUR, USDC\/USDT, USDC\/USD and USDC\/EUR)<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Automated settlement<\/b><span style=\"font-weight: 400;\">: <\/span><span style=\"font-weight: 400;\">Settle OTC trades instantly when using your account balance to trade<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Flexible settlement<\/b><span style=\"font-weight: 400;\">: Settle your side of an OTC trade up to 24 hours later (subject to eligibility).<\/span><\/li>\n<\/ul>\n<h2><b>Dashboard<\/b><\/h2>\n<p><span style=\"font-weight: 400;\">OTC clients have access to a dedicated dashboard of in-depth view of trading data that helps to surface key information easily and quickly.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Dashboard features:<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Price charts<\/b><span style=\"font-weight: 400;\">: View price movements on your three most-traded coins<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Trading data<\/b><span style=\"font-weight: 400;\">: Get an in-depth view of your recent transactions, most-traded coins by volume, and your year-to-date trading volume<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Dynamic view of exposure<\/b><span style=\"font-weight: 400;\">: Stay on top of your outstanding exposure with the live exposure panel.<\/span><\/li>\n<\/ul>\n<h2><b>Trade history<\/b><\/h2>\n<p><span style=\"font-weight: 400;\">For clients looking for detailed transaction information specific to OTC spot and options trades, the OTC Portal also includes a comprehensive view of their OTC trading history.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Trade history features:<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Trading history<\/b><span style=\"font-weight: 400;\">: Get a full overview of your past OTC spot and options trades, with the ability to filter, so you can get straight to the information you need <\/span><span style=\"font-weight: 400;\">\u2013<\/span><span style=\"font-weight: 400;\"> fast<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Trade detail information<\/b><span style=\"font-weight: 400;\">: Dive into individual trades for a more granular view of your order details<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Reporting<\/b><span style=\"font-weight: 400;\">: Generate reports for a detailed statement of your trades sent to your email.\u00a0<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Log in to Kraken Pro now and explore what Kraken OTC can do for you!<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/kraken-pro-otc-link\/\" target=\"_blank\" rel=\"noopener\">Try OTC Portal<\/a><\/div>\n<p><span style=\"font-weight: 400;\">Kraken OTC\u2019s pro traders are available 24\/7\/365 to execute your trades with minimal slippage and optimal pricing. Whether you trade via <\/span><a href=\"mailto:otc@kraken.com\"><span style=\"font-weight: 400;\">email<\/span><\/a><span style=\"font-weight: 400;\">, secure chat, or phone, you always get:<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>White-glove service<\/b><span style=\"font-weight: 400;\">: Personalized large-trade-execution assistance whenever you want it, across 200+ digital assets<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Expert traders<\/b><span style=\"font-weight: 400;\">: Seasoned professionals who know how to get the best possible price for your trade<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Learn more about <\/span><a href=\"https:\/\/www.kraken.com\/features\/otc-exchange\"><span style=\"font-weight: 400;\">Kraken\u2019s OTC offering here<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">*Clients who have had a portfolio value of at least $50,000 will be able to view the OTC Portal when they are logged in.\u00a0<\/span><\/p>\n<hr \/>\n<p><i>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any digital asset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your crypto assets and you should seek independent advice on your taxation position.<\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Kraken\u2019s OTC Portal is now integrated within Kraken Pro. This integration allows OTC clients to access the features and functionality they know and love from our OTC Desk via a fully automated, self-service UI.\u00a0 Access the OTC Portal by logging in to Pro and selecting &#8220;OTC&#8221; in the top navigation: [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":17923,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774,1426],"tags":[1462],"language":[],"class_list":["post-17911","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","category-product","tag-otc"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken\u2019s OTC Portal is now part of Kraken Pro - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Kraken\u2019s OTC Portal is now part of Kraken Pro\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that Kraken\u2019s OTC Portal is now integrated within Kraken Pro. This integration allows OTC clients to access the features and functionality they know and love from our OTC Desk via a fully automated, self-service UI.\u00a0 Access the OTC Portal by logging in to Pro and selecting &#8220;OTC&#8221; in the top navigation: [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/krakens-otc-portal-is-now-part-of-kraken-pro\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-03-02T19:15:33+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-03-04T11:31:43+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/03\/blog_header-3-1-1024x467.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1024\" \/>\n\t<meta property=\"og:image:height\" content=\"467\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/05fd1aef04d178f2231400ddb85550a2\"},\"headline\":\"Kraken\u2019s OTC Portal is now part of Kraken Pro\",\"datePublished\":\"2023-03-02T19:15:33+00:00\",\"dateModified\":\"2025-03-04T11:31:43+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro\"},\"wordCount\":624,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/03\\\/blog_header-3-1.png?fit=3072%2C1400&ssl=1\",\"keywords\":[\"OTC\"],\"articleSection\":[\"News\",\"Product\"],\"inLanguage\":\"en-US\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro\",\"name\":\"Kraken\u2019s OTC Portal is now part of Kraken Pro - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro#primaryimage\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/krakens-otc-portal-is-now-part-of-kraken-pro#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/03\\\/blog_header-3-1.png?fit=3072%2C1400&ssl=1\",\"datePublished\":\"2023-03-02T19:15:33+00:00\",\"dateModified\":\"2025-03-04T11:31:43+00:00\",\"brea