g-KrakenGeneric.png?fit=1536%2C701&ssl=1\",\"datePublished\":\"2023-01-24T15:59:34+00:00\",\"dateModified\":\"2023-05-05T10:56:22+00:00\",\"breadcrumb\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/press-release\\\/kraken-appoints-cj-rinaldi-as-chief-compliance-officer#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/press-release\\\/kraken-appoints-cj-rinaldi-as-chief-compliance-officer\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/press-release\\\/kraken-appoints-cj-rinaldi-as-chief-compliance-officer#primaryimage\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/05\\\/blog-KrakenGeneric.png?fit=1536%2C701&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/05\\\/blog-KrakenGeneric.png?fit=1536%2C701&ssl=1\",\"width\":1536,\"height\":701},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/press-release\\\/kraken-appoints-cj-rinaldi-as-chief-compliance-officer#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\\/\\\/blog.kraken.com\\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Kraken Appoints CJ Rinaldi as Chief Compliance Officer\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"name\":\"Kraken Blog\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\\/\\\/blog.kraken.com\\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\