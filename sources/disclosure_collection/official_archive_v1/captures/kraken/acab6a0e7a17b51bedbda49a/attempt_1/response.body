\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\",\"name\":\"krakenfx\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"caption\":\"krakenfx\"},\"sameAs\":[\"https:\\\/\\\/blog.kraken.com\"],\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/krakenfx\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Busting Crypto Myths: You don\u2019t own anything when you buy an NFT - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft","og_locale":"en_US","og_type":"article","og_title":"Busting Crypto Myths: You don\u2019t own anything when you buy an NFT","og_description":"For the uninitiated or crypto-curious people out there,\u00a0non-fungible tokens (NFTs)\u00a0represent one of the more colorful sectors of the cryptocurrency industry. How is it that duplicable, oftentimes wacky pieces of digital artwork can fetch extraordinarily high prices, and why are people flocking to buy these intangible items? It&#8217;s certainly a difficult topic to get your head [&hellip;]","og_url":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft","og_site_name":"Kraken Blog","article_published_time":"2023-02-03T23:00:01+00:00","article_modified_time":"2023-05-08T20:37:50+00:00","og_image":[{"width":1024,"height":444,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/BTC-illustration-2-1024x444.png","type":"image\/png"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"5 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"Busting Crypto Myths: You don\u2019t own anything when you buy an NFT","datePublished":"2023-02-03T23:00:01+00:00","dateModified":"2023-05-08T20:37:50+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft"},"wordCount":997,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/BTC-illustration-2.png?fit=2175%2C944&ssl=1","keywords":["crypto 101","NFT"],"articleSection":["Crypto Education","NFT"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft","url":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft","name":"Busting Crypto Myths: You don\u2019t own anything when you buy an NFT - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#primaryimage"},"image":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/BTC-illustration-2.png?fit=2175%2C944&ssl=1","datePublished":"2023-02-03T23:00:01+00:00","dateModified":"2023-05-08T20:37:50+00:00","breadcrumb":{"@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#primaryimage","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/BTC-illustration-2.png?fit=2175%2C944&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/BTC-illustration-2.png?fit=2175%2C944&ssl=1","width":2175,"height":944},{"@type":"BreadcrumbList","@id":"https:\/\/blog.kraken.com\/crypto-education\/busting-crypto-myths-you-dont-own-anything-when-you-buy-an-nft#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"Busting Crypto Myths: You don\u2019t own anything when you buy an NFT"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21","name":"krakenfx","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-4z8","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/BTC-illustration-2.png?fit=2175%2C944&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17554","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=17554"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17554\/revisions"}],"predecessor-version":[{"id":21038,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/17554\/revisions\/21038"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/17558"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=17554"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=17554"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=17554"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=17554"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":17546,"date":"2023-02-06T16:54:03","date_gmt":"2023-02-06T21:54:03","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=17546"},"modified":"2023-05-08T16:24:18","modified_gmt":"2023-05-08T20:24:18","slug":"crypto-101-what-is-a-consensus-mechanism","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/crypto-education\/crypto-101-what-is-a-consensus-mechanism","title":{"rendered":"Crypto 101: What is a consensus mechanism?"},"content":{"rendered":"<p>A blockchain consensus mechanism is a type of automated system that aims to accomplish two objectives:<\/p>\n<ol>\n<li>Provide a distributed, leaderless way to unanimously agree on data stored on a blockchain ledger.<\/li>\n<li>Make sure all network validators follow the rules of the protocol and perform their roles honestly.<\/li>\n<\/ol>\n<p>While it may be tempting to trust a single individual or entity with the role of making sure everyone behaves according to the rules, hierarchical systems have definite shortcomings. That&#8217;s why Bitcoin uses a consensus mechanism.<\/p>\n<p><a href=\"https:\/\/www.kraken.com\/prices\/bitcoin\" target=\"_blank\" rel=\"noopener noreferrer\">Bitcoin&#8217;s<\/a> use of consensus mechanisms created a truly peer-to-peer electronic cash system. This system offset the need for centralized intermediaries, like banks and governments, and changed the concept of financial freedom for all.<\/p>\n<p>What does this mean in practice? It means bitcoin is the first currency not controlled by a central bank. The resulting freedom, in theory, allows us to explore some very interesting questions about the nature of trust and consensus.<\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/consensus\/\" target=\"_blank\" rel=\"noopener\">Learn more<\/a><\/div>\n<h2>What is the Byzantine Generals&#8217; Problem?<\/h2>\n<p>One of the most important things Bitcoin did was solve the Byzantine Generals Problem. Imagine you are the commander of an army consisting of several platoons of soldiers, each located at a different spot on the battlefield. You plan to attack a single fortified area at a specific time. To do this, you must coordinate with each of your platoons to make sure they all know the correct time, location, and plan of action.<\/p>\n<p>But, what if one or more platoons fail to receive the orders? What if they attack too early? What if they arrive at the wrong location? What if there are traitors in a platoon that try to sabotage the plan?<\/p>\n<p>In other words, until Bitcoin there was no safe way to reach consensus among the various parties in an environment lacking implicit trust.<\/p>\n<p>This problem first appeared in a 1982 academic paper that explored how a distributed network could reach agreement in a decentralized way. The answer, as Satoshi Nakamoto laid out in the <a href=\"https:\/\/www.kraken.com\/learn\/what-is-bitcoin-white-paper\" target=\"_blank\" rel=\"noopener noreferrer\">bitcoin white paper<\/a>, was a consensus mechanism.<\/p>\n<p>This algorithm allows all nodes in the network to agree on a single version of the truth, even if some of the nodes act maliciously or simply fail. The consensus mechanism works by having each node in the network broadcast and validate all of the transactions to the network. Once a node validates a transaction, every other node adds a record to their copy of an append-only ledger. &#8220;Append-only&#8221; means that the ledger can only receive new records and no one can change previous records. This is called a blockchain.<\/p>\n<p>In going back to the Byzantine Generals problem, each platoon would individually confirm and store the orders and check with other platoons. If one of them claims the attack is cancelled, for example, further checking with nearby platoons would prove that one leader was lying. This guarantees that all nodes in the network have the same version of the truth. It also means that malicious nodes cannot single-handedly manipulate the network data.<\/p>\n<h2>How do consensus mechanisms work?<\/h2>\n<p>There are many different methods employed by various <a href=\"https:\/\/www.kraken.com\/learn\/what-is-blockchain-technology\" target=\"_blank\" rel=\"noopener noreferrer\">blockchains<\/a> and <a href=\"https:\/\/www.kraken.com\/learn\/what-is-cryptocurrency\" target=\"_blank\" rel=\"noopener noreferrer\">cryptocurrency protocols<\/a> to achieve consensus. However, the two most popular are known as the<a href=\"https:\/\/www.kraken.com\/learn\/proof-of-work-vs-proof-of-stake\" target=\"_blank\" rel=\"noopener noreferrer\"> proof-of-work (PoW) and the proof-of-stake (PoS) consensus mechanisms<\/a>.<\/p>\n<h3>Proof-of-work (PoW)<\/h3>\n<p>Computer scientists Cynthia Dwork and Moni Naor first developed PoW in 1993 as a means of preventing email spam. Bitcoin&#8217;s creator later took the concept and adapted it for use in a decentralized monetary system.<\/p>\n<p>Through the <a href=\"https:\/\/www.kraken.com\/learn\/what-is-bitcoin-mining\" target=\"_blank\" rel=\"noopener noreferrer\">bitcoin mining process<\/a>, network validators (called miners) use specialized computer equipment to win a cryptography-based competition that repeats every ten minutes.<\/p>\n<p>You can learn more about this concept in our Learn Center article <a href=\"https:\/\/www.kraken.com\/learn\/how-do-cryptocurrencies-use-cryptography\" target=\"_blank\" rel=\"noopener noreferrer\">How do cryptocurrencies use cryptography?<\/a><\/p>\n<p><span class=\"ql-writer-texthighlight ql-writer-texthighlight-clarity issue-53ec2d95-e344-4c29-acd1-afdf78e0a130\" data-id=\"53ec2d95-e344-4c29-acd1-afdf78e0a130\" data-category=\"clarity\" data-value=\"53ec2d95-e344-4c29-acd1-afdf78e0a130\">PoW makes use of computational resources to make sure that &#8220;work&#8221; has gone into &#8220;proving&#8221; newly proposed transactions are valid and abide by the rules of the protocol. <\/span><\/p>\n<p>The work involves electrical, maintenance, and initial outlay costs that each miner must cover themselves. This cost is important because it helps to deter bad actors from joining the network and attempting to corrupt it with spam or fraudulent transactions. After all, you&#8217;re less likely to want to corrupt something when you&#8217;ve invested your own money into it.<\/p>\n<h3>Proof-of-stake (PoS)<\/h3>\n<p>PoS is a relatively new type of consensus mechanism pioneered by Sunny King and Scott Nadal in 2012.<\/p>\n<p>Like proof-of-work, PoS fulfills the same key objectives of a consensus mechanism, but in a uniquely different way.<\/p>\n<p><span class=\"ql-writer-texthighlight ql-writer-texthighlight-clarity issue-4736d79f-0095-4e01-aa1f-7a73cee558bd\" data-id=\"4736d79f-0095-4e01-aa1f-7a73cee558bd\" data-category=\"clarity\" data-value=\"4736d79f-0095-4e01-aa1f-7a73cee558bd\">Rather than competing with other validators on the network to win a cryptography-based competition first, PoS requires network participants to &#8220;stake&#8221; or lock their assets to become validators. <\/span><\/p>\n<p><span class=\"ql-writer-texthighlight ql-writer-texthighlight-clarity issue-79bdef1b-4e8a-4e76-a87d-b7d922c1ae5d\" data-id=\"79bdef1b-4e8a-4e76-a87d-b7d922c1ae5d\" data-category=\"clarity\" data-value=\"79bdef1b-4e8a-4e76-a87d-b7d922c1ae5d\">PoS uses a system of reward and penalty incentives to make sure that transactions are validated and added to the blockchain in an honest way.<\/span> Those willing to lock away a greater amount of cryptocurrency gain a greater chance of proposing new blocks and earning rewards. But, if validators break the rules of the protocol, their staked assets risk being automatically confiscated in a process known as &#8220;slashing.&#8221;<\/p>\n<h2>What is the best blockchain consensus mechanism?<\/h2>\n<p>The debate about which consensus mechanism is &#8220;best&#8221; will likely never be settled. There are too many factors regarding each blockchain&#8217;s specific use case to draw a definitive conclusion.<\/p>\n<p>Many perceive PoW to offer greater security against 51% attacks, but the process consumes a significant amount of energy. We&#8217;ve already <a href=\"https:\/\/blog.kraken.com\/post\/16645\/crypto-myths-bitcoin-destroying-environment\/\" target=\"_blank\" rel=\"noopener noreferrer\">busted the myth that bitcoin is destroying the environment in a previous blog post<\/a>, but the perception remains.<\/p>\n<p>While many PoS blockchains consume significantly less energy than PoW chains, many feel these blockchains are compromised. For example, they believe PoS blockchains focus on decentralization in favor of security. You can learn more about this in our discussion of the <a href=\"https:\/\/blog.kraken.com\/post\/17395\/crypto-101-what-is-the-blockchain-trilemma\/\">Blockchain trilemma<\/a>.<\/p>\n<p>In short, experts generally perceive PoW to offer better security and decentralization guarantees, while sacrificing some degree of scalability in the process. PoS is seen to offer better scalability, while sacrificing some degree of security and decentralization.<\/p>\n<p>The best choice ultimately depends on numerous factors, including a given blockchain&#8217;s primary use case.<\/p>\n<h2>Keep learning about crypto<\/h2>\n<p>Interested in learning more about the Byzantine Generals&#8217; Problem and the various tradeoffs of different blockchain consensus mechanisms? The <a href=\"https:\/\/www.kraken.com\/learn\" target=\"_blank\" rel=\"noopener noreferrer\">Kraken Learn Center<\/a> is here to help!<\/p>\n<p>Check out one of our latest articles, <a href=\"https:\/\/www.kraken.com\/learn\/what-is-blockchain-consensus-mechanism\" target=\"_blank\" rel=\"noopener noreferrer\">What is a blockchain consensus mechanism?<\/a>, to continue learning about the important role consensus mechanisms play in crypto and blockchain technology.<\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/learn\/what-is-blockchain-consensus-mechanism\" target=\"_blank\" rel=\"noopener\">Learn more<\/a><\/div>\n<hr \/>\n<p><i><span style=\"font-weight: 400;\">These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, or hold any digital asset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your crypto assets and you should seek independent advice on your taxation position.<\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>A blockchain consensus mechanism is a type of automated system that aims to accomplish two objectives: Provide a distributed, leaderless way to unanimously agree on data stored on a blockchain ledger. Make sure all network validators follow the rules of the protocol and perform their roles honestly. While it may be tempting to trust a [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":17549,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1391],"tags":[1707,1708,1709],"language":[],"class_list":["post-17546","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-crypto-education","tag-consensus-mechanism","tag-proof-of-stake","tag-proof-of-work"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Crypto 101: What is a consensus mechanism? - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/crypto-education\/crypto-101-what-is-a-consensus-mechanism\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Crypto 101: What is a consensus mechanism?\" \/>\n<meta property=\"og:description\" content=\"A blockchain consensus mechanism is a type of automated system that aims to accomplish two objectives: Provide a distributed, leaderless way to unanimously agree on data stored on a blockchain ledger. Make sure all network validators follow the rules of the protocol and perform their roles honestly. While it may be tempting to trust a [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/crypto-education\/crypto-101-what-is-a-consensus-mechanism\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-02-06T21:54:03+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-05-08T20:24:18+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/02\/consensus-1536x700-copy.png?fit=1535%2C700&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"1535\" \/>\n\t<meta property=\"og:image:height\" content=\"700\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"6 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism\"},\"author\":{\"name\":\"krakenfx\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\"},\"headline\":\"Crypto 101: What is a consensus mechanism?\",\"datePublished\":\"2023-02-06T21:54:03+00:00\",\"dateModified\":\"2023-05-08T20:24:18+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism\"},\"wordCount\":1171,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/02\\\/consensus-1536x700-copy.png?fit=1535%2C700&ssl=1\",\"keywords\":[\"consensus mechanism\",\"proof-of-stake\",\"proof-of-work\"],\"articleSection\":[\"Crypto Education\"],\"inLanguage\":\"en-US\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism\",\"name\":\"Crypto 101: What is a consensus mechanism? - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#primaryimage\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/02\\\/consensus-1536x700-copy.png?fit=1535%2C700&ssl=1\",\"datePublished\":\"2023-02-06T21:54:03+00:00\",\"dateModified\":\"2023-05-08T20:24:18+00:00\",\"breadcrumb\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#primaryimage\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/02\\\/consensus-1536x700-copy.png?fit=1535%2C700&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/02\\\/consensus-1536x700-copy.png?fit=1535%2C700&ssl=1\",\"width\":1535,\"height\":700},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/crypto-101-what-is-a-consensus-mechanism#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\\/\\\/blog.kraken.com\\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Crypto 101: What is a consensus mechanism?\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"name\":\"Kraken Blog\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\\/\\\/blog.kraken.com\\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\",\"name\":\"Kraken Blog\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\",\"name\":\"krakenfx\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"caption\":\"krakenfx\"},\"sameAs\":[\"https:\\\/\\\/blog.kraken.com\"],\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/krakenfx\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Crypto 101: What is a consensus mechanism? - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/crypto-education\/crypto-101-what-is-a-consensus-mechanism","og_locale":"en_US","og_type":"article","og_title":"Crypto 101: What is a consensus mechanism?","og_description":"A blockchain consensus mechanism is a type of automated system that aims to accomplish two objectives: Provide a distributed, leaderless way to unanimously agree on data stored on a blockchain ledger. Make sure all network validators follow the rules of the protocol and perform their roles honestly. While it may be tempting to trust a [&hellip;]","og_url":"https:\/\