da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-3vj","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-inner-Single-token-1.jpg?fit=730%2C836&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/13473","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=13473"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/13473\/revisions"}],"predecessor-version":[{"id":21784,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/13473\/revisions\/21784"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/13477"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=13473"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=13473"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=13473"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=13473"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":13493,"date":"2022-03-30T14:51:29","date_gmt":"2022-03-30T14:51:29","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=13493"},"modified":"2023-06-07T09:50:51","modified_gmt":"2023-06-07T13:50:51","slug":"trading-for-alcx-bond-jasmy-mask-rndr-spell-tribe-uma-starts-april-1-deposit-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/trading-for-alcx-bond-jasmy-mask-rndr-spell-tribe-uma-starts-april-1-deposit-now","title":{"rendered":"Trading for ALCX, BOND, JASMY, MASK, RNDR, SPELL, TRIBE, UMA Starts April 1  &#8211; Deposit Now!"},"content":{"rendered":"<p><span style=\"font-weight: 400;\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"13498\" data-permalink=\"https:\/\/blog.kraken.com\/blog-inner-multi-token\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?fit=1536%2C701&amp;ssl=1\" data-orig-size=\"1536,701\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Blog Inner &amp;#8211; Multi token\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?fit=1024%2C467&amp;ssl=1\" class=\"aligncenter wp-image-13498 size-full\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?resize=1536%2C701&#038;ssl=1\" alt=\"\" width=\"1536\" height=\"701\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?w=1536&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?resize=300%2C137&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?resize=1024%2C467&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?resize=768%2C351&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/Blog-Inner-Multi-token.png?resize=200%2C91&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/span><\/p>\n<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that Kraken now supports <\/span><b>Alchemix (ALCX), Barnbridge (BOND), Jasmy (JASMY), Mask Network (MASK), Render (RNDR), Spell Token (SPELL), Tribe (TRIBE) <\/b><span style=\"font-weight: 400;\">and<\/span><b> Universal Market Access (UMA)!<\/b><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and Trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Funding is live, and trading will begin on <\/span><span style=\"font-weight: 400;\">April 1 at approximately 14:30 UTC.<\/span><span style=\"font-weight: 400;\"> Keep an eye on the <\/span><a href=\"https:\/\/status.kraken.com\/\"><span style=\"font-weight: 400;\">status page<\/span><\/a><span style=\"font-weight: 400;\"> for updates.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">You can add these tokens to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">. Deposits require <\/span><b>20 confirmations<\/b><span style=\"font-weight: 400;\"> (~5 minutes)<\/span><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">All tokens are tradeable against <\/span><b>USD <\/b><span style=\"font-weight: 400;\">and <\/span><b>EUR<\/b><span style=\"font-weight: 400;\">, on <\/span><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\"> and the <\/span><a href=\"https:\/\/trade.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> interface with the following price precisions and minimum deposits<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Asset<\/b><\/td>\n<td><b>Price precision\u00a0<\/b><\/td>\n<td><b>Minimum deposit<\/b><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">ALCX<\/span><\/td>\n<td><span style=\"font-weight: 400;\">2<\/span><\/td>\n<td><span style=\"font-weight: 400;\">0.05 ALCX<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">BOND<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3<\/span><\/td>\n<td><span style=\"font-weight: 400;\">0.5 BOND<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">JASMY<\/span><\/td>\n<td><span style=\"font-weight: 400;\">5<\/span><\/td>\n<td><span style=\"font-weight: 400;\">100 JASMY<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">MASK<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3<\/span><\/td>\n<td><span style=\"font-weight: 400;\">1 MASK<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">RNDR<\/span><\/td>\n<td><span style=\"font-weight: 400;\">4<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3 RNDR<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">SPELL<\/span><\/td>\n<td><span style=\"font-weight: 400;\">6<\/span><\/td>\n<td><span style=\"font-weight: 400;\">1,000 SPELL<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">TRIBE<\/span><\/td>\n<td><span style=\"font-weight: 400;\">4<\/span><\/td>\n<td><span style=\"font-weight: 400;\">10 TRIBE<\/span><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">UMA<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3<\/span><\/td>\n<td><span style=\"font-weight: 400;\">1 UMA<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><b>Note:\u00a0 Jasmy (JASMY) trading is not available to residents of the United States, Canada and Japan.<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the assets:<\/span><\/p>\n<p><b>Alchemix (ALCX) &#8211; <\/b><span style=\"font-weight: 400;\">Alchemix is an Ethereum-based decentralized finance (DeFi) lending platform. Loans taken out on Alchemix repay themselves over time as the user\u2019s collateral earns yield. The ALCX token can be staked to earn additional ALCX or used to govern the protocol\u2019s development.<\/span><\/p>\n<p><b>Barnbridge (BOND) &#8211; <\/b><span style=\"font-weight: 400;\">BarnBridge is a cross-platform risk-tokenizing protocol, designed to reduce DeFi-related risks such as market volatility and fluctuating interest rates. It allows users to select a risk profile and strategy to suit their trading objectives. BOND is the BarnBridge utility and governance token that lets holders steer future protocol development.<\/span><\/p>\n<p><b>Jasmy (JASMY) &#8211; <\/b><span style=\"font-weight: 400;\">Jasmy aims to decentralize the maintenance and management of sensitive information through the use of \u2018personal data lockers\u2019 on the Jasmy network. The JASMY token is the network\u2019s utility token that is used to secure the network and pay for personal data that users send and receive from IoT devices.<\/span><\/p>\n<p><b>Mask Network (MASK) &#8211; <\/b><span style=\"font-weight: 400;\">Mask Network aims to bring the privacy and benefits of Web3 to centralized Web 2.0 social media applications. The Mask open-source browser extension enables users to send cryptographically encrypted messages secured by the Ethereum blockchain and to display their Web 3.0 profiles on platforms like Facebook and Twitter.<\/span><\/p>\n<p><b>Render (RNDR) &#8211; <\/b><span style=\"font-weight: 400;\">The Render Network is a distributed rendering network for GPU compute built on Ethereum. It aims to connect users that require GPU power with node operators who have idle GPU capacity. The RNDR token is used by creators on the network to pay providers for their processing power.<\/span><\/p>\n<p><b>Spell Token (SPELL) &#8211; <\/b><span style=\"font-weight: 400;\">SPELL is a reward token tied to the Abracadabra lending platform on the Ethereum blockchain. SPELL\u00a0 enables users to leverage interest-bearing crypto assets as collateral to borrow Magic Internet Money (MIM) \u2014 a USD-pegged stablecoin that can be exchanged for other stablecoins.<\/span><\/p>\n<p><b>Tribe (TRIBE) &#8211; <\/b><span style=\"font-weight: 400;\">TRIBE is the governance token that allows individuals to steer the development of Fei\u2019s decentralized, scalable and DeFi-native algorithmic stablecoin FEI USD. The Fei network\u2019s goal is to be more capital-efficient than fiat-collateralized or crypto-collateralized stablecoin alternatives.<\/span><\/p>\n<p><b>Universal Market Access (UMA) &#8211; <\/b><span style=\"font-weight: 400;\">Universal Market Access is an Ethereum blockchain protocol for creating and trading synthetic assets and decentralized financial products. The protocol\u2019s governance token, UMA, allows holders to vote on upgrades and changes to the project\u2019s development road map.<\/span><\/p>\n<h3><b>Will Kraken list more assets?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 not even which assets we are considering. All of Kraken\u2019s listed tokens are available on our website, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be listing in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee of executing at a certain price for a market order. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Listing an asset or token for trade is not a recommendation to buy, sell, or participate in the associated network. Do your own research and invest at your own risk.<\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Kraken now supports Alchemix (ALCX), Barnbridge (BOND), Jasmy (JASMY), Mask Network (MASK), Render (RNDR), Spell Token (SPELL), Tribe (TRIBE) and Universal Market Access (UMA)! Funding and Trading Funding is live, and trading will begin on April 1 at approximately 14:30 UTC. Keep an eye on the status page for updates. [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":13499,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[],"language":[],"class_list":["post-13493","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for ALCX, BOND, JASMY, MASK, RNDR, SPELL, TRIBE, UMA Starts April 1 - Deposit Now! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/trading-for-alcx-bond-jasmy-mask-rndr-spell-tribe-uma-starts-april