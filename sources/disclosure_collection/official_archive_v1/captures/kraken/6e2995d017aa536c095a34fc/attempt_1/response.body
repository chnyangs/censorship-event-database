[{"id":13473,"date":"2022-03-29T17:24:33","date_gmt":"2022-03-29T17:24:33","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=13473"},"modified":"2023-06-07T09:51:57","modified_gmt":"2023-06-07T13:51:57","slug":"deposits-and-staking-for-scrt-available-now-earn-up-to-20-in-yearly-rewards","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/deposits-and-staking-for-scrt-available-now-earn-up-to-20-in-yearly-rewards","title":{"rendered":"Deposits and Staking for SCRT Available Now &#8211; Earn Up to 20% in Yearly Rewards"},"content":{"rendered":"<p><span style=\"font-weight: 400;\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"13478\" data-permalink=\"https:\/\/blog.kraken.com\/scrt-social\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?fit=1200%2C675&amp;ssl=1\" data-orig-size=\"1200,675\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"SCRT &amp;#8211; Social\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?fit=1024%2C576&amp;ssl=1\" class=\"aligncenter wp-image-13478 size-full\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?resize=1200%2C675&#038;ssl=1\" alt=\"\" width=\"1200\" height=\"675\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?w=1200&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/03\/SCRT-Social.jpg?resize=178%2C100&amp;ssl=1 178w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/span><\/p>\n<p><span style=\"font-weight: 400;\">Kraken is excited to announce the listing of SCRT and staking <\/span><b>with up to 20% in yearly rewards<\/b><span style=\"font-weight: 400;\">!<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and Trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Funding is live, and trading will begin on April 1 at approximately 14:30 UTC. Keep an eye on the status page for updates.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">You can add SCRT to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know:<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Ticker<\/b><\/td>\n<td><span style=\"font-weight: 400;\">SCRT<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Tradeable against<\/b><\/td>\n<td><span style=\"font-weight: 400;\">EUR, USD<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Price precision<\/b><\/td>\n<td><span style=\"font-weight: 400;\">3 decimal places<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Deposit confirmations required<\/b><\/td>\n<td><span style=\"font-weight: 400;\">Near instant<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Not available in<\/b><\/td>\n<td><span style=\"font-weight: 400;\">Japan<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Services available<\/b><\/td>\n<td><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\">, the <\/span><a href=\"https:\/\/trade.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> interface<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><span style=\"font-weight: 400;\">Keep an eye on the <\/span><a href=\"https:\/\/status.kraken.com\/\"><span style=\"font-weight: 400;\">status page<\/span><\/a><span style=\"font-weight: 400;\"> for updates.<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Staking<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">You can stake SCRT on your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/earn\/staking\"><b>Earn<\/b><\/a><span style=\"font-weight: 400;\">, clicking on &#8216;STAKING&#8217; and then selecting the asset you would like to stake. Input the amount of the asset you want to stake, then follow the on-screen instructions.<\/span><\/p>\n<h3><b>What is SCRT?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Secret Network is a Delegated Proof of Stake (DPoS) privacy-first blockchain built on the Cosmos ecosystem. Secret Network enables the encryption of smart contracts called \u2018Secret Contracts\u2019 in a permissionless way through the use of computers&#8217; trusted execution environments (TEEs) to offer greater privacy to users. The native token SCRT can be staked to earn rewards and used to vote on governance proposals.<\/span><\/p>\n<h3><b>Will Kraken list more assets?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 not even which assets we are considering. All of Kraken\u2019s listed tokens are available on our website, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be listing in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee of executing at a certain price for a market order. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Listing an asset or token for trade is not a recommendation to buy, sell, or participate in the associated network. Do your own research and invest at your own risk.<\/span><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Kraken is excited to announce the listing of SCRT and staking with up to 20% in yearly rewards! Funding and Trading Funding is live, and trading will begin on April 1 at approximately 14:30 UTC. Keep an eye on the status page for updates.\u00a0 You can add SCRT to your Kraken account by navigating to [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":13477,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1625],"language":[],"class_list":["post-13473","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-scrt"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Deposits and Staking for SCRT Available Now - Earn Up to 20% in Yearly Rewards - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<li