02d06?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/celia-delcastillo"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6Z3","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/12\/Frame-2041277481.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26849","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089406"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=26849"}],"version-history":[{"count":11,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26849\/revisions"}],"predecessor-version":[{"id":26868,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26849\/revisions\/26868"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/26850"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=26849"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=26849"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=26849"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=26849"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":26856,"date":"2024-12-09T08:57:19","date_gmt":"2024-12-09T13:57:19","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=26856"},"modified":"2024-12-12T10:48:13","modified_gmt":"2024-12-12T15:48:13","slug":"12-days-of-mememas","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/12-days-of-mememas","title":{"rendered":"Kraken\u2019s 12 Days of Mememas: Compete to win $12,000 in memecoins!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We are excited to announce Kraken\u2019s 12 Days of Mememas competition! Join <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenfx<\/a> on X (Twitter) for the unboxing of each memecoin, starting Dec. 9, 2024!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-can-you-win\">What can you win?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">There are now <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">over 300 tokens listed on Kraken<\/a>. Each day of the 12 Days of Mememas contest, we\u2019ll give away $1,000 total in one of these tokens \u2013 $500 worth to two lucky winners.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A different token will be selected each day from Dec. 9-Dec. 20. This is your chance to get on the next rocketship, start a position in a popular coin or maybe even give the gift of crypto to a friend or family member.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-who-can-participate\">Who can participate?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you are new to crypto or a seasoned veteran, this competition is open to everyone who qualifies. Kraken will select the winners for each day of the competition.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-to-qualify-you-need-to\">To qualify you need to:<\/h3>\n\n\n\n<ol class=\"wp-block-list\">\n<li>Have a verified Kraken or Kraken Pro <a href=\"https:\/\/kraken.onl\/JDNW\/6efp65or\" target=\"_blank\" rel=\"noreferrer noopener\">account<\/a><\/li>\n\n\n\n<li><strong>Not<\/strong> reside in one of the following excluded locations:<br>&#8211; U.S. states of Maine, New York or Washington<br>&#8211; Quebec, Canada<br>&#8211; Germany<br>&#8211; United Kingdom<br>&#8211; Austria<\/li>\n\n\n\n<li>Follow our <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenfx<\/a> <strong>and<\/strong> <a href=\"https:\/\/x.com\/krakenpro\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenpro<\/a> X accounts<br><strong>Note: Your X account must be at least three months old.<\/strong><\/li>\n\n\n\n<li>Reply to <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">@krakenfx<\/a>\u2019s X post with a meme related to the giveaway token of the day<\/li>\n\n\n\n<li>Fill out the giveaway\u2019s Google Form (each individual contest day\u2019s X post will link to that day\u2019s contest form)<\/li>\n\n\n\n<li>Agree to the contest&#8217;s <a href=\"http:\/\/kraken.com\/mememascontestterms\" target=\"_blank\" rel=\"noreferrer noopener\">Terms and Conditions<\/a><\/li>\n<\/ol>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-will-winners-get-their-prizes\">How will winners get their prizes?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">We will select winners within 48 hours of each unboxing. We will notify winners via email, sent from support@kraken.com. Please add @kraken.com to your contacts to ensure that our emails don&#8217;t end up in your spam folder.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Not a Kraken client yet? Don\u2019t miss out on the Mememas festivities! <a href=\"https:\/\/kraken.onl\/JDNW\/6efp65or\" target=\"_blank\" rel=\"noreferrer noopener\">Create your account<\/a> and get verified to Intermediate or Pro now.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/kraken.onl\/JDNW\/6efp65or\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>NO PURCHASE NECESSARY. Terms &amp; conditions apply. Void where prohibited by law.<br><br>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake, or hold any cryptoasset or to engage in any specific trading strategy. Kraken makes no representation or warranty of any kind, express or implied, as to the accuracy, completeness, timeliness, suitability or validity of any such information and will not be liable for any errors, omissions, or delays in this information or any losses, injuries, or damages arising from its display or use. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are regulated and others are unregulated; regardless, Kraken may or may not be required to be registered or otherwise authorised to provide specific products and services in each market, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the crypto-asset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply. See Legal Disclosures for each jurisdiction<\/em> <a href=\"https:\/\/www.kraken.com\/legal\/disclosures\" target=\"_blank\" rel=\"noreferrer noopener\"><em>here<\/em><\/a><em>.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p><i>Starting Dec. 9, celebrate Mememas with us as we give away $12,000 in memecoins \u2013 $1,000 of a different memecoin, every day, for 12 days.<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":26869,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"