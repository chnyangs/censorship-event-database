ure.gravatar.com\/avatar\/0be680e9c206e5993833995fa8b62ce83349d2c27001a6499a987bdfd3a02d06?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/0be680e9c206e5993833995fa8b62ce83349d2c27001a6499a987bdfd3a02d06?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/celia-delcastillo"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6XA","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/Frame-2041277471-2.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26758","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089406"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=26758"}],"version-history":[{"count":5,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26758\/revisions"}],"predecessor-version":[{"id":26798,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26758\/revisions\/26798"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/26761"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=26758"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=26758"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=26758"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=26758"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":26768,"date":"2024-11-26T11:25:20","date_gmt":"2024-11-26T16:25:20","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=26768"},"modified":"2024-11-28T08:48:15","modified_gmt":"2024-11-28T13:48:15","slug":"kraken-wallet-explore-page","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/kraken-wallet-explore-page","title":{"rendered":"Introducing the Kraken Wallet Explore page"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">With <a href=\"https:\/\/www.kraken.com\/wallet\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Wallet<\/a>, we are committed to creating intuitive, seamless and secure onchain experiences. Today, we\u2019re thrilled to unveil a new set of tools to navigate the vast onchain world, and our new Explore page is at the forefront.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you&#8217;re new to onchain or a seasoned professional, Explore pairs with our new in-app browser so you can directly connect to <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-decentralized-application-dapp\" target=\"_blank\" rel=\"noreferrer noopener\">dApps<\/a> within Kraken Wallet. This latest update gets you onchain seamlessly.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-s-new-with-kraken-wallet\"><strong>What\u2019s new with Kraken Wallet<\/strong><\/h2>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-updated-home-screen-with-new-navigation-bar\"><strong>Updated home screen with new navigation bar<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019ve introduced a small floating navigation bar at the bottom of the screen, with buttons for your home page shown with a Wallet button,&nbsp;our new Explore page with a Navigate button, and the WalletConnect button, which moved from the upper right corner.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"237\" height=\"512\" data-attachment-id=\"26770\" data-permalink=\"https:\/\/blog.kraken.com\/product\/kraken-wallet-explore-page\/attachment\/kwe1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe1.png?fit=237%2C512&amp;ssl=1\" data-orig-size=\"237,512\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kwe1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe1.png?fit=237%2C512&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe1.png?resize=237%2C512&#038;ssl=1\" alt=\"\" class=\"wp-image-26770\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe1.png?w=237&amp;ssl=1 237w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe1.png?resize=139%2C300&amp;ssl=1 139w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe1.png?resize=46%2C100&amp;ssl=1 46w\" sizes=\"auto, (max-width: 237px) 100vw, 237px\" \/><\/figure>\n<\/div>\n\n\n<div style=\"height:11px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"512\" height=\"161\" data-attachment-id=\"26772\" data-permalink=\"https:\/\/blog.kraken.com\/product\/kraken-wallet-explore-page\/attachment\/kwe2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe2.png?fit=512%2C161&amp;ssl=1\" data-orig-size=\"512,161\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kwe2\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe2.png?fit=512%2C161&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe2.png?resize=512%2C161&#038;ssl=1\" alt=\"\" class=\"wp-image-26772\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe2.png?w=512&amp;ssl=1 512w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe2.png?resize=300%2C94&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/kwe2.png?resize=200%2C63&amp;ssl=1 200w\" sizes=\"auto, (max-width: 512px) 100vw, 512px\" \/><\/figure>\n<\/div>\n\n\n<h2 class=\"wp-block-heading\" id=\"h-the-new-explore-page\"><strong>The new Explore page<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The Explore page is a dynamic hub within Kraken Wallet that organizes all your favorite onchain content. For new users, it is a great place to get started with popular\/trusted dApps across <a href=\"https:\/\/www.kraken.com\/learn\/defi\" target=\"_blank\" rel=\"noreferrer noopener\">DeFi<\/a>, <a href=\"https:\/\/www.kraken.com\/learn\/nft\" target=\"_blank\" rel=\"noreferrer noopener\">NFTs<\/a> and more. For experienced users, you can quickly access your favorite onchain destinations. We have plans for the Explore page to evolve over time including introducing dynamic content, <a href=\"https:\/\/inkonchain.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Ink<\/a> experiences and much more.<\/p>\n\n\n\n<div style=\"height:26px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"698\" data-attachment-id=\"26821\" data-permalink=\"https:\/\/blog.kraken.com\/product\/kraken-wallet-explore-page\/attachment\/app-screen-explore\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?fit=2560%2C1746&amp;ssl=1\" data-orig-size=\"2560,1746\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"app-screen-explore\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?fit=1024%2C698&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore-1024x698.png?resize=1024%2C698&#038;ssl=1\" alt=\"\" class=\"wp-image-26821\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=1024%2C698&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=300%2C205&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=768%2C524&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=1536%2C1048&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=2048%2C1397&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=1200%2C818&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/app-screen-explore.png?resize=147%2C100&amp;ssl=1 147w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<div style=\"height:26px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-an-in-app-browser-with-direct-dapp-connections\"><strong>An in-app browser with direct dApp connections<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">With the Explore page, you will discover exciting dApps. Once you find one you&#8217;re interested in, you can now view and interact with it directly via Kraken Wallet\u2019s new in-app browser.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Easily connect your wallet to any dApp and sign transactions, all within the native browser. Didn\u2019t find what you were looking for on the Explore page? Simply use the search function at the top of the screen and find it using the browser.<\/p>\n\n\n\n<div style=\"height:17px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"698\" data-attachment-id=\"26823\" data-permalink=\"https:\/\/blog.kraken.com\/product\/kraken-wallet-explore-page\/attachment\/trio-wallet-explore\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?fit=2560%2C1746&amp;ssl=1\" data-orig-size=\"2560,1746\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"trio-wallet-explore\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?fit=1024%2C698&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore-1024x698.png?resize=1024%2C698&#038;ssl=1\" alt=\"\" class=\"wp-image-26823\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=1024%2C698&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=300%2C205&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=768%2C524&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=1536%2C1048&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=2048%2C1397&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=1200%2C818&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/11\/trio-wallet-explore.png?resize=147%2C100&amp;ssl=1 147w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<div style=\"height:13px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-enhanced-security\"><strong>Enhanced security<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">We are always ensuring that we keep security and privacy at the forefront of development. In addition to new secret recovery phrase tooling like <a href=\"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet\" target=\"_blank\" rel=\"noreferrer noopener\">iCloud Backup<\/a>, we partnered with Trail of Bits to conduct an additional security review of the in-app browser. You can find the report <a href=\"https:\/\/github.com\/krakenfx\/wallet\/blob\/main\/audits\/Kraken%20Wallet%20-%20in%20app%20browser%20security%20review.pdf\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-getting-started-with-explore\"><strong>Getting started with Explore<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>First, you need to make sure you have some crypto in your wallet.<\/strong> You can <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/send-and-receive-crypto\" target=\"_blank\" rel=\"noreferrer noopener\">send crypto to your Kraken Wallet<\/a>, <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/importing-a-wallet-to-kraken-wallet\" target=\"_blank\" rel=\"noreferrer noopener\">import a different wallet<\/a> or <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6551972073364-How-to-withdraw-cryptocurrencies-from-your-Kraken-account\" target=\"_blank\" rel=\"noreferrer noopener\">withdraw from your Kraken account<\/a> directly to your Kraken Wallet.<br><\/li>\n\n\n\n<li><strong>Next, use the navigation bar to select the Explore page<\/strong>\n<ul class=\"wp-block-list\">\n<li>At the bottom of the screen, press the middle button on the navigation bar that looks like a compass. This will take you to the Explore page.<br><\/li>\n<\/ul>\n<\/li>\n\n\n\n<li><strong>Choose the right dApp&nbsp;<\/strong>\n<ul class=\"wp-block-list\">\n<li>Either select one from our provided lists or type the name of the specific dApp that you are looking for in the search bar at the top.<br><\/li>\n<\/ul>\n<\/li>\n\n\n\n<li><strong>Using the in-app browser to connect to and interact with dApps<\/strong>\n<ul class=\"wp-block-list\">\n<li>Connect your wallet to the selected dApp by finding the&nbsp;Connect button, wallet logo or Sign In button.&nbsp;<\/li>\n\n\n\n<li>You will be presented with that dApp\u2019s preferred connection method. You can connect by looking for the Kraken Wallet icon. If you do not see the Kraken Wallet icon, you can connect with either the Mobile Wallet button or <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/connect-to-dapps-using-walletconnect\" target=\"_blank\" rel=\"noreferrer noopener\">by using WalletConnect<\/a>.\n<ul class=\"wp-block-list\">\n<li>(Note: Each dApp is different, so the ways of connecting to a specific dApp can vary based on what the dApp supports)<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-join-us-and-explore-today\"><strong>Join us and Explore today<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The Explore page and in-app browser are just the beginning of driving new, seamless and secure ways for Kraken Wallet users to make the most of their onchain journey. Over the coming months, we will continue to enhance both features, adding more robust tooling for better dApp connectivity and interoperability, as well as more personalized ways of discovering opportunities.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We could not be more excited for you to explore this new chapter with us. Dive into the Explore page today and let us know what you think, as we are always looking for more ways to improve your experience.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Ready to Explore? <\/strong><a href=\"https:\/\/www.kraken.com\/wallet\" target=\"_blank\" rel=\"noreferrer noopener\">Download Kraken Wallet<\/a> today or update your app in the app store and get started unlocking the full potential of onchain.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/wallet\" target=\"_blank\" rel=\"noopener\">Download Kraken Wallet<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are regulated and others are unregulated; regardless, Kraken may or may not be required to be registered or otherwise authorised to provide specific products and services in each market, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply. See Legal Disclosures for each jurisdiction <\/em><a href=\"https:\/\/www.kraken.com\/legal\/disclosures\"><em>here<\/em><\/a><em>.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p><i>The Explore page is a gateway to discovering decentralized apps (dApps) and DeFi opportunities all in one place.<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":24943,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1426],"tags":[1373,1403,1828],"language":[],"cl