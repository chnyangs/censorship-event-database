blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/05fd1aef04d178f2231400ddb85550a2","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/danielpintokraken"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-4Nw","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/1536x700-blog-1.png?fit=1536%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18446","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=18446"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18446\/revisions"}],"predecessor-version":[{"id":20949,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18446\/revisions\/20949"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/18447"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=18446"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=18446"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=18446"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=18446"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":18523,"date":"2023-04-27T14:00:56","date_gmt":"2023-04-27T18:00:56","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=18523"},"modified":"2023-06-02T11:46:40","modified_gmt":"2023-06-02T15:46:40","slug":"its-official-dave-ripley-takes-the-helm-as-krakens-new-ceo","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/its-official-dave-ripley-takes-the-helm-as-krakens-new-ceo","title":{"rendered":"It\u2019s official: Dave Ripley takes the helm as Kraken\u2019s new CEO"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019ve come a long way since Kraken <\/span><a href=\"https:\/\/www.kraken.com\/press\/releases\/kraken-announces-leadership-succession-plan\"><span style=\"font-weight: 400;\">announced its leadership succession plan<\/span><\/a><span style=\"font-weight: 400;\"> last September. This week Dave Ripley will officially start as Kraken\u2019s CEO, while outgoing CEO and co-founder Jesse Powell will move into his new role as Chairman of the Board.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Over the last few months, the leadership team at Kraken has done a lot of work to ensure a smooth transition. We successfully navigated a number of industry challenges, launched several new products, and further strengthened our executive bench. We did this to ensure Kraken is in a strong position for the next phase of growth under Dave\u2019s leadership.\u00a0<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">To ensure the right operational leadership and capabilities we hired key senior executives including <\/span><a href=\"https:\/\/blog.kraken.com\/post\/17199\/krakens-new-managing-director-for-north-america-guy-hirsch-talks-about-his-crypto-journey\/\"><span style=\"font-weight: 400;\">Guy Hirsch, Managing Director for North America<\/span><\/a><span style=\"font-weight: 400;\">, and <\/span><a href=\"https:\/\/blog.kraken.com\/post\/17384\/kraken-appoints-cj-rinaldi-as-chief-compliance-officer\/\"><span style=\"font-weight: 400;\">Chief Compliance Officer CJ Rinaldi<\/span><\/a><span style=\"font-weight: 400;\">, in addition to the appointment of <\/span><a href=\"https:\/\/blog.kraken.com\/post\/17379\/kraken-appoints-dan-ciporin-to-board-of-directors\/\"><span style=\"font-weight: 400;\">Dan Ciporin<\/span><\/a><span style=\"font-weight: 400;\"> to its board of directors and several internal promotions.\u00a0<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">While continuously improving our current product suite to meet client needs, we launched <\/span><a href=\"https:\/\/www.kraken.com\/nft\"><span style=\"font-weight: 400;\">Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\"> marketplace, <\/span><a href=\"https:\/\/pro.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> trading interface, and our <\/span><a href=\"http:\/\/www.kraken.com\"><span style=\"font-weight: 400;\">consumer web <\/span><\/a><span style=\"font-weight: 400;\">user experience.<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">As part of our international growth plans, Kraken recently obtained a VASP registration in <\/span><a href=\"https:\/\/blog.kraken.com\/post\/18446\/kraken-secures-virtual-asset-service-provider-vasp-registration-in-ireland\/\"><span style=\"font-weight: 400;\">Ireland<\/span><\/a><span style=\"font-weight: 400;\"> and filed a pre-registration undertaking in <\/span><a href=\"https:\/\/blog.kraken.com\/post\/18260\/kraken-remains-committed-to-canada\/\"><span style=\"font-weight: 400;\">Canada<\/span><\/a><span style=\"font-weight: 400;\"> as we are working toward registration as a \u201cRestricted Dealer\u201d.<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">We\u2019re also <\/span><a href=\"https:\/\/www.kraken.com\/williamsracing\"><span style=\"font-weight: 400;\">collaborating with Williams Racing<\/span><\/a><span style=\"font-weight: 400;\"> to bring the Kraken brand to hundreds of millions of race fans around the world.\u00a0<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">We have a lot more exciting stuff coming up and we\u2019re looking forward to sharing more in the weeks and months to come.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">&#8220;Dave has been an incredibly valued colleague and thought partner for years. There&#8217;s no other leader in this industry with the crypto conviction, experience and character that Dave brings,&#8221; said Jesse. &#8220;As a founder himself, he has an unparalleled and deep understanding of our business, our clients, and Kraken\u2019s opportunities ahead.&#8221;<\/span><\/p>\n<p><span style=\"font-weight: 400;\">After a period of unprecedented growth, 2022 was a tumultuous year for crypto. During the transition period, Kraken has brought its organization in line with current demand to effectively grow market share and scale its business globally.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">&#8220;Jesse&#8217;s leadership over the past 12 years has been instrumental in making Kraken the mission-driven powerhouse it is today,&#8221; said Dave. \u201cAs we move forward, the challenges and opportunities will continue to change, but Kraken&#8217;s mission and values will remain deeply ingrained in its DNA. We stay committed to driving crypto adoption and unlocking its full potential while keeping our clients at the forefront of everything we do.&#8221;<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/join-kraken\/\" target=\"_blank\" rel=\"noopener\">Join us at Kraken<\/a><\/div>\n<div><\/div>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019ve come a long way since Kraken announced its leadership succession plan last September. This week Dave Ripley will officially start as Kraken\u2019s CEO, while outgoing CEO and co-founder Jesse Powell will move into his new role as Chairman of the Board.\u00a0 Over the last few months, the leadership team at Kraken has done a [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":18532,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1769,1715],"language":[],"class_list":["post-18523","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-dave-ripley","tag-news"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>It\u2019s official: Dave Ripley takes the helm as Kraken\u2019s new CEO - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"htt