sers\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=18486"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18486\/revisions"}],"predecessor-version":[{"id":23176,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18486\/revisions\/23176"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/18513"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=18486"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=18486"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=18486"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=18486"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22172,"date":"2023-05-03T12:19:52","date_gmt":"2023-05-03T16:19:52","guid":{"rendered":"https:\/\/blog.kraken.com\/trading-for-sui-sui-starts-now"},"modified":"2023-06-12T12:04:39","modified_gmt":"2023-06-12T16:04:39","slug":"trading-for-sui-sui-starts-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/trading-for-sui-sui-starts-now","title":{"rendered":"Trading for Sui (SUI) starts now!"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that <\/span><b>Sui (SUI)<\/b><span style=\"font-weight: 400;\"> is now available on Kraken!<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">SUI funding and trading are live<\/span><span style=\"font-weight: 400;\">.<\/span> <span style=\"font-weight: 400;\">A<\/span><span style=\"font-weight: 400;\">dd SUI to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n<p><b><i>Already have SUI and a Kraken account? Click below to get started \u2935\ufe0f<\/i><\/b><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/sui-funding\/\" target=\"_blank\" rel=\"noopener\">Deposit now<\/a><\/div>\n<div>\n<p><span style=\"font-weight: 400;\">SUI is tradeable via Spot and Perpetual Future markets on <\/span><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/pro.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> with the following parameters:<\/span><b><\/b><\/p>\n<h3><span style=\"font-weight: 400;\">Spot market<\/span><b><\/b><\/h3>\n<table>\n<tbody>\n<tr>\n<td><b>Asset<\/b><\/td>\n<td><b>Pair<\/b><\/td>\n<td><b>Price decimal precision<\/b><\/td>\n<td><b>Minimum order size<\/b><\/td>\n<td><b>Minimum deposit<\/b><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">SUI<\/span><\/td>\n<td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td>\n<td><span style=\"font-weight: 400;\">3<\/span><\/td>\n<td><span style=\"font-weight: 400;\">5<\/span><\/td>\n<td><span style=\"font-weight: 400;\">0.5<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h3><span style=\"font-weight: 400;\">Perpetual future\u00a0<\/span><b><\/b><\/h3>\n<table>\n<tbody>\n<tr>\n<td><b>Symbol<\/b><\/td>\n<td><b>Base currency<\/b><\/td>\n<td><b>Min order<\/b><\/td>\n<td><b>Tick size<\/b><\/td>\n<td><b>Max position (Base units)<\/b><\/td>\n<td><b>Impact mid<\/b><\/td>\n<td><b>Margin class<\/b><\/td>\n<td><b>First trading<\/b><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">PF_SUIUSD<\/span><\/td>\n<td><span style=\"font-weight: 400;\">Sui (SUI)<\/span><\/td>\n<td><span style=\"font-weight: 400;\">1<\/span><\/td>\n<td><span style=\"font-weight: 400;\">0.0001<\/span><\/td>\n<td><span style=\"font-weight: 400;\">1,500,000<\/span><\/td>\n<td><span style=\"font-weight: 400;\">60 SUI<\/span><\/td>\n<td><span style=\"font-weight: 400;\">Class D<\/span><\/td>\n<td><span style=\"font-weight: 400;\">May 3 2023<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><b>Note:\u00a0\u00a0<\/b><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/b><i><span style=\"font-weight: 400;\"> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/span><\/i><\/li>\n<li aria-level=\"1\">Trading for SUI is not available in the United States or Canada at this time.<\/li>\n<\/ul>\n<h3><span style=\"font-weight: 400;\">Here\u2019s what you need to know about Sui:<\/span><\/h3>\n<p><span style=\"font-weight: 400;\"><strong>Sui<\/strong> is a scalable, low-latency smart contract platform powered by a permissionless set of validators. Sui allows transactions to be processed in parallel thanks to its unique data model and approach to consensus. The SUI token allows network users to pay gas fees, while also helping to ensure smooth transaction execution and reliable storage of operations on the network.<\/span><\/p>\n<p><b><i>Ready to trade but don&#8217;t have a Kraken account yet? <\/i><\/b><a href=\"https:\/\/www.kraken.com\/sign-up\"><b><i>Sign up today<\/i><\/b><\/a><b><i>! <\/i><\/b><\/p>\n<\/div>\n<div><\/div>\n<div>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/sui-sign-up\/\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n<h3><\/h3>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\"><span style=\"font-weight: 400;\">here<\/span><\/a><span style=\"font-weight: 400;\">, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p><a href=\"https:\/\/blog.kraken.com\/go\/sui-referral\/\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15784\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1200%2C250&amp;ssl=1\" data-orig-size=\"1200,250\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"subhead_reflink (1)\" data-image-description=\"\" data-image-caption=\"&lt;p&gt;Referral cta image&lt;\/p&gt;\n\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1024%2C213&amp;ssl=1\" class=\"size-full wp-image-15784\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1200%2C250&#038;ssl=1\" alt=\"Referral link image\" width=\"1200\" height=\"250\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?w=1200&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=300%2C63&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1024%2C213&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=768%2C160&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=200%2C42&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/a><\/p>\n<p><i><span style=\"font-weight: 400;\">Trading futures, derivatives and other instruments using leverage involves an element of risk and may not be suitable for everyone. Read Kraken Derivatives\u2019 risk disclosure to learn more.<\/span><\/i><\/p>\n<\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Sui (SUI) is now available on Kraken! Funding and trading SUI funding and trading are live. Add SUI to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.\u00a0 Already have SUI and a Kraken account? Click below to get started \u2935\ufe0f Deposit now SUI is tradeable [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":22170,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1797],"language":[],"class_list":["post-22172","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-sui"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for Sui (SUI) starts now! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/trading-for-sui-sui-starts-now\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Trading for Sui (SUI) starts now!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that Sui (SUI) is now available on Kraken! Funding and trading SUI funding and trading are live. Add SUI to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.\u00a0 Already have SUI and a Kraken account? Click below to get started \u2935\ufe0f Deposit now SUI is tradeable [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/trading-for-sui-sui-starts-now\" \/>\n<me