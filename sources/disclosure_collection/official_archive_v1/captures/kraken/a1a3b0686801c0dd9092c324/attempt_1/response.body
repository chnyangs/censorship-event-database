.kraken.com\/wp-json\/wp\/v2\/categories?post=22180"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=22180"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=22180"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22173,"date":"2023-05-19T15:57:36","date_gmt":"2023-05-19T19:57:36","guid":{"rendered":"https:\/\/blog.kraken.com\/degods-owls-nakamigos-and-otherside-vessels-added-to-kraken-nft"},"modified":"2023-06-02T11:51:16","modified_gmt":"2023-06-02T15:51:16","slug":"degods-owls-nakamigos-and-otherside-vessels-added-to-kraken-nft","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/nft\/degods-owls-nakamigos-and-otherside-vessels-added-to-kraken-nft","title":{"rendered":"DeGods, Owls, Nakamigos, and Otherside Vessels added to Kraken NFT"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that we have added <\/span><b>five<\/b><b> new NFT collections<\/b><span style=\"font-weight: 400;\"> to <\/span><a href=\"https:\/\/www.kraken.com\/nft\"><span style=\"font-weight: 400;\">Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\"> for our clients to explore, collect and trade.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">After revealing <\/span><a href=\"https:\/\/blog.kraken.com\/nft\/\"><span style=\"font-weight: 400;\">dozens of NFT collections over the past few weeks<\/span><\/a><span style=\"font-weight: 400;\">, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\"><span style=\"font-weight: 400;\">gas fees<\/span><\/a><span style=\"font-weight: 400;\">.*\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We will continue to add a wide range of new NFT collections every week \u2014 from the hottest profile picture communities to the latest gaming experiences \u2014 across the <\/span><a href=\"https:\/\/www.kraken.com\/prices\/ethereum\"><span style=\"font-weight: 400;\">Ethereum<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/www.kraken.com\/prices\/solana\"><span style=\"font-weight: 400;\">Solana<\/span><\/a><span style=\"font-weight: 400;\"> blockchains.\u00a0<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Here are the new collections launching on Kraken NFT today:<\/span><\/h3>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Owls<\/b><span style=\"font-weight: 400;\"> \u2014 Created by REI-N, Owls is a randomly generated NFT collection consisting of more than 90,000,0000 trait combinations<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Nakamigos<\/b><span style=\"font-weight: 400;\"> \u2014 Inspired by Bitcoin creator Satoshi Nakamoto, Nakamigos is a pixelated profile picture NFT collection created by HiFo Labs<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Otherside Vessels<\/b><span style=\"font-weight: 400;\"> \u2014 As part of the Yuga Labs ecosystem, Otherside Vessels consist of Shade, which will hatch into a Mara; depending on its type (Enchanter, Farmer, or Hunter) it will provide service to the Otherdeed on which it is living<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>DeGods (ETH)<\/b><span style=\"font-weight: 400;\"> \u2014\u00a0 Centering around stone busts of emblematic figures, DeGods is a digital art collection and global community of creators, developers, entrepreneurs, athletes, artists, experimenters and innovators<\/span><\/li>\n<li aria-level=\"1\"><b>Iron Paw Gang<\/b><span style=\"font-weight: 400;\"> \u2014 As a narrative driven project building on the walk-cycle genre, Iron Paw Gang is introducing swap-able driver PFPs and generative soundscapes uniquely tailored to each animation<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Check out these collections on Kraken NFT.<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/nft-listing-may-18\/\" target=\"_blank\" rel=\"noopener\">Get started<\/a><\/div>\n<h3><span style=\"font-weight: 400;\">Your opinion matters<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Your opinion will help shape Kraken NFT as we take it to the global market. Please check out our Support Center for any FAQs about <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\"><span style=\"font-weight: 400;\">using the marketplace<\/span><\/a><span style=\"font-weight: 400;\">, or contact <\/span><a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\"><span style=\"font-weight: 400;\">Kraken Support<\/span><\/a><span style=\"font-weight: 400;\"> for 24\/7 assistance.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you\u2019re new to the world of NFTs, you can check out our <\/span><a href=\"https:\/\/www.kraken.com\/learn\"><span style=\"font-weight: 400;\">Kraken Learn Center<\/span><\/a><span style=\"font-weight: 400;\"> article, <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\"><span style=\"font-weight: 400;\">What is an NFT?<\/span><\/a><span style=\"font-weight: 400;\"> to discover what all the excitement is about.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">In addition to these latest NFT collections that have just been added, you can also browse the full list of <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">all 200+ NFT collections available for you to explore, collect and trade on Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Follow the <\/span><a href=\"https:\/\/blog.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\"> and our <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">@KrakenNFT social account<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know when we add new features and NFT collections.<\/span><\/p>\n<h3><b>Follow our Kraken NFT Twitter!<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">That\u2019s right, we launched a new Twitter account for all things NFTs! Follow us on Twitter at <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">KrakenNFT<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know about all of the exciting things happening on Kraken NFT.<\/span><\/p>\n<h3><b>Will Kraken make more NFTs available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken can be found on <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">our website<\/span><\/a><span style=\"font-weight: 400;\">, and all future NFTs will be announced on <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">Kraken NFT\u2019s Twitter<\/span><\/a><span style=\"font-weight: 400;\">. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Specific asset availability and liquidity are not guaranteed.<\/span> <span style=\"font-weight: 400;\">When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/span><\/p>\n<p><i><span style=\"font-weight: 400;\">*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform. <\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that we have added five new NFT collections to Kraken NFT for our clients to explore, collect and trade.\u00a0 After revealing dozens of NFT collections over the past few weeks, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":22206,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460],"tags":[1459,1421],"language":[],"class_list":["post-22173","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-nft","tag-kraken-nft","tag-nft"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>DeGods, Owls, Nakamigos, and Otherside Vessels added to Kraken NFT - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/nft\/degods-owls-nakamigos-and-otherside-vessels-added-to-kraken-nft\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"DeGods, Owls, Nakamigos, and Otherside Vessels added to Kraken NFT\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that we have added five new NFT collections to Kraken NFT for our clients to explore, collect and trade.\u00a0 After revealing dozens of NFT collections over the past few weeks, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/nft\/degods-owls-nakamigos-and-otherside-vessels-added-to-kraken-nft\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-05-19T19:57:36+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-06-02T15:51:16+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/NFT_Listing_May10_BlogInner.webp?fit=1460%2C665&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"1460\" \/>\n\t<meta property=\"og:image:height\" content=\"665\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/webp\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"3 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/nft\\\/degods-owls-nakamigos-and-otherside-vesse