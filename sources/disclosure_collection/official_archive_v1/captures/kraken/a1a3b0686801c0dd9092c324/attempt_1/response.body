kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-5LD","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/NFT_Listing_May10_BlogInner.webp?fit=1460%2C665&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22173","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=22173"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22173\/revisions"}],"predecessor-version":[{"id":22218,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/22173\/revisions\/22218"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/22206"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=22173"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=22173"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=22173"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=22173"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":22181,"date":"2023-05-22T13:41:20","date_gmt":"2023-05-22T17:41:20","guid":{"rendered":"https:\/\/blog.kraken.com\/bitcoin-pizza-day-a-celebration-of-decentralization"},"modified":"2023-06-02T11:41:58","modified_gmt":"2023-06-02T15:41:58","slug":"bitcoin-pizza-day-a-celebration-of-decentralization","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/crypto-education\/bitcoin-pizza-day-a-celebration-of-decentralization","title":{"rendered":"Bitcoin Pizza Day \u2014 A celebration of decentralization"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">Pizza parties rarely need an explanation. But pizza parties on Bitcoin Pizza Day deserve one.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Thirteen years ago today, Laszlo Hanyecz created a thread in the bitcointalk.org forum titled <\/span><a href=\"https:\/\/bitcointalk.org\/index.php?topic=137.0\"><span style=\"font-weight: 400;\">Pizza for bitcoins?<\/span><\/a><span style=\"font-weight: 400;\"> After some explanation and much discussion, Hanyecz found someone willing to buy him two pizzas (valued at ~$41) in exchange for his 10,000 bitcoin.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">At <\/span><a href=\"https:\/\/www.kraken.com\/prices\/bitcoin\"><span style=\"font-weight: 400;\">bitcoin\u2019s price<\/span><\/a><span style=\"font-weight: 400;\"> today, those pizzas are worth ~$270,000,000.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Many look back on Bitcoin Pizza Day as a cautionary tale that demonstrates why people <\/span><a href=\"https:\/\/www.kraken.com\/learn\/hodl\"><span style=\"font-weight: 400;\">HODL<\/span><\/a><span style=\"font-weight: 400;\"> crypto for the long term. Yet, many others look to the future on this day while considering the unrealized potential of Bitcoin and the power of decentralization.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Ultimately, Bitcoin Pizza Day has become a celebration of Bitcoin&#8217;s viability as a complete \u201cpeer-to-peer electronic cash system\u201d \u2014 just as Satoshi envisioned in the <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-bitcoin-white-paper\"><span style=\"font-weight: 400;\">Bitcoin white paper<\/span><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Money (including cash) is generally defined as:<\/span><\/p>\n<ol>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">A medium of exchange<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">A unit of account<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">A store of value<\/span><\/li>\n<\/ol>\n<p><span style=\"font-weight: 400;\">On this day more than a decade ago, the world saw that Bitcoin could be used as a medium of exchange. After all, Hanyecz was able to use Bitcoin while transacting with another individual \u2014 without any intermediary&#8217;s participation.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Yet, as time has gone on, Bitcoin Pizza Day has also become a reminder of the progress Bitcoin has made in the other two functions of money as well.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">As individuals continue to exchange Bitcoin for goods and services \u2014 just as Hanyecz did years ago \u2014 Bitcoin\u2019s viability as a global unit of account and independent store of value has also emerged. Days like today are a reminder that first proving its effectiveness as a medium of exchange is what has ultimately allowed Bitcoin to prove its legitimacy as a globally recognized unit of account and self-sovereign store of value as well.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Bitcoin Pizza Day is a celebration of <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-cryptocurrency\"><span style=\"font-weight: 400;\">cryptocurrency<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-is-blockchain-technology\"><span style=\"font-weight: 400;\">blockchain technology<\/span><\/a><span style=\"font-weight: 400;\">\u2019s effectiveness in decentralizing information. It is also a celebration of Bitcoin\u2019s reliability as a sound form of money.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">For many others, Bitcoin Pizza Day is a celebration of <\/span><a href=\"https:\/\/www.kraken.com\/culture\"><span style=\"font-weight: 400;\">the crypto values Kraken embodies<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/www.kraken.com\/why-kraken\"><span style=\"font-weight: 400;\">the mission we deliver on each day<\/span><\/a><span style=\"font-weight: 400;\">. It is a celebration of the freedom that Bitcoin brings back to individuals\u2019 ability to connect and transact.<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/bitcoin-pizza-day-sign-up\/\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n<h2><span style=\"font-weight: 400;\">Celebrate Bitcoin Pizza Day with Kraken<\/span><\/h2>\n<p><span style=\"font-weight: 400;\">Kraken makes it easy to share the gift of financial freedom on Bitcoin Pizza Day.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Invite your friends to Kraken and you\u2019ll each get $10 in BTC through our <\/span><a href=\"https:\/\/www.kraken.com\/referrals\"><span style=\"font-weight: 400;\">referral program<\/span><\/a><span style=\"font-weight: 400;\">.*<\/span><\/p>\n<p><span style=\"font-weight: 400;\">You can also use Kraken to send Bitcoin around the world in seconds using our <\/span><a href=\"https:\/\/www.kraken.com\/learn\/lightning-network\"><span style=\"font-weight: 400;\">Lightning Network<\/span><\/a><span style=\"font-weight: 400;\"> integration. Lightning Network is a highly secure and cost-effective way to send Bitcoin to anyone \u2014 with almost no fees.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Have a Happy Bitcoin Pizza Day and count on Kraken while sharing the gift of Bitcoin today!<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/bitcoin-pizza-day-sign-up\/\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<p><i><span style=\"font-weight: 400;\">*Geographic restrictions apply<\/span><\/i><\/p>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>Pizza parties rarely need an explanation. But pizza parties on Bitcoin Pizza Day deserve one.\u00a0 Thirteen years ago today, Laszlo Hanyecz created a thread in the bitcointalk.org forum titled Pizza for bitcoins? After some explanation and much discussion, Hanyecz found someone willing to buy him two pizzas (valued at ~$41) in exchange for his 10,000 [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":22207,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1391,1774],"tags":[1365],"language":[],"class_list":["post-22181","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-crypto-education","category-news","tag-btc"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Bitcoin Pizza Day \u2014 A celebration of decentralization - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/crypto-education\/bitcoin-pizza-day-a-celebration-of-decentralization\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Bitcoin Pizza Day \u2014 A celebration of decentralization\" \/>\n<meta property=\"og:description\" content=\"Pizza parties rarely need an explanation. But pizza parties on Bitcoin Pizza Day deserve one.\u00a0 Thirteen years ago today, Laszlo Hanyecz created a thread in the bitcointalk.org forum titled Pizza for bitcoins? After some explanation and much discussion, Hanyecz found someone willing to buy him two pizzas (valued at ~$41) in exchange for his 10,000 [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/crypto-education\/bitcoin-pizza-day-a-celebration-of-decentralization\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-05-22T17:41:20+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-06-02T15:41:58+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/PIZZA-FD2.webp?fit=730%2C333&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"730\" \/>\n\t<meta property=\"og:image:height\" content=\"333\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/webp\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"2 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization\"},\"author\":{\"name\":\"krakenfx\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\"},\"headline\":\"Bitcoin Pizza Day \u2014 A celebration of decentralization\",\"datePublished\":\"2023-05-22T17:41:20+00:00\",\"dateModified\":\"2023-06-02T15:41:58+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization\"},\"wordCount\":475,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/05\\\/PIZZA-FD2.webp?fit=730%2C333&ssl=1\",\"keywords\":[\"BTC\"],\"articleSection\":[\"Crypto Education\",\"News\"],\"inLanguage\":\"en-US\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization\",\"name\":\"Bitcoin Pizza Day \u2014 A celebration of decentralization - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/crypto-education\\\/bitcoin-pizza-day-a-celebration-of-decentralization#primaryimage\"},\"i