3\/04\/Payward_LosCabos-March-21-2023-107-1.jpg?fit=5472%2C3648&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18523","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=18523"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18523\/revisions"}],"predecessor-version":[{"id":20948,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/18523\/revisions\/20948"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/18532"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=18523"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=18523"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=18523"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=18523"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":18487,"date":"2023-04-27T17:20:40","date_gmt":"2023-04-27T21:20:40","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=18487"},"modified":"2023-06-07T09:49:14","modified_gmt":"2023-06-07T13:49:14","slug":"trading-for-euro-tether-eurt-starts-may-2-deposit-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/trading-for-euro-tether-eurt-starts-may-2-deposit-now","title":{"rendered":"Trading for Euro Tether (EURT) starts May 2 \u2013 deposit now!"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that <\/span><b>Tether EURt (EURT)<\/b><span style=\"font-weight: 400;\"> is now available on Kraken!<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Funding is live, and trading will begin on<\/span><span style=\"font-weight: 400;\"> May 2 at approximately 14H30 UTC.<\/span> <span style=\"font-weight: 400;\">A<\/span><span style=\"font-weight: 400;\">dd EURT to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n<p><b>Note: <\/b><span style=\"font-weight: 400;\">Only deposit EURT on Kraken using the <\/span><b>Ethereum network. <\/b><span style=\"font-weight: 400;\">Deposits of EURT using any other network <\/span><b>will be lost.\u00a0<\/b><\/p>\n<p><b><i>Already have EURT and a Kraken account? Click below to get started \u2935\ufe0f<\/i><\/b><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div><\/div>\n<p><span style=\"font-weight: 400;\">EURT is tradeable on <\/span><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\"> and <\/span><a href=\"https:\/\/pro.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> with the following parameters:<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Asset<\/b><\/td>\n<td><b>Pair<\/b><\/td>\n<td><b>Price decimal precision<\/b><\/td>\n<td><b>Minimum order size<\/b><\/td>\n<td><b>Minimum deposit<\/b><\/td>\n<\/tr>\n<tr>\n<td><span style=\"font-weight: 400;\">EURT<\/span><\/td>\n<td><span style=\"font-weight: 400;\">USD, EUR and USDT<\/span><\/td>\n<td><span style=\"font-weight: 400;\">4<\/span><\/td>\n<td><span style=\"font-weight: 400;\">5<\/span><\/td>\n<td><span style=\"font-weight: 400;\">5<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><b>Note:\u00a0\u00a0<\/b><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/b><i><span style=\"font-weight: 400;\"> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/span><\/i><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the token:<\/span><\/p>\n<p><a href=\"https:\/\/www.kraken.com\/prices\/tether-euro\"><b>Tether EURt (EURT)<\/b><\/a> <span style=\"font-weight: 400;\">is a stablecoin pegged 1-to-1 with the EUR and is issued by the same company that operates Tether USD (USDT). EURT mirrors the price of the Euro by holding collateral reserves equal to the amount of EURT in circulation. EURT is used to avoid market volatility, transact in a peer-to-peer way, as well as to trade for crypto and NFTs across various exchanges and blockchain-based platforms.\u00a0<\/span><\/p>\n<p><b><i>Ready to deposit but don&#8217;t have a Kraken account yet? <\/i><\/b><a href=\"https:\/\/www.kraken.com\/sign-up\"><b><i>Sign up today<\/i><\/b><\/a><b><i>!\u00a0<\/i><\/b><\/p>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\"><span style=\"font-weight: 400;\">here<\/span><\/a><span style=\"font-weight: 400;\">, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p><a href=\"https:\/\/www.kraken.com\/referrals\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"18551\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1-3\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?fit=1200%2C250&amp;ssl=1\" data-orig-size=\"1200,250\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"subhead_reflink-1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?fit=1024%2C213&amp;ssl=1\" class=\"alignnone size-full wp-image-18551\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?resize=1200%2C250&#038;ssl=1\" alt=\"\" width=\"1200\" height=\"250\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?w=1200&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?resize=300%2C63&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?resize=1024%2C213&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?resize=768%2C160&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/04\/subhead_reflink-1-1.webp?resize=200%2C42&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/a><\/p>\n<p><i><span style=\"font-weight: 400;\">These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/span><\/i><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div><\/div>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Tether EURt (EURT) is now available on Kraken! Funding and trading Funding is live, and trading will begin on May 2 at approximately 14H30 UTC. Add EURT to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.\u00a0 Note: Only deposit EURT on Kraken using the Ethereum [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":18548,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1770,1771],"language":[],"class_list":["post-18487","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-eurt","tag-general"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for Euro Tether (EURT) starts May 2 \u2013 deposit now! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/trading-for-euro-tether-eurt-starts-may-2-deposit-now\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Trading for Euro Tether (EURT) starts May 2 \u2013 deposit now!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that Tether EURt (EURT) is now available on Kraken! Funding and trading Funding is live, and trading will begin on May 2 at approximately 14H30 UTC. Add EURT to your Kraken account by navigating to Funding, selecting the asset