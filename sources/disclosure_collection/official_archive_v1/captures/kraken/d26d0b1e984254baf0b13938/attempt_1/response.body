"position":2,"name":"Self-custody best practices"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21","name":"krakenfx","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-4gQ","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/11\/Carousel-Self-custody-best-practices.png?fit=2946%2C1472&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/16420","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=16420"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/16420\/revisions"}],"predecessor-version":[{"id":21164,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/16420\/revisions\/21164"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/16425"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=16420"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=16420"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=16420"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=16420"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":16319,"date":"2022-11-30T15:16:34","date_gmt":"2022-11-30T15:16:34","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=16319"},"modified":"2023-05-05T10:22:46","modified_gmt":"2023-05-05T14:22:46","slug":"new-nft-collections-added-to-kraken-nft","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/nft\/new-nft-collections-added-to-kraken-nft","title":{"rendered":"New NFT Collections added to Kraken NFT"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that we have added <\/span><b>ten new NFT collections<\/b><span style=\"font-weight: 400;\"> to Kraken NFT for our current beta testers to explore, collect and trade. After revealing <\/span><a href=\"https:\/\/blog.kraken.com\/post\/14252\/70-nft-collections-for-kraken-nft-beta-testers\"><span style=\"font-weight: 400;\">the first 70 collections<\/span><\/a><span style=\"font-weight: 400;\"> earlier this year, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas fees.*\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We will continue to add a wide range of new NFT collections every week \u2014 from the hottest profile picture communities to latest gaming experiences \u2014 across the Ethereum and Solana blockchains.<\/span><\/p>\n<h2><span style=\"font-weight: 400;\">Here is everything you need to know about the new collections launching on Kraken NFT this week:<\/span><\/h2>\n<p><b>Anthony Hopkins &#8211; The Eternal<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Anthony Hopkins &#8211; The Eternal is a collection of 1,000 NFTs depicting the two time Oscar winning actor, Sir Anthony Hopkins. Each 3D NFT portrays the distinguished actor as a character archetype such as the jester, lover, rebel or hero. Randomly selected NFTs within the collection entitle their holders to redeemable fan merchandise and a chance to meet Sir Anthony Hopkins himself.<\/span><\/p>\n<p><b>Azuki<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Azuki is a collection of 10,000 hand-drawn NFT avatars ready for the metaverse. The collection\u2019s anime-styled characters act as the NFT owner\u2019s identity within a virtual world. Holders of Azuki NFTs are entitled to exclusive experiences within the metaverse and are granted membership access to The Garden \u2014 an online space for creators and community members.<\/span><\/p>\n<p><b>BEANZ Official<\/b><\/p>\n<p><span style=\"font-weight: 400;\">BEANZ is an official companion collection which accompanies Azuki NFT avatars in the metaverse. BEANZ act as sidekicks to Azuki NFTs and come with a unique set of varying attributes and attitudes that help define their personalities. While all BEANZ are driven by a desire to help, some may be more helpful than others.<\/span><\/p>\n<p><b>Castaways &#8211; The Islands<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Castaways &#8211; The Islands is a collection of 500 NFTs created for the Castaways sandbox game. Players of the game drift to sea on NFT-based rafts in search of land they can use to build a new civilization. The Islands are digital representations of land found within the game and can be used strategically to provide owners the resources needed for survival.\u00a0<\/span><\/p>\n<p><b>CryptoDickbutts<\/b><\/p>\n<p><span style=\"font-weight: 400;\">CryptoDickbutts is a collection of 5,200 adult-themed NFTs minted on the Ethereum blockchain. The collection depicts a series of pixelated creatures with pronounced rear ends and unique, protruding accessories. Owners of the generative NFTs are granted full rights to use the included artwork as they see fit \u2014 <\/span><span style=\"font-weight: 400;\">provided they hide it from their kids.<\/span><\/p>\n<p><b>DigiDaigaku Genesis<\/b><\/p>\n<p><span style=\"font-weight: 400;\">DigiDaigaku is an NFT collection of 2,022 original characters created by Limit Break \u2014 a blockchain-based game development company. The limited collection of girlish anime profiles are each generated from 13 different traits which include backgrounds, hairstyles, expressions and accessories. The world these girls live in has yet to be discovered but details are expected to be revealed in time.\u00a0<\/span><\/p>\n<p><b>Murakami.Flowers Official<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Murakiami.Flowers is a fragrant NFT collection which showcases 11,664 floral artworks by artist Takashi Murakami. Each flower in the collection is crafted using dot art \u2014 a technique similar to that used by Japanese TV games in the 1970s \u2014 and is developed with special attention to the number 108 which represents the number of earthly temptations in the Buddhist religion. Verified owners of Murakami.Flowers may be entitled to occasional benefits including additional content and physical items offered by authorized third parties.<\/span><\/p>\n<p><b>QQL Mint Pass<\/b><\/p>\n<p><span style=\"font-weight: 400;\">QQL Mint Pass is a collection of licenses which allow holders to generate an official NFT from the project. Owner\u2019s of a QQL Mint Pass can interact with the project\u2019s website in order to create a unique digital artwork based on their individual tastes. By playing a role in the output of the NFT, owners share in the creative process thereby turning collectors into curators of the platform\u2019s generative art.<\/span><\/p>\n<p><b>RENGA<\/b><\/p>\n<p><span style=\"font-weight: 400;\">RENGA is a collection of 10,000 NFTs handcrafted by digital artist, DirtyRobot. The collection is inspired by a Japanese poetry style of the same name where writers alternate their contributions between stanzas. In keeping with the tradition of the genre, the stories behind each character within the RENGA collection are told by the owners of the NFTs and shared within the community.\u00a0<\/span><\/p>\n<p><b>VeeFriends Series 2<\/b><\/p>\n<p><span style=\"font-weight: 400;\">VeeFriends Series 2 is the natural evolution to the original NFT trading card game of the same name. The upgraded collection now features 55,555 original NFTs which depict 251 characters from the game in unique poses and with varying qualities. VeeFriends Series 2 NFTs offer their holders exclusive access to redeem a box of 52 physical trading cards issued by the project team.<\/span><\/p>\n<h2><span style=\"font-weight: 400;\">Your opinion matters<\/span><\/h2>\n<p><span style=\"font-weight: 400;\">Beta testers\u2019 opinions will help shape Kraken NFT before we take it to the global market. Please check out our Support Center for any FAQs about <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\"><span style=\"font-weight: 400;\">using the marketplace<\/span><\/a><span style=\"font-weight: 400;\">, or contact <\/span><a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\"><span style=\"font-weight: 400;\">Kraken Support<\/span><\/a><span style=\"font-weight: 400;\"> for 24\/7 assistance.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you\u2019re new to the world of NFTs, you can visit our <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\"><span style=\"font-weight: 400;\">Learn Center<\/span><\/a><span style=\"font-weight: 400;\"> to discover what all the excitement is about.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">You can also <\/span><a href=\"https:\/\/blog.kraken.com\/post\/14252\/70-nft-collections-for-kraken-nft-beta-testers\"><span style=\"font-weight: 400;\">browse the 70 carefully selected NFT collections<\/span><\/a><span style=\"font-weight: 400;\"> that are available to explore, collect and trade in the beta testing phase.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you were not selected for the chance to try the Kraken NFT Beta, follow the <\/span><a href=\"https:\/\/blog.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\"> and our social account to be the first to know when the full public beta launches.<\/span><\/p>\n<h2>Follow our Kraken NFT Twitter!<\/h2>\n<p><span style=\"font-weight: 400;\">That\u2019s right, we launched a new Twitter account for all things NFTs! Follow us on Twitter at <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">KrakenNFT<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know about all of the exciting things happening on Kraken NFT.<\/span><\/p>\n<h2>Will Kraken make more NFTs available?<\/h2>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken are listed on <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">our website<\/span><\/a><span style=\"font-weight: 400;\">, and all future NFTs will be announced on <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">Kraken NFT\u2019s Twitter<\/span><\/a><span style=\"font-weight: 400;\">. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h2>Trade with caution<\/h2>\n<p><span style=\"font-weight: 400;\">Specific asset availability and liquidity are not guaranteed.<\/span> <span style=\"font-weight: 400;\">When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/span><\/p>\n<hr \/>\n<p><i><span style=\"font-weight: 400;\">*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform.\u00a0<\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that we have added ten new NFT collections to Kraken NFT for our current beta testers to explore, collect and trade. After revealing the first 70 collections earlier this year, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":16320,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460],"tags":[1421],"language":[],"class_list":["post-16319","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-nft","tag-nft"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>New NFT Collections added to Kraken NFT - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/nft\/new-nft-collections-added-to-kraken-nft\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"New NFT Collections added to Kraken NFT\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that we have added ten new NFT collections to Kraken NFT for our current beta testers to explore, collect and trade. After revealing the first 70 collections earlier this year, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/nft\/new-nft-collections-added-to-kraken-nft\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2022-11-30T15:16:34+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-05-05T14:22:46+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/11\/NFT_Listing_VID1_BlogInner.png?fit=1536%2C700&ssl=