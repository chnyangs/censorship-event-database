h":1536,"height":701},{"@type":"BreadcrumbList","@id":"https:\/\/blog.kraken.com\/news\/business-update#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"Kraken Takes Steps to Weather Crypto Winter"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/05fd1aef04d178f2231400ddb85550a2","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/danielpintokraken"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-4hc","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/blog-KrakenGeneric.png?fit=1536%2C701&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/16442","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=16442"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/16442\/revisions"}],"predecessor-version":[{"id":21160,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/16442\/revisions\/21160"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/21092"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=16442"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=16442"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=16442"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=16442"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":16434,"date":"2022-12-08T15:01:05","date_gmt":"2022-12-08T20:01:05","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=16434"},"modified":"2023-06-13T08:12:36","modified_gmt":"2023-06-13T12:12:36","slug":"forgotten-runes-wizard-cult-cyberkongz-the-catalina-whale-mixer-and-more-collections-added-to-kraken-nft","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/nft\/forgotten-runes-wizard-cult-cyberkongz-the-catalina-whale-mixer-and-more-collections-added-to-kraken-nft","title":{"rendered":"Forgotten Runes Wizard Cult, CyberKongz, The Catalina Whale Mixer and more collections added to Kraken NFT"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that we have added <\/span><b>ten new NFT collections<\/b><span style=\"font-weight: 400;\"> to Kraken NFT for our current beta testers to explore, collect and trade. After revealing <\/span><a href=\"https:\/\/blog.kraken.com\/post\/14252\/70-nft-collections-for-kraken-nft-beta-testers\"><span style=\"font-weight: 400;\">the first 70 collections<\/span><\/a><span style=\"font-weight: 400;\"> earlier this year and <a href=\"https:\/\/blog.kraken.com\/post\/16319\/new-nft-collections-added-to-kraken-nft\/\">ten new collections last week<\/a>, we carefully selected these new collections so you can continue to build the NFT collection of your dreams with zero gas fees.*\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">We will continue to add a wide range of new NFT collections every week \u2014 from the hottest profile picture communities to the latest gaming experiences \u2014 across the <a href=\"https:\/\/www.kraken.com\/prices\/solana\">Ethereum<\/a> and <a href=\"https:\/\/www.kraken.com\/prices\/solana\">Solana<\/a> blockchains.<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Here is everything you need to know about the new collections launching on Kraken NFT this week:<\/span><\/h3>\n<p><b>ABC<\/b><\/p>\n<p><span style=\"font-weight: 400;\">ABC is a collection of 10,000 distinct NFTs stored on the Solana Blockchain. ABC depicts cartoonified digital avatars intended to remind the holder of their childhood \u2014 when life was fun! The royalty free collection was created by artist HGE.SOL and dropped without an official roadmap or website.\u00a0<\/span><\/p>\n<p><b>The Catalina Whale Mixer<\/b><\/p>\n<p><span style=\"font-weight: 400;\">The Catalina Whale Mixer is a collection of 5,000+ unique NFTs beached on the Solana blockchain. The marine mammals found in the collection are the genesis project of Wagmi Beach \u2014 <\/span><span style=\"font-weight: 400;\">a web3-native entertainment platform.<\/span><span style=\"font-weight: 400;\"> Each NFT grants its holder commercial rights to the artwork depicted as well as primary access to the media created by Wagmi Beach.<\/span><\/p>\n<p><b>Cets on Creck<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Cets on Creck is a doped-up collection of 6,969 pop-styled NFT cats known as \u2018cets.\u2019 Set in the near-future, the collection\u2019s backstory tells of a time when drugs are legal, life is chill and \u2018cets\u2019 cause trouble on the Solana blockchain out of sheer boredom.\u00a0<\/span><\/p>\n<p><b>Communi3: Mad Scientists<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Communi3: Mad Scientists<\/span> <span style=\"font-weight: 400;\">is a collection of 5,001 chemists and engineers experimenting on the Solana blockchain. Each NFT depicts a unique scientific expert working to perfect the formula for community engagement.<\/span><\/p>\n<p><b>CyberKongz VX<\/b><\/p>\n<p><span style=\"font-weight: 400;\">CyberKongz VX is a 3D NFT collection of 15,000 randomly generated gorillas on the Ethereum blockchain. The collection features voxelated gorilla avatars which are used as player identities on metaverse platforms like The Sandbox. BANANA is the project\u2019s associated cryptocurrency which can be earned by holders of CyberKongz VX NFTs and burned to give their avatars unique names and biographies.<\/span><\/p>\n<p><b>Famous Fox Federation<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Famous Fox Federation is a collection of 7,777 NFTs on the Solana blockchain. The NFTs feature the profile of a small carnivorous canine generated from an assemblage of unique traits and attributes.<\/span><\/p>\n<p><b>Forgotten Runes Wizard Cult<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Forgotten Runes Wizard Cult is an NFT collection featuring 10,000 magical beings on the Ethereum blockchain. The NFTs showcase a diverse group of wizards with differing attributes that include backgrounds, affinities, enchanted runes and more. Wizards are at the center of a larger fantasy MMO known as the Runiverse whose lore continues to evolve via an active online community.<\/span><\/p>\n<p><b>Genuine Undead<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Genuine Undead is a collection of 9,999 unique NFTs built on the Ethereum blockchain. The collection depicts a series of 24&#215;24 pixel skeleton portraits which feature more than 200 hand-drawn traits. The collection\u2019s community of artists and enthusiasts\u00a0 are working together to create a new Web3 experience.<\/span><\/p>\n<p><b>Meta Tattoo Club<\/b><\/p>\n<p><span style=\"font-weight: 400;\">Meta Tattoo Club (MTC) is a collection of 8,888 tattooed deities stored on the Solana blockchain. The collection depicts the gods of ancient Greece each with unique tattoos and additional attributes that make them ideal for social media PFPs.\u00a0<\/span><\/p>\n<p><b>The Potatoz<\/b><\/p>\n<p><span style=\"font-weight: 400;\">The Potatoz is a collection of 9,999 spuds inhabiting the Memeland metaverse. The project features a series of animated tubers endowed with distinct attributes inspired by internet memes and pop-culture. Holders of Potatoz are granted access to the Memeland ecosystem, and are able to evolve their NFTs over time by simply holding them in their crypto wallet.<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Your opinion matters<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Beta testers\u2019 opinions will help shape Kraken NFT before we take it to the global market. Please check out our Support Center for any FAQs about <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/categories\/6498987564308-NFT-Marketplace\"><span style=\"font-weight: 400;\">using the marketplace<\/span><\/a><span style=\"font-weight: 400;\">, or contact <\/span><a href=\"https:\/\/support.kraken.com\/hc\/articles\/215601908\"><span style=\"font-weight: 400;\">Kraken Support<\/span><\/a><span style=\"font-weight: 400;\"> for 24\/7 assistance.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you\u2019re new to the world of NFTs, you can visit our <\/span><a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\"><span style=\"font-weight: 400;\">Learn Center<\/span><\/a><span style=\"font-weight: 400;\"> to discover what all the excitement is about.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">You can also <\/span><a href=\"https:\/\/blog.kraken.com\/post\/14252\/70-nft-collections-for-kraken-nft-beta-testers\"><span style=\"font-weight: 400;\">browse the list of the first 70 carefully selected NFT collections<\/span><\/a><span style=\"font-weight: 400;\"> that are available to explore, collect and trade in the beta testing phase, as well as <a href=\"https:\/\/blog.kraken.com\/post\/16319\/new-nft-collections-added-to-kraken-nft\/\">the most recent NFT collections to be added to Kraken NFT<\/a>.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you were not selected for the chance to try the Kraken NFT Beta, follow the <\/span><a href=\"https:\/\/blog.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\"> and our social account to be the first to know when the full public beta launches.<\/span><\/p>\n<h3><b>Follow our Kraken NFT Twitter!<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">That\u2019s right, we launched a new Twitter account for all things NFTs! Follow us on Twitter at <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">KrakenNFT<\/span><\/a><span style=\"font-weight: 400;\"> to be the first to know about all of the exciting things happening on Kraken NFT.<\/span><\/p>\n<h3><b>Will Kraken make more NFTs available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2014 not even which NFTs we are considering. All of the NFTs available on Kraken can be found on <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/6557260067476-NFTs-available-on-Kraken-\"><span style=\"font-weight: 400;\">our website<\/span><\/a><span style=\"font-weight: 400;\">, and all future NFTs will be announced on <\/span><a href=\"https:\/\/twitter.com\/krakennft\"><span style=\"font-weight: 400;\">Kraken NFT\u2019s Twitter<\/span><\/a><span style=\"font-weight: 400;\">. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Specific asset availability and liquidity are not guaranteed.<\/span> <span style=\"font-weight: 400;\">When Kraken makes an NFT collection available for trading, it\u2019s not a recommendation to buy, sell, or participate in the associated collection. Do your own research and invest at your own risk.<\/span><\/p>\n<p><i><span style=\"font-weight: 400;\">*Gas fees will be incurred when transferring NFTs and other cryptoassets on and off the Kraken platform. <\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that we have added ten new NFT collections to Kraken NFT for our current beta testers to explore, collect and trade. After revealing the first 70 collections earlier this year and ten new collections last week, we carefully selected these new collections so you can continue to build the NFT collection [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":16431,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"