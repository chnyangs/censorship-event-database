alueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\",\"name\":\"Kraken Blog\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\",\"name\":\"krakenfx\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"caption\":\"krakenfx\"},\"sameAs\":[\"https:\\\/\\\/blog.kraken.com\"],\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/krakenfx\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Kraken celebrates excellence in cybersecurity with a new accreditation - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/kraken-celebrates-excellence-in-cybersecurity-with-a-new-accreditation","og_locale":"en_US","og_type":"article","og_title":"Kraken celebrates excellence in cybersecurity with a new accreditation","og_description":"World-class security and protection for our clients have been at the heart of Kraken\u2019s mission since our inception 11 years ago. With the motto security above everything, Kraken has earned trust among crypto investors with one uncompromising priority: the safeguarding of client funds. Eleven years on, we\u2019re proud to announce that our over-the-counter (OTC) and [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/kraken-celebrates-excellence-in-cybersecurity-with-a-new-accreditation","og_site_name":"Kraken Blog","article_published_time":"2022-11-08T14:00:04+00:00","article_modified_time":"2023-05-09T11:54:26+00:00","og_image":[{"width":1536,"height":800,"url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/11\/ComplianceCertification_blogGraphic-V2-noText.png?fit=1536%2C800&ssl=1","type":"image\/png"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"3 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/kraken-celebrates-excellence-in-cybersecurity-with-a-new-accreditation#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/kraken-celebrates-excellence-in-cybersecurity-with-a-new-accreditation"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"Kraken celebrates excellence in cybersecurity with a new accreditation","datePublished":"2022-11-08T14:00:04+00:00","dateModified":"2023-05-09T11:54:26+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/kraken-celebrates-excellence-in-cybersecurity-with-a-new-accreditation"},"wordCount":522,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organizati