way for Kraken clients to verify whether or not their [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide","og_site_name":"Kraken Blog","article_published_time":"2022-11-28T14:41:09+00:00","article_modified_time":"2023-05-09T11:54:55+00:00","og_image":[{"width":1024,"height":512,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Carousel-Proof-of-reserve-1-1024x512.png","type":"image\/png"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"6 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"What is Proof of Reserves? A Beginner\u2019s Guide","datePublished":"2022-11-28T14:41:09+00:00","dateModified":"2023-05-09T11:54:55+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide"},"wordCount":1209,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Carousel-Proof-of-reserve-1.png?fit=2946%2C1472&ssl=1","keywords":["featured"],"articleSection":["News"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide","url":"https:\/\/blog.kraken.com\/news\/what-is-proof-of-reserves-a-beginners-guide","name":"What is Proof of Reserves? A Beginner\u2019s Guide - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/n