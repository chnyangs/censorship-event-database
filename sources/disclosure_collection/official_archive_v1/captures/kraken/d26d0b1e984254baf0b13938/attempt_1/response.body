[{"id":16012,"date":"2022-11-02T14:15:14","date_gmt":"2022-11-02T14:15:14","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=16012"},"modified":"2023-05-09T07:54:25","modified_gmt":"2023-05-09T11:54:25","slug":"join-our-cmo-mayur-on-his-twitter-space-this-thursday","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/join-our-cmo-mayur-on-his-twitter-space-this-thursday","title":{"rendered":"Join our CMO Mayur on his Twitter Space this Thursday"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">Ever wondered what goes behind throwing one of the largest virtual festivals with some of the biggest names in music?\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Here\u2019s your chance to find out! Join Kraken\u2019s CMO, Mayur Gupta in Decentraland\u2019s \u201cBehind the Scenes\u201d Twitter Space on Nov. 3rd at 12pm ET to chat about this year\u2019s Metaverse Music Festival (MVMF), where we\u2019ll celebrate the upcoming launch of <\/span><a href=\"https:\/\/www.kraken.com\/nft\"><span style=\"font-weight: 400;\">Kraken NFT<\/span><\/a><span style=\"font-weight: 400;\">. Mayur will be discussing NFTs and the MVMF with Decentrland\u2019s Creative Director, Sam Hamilton.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">A reminder: we\u2019re gearing up to present Decentraland\u2019s MVMF from Nov. 10 to Nov. 13 and we\u2019ve pulled out all the stops to create an immersive experience that emulates a real-life festival. You\u2019ll get to witness the transformative power of Web3, the metaverse and NFTs in the music scene as we celebrate the artists and curators that are making history at this year\u2019s MVMF.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Set in a cyberpunk city of the future, the MVMF will feature over a hundred musicians performing on several stages across Decentraland, including musical legends Ozzy Osbourne on the Ozzfest stage, Dillon Francis, and Soulja Boy on the Limewire stage.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Join Mayur tomorrow at 12pm ET to chat about Decentraland\u2019s MVMF presented by Kraken. Set up a reminder by clicking below so you don\u2019t miss it!<\/span><\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5d45dc;\" href=\"https:\/\/blog.kraken.com\/go\/dcl-and-kraken-twitter-space\/\">Set a reminder<\/a><\/div>\n<p><span style=\"font-weight: 400;\">Check out our <\/span><a href=\"https:\/\/blog.kraken.com\/post\/15906\/were-about-to-crank-it-up-kraken-presents-this-years-dcl-metaverse-music-festival\/\"><span style=\"font-weight: 400;\">blog about the MVMF<\/span><\/a><span style=\"font-weight: 400;\"> to learn more about what we have in store for you at this year\u2019s festival.<\/span><\/p>\n<hr \/>\n<p><i>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell or hold any cryptoasset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position.<\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Ever wondered what goes behind throwing one of the largest virtual festivals with some of the biggest names in music?\u00a0 Here\u2019s your chance to find out! Join Kraken\u2019s CMO, Mayur Gupta in Decentraland\u2019s \u201cBehind the Scenes\u201d Twitter Space on Nov. 3rd at 12pm ET to chat about this year\u2019s Metaverse Music Festival (MVMF), where we\u2019ll [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":16397,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[],"language":[],"class_list":["post-16012","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Join our CMO Mayur on his Twitter Space this Thursday - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/join-our-cmo-mayur-on-his-twitter-space-this-thursday\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Join our CMO Mayur on his Twitter Space this Thursday\" \/>\n<meta property=\"og:description\" content=\"Ever wondered what goes behind throwing one of the largest virtual festivals with some of the biggest names in music?\u00a0 Here\u2019s your chance to find out! Join Kraken\u2019s CMO, Mayur Gupta in Decentraland\u2019s \u201cBehind the Scenes\u201d Twitter Space on Nov. 3rd at 12pm ET to chat about this year\u2019s Metaverse Music Festival (MVMF), where we\u2019ll [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/join-our-cmo-mayur-on-his-twitter-space-this-thursday\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2022-11-02T14:15:14+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-05-09T11:54:25+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/11\/blog_header.png?fit=1536%2C700&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"1536\" \/>\n\t<meta property=\"og:image:height\" content=\"700\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"2 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/join-our-cmo-mayur-on-his-twitter-space-this-thursday#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/join-our-cmo-mayur-on-his-twitter-space-this-thursday\"},\"author\":{\"name\":\"krakenfx\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\"},\"headline\":\"Join our CMO Mayur on his Twitter Space this Thursday\",\"datePublished\":\"2022-11-02T14:15:14+00:00\",\"dateModified\":\"2023-05-09T11:54:25+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/join-our-cmo-mayur-on-his-twitter-space-this-thursday\"},\"wordCount\":348,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/join-our-cmo-mayur-on-his-twitter-space-this-thursday#primaryimage\"},\"thumbnai