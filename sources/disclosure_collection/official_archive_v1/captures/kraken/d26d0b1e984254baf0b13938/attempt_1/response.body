.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/05fd1aef04d178f2231400ddb85550a2","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/danielpintokraken"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-3VY","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/NFTbeta_blog-inner-V2.png?fit=1536%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15126","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=15126"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15126\/revisions"}],"predecessor-version":[{"id":21234,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15126\/revisions\/21234"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/15653"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=15126"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=15126"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=15126"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=15126"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":16048,"date":"2022-11-04T14:51:09","date_gmt":"2022-11-04T18:51:09","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=16048"},"modified":"2023-06-13T08:18:37","modified_gmt":"2023-06-13T12:18:37","slug":"trading-for-hashflow-hft-starts-november-7-deposit-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-hashflow-hft-starts-november-7-deposit-now","title":{"rendered":"Trading for Hashflow (HFT) is live"},"content":{"rendered":"<p><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that Kraken now supports <\/span><b>Hashflow (HFT<\/b><b>)!<\/b><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and Trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Funding and trading are live. <\/span><span style=\"font-weight: 400;\">You will be able to add these tokens to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">.\u00a0<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Ticker<\/b><\/td>\n<td><span style=\"font-weight: 400;\">HFT<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Tradable against<\/b><\/td>\n<td><span style=\"font-weight: 400;\">EUR, USD<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Price precision<\/b><\/td>\n<td><span style=\"font-weight: 400;\">4 decimal places<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Minimum Order Size<\/b><\/td>\n<td><span style=\"font-weight: 400;\">5<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Minimum Deposit<\/b><\/td>\n<td><span style=\"font-weight: 400;\">10<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Deposit confirmations required<\/b><\/td>\n<td><span style=\"font-weight: 400;\">70 confirmations (~14 minutes)<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Not available in<\/b><\/td>\n<td><span style=\"font-weight: 400;\">Japan<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Services available<\/b><\/td>\n<td><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\">, <\/span><a href=\"https:\/\/trade.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Terminal<\/span><\/a><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><i><span style=\"font-weight: 400;\">Subject to change, for the latest information please review our <\/span><\/i><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/sections\/4402657292436-Cryptocurrency-Funding\"><i><span style=\"font-weight: 400;\">support center<\/span><\/i><\/a><i><span style=\"font-weight: 400;\">.<\/span><\/i><\/p>\n<p><b>Note: Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/b><i><span style=\"font-weight: 400;\"> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).\u00a0<\/span><\/i><\/p>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the asset:<\/span><\/p>\n<p><b>Hashflow (HFT)<\/b><span style=\"font-weight: 400;\"> is a decentralized exchange (DEX) designed for interoperable trades with low slippage. The platform enables bridgeless cross-chain swaps and allows market makers to price assets off-chain, which creates tighter quotes for traders. HFT is the native token of the DEX used to earn rewards for providing liquidity on the platform, incentivize trading activity and vote on decisions that affect the future of the protocol.<\/span><\/p>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <\/span><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\"><span style=\"font-weight: 400;\">here<\/span><\/a><span style=\"font-weight: 400;\">, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p><a href=\"https:\/\/blog.kraken.com\/go\/referrals\/\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15784\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1200%2C250&amp;ssl=1\" data-orig-size=\"1200,250\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"subhead_reflink (1)\" data-image-description=\"\" data-image-caption=\"&lt;p&gt;Referral cta image&lt;\/p&gt;\n\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1024%2C213&amp;ssl=1\" class=\"aligncenter wp-image-15784 size-full\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1200%2C250&#038;ssl=1\" alt=\"\" width=\"1200\" height=\"250\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?w=1200&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=300%2C63&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1024%2C213&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=768%2C160&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=200%2C42&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/a><\/p>\n<p><span style=\"font-weight: 400;\">Kraken holds tokens on its balance sheet for operational purposes or other reasons. Kraken Ventures, in which Kraken is a limited partner, is an investor in certain tokens. Kraken may therefore benefit from listing certain tokens on the platform. However, Kraken Ventures may be subject to a contractual lock-up for a period of time after its investment during which it cannot sell the tokens. All tokens, regardless of whether held by Kraken or Kraken Ventures, are subject to the same strict review process and guidelines in determining whether to make them available to trade on Kraken.<\/span><\/p>\n<hr \/>\n<p><i><span style=\"font-weight: 400;\">These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell or hold any cryptoasset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position.<\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Kraken now supports Hashflow (HFT)! Funding and Trading Funding and trading are live. You will be able to add these tokens to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.\u00a0 Ticker HFT Tradable against EUR, USD Price precision 4 decimal places Minimum Order Size 5 [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":16052,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever