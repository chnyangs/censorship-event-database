":11,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24878\/revisions"}],"predecessor-version":[{"id":24901,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24878\/revisions\/24901"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/24898"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=24878"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=24878"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=24878"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=24878"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":24887,"date":"2024-04-09T11:47:21","date_gmt":"2024-04-09T15:47:21","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=24887"},"modified":"2024-04-10T07:41:54","modified_gmt":"2024-04-10T11:41:54","slug":"trading-for-beam-beam-starts-april-11-deposit-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-beam-beam-starts-april-11-deposit-now","title":{"rendered":"Trading for Beam (BEAM) starts April 11 &#8211; deposit now"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that <strong>Beam (BEAM)<\/strong> is now available on Kraken!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Important: <\/strong>Kraken will not be supporting the migration of MC tokens to BEAM. If you hold MC tokens and wish to migrate them, please follow the instructions provided in this tutorial and FAQ: <a href=\"https:\/\/medium.com\/@meritcircle\/beam-token-migration-tutorial-and-faq-3f72cecf09d2\">Beam Token Migration Tutorial and FAQ<\/a>. <\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Alternatively, you can directly access the migration tool at <a href=\"https:\/\/meritcircle.io\/migrate\">Merit Circle Migration Portal<\/a>.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-funding-and-trading\">Funding and trading<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Funding for BEAM is live and trading will begin on April 11. Add BEAM to your Kraken account by navigating to <a href=\"https:\/\/www.kraken.com\/u\/funding\"><strong>Funding<\/strong><\/a>, selecting the asset, and hitting <strong>Deposit.&nbsp;<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Only deposit BEAM on Ethereum. Deposits using other networks will be lost.<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Got BEAM and a Kraken account? \u2935\ufe0f<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\">\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken<\/a>\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/pro.kraken.com\/app\/portfolio\/overview#dialog\/funding\/deposit\/BEAM\/beam-ethereum-unified\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken Pro<\/a>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">BEAM is tradeable on <a href=\"https:\/\/www.kraken.com\/\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\">Kraken Pro<\/a> with the following parameters:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Price decimal precision<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/td><\/tr><tr><td>BEAM<\/td><td>USD, EUR<\/td><td>2<\/td><td>40<\/td><td>50<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li><strong>Not available in Canada<\/strong><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-the-token\">Here\u2019s some more information about the token:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Beam (BEAM)<\/strong> is a gaming-focused blockchain by <a href=\"https:\/\/www.kraken.com\/prices\/merit-circle\">Merit Circle (MC)<\/a>, aiming to innovate in game development, player experiences, and asset trading. It allows for seamless cross-chain transfer of game assets as omnichain <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\">NFTs<\/a>. BEAM allows users to pay for <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\">blockchain transaction fees<\/a> and also serves as a <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\">governance token<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Check out more information about Beam our <\/strong><a href=\"https:\/\/www.kraken.com\/legal\/uk\/asset-statements\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Crypto Asset Statement.<\/strong><\/a><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!&nbsp;<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-trade-with-caution\"><strong>Trade with caution<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Beam (BEAM) is now available on Kraken! Important: Kraken will not be supporting the migration of MC tokens to BEAM. If you hold MC tokens and wish to migrate them, please follow the instructions provided in this tutorial and FAQ: Beam Token Migration Tutorial and FAQ. Alternatively, you can directly [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":24897,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":