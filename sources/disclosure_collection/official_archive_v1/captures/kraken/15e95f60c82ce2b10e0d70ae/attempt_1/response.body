\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/05fd1aef04d178f2231400ddb85550a2","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/danielpintokraken"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6uE","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/04\/Blog-Banner-Ondo-1-2.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24964","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=24964"}],"version-history":[{"count":6,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24964\/revisions"}],"predecessor-version":[{"id":25024,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24964\/revisions\/25024"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/24968"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=24964"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=24964"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=24964"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=24964"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":25022,"date":"2024-04-23T11:31:38","date_gmt":"2024-04-23T15:31:38","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=25022"},"modified":"2024-05-06T08:35:42","modified_gmt":"2024-05-06T12:35:42","slug":"trading-for-beam-beam-and-ondo-ondo-starts-now-in-canada","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-beam-beam-and-ondo-ondo-starts-now-in-canada","title":{"rendered":"Trading for Beam (BEAM) and Ondo (ONDO) starts now in Canada"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that <strong>Beam (BEAM) and Ondo (ONDO)<\/strong> are now available on Kraken for residents in Canada!<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-funding-and-trading\">Funding and trading<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Both BEAM and ONDO funding and trading are live. Add BEAM and ONDO to your Kraken account by navigating to <a href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Funding<\/strong><\/a>, selecting the asset, and hitting <strong>Deposit.\u00a0<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Make sure to deposit your tokens into the networks supported by Kraken. Deposits made using other networks will be lost.<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Got BEAM or ONDO and a Kraken account? \u2935\ufe0f<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\">\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken<\/a>\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/pro.kraken.com\/app\/portfolio\/overview#dialog\/funding\/deposit\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken Pro<\/a>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">BEAM and ONDO are tradeable on <a href=\"https:\/\/www.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Pro<\/a> with the following parameters:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Price decimal precision<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/td><\/tr><tr><td>BEAM<\/td><td>USD, EUR<\/td><td>2<\/td><td>40<\/td><td>50<\/td><\/tr><tr><td>ONDO<\/td><td>USD, EUR<\/td><td>3<\/td><td>20<\/td><td>20<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-the-token\">Here\u2019s some more information about the token:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/beam\" target=\"_blank\" rel=\"noreferrer noopener\">Beam (BEAM)<\/a><\/strong> is a gaming-focused blockchain by <a href=\"https:\/\/www.kraken.com\/prices\/merit-circle\" target=\"_blank\" rel=\"noreferrer noopener\">Merit Circle (MC)<\/a>, aiming to innovate in game development, player experiences, and asset trading. It allows for seamless cross-chain transfer of game assets as omnichain <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\" target=\"_blank\" rel=\"noreferrer noopener\">NFTs<\/a>. BEAM allows users to pay for <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-blockchain-gas-fee\" target=\"_blank\" rel=\"noreferrer noopener\">blockchain transaction fees<\/a> and also serves as a <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\" target=\"_blank\" rel=\"noreferrer noopener\">governance token<\/a>. If you want to learn more about Beam, please visit our <a href=\"https:\/\/assets-cms.kraken.com\/files\/51n36hrp\/facade\/2b0fe36d8eabe115db28a39baf15f8926efc3ea7.pdf\" target=\"_blank\" rel=\"noreferrer noopener\">Crypto Asset Statement<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/ondo\" target=\"_blank\" rel=\"noreferrer noopener\">Ondo (ONDO)<\/a><\/strong> is a <a href=\"https:\/\/www.kraken.com\/learn\/what-is-decentralized-finance-defi\" target=\"_blank\" rel=\"noreferrer noopener\">decentralized finance (DeFi)<\/a> protocol dedicated to democratizing access to institutional-grade financial products and services. It focuses on integrating real-world financial instruments into the blockchain. ONDO serves as a <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\" target=\"_blank\" rel=\"noreferrer noopener\">governance token<\/a> that grants holders voting rights on proposals that influence the future of the protocol. If you want to learn more about Ondo, please visit our <a href=\"https:\/\/assets-cms.kraken.com\/files\/51n36hrp\/facade\/cf2ea504b1a1c1c83c58e3622536e5dfa4d0a1f3.pdf\" target=\"_blank\" rel=\"noreferrer noopener\">Crypto Asset Statement.<\/a><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noreferrer noopener\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!\u00a0<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Payward Canada Inc., operating as Kraken, has filed an application for registration in certain Canadian jurisdictions but has not yet obtained registration. Until such time as Payward Canada Inc., operating as Kraken, obtains registration, Payward Canada Inc. has agreed to abide by the terms of an undertaking available at the following page: <a href=\"https:\/\/www.securities-administrators.ca\/wp-content\/uploads\/2023\/04\/20230324-Kraken-PRU-publication-version.pdf\">https:\/\/www.securities-administrators.ca\/wp-content\/uploads\/2023\/04\/20230324-Kraken-PRU-publication-version.pdf<\/a>.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Beam (BEAM) and Ondo (ONDO) are now available on Kraken for residents in Canada! Funding and trading Both BEAM and ONDO funding and trading are live. Add BEAM and ONDO to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.\u00a0 Make sure to deposit your tokens [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":25026,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1832,1373,1830],"language":[],"class_list":["post-25022","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-beam","tag-featured","tag-ondo"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for Beam (BEAM) and Ondo (ONDO) starts now in Canada - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-beam-beam-and-ondo-ondo-starts-now-in-canada\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=