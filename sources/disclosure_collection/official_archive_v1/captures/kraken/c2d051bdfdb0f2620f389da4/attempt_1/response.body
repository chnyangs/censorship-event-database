n&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g\",\"caption\":\"krakenfx\"},\"sameAs\":[\"https:\\\/\\\/blog.kraken.com\"],\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/krakenfx\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Crypto for All: Empowering our Ukrainian clients with Bitcoin - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin","og_locale":"en_US","og_type":"article","og_title":"Crypto for All: Empowering our Ukrainian clients with Bitcoin","og_description":"\u201cCryptocurrency remains an important humanitarian tool, especially at a time when many around the world can no longer rely on traditional banks and custodians.\u201d \u2013 Jesse Powell, Kraken Co-founder and CEO On March 9, 2022, we announced an ambitious aid package as Kraken distributed $1,000 in BTC to all Ukrainian accounts. This came two weeks [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin","og_site_name":"Kraken Blog","article_published_time":"2022-09-27T13:59:55+00:00","article_modified_time":"2023-06-13T12:08:19+00:00","og_image":[{"width":1024,"height":512,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/SUNFLOWER-CAROUSEL-1024x512.png","type":"image\/png"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"3 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"Crypto for All: Empowering our Ukrainian clients with Bitcoin","datePublished":"2022-09-27T13:59:55+00:00","dateModified":"2023-06-13T12:08:19+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin"},"wordCount":704,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/SUNFLOWER-CAROUSEL.png?fit=2946%2C1472&ssl=1","keywords":["featured"],"articleSection":["News"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin","url":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin","name":"Crypto for All: Empowering our Ukrainian clients with Bitcoin - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin#primaryimage"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/SUNFLOWER-CAROUSEL.png?fit=2946%2C1472&ssl=1","datePublished":"2022-09-27T13:59:55+00:00","dateModified":"2023-06-13T12:08:19+00:00","breadcrumb":{"@id":"https:\/\/blog.kraken.com\/news\/crypto-for-all-empowering-our-ukrainian-clients-with-bitcoin#breadcrumb"},"inLanguage":"en-