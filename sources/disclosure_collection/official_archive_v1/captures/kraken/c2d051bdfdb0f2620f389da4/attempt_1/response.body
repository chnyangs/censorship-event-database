8?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/danielpintokraken"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-430","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Featured-Image-CEO-Image.png?fit=800%2C917&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15562","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=15562"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15562\/revisions"}],"predecessor-version":[{"id":22494,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15562\/revisions\/22494"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/15565"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=15562"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=15562"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=15562"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=15562"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":15248,"date":"2022-09-23T15:00:08","date_gmt":"2022-09-23T15:00:08","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=15248"},"modified":"2023-05-09T07:54:26","modified_gmt":"2023-05-09T11:54:26","slug":"kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative","title":{"rendered":"Kraken Donates $100,000 to Anti-Human Trafficking Intelligence Initiative"},"content":{"rendered":"<p><span style=\"font-weight: 400;\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15270\" data-permalink=\"https:\/\/blog.kraken.com\/blog-inner-atii-diamond-partnership\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?fit=1536%2C700&amp;ssl=1\" data-orig-size=\"1536,700\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Blog Inner &amp;#8211; ATII Diamond Partnership\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?fit=1024%2C467&amp;ssl=1\" class=\"aligncenter wp-image-15270 size-full\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?resize=1536%2C700&#038;ssl=1\" alt=\"\" width=\"1536\" height=\"700\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?w=1536&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?resize=300%2C137&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?resize=1024%2C467&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?resize=768%2C350&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/08\/Blog-Inner-ATII-Diamond-Partnership.png?resize=200%2C91&amp;ssl=1 200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/span><\/p>\n<p><span style=\"font-weight: 400;\">Kraken is proud to announce that it has become a Diamond Sponsor of the <a href=\"https:\/\/followmoneyfightslavery.org\/\" target=\"_blank\" rel=\"noopener\">Anti-Human Trafficking Intelligence Initiative<\/a> (ATII), a U.S.-based nonprofit that harnesses intelligence to help financial institutions, technology firms and cryptocurrency exchanges combat human trafficking and child exploitation.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">\u201cKraken\u2019s partnership with ATII will provide us with actionable data on illicit dark web use so our compliance team can better detect and respond to potential criminal activity,\u201d said Ian Mynot, Senior FIU Manager at Kraken. \u201cKraken\u2019s mission has been to accelerate the adoption of digital assets globally by offering a safe and secure route for clients to access with certainty and confidence. Cryptocurrencies have never been a safe haven for criminals and through this partnership, we are taking a proactive step to ensure that digital assets traded on Kraken are not used to facilitate human trafficking and child exploitation.\u201d<\/span><\/p>\n<p><span style=\"font-weight: 400;\">&#8220;The Anti-Human Trafficking Intelligence Initiative is honored to have Kraken as a formal sponsor and corporate partner in the fight against modern slavery,\u201d said Aaron Kahler, ATII Founder &amp; Chief Executive. \u201cATII is grateful to be able to leverage Kraken&#8217;s expertise and industry relationships within the crypto and finance world in our efforts to disrupt the operations, economics, and anonymity of human trafficking at the source.&#8221;\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">There are an <\/span><a href=\"https:\/\/www.stopthetraffik.org\/about-human-trafficking\/the-scale-of-human-trafficking\/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">estimated<\/span><\/a><span style=\"font-weight: 400;\"> 40.3 million victims of modern slavery around the world, the majority being women and girls. <\/span><a href=\"https:\/\/www.ilo.org\/wcmsp5\/groups\/public\/---dgreports\/---dcomm\/documents\/publication\/wcms_575479.pdf\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">One in four people<\/span><\/a><span style=\"font-weight: 400;\"> forced into slavery are children.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">ATII is solely focused on identifying the proceeds of human trafficking, tracking them through the financial system and notifying relevant parties so they can take action. By working with a range of partners, ATII hopes to end the trade of human beings for good. Kraken\u2019s donation will enable ATII to continue providing financial institutions with the training and tools needed to prevent the use of digital assets in human trafficking.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">By partnering with ATII, we are furthering our mission to create an inclusive, transparent and trustless financial system through the adoption of cryptocurrency. In addition to our $100,000 donation, we will use our shared expertise in investigations and blockchain technology to help ATII strengthen its digital financial crime prevention efforts and bolster Kraken&#8217;s proactive investigations strategy.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Kraken\u2019s partnership with ATII showcases our ongoing commitment to a high level of corporate social responsibility and highlights how Kraken\u2019s platform remains off-limits to bad actors. We hope this will inspire other crypto companies to follow our example.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">If you&#8217;re working on a project that&#8217;s driving innovation in the crypto industry, here&#8217;s how you can <a href=\"https:\/\/www.kraken.com\/features\/grants\" target=\"_blank\" rel=\"noopener\">apply for a grant from Kraken<\/a>.<\/span><\/p>\n<p>Join us in our efforts to prevent the use of digital assets in human trafficking.<\/p>\n<p>&nbsp;<\/p>\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #ffffff; background-color: #5d45dc; border: 1px solid #5d45dc;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Create your account<\/a><\/div>\n<p>&nbsp;<\/p>\n<hr \/>\n<p><i>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell or hold any digital asset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position.<\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Kraken is proud to announce that it has become a Diamond Sponsor of the Anti-Human Trafficking Intelligence Initiative (ATII), a U.S.-based nonprofit that harnesses intelligence to help financial institutions, technology firms and cryptocurrency exchanges combat human trafficking and child exploitation.\u00a0 \u201cKraken\u2019s partnership with ATII will provide us with actionable data on illicit dark web use [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":15271,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1373],"language":[],"class_list":["post-15248","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-featured"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken Donates $100,000 to Anti-Human Trafficking Intelligence Initiative - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Kraken Donates $100,000 to Anti-Human Trafficking Intelligence Initiative\" \/>\n<meta property=\"og:description\" content=\"Kraken is proud to announce that it has become a Diamond Sponsor of the Anti-Human Trafficking Intelligence Initiative (ATII), a U.S.-based nonprofit that harnesses intelligence to help financial institutions, technology firms and cryptocurrency exchanges combat human trafficking and child exploitation.\u00a0 \u201cKraken\u2019s partnership with ATII will provide us with actionable data on illicit dark web use [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2022-09-23T15:00:08+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-05-09T11:54:26+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Carousel-blog-ATII-Diamond-Partnership.png?fit=2946%2C1472&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"2946\" \/>\n\t<meta property=\"og:image:height\" content=\"1472\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"3 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative\"},\"author\":{\"name\":\"krakenfx\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\"},\"headline\":\"Kraken Donates $100,000 to Anti-Human Trafficking Intelligence Initiative\",\"datePublished\":\"2022-09-23T15:00:08+00:00\",\"dateModified\":\"2023-05-09T11:54:26+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.krak