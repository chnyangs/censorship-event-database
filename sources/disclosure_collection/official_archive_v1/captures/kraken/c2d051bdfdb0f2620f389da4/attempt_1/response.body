ta on illicit dark web use [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative","og_site_name":"Kraken Blog","article_published_time":"2022-09-23T15:00:08+00:00","article_modified_time":"2023-05-09T11:54:26+00:00","og_image":[{"width":2946,"height":1472,"url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Carousel-blog-ATII-Diamond-Partnership.png?fit=2946%2C1472&ssl=1","type":"image\/png"}],"author":"krakenfx","twitter_card":"summary_large_image","twitter_misc":{"Written by":"krakenfx","Est. reading time":"3 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative"},"author":{"name":"krakenfx","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21"},"headline":"Kraken Donates $100,000 to Anti-Human Trafficking Intelligence Initiative","datePublished":"2022-09-23T15:00:08+00:00","dateModified":"2023-05-09T11:54:26+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative"},"wordCount":554,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Carousel-blog-ATII-Diamond-Partnership.png?fit=2946%2C1472&ssl=1","keywords":["featured"],"articleSection":["News"],"inLanguage":"en-US"},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-to-anti-human-trafficking-intelligence-initiative","url":"https:\/\/blog.kraken.com\/news\/kraken-donates-100000-t