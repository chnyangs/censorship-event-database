\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=15411"}],"version-history":[{"count":0,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15411\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/15416"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=15411"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=15411"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=15411"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=15411"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":15482,"date":"2022-09-16T00:33:17","date_gmt":"2022-09-16T04:33:17","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=15482"},"modified":"2023-06-13T08:13:46","modified_gmt":"2023-06-13T12:13:46","slug":"ethereumpow-ethw-trading-starts-now-token-distribution","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/ethereumpow-ethw-trading-starts-now-token-distribution","title":{"rendered":"EthereumPoW (ETHW) trading starts now + token distribution"},"content":{"rendered":"<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15490\" data-permalink=\"https:\/\/blog.kraken.com\/blog-inner-single-token-22\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?fit=4608%2C2100&amp;ssl=1\" data-orig-size=\"4608,2100\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Blog Inner &amp;#8211; Single token\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?fit=1024%2C467&amp;ssl=1\" class=\"aligncenter wp-image-15490 size-full\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=4608%2C2100&#038;ssl=1\" alt=\"\" width=\"4608\" height=\"2100\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?w=4608&amp;ssl=1 4608w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=300%2C137&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=1024%2C467&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=768%2C350&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=1536%2C700&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=2048%2C933&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?resize=200%2C91&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Single-token-2.png?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/p>\n<p><span style=\"font-weight: 400;\">We are pleased to announce that Kraken now supports <\/span><a href=\"https:\/\/www.kraken.com\/prices\/ethereumpow\"><b>EthereumPoW (ETHW)<\/b><\/a><span style=\"font-weight: 400;\">.<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Funding and Trading<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">ETHW trading is live and the ETHW token has been distributed to eligible clients<\/span><span style=\"font-weight: 400;\">. <\/span><span style=\"font-weight: 400;\">A further announcement will be made once Funding is live, at which point y<\/span><span style=\"font-weight: 400;\">ou will be able to add ETHW to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">. Keep an eye on our <\/span><a href=\"https:\/\/status.kraken.com\/\"><span style=\"font-weight: 400;\">status page<\/span><\/a><span style=\"font-weight: 400;\"> for updates.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Here\u2019s what you need to know:<\/span><\/p>\n<table>\n<tbody>\n<tr>\n<td><b>Ticker<\/b><\/td>\n<td><span style=\"font-weight: 400;\">ETHW<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Tradeable against<\/b><\/td>\n<td><span style=\"font-weight: 400;\">EUR, USD and ETH<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Price precision<\/b><\/td>\n<td><span style=\"font-weight: 400;\">3 decimal places for EUR and USD<\/span><\/p>\n<p><span style=\"font-weight: 400;\">6 decimal places for ETH<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Minimum order size<\/b><\/td>\n<td><span style=\"font-weight: 400;\">0.01 ETHW<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Minimum deposit\u00a0<\/b><\/td>\n<td><span style=\"font-weight: 400;\">0.1 ETHW\u00a0<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Deposit confirmations required<\/b><\/td>\n<td>20,000 (~3.5 days)<\/td>\n<\/tr>\n<tr>\n<td><b>Not available in<\/b><\/td>\n<td><span style=\"font-weight: 400;\">Japan<\/span><\/td>\n<\/tr>\n<tr>\n<td><b>Services available<\/b><\/td>\n<td><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\">, the <\/span><a href=\"https:\/\/trade.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Pro<\/span><\/a><span style=\"font-weight: 400;\"> interface<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><b>Please Note:<\/b><\/p>\n<ul>\n<li aria-level=\"1\"><b>It is possible that the ETHW token may not emerge and that its value could settle to zero. ETHW\u2019s price is highly volatile, please take the time to research the risks involved in trading this token.<\/b><\/li>\n<li aria-level=\"1\"><b>You may receive the below email as part of the ETHW token distribution:<br \/>\n<\/b><\/li>\n<\/ul>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"15510\" data-permalink=\"https:\/\/blog.kraken.com\/screenshot-2022-09-16-at-15-34-05\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?fit=820%2C1008&amp;ssl=1\" data-orig-size=\"820,1008\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Screenshot 2022-09-16 at 15.34.05\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?fit=820%2C1008&amp;ssl=1\" class=\"aligncenter wp-image-15510 \" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?resize=533%2C655&#038;ssl=1\" alt=\"\" width=\"533\" height=\"655\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?w=820&amp;ssl=1 820w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?resize=244%2C300&amp;ssl=1 244w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?resize=768%2C944&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Screenshot-2022-09-16-at-15.34.05.png?resize=81%2C100&amp;ssl=1 81w\" sizes=\"auto, (max-width: 533px) 100vw, 533px\" \/><\/p>\n<h3><\/h3>\n<h3>What is EthereumPoW?<\/h3>\n<p><span style=\"font-weight: 400;\">EthereumPoW is a copy of the <a href=\"https:\/\/www.kraken.com\/prices\/ethereum\">Ethereum<\/a> network\u2019s proof-of-work (PoW) blockchain as it existed before moving to a proof-of-stake (PoS) consensus mechanism. EthereumPoW retains the functionality of the Ethereum network before its transition to PoS and is supported by mining groups who are unable to earn rewards via Ethereum\u2019s new protocol. ETHW is the native token of the blockchain which is used to pay for network transaction fees, earn rewards for securing the protocol via mining and purchase goods and services from decentralized applications (dApps) built on the platform.<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">ETHW token distribution<\/span><\/h3>\n<p><span style=\"font-weight: 400;\">Kraken clients will be credited with the ETHW forked token at a 1 for 1 ratio for each ETH token held at the time of the snapshot. This credit would only apply to unstaked, liquid ETH and not to staked (ETH.S) tokens.<\/span><span style=\"font-weight: 400;\"><br \/>\n<\/span><\/p>\n<p><strong>Please contact our <a class=\"c-link\" tabindex=\"-1\" href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/215601908\" target=\"_blank\" rel=\"noopener noreferrer\" data-stringify-link=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/215601908\" data-sk=\"tooltip_parent\" data-remove-tab-index=\"true\">support team<\/a> if you wish to opt out of the token distribution.<\/strong><\/p>\n<p><b>Snapshot timestamp:\u00a0<\/b><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Block Height: <\/span><a href=\"https:\/\/etherscan.io\/block\/15537393\"><span style=\"font-weight: 400;\">15537393<\/span><\/a><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Time: Sep-15-2022 06:42:42 AM +UTC<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Unix time: 1663224162<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">A further announcement will be made once the distribution is completed.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Please note: it is possible that ETH deposits sent closer to The Merge event may not count toward the snapshot of clients\u2019 ETH balances. <\/span><b>Only settled account balances at the snapshot time will be considered.\u00a0<\/b><\/p>\n<p><b>Important<\/b><span style=\"font-weight: 400;\">: Traders holding open margin positions during The Merge need to be aware of the treatment of their positions, as forked tokens can impact your account once credited\/debited.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Margin positions will be treated as if the user held the underlying ETH, which means that Kraken will:<\/span><\/p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Add<\/b><span style=\"font-weight: 400;\"> the relevant amount of forked ETHW tokens to the account for ETH long positions.<\/span><\/li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Deduct<\/b><span style=\"font-weight: 400;\"> the relevant amount of forked ETHW tokens from the account for ETH short positions.<\/span><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">Check out our <\/span><a href=\"https:\/\/blog.kraken.com\/post\/15260\/what-you-should-know-about-the-ethereum-merge-on-kraken\/\"><span style=\"font-weight: 400;\">blog post<\/span><\/a><span style=\"font-weight: 400;\"> for further information about the token distribution treatment for margin traders.<\/span><\/p>\n<h3><span style=\"font-weight: 400;\">Useful links<\/span><\/h3>\n<ul>\n<li aria-level=\"1\"><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/8650291932820-Notice-regarding-the-Ethereum-Merge\"><span style=\"font-weight: 400;\">Notice Regarding the Ethereum Merge | Kraken Support Center<\/span><\/a><\/li>\n<\/ul>\n<ul>\n<li aria-level=\"1\"><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360052734432\"><span style=\"font-weight: 400;\">Ethereum Merge, Staking and Trading FAQ | Kraken Support Center<\/span><\/a><span style=\"font-weight: 400;\">\u00a0<\/span><\/li>\n<\/ul>\n<ul>\n<li aria-level=\"1\"><a href=\"https:\/\/blog.kraken.com\/post\/14885\/pow-vs-pos-securing-the-chain\/\"><span style=\"font-weight: 400;\">PoW vs. PoS: Securing the Chain | Kraken Blog<\/span><\/a><span style=\"font-weight: 400;\">\u00a0<\/span><\/li>\n<\/ul>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/www.kraken.com\/learn\/ethereum-merge-explained\"><span style=\"font-weight: 400;\">What is The Ethereum Merge? | Kraken Learn Center<\/span><\/a><span style=\"font-weight: 400;\">\u00a0<\/span><\/li>\n<\/ul>\n<h3><b>Will Kraken make more assets available?<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found here, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.\u00a0<\/span><\/p>\n<h3><b>Trade with caution<\/b><\/h3>\n<p><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n<p>&nbsp;<\/p>\n<hr \/>\n<p><i><span style=\"font-weight: 400;\">These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell or hold any digital asset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position.<\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We are pleased to announce that Kraken now supports EthereumPoW (ETHW). Funding and Trading ETHW trading is live and the ETHW token has been distributed to eligible clients. A further announcement will be made once Funding is live, at which point you will be able to add ETHW to your Kraken account by navigating to [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":15495,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789],"tags":[1682],"language":[],"class_list":["post-15482","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","tag-ethw"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>EthereumPoW (ETHW) trading starts now + token distribution - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/asset-listings\/ethereumpow-ethw-trading-starts-now-token-distribution\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"EthereumPoW (ETHW) trading starts now + token distribution\" \/>\n<meta property=\"og:description\" content=\"We are pleased to announce that Kraken now supports EthereumPoW (ETHW). Funding and Trading ETHW trading is live and the ETHW token has been distributed to eligible clients. A further announcement will be made once Funding is live, at which point you will be able to add ETHW to your Kraken account by navigating to [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/asset-listings\/ethereumpow-ethw-trading-starts-now-token-distribution\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2022-09-16T04:33:17+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-06-13T12:13:46+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-inner-Single-token-2.png?fit=2190%2C2509&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"2190\" \/>\n\t<meta property=\"og:image:height\" content=\"2509\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"krakenfx\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"krakenfx\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/ethereumpow-ethw-trading-starts-now-token-distribution#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/ethereumpow-ethw-trading-starts-now-token-distribution\"},\"author\":{\"name\":\"krakenfx\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/461b7fbe1832d96cab8eb182c6642a21\"},\"headline\":\"EthereumPoW (ETHW) trading starts now + token distribution\",\"datePublished\":\"2022-09-16T04:33:17+00:00\",\"dateModified\":\"2023-06-13T12:13:46+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/ethereumpow-ethw-trading-starts-now-token-distribution\"},\"wordCount\":727,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/ethereumpow-ethw-trading-starts-now-token-distribution#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2022\\\/09\\\/Blog-inner-Single-token-2.png?fit=2190%2C2509&ssl=1\",\"keywords\":[\"ETHW\"],\"articleSection\":[\"Asset Listings\"],\"inLanguage\":\"en-US\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/ethereumpow-ethw-trading-starts-now-token-distribution\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/asset-listings\\\/ethereumpow-ethw-trading-starts-now-token-distribution\",\"name\":\"EthereumPoW (ETHW) trading starts now + token distribution - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#webs