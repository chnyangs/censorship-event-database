/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/461b7fbe1832d96cab8eb182c6642a21","name":"krakenfx","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/04487d6556c0179da80ad38a8388130aae1fbdf092aac5bdc95f97ca322e6b7b?s=96&d=identicon&r=g","caption":"krakenfx"},"sameAs":["https:\/\/blog.kraken.com"],"url":"https:\/\/blog.kraken.com\/author\/krakenfx"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-447","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/SUNFLOWER-CAROUSEL.png?fit=2946%2C1472&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15631","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/120066484"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=15631"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15631\/revisions"}],"predecessor-version":[{"id":22501,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/15631\/revisions\/22501"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/15636"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=15631"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=15631"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=15631"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=15631"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":15661,"date":"2022-09-28T14:52:09","date_gmt":"2022-09-28T14:52:09","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=15661"},"modified":"2023-06-09T16:01:11","modified_gmt":"2023-06-09T20:01:11","slug":"trading-for-c98-gal-rpl-stg-and-syn-starts-september-29-deposit-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/trading-for-c98-gal-rpl-stg-and-syn-starts-september-29-deposit-now","title":{"rendered":"Trading for C98, GAL, RPL, STG and SYN starts September 29 &#8211; Deposit Now!"},"content":{"rendered":"<div class=\"wp-block-image\">\n<figure class=\"aligncenter\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"4608\" height=\"2101\" data-attachment-id=\"15663\" data-permalink=\"https:\/\/blog.kraken.com\/blog-inner-multi-token-23\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?fit=4608%2C2101&amp;ssl=1\" data-orig-size=\"4608,2101\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Blog Inner &amp;#8211; Multi token\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?fit=1024%2C467&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=4608%2C2101&#038;ssl=1\" alt=\"\" class=\"wp-image-15663\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?w=4608&amp;ssl=1 4608w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=300%2C137&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=1024%2C467&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=768%2C350&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=1536%2C700&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=2048%2C934&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?resize=200%2C91&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/09\/Blog-Inner-Multi-token-1.png?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n<\/div>\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">We\u2019re thrilled to announce that Kraken now supports <\/span><b>Coin98 (C98)<\/b><b>,<\/b> <b>Galxe (GAL), Rocket Pool (RPL), Stargate Finance (STG)<\/b><span style=\"font-weight: 400;\"> and <\/span><b>Synapse (SYN)!<\/b><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><span style=\"font-weight: 400;\">Funding and Trading<\/span><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Funding is live, and trading will begin on<\/span><span style=\"font-weight: 400;\"> September 29 at approximately 14:30 UTC. <\/span><span style=\"font-weight: 400;\">Keep an eye on the <\/span><a href=\"https:\/\/status.kraken.com\/\"><span style=\"font-weight: 400;\">status page<\/span><\/a><span style=\"font-weight: 400;\"> for updates.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">You can add these tokens to your Kraken account by navigating to <\/span><a href=\"https:\/\/www.kraken.com\/u\/funding\"><b>Funding<\/b><\/a><span style=\"font-weight: 400;\">, selecting the asset, and hitting <\/span><b>Deposit<\/b><span style=\"font-weight: 400;\">. Deposits require <\/span><b>70 confirmations (14 minutes)<\/b><span style=\"font-weight: 400;\"> for all.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">All tokens are tradeable against <\/span><b>USD <\/b><span style=\"font-weight: 400;\">and <\/span><b>EUR<\/b><span style=\"font-weight: 400;\"> on <\/span><a href=\"https:\/\/www.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken<\/span><\/a><span style=\"font-weight: 400;\"> and the <\/span><a href=\"https:\/\/trade.kraken.com\/\"><span style=\"font-weight: 400;\">Kraken Terminal<\/span><\/a><span style=\"font-weight: 400;\">&nbsp;interface with the following parameters:<\/span><\/p>\n\n\n\n<figure class=\"wp-block-table\"><table><tbody><tr><td><b>Asset<\/b><\/td><td><b>Pair<\/b><\/td><td><b>Price Decimal <br>Precision<\/b><\/td><td><b>Minimum <br>Order Size<\/b><\/td><td><b>Minimum <br>Deposit<\/b><\/td><\/tr><tr><td><span style=\"font-weight: 400;\">C98<\/span><\/td><td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td><td><span style=\"font-weight: 400;\">4<\/span><\/td><td><span style=\"font-weight: 400;\">10<\/span><\/td><td><span style=\"font-weight: 400;\">8<\/span><\/td><\/tr><tr><td><span style=\"font-weight: 400;\">GAL<\/span><\/td><td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td><td><span style=\"font-weight: 400;\">4<\/span><\/td><td><span style=\"font-weight: 400;\">1<\/span><\/td><td><span style=\"font-weight: 400;\">2<\/span><\/td><\/tr><tr><td><span style=\"font-weight: 400;\">RPL<\/span><\/td><td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td><td><span style=\"font-weight: 400;\">2<\/span><\/td><td><span style=\"font-weight: 400;\">0.1<\/span><\/td><td><span style=\"font-weight: 400;\">0.2<\/span><\/td><\/tr><tr><td><span style=\"font-weight: 400;\">STG<\/span><\/td><td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td><td><span style=\"font-weight: 400;\">4<\/span><\/td><td><span style=\"font-weight: 400;\">5<\/span><\/td><td><span style=\"font-weight: 400;\">10<\/span><\/td><\/tr><tr><td><span style=\"font-weight: 400;\">SYN<\/span><\/td><td><span style=\"font-weight: 400;\">USD, EUR<\/span><\/td><td><span style=\"font-weight: 400;\">4<\/span><\/td><td><span style=\"font-weight: 400;\">2<\/span><\/td><td><span style=\"font-weight: 400;\">10<\/span><\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><b>Note: Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/b><i><span style=\"font-weight: 400;\"> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/span><\/i><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Here\u2019s what you need to know about the assets:<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><b>Coin98 (C98)<\/b><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Coin98 is a decentralized finance (DeFi) solution that allows users access to cross-chain swaps, staking and yield farming. Coin98 offers a full suite of products, including Coin98 Wallet, Coin98 Exchange and Space Gate (a cross-chain bridge). The C98 token is the native utility token of the platform and can be used to pay services fees and incentivize staking. It is also used to vote on governance proposals and to grant access to unique membership rights.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><b>Galxe (GAL)<\/b><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Galaxe, formerly known as Project Galaxy, provides an open, decentralized, and multi-chain framework for digital credentials. The protocol aims to create an infrastructure that enables a unified identity system for Web3 platforms. GAL is the native token for the project and can be used to pay for the use of the data network, create and edit credentials as well as to vote on platform fees and the use of treasury funds.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><b>Rocket Pool (RPL)<\/b><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Rocket Pool is a decentralized staking service for Ethereum\u2019s ETH cryptocurrency. Rocket Pool allows stakers to create a node with 16 ETH rather than the standard 32 ETH. RPL is the native cryptocurrency of the protocol, used to incentivize honest staking behavior as well as to participate in the governance and future development of protocol.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><b>Stargate Finance (STG)<\/b><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Stargate Finance is a composable liquidity transport protocol. Users can transfer assets cross-chain with Stargate\u2019s Omnichain native asset bridge and access the protocol\u2019s unified liquidity pools that enable decentralized lending and borrowing. The native token STG can be staked on the Stargate platform and is used to reward users who provide liquidity.<\/span><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><b>Synapse (SYN)<\/b><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Synapse is a cross-chain decentralized exchange (DEX) allowing transactions between Layer 1, sidechain and Layer 2 ecosystems. The protocol facilitates interoperability between blockchains with its asset bridge, token swap, liquidity pools and staking opportunities. SYN is the platform\u2019s governance token, giving holders a say in the direction of the platform. It is also used to pay for transactions within the network and incentivize liquidity providers.<\/span><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><b>Will Kraken make more assets available?<\/b><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/span><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><b>Trade with caution<\/b><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"font-weight: 400;\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/span><\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"wp-block-paragraph\"><i><span style=\"font-weight: 400;\">These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell or hold any cryptoasset or to engage in any specific trading strategy. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position.<\/span><\/i><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Kraken now supports Coin98 (C98), Galxe (GAL), Rocket Pool (RPL), Stargate Finance (STG) and Synapse (SYN)! Funding and Trading Funding is live, and trading will begin on September 29 at approximately 14:30 UTC. Keep an eye on the status page for updates. You can add these tokens to your Kraken [&hellip;]<\/p>\n","protected":false},"author":120066484,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1683,1684,1685,1686,1687],"language":[],"class_list":["post-15661","post","type-post","status-publish","format-standard","hentry","category-asset-listings","category-product","tag-c98","tag-gal","tag-rpl","tag-stg","tag-syn"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for C98, GAL, RPL, STG and SYN starts September 29 - Deposit Now! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/trading-for-c98-gal-rpl-stg-and-syn-starts-september-29-deposit-now\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Trading for C98, GAL, RPL, STG and SYN starts September 29 - Deposit Now!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that Kraken now supports Coin98 (C98), Galxe (GAL), Rocke