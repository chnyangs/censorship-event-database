ding\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/c83645a025bc9471ca9a0f7c34933483\"},\"headline\":\"Puffer Finance is available for trading!\",\"datePublished\":\"2024-10-14T13:18:56+00:00\",\"dateModified\":\"2024-10-16T08:26:31+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading\"},\"wordCount\":490,\"commentCount\":0,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/10\\\/3-Blog-1535x700-1.png?fit=3070%2C1400&ssl=1\",\"keywords\":[\"featured\",\"TON\"],\"articleSection\":[\"Asset Listings\",\"Product\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading\",\"name\":\"Puffer Finance is available for trading! - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading#primaryimage\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/puffer-finance-is-available-for-trading#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/10\\\/3-Blog-1535x700-1.png?fit=3070%2C1400&ssl=1\",\"datePublished\":\"2024-10-14T13:18:56+00:00\",\"dateModified\":\"2024-10-16T08:26:31+00:00\",\"breadcrumb\":{\"@id\":\"https:\\\/\\\/blog.kraken