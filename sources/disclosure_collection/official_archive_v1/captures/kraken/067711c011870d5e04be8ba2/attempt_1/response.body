raken.com\/wp-content\/uploads\/2024\/10\/image.png?fit=3070%2C1400&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/image.png?fit=3070%2C1400&ssl=1","width":3070,"height":1400},{"@type":"BreadcrumbList","@id":"https:\/\/blog.kraken.com\/news\/kbtc#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"Introducing Kraken Wrapped Bitcoin (kBTC): Unleashing Bitcoin\u2019s potential across networks"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/seDd1v-kbtc","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/image.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25947","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=25947"}],"version-history":[{"count":58,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25947\/revisions"}],"predecessor-version":[{"id":26767,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25947\/revisions\/26767"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/26312"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=25947"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=25947"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=25947"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=25947"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":26203,"date":"2024-10-17T11:01:37","date_gmt":"2024-10-17T15:01:37","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=26203"},"modified":"2024-10-22T07:30:25","modified_gmt":"2024-10-22T11:30:25","slug":"introducing-icloud-backup-for-kraken-wallet","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet","title":{"rendered":"Introducing iCloud backup for Kraken Wallet"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Kraken Wallet now offers encrypted iCloud backups for your secret recovery phrase (SRP). This feature provides a simple and secure way to store your SRP and recover your wallet, helping ensure you always have access to your cryptoassets.&nbsp;<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-self-custody-with-peace-of-mind\"><strong>Self-custody with peace of mind<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/wallet\">Kraken Wallet<\/a> users enjoy the freedom of self-custody, retaining full control over their own funds. However, this power comes with the responsibility of safeguarding your SRP. An SRP, also known as a seed phrase or mnemonic phrase, is the randomly generated set of words permanently associated with a crypto wallet that allows a user to access and restore or migrate that crypto wallet.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/kwallet.app.link\/TpSUuw1VGIb\" target=\"_blank\" rel=\"noopener\">Download Kraken Wallet<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\">If you lose access to your wallet and don&#8217;t have your SRP, you will not be able to recover your assets. The most common way to store your SRP is by manually writing it down and keeping it somewhere safe. While we encourage all users to take this important step, we want to offer additional peace of mind. This is why we&#8217;ve introduced encrypted iCloud backup.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This new feature encrypts your 12-word SRP and securely stores it in a unique Passkey. By leveraging iCloud Keychain infrastructure, your Passkey is automatically synced across all your devices. This means you no longer have to worry about lost or new devices.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Recovery is simple: you can import your iCloud backup with just a few taps. You\u2019ll also always have the option of manually importing your SRP.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-best-in-class-security\"><strong>Best-in-class security<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken takes security extremely seriously, which is why we engaged Trail of Bits, an industry leading security auditor, to conduct a thorough review of our code. You can <a href=\"https:\/\/github.com\/krakenfx\/wallet\/tree\/main\/audits\">read their full report for yourself<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019ve designed the iCloud backup feature utilizing cutting-edge security features.&nbsp;<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Encrypted cloud recovery using <a href=\"https:\/\/support.apple.com\/en-us\/102195\">Passkeys<\/a> with Large Blob extension for iOS. Compatible with iOS 17 and later versions<\/li>\n\n\n\n<li>The Large Blob extension enables the secure storage of user-specific data that is cryptographically bound to a Passkey credential. (Your SRP is stored directly with the Passkey)<\/li>\n\n\n\n<li>This data can be retrieved only when the user successfully authenticates with the Passkey<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">What does all this mean? <strong>You don\u2019t have to trust Kraken or Apple to know that your Secret Recovery Phrase is securely stored<\/strong><em>. <\/em>Put simply, <strong><em>only you<\/em><\/strong> hold the key to view and use your SRP. Apple can\u2019t see it, and neither can we.&nbsp;<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-get-started-with-icloud-backup-today\"><strong>Get started with iCloud backup today<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019ll show just how simple it is to create and import your iCloud backup. For step by step instructions, refer to <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/sections\/icloud-backup\">our Support Center guide<\/a>.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-create-a-backup\"><strong>Create a backup<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">It\u2019s quick and easy to create a backup with Kraken Wallet, whether you\u2019re a new or existing user.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">New users can simply tap the <strong>Back up with iCloud<\/strong> option when creating a wallet. You\u2019ll then still have the option to manually back up your Secret Recovery Phrase for additional security.<\/p>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-1 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"232\" height=\"483\" data-attachment-id=\"26217\" data-permalink=\"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet\/attachment\/kw1-3\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw1-2.png?fit=232%2C483&amp;ssl=1\" data-orig-size=\"232,483\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kw1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw1-2.png?fit=232%2C483&amp;ssl=1\" data-id=\"26217\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw1-2.png?resize=232%2C483&#038;ssl=1\" alt=\"\" class=\"wp-image-26217\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw1-2.png?w=232&amp;ssl=1 232w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw1-2.png?resize=144%2C300&amp;ssl=1 144w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw1-2.png?resize=48%2C100&amp;ssl=1 48w\" sizes=\"auto, (max-width: 232px) 100vw, 232px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"233\" height=\"485\" data-attachment-id=\"26216\" data-permalink=\"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet\/attachment\/kw2-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw2-1.png?fit=233%2C485&amp;ssl=1\" data-orig-size=\"233,485\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kw2\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw2-1.png?fit=233%2C485&amp;ssl=1\" data-id=\"26216\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw2-1.png?resize=233%2C485&#038;ssl=1\" alt=\"\" class=\"wp-image-26216\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw2-1.png?w=233&amp;ssl=1 233w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw2-1.png?resize=144%2C300&amp;ssl=1 144w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw2-1.png?resize=48%2C100&amp;ssl=1 48w\" sizes=\"auto, (max-width: 233px) 100vw, 233px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"232\" height=\"484\" data-attachment-id=\"26218\" data-permalink=\"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet\/attachment\/kw3-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw3-1.png?fit=232%2C484&amp;ssl=1\" data-orig-size=\"232,484\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kw3\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw3-1.png?fit=232%2C484&amp;ssl=1\" data-id=\"26218\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw3-1.png?resize=232%2C484&#038;ssl=1\" alt=\"\" class=\"wp-image-26218\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw3-1.png?w=232&amp;ssl=1 232w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw3-1.png?resize=144%2C300&amp;ssl=1 144w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw3-1.png?resize=48%2C100&amp;ssl=1 48w\" sizes=\"auto, (max-width: 232px) 100vw, 232px\" \/><\/figure>\n<\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Existing users can navigate to Settings and tap the <strong>Back up with iCloud <\/strong>option to get started.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignleft size-large is-resized\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"492\" height=\"1024\" data-attachment-id=\"26220\" data-permalink=\"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet\/attachment\/kw4\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?fit=727%2C1514&amp;ssl=1\" data-orig-size=\"727,1514\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kw4\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?fit=492%2C1024&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?resize=492%2C1024&#038;ssl=1\" alt=\"\" class=\"wp-image-26220\" style=\"width:224px;height:auto\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?resize=492%2C1024&amp;ssl=1 492w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?resize=144%2C300&amp;ssl=1 144w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?resize=48%2C100&amp;ssl=1 48w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw4.png?w=727&amp;ssl=1 727w\" sizes=\"auto, (max-width: 492px) 100vw, 492px\" \/><\/figure>\n<\/div>\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-import-a-backup\"><strong>Import a backup<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Simply tap the <strong>Import <\/strong>button and select <strong>Import from iCloud<\/strong>.<\/p>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-2 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"488\" height=\"1024\" data-attachment-id=\"26242\" data-permalink=\"https:\/\/blog.kraken.com\/product\/introducing-icloud-backup-for-kraken-wallet\/attachment\/kw41-5\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw41-4.png?fit=725%2C1521&amp;ssl=1\" data-orig-size=\"725,1521\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"kw41\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/kw41-4.png?fit=488%2C1024&amp;ssl=1\