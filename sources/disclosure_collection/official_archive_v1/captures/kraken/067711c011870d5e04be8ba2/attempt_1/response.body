pack_shortlink":"https:\/\/wp.me\/peDd1v-6Ns","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/image2.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26130","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089406"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=26130"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26130\/revisions"}],"predecessor-version":[{"id":26152,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26130\/revisions\/26152"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/26131"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=26130"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=26130"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=26130"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=26130"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":26153,"date":"2024-10-11T17:55:56","date_gmt":"2024-10-11T21:55:56","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=26153"},"modified":"2024-10-14T10:16:24","modified_gmt":"2024-10-14T14:16:24","slug":"2024-rear-wing-takeover-winners","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/nft\/2024-rear-wing-takeover-winners","title":{"rendered":"Kraken x Williams: First look at the winners of the 2024 Rear Wing Takeover contest"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We are proud to unveil the Williams Racing rear wing design chosen by fans in our second annual Rear Wing Takeover contest!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The FW46 cars driven by Alex Albon and Franco Colapinto will feature six fans\u2019 digital alter egos from <a href=\"https:\/\/blog.kraken.com\/product\/nft\/cosmos-collection\">the Cosmos collection<\/a>. Tens of thousands of fans around the world voted to decide which collectibles would make up the rear wing mosaic:<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" data-attachment-id=\"26155\" data-permalink=\"https:\/\/blog.kraken.com\/product\/nft\/2024-rear-wing-takeover-winners\/attachment\/rear-wing-edited\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?fit=7650%2C5100&amp;ssl=1\" data-orig-size=\"7650,5100\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Rear Wing Edited\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?fit=1024%2C683&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited-1024x683.jpg?resize=1024%2C683&#038;ssl=1\" alt=\"\" class=\"wp-image-26155\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=1024%2C683&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=300%2C200&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=768%2C512&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=1536%2C1024&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=2048%2C1365&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=1200%2C800&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?resize=150%2C100&amp;ssl=1 150w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/10\/Rear-Wing-Edited.jpg?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/blog.kraken.com\/product\/nft\/the-rear-wing-takeover-competition-is-live\">Our 2023 contest<\/a> allowed fans to put their favorite digital collectible design from any public collection in the running to create a unique and diverse rear wing look based on fan voting and the drivers\u2019 own choices.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-about-the-collection\">About the collection<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Earlier this year, Kraken and Williams Racing sent 100,000 supporters holding a free <a href=\"https:\/\/nft.kraken.com\/williams-grid-pass\">Williams+ Collectibles Grid Pass<\/a> one randomly generated digital art profile picture (PFP). The PFP was a part of the Cosmos collection.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Unique traits were integrated with iconic Williams Racing branding across 10 different character types, ranging from cats to dragons to krakens. It was conceptualized and brought to life by the lead artist for DeGods and y00ts, Candy Apple.&nbsp;<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-fans-chose-the-design\">How fans chose the design<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Those Cosmos collectible holders were then encouraged to submit their PFP for a chance to feature their unique character on the car. More than 35,000 votes were cast for the winning design.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The Rear Wing Takeover winning design will make its race debut during a significant milestone for Williams Racing: The U.S. F1 Grand Prix in Austin will mark Alex Albon\u2019s 100th Formula 1 race.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-can-i-see-the-rear-wing-design-in-person\">How can I see the rear wing design in person?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Fans visiting the Williams Racing Fan Zone in Austin will have the chance for an up-close look at the rear wing design on the Williams FW46s. They will be displayed at 800 Congress, a downtown Austin event venue, from Monday, October 14 to Sunday, October 20. For more information please visit <a href=\"http:\/\/williamsf1.com\/fan-zone\">WilliamsF1.com\/fan-zone<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If you don\u2019t already have one, be sure to grab a free <a href=\"https:\/\/nft.kraken.com\/williams-grid-pass\">Williams+ Collectibles Grid Pass<\/a> collectible to get immediate perks designed exclusively for Williams Racing fans \u2013 maximize the Fan Zone experience during your visit!<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/nft.kraken.com\/williams-grid-pass\" target=\"_blank\" rel=\"noopener\">Explore Kraken x Williams<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake, or hold any cryptoasset or to engage in any specific trading strategy. Kraken makes no representation or warranty of any kind, express or implied, as to the accuracy, completeness, timeliness, suitability or validity of any such information and will not be liable for any errors, omissions, or delays in this information or any losses, injuries, or damages arising from its display or use. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We are proud to unveil the Williams Racing rear wing design chosen by fans in our second annual Rear Wing Takeover contest! The FW46 cars driven by Alex Albon and Franco Colapinto will feature six fans\u2019 digital alter egos from the Cosmos collection. Tens of thousands of fans around the world voted to decide which [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":25863,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1460],"tags":[1373,14