":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089406"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=26086"}],"version-history":[{"count":5,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26086\/revisions"}],"predecessor-version":[{"id":26093,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/26086\/revisions\/26093"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/26087"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=26086"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=26086"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=26086"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=26086"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":26074,"date":"2024-10-03T08:25:27","date_gmt":"2024-10-03T12:25:27","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=26074"},"modified":"2024-11-18T17:19:08","modified_gmt":"2024-11-18T22:19:08","slug":"eigen-available-for-trading","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/eigen-available-for-trading","title":{"rendered":"EIGEN available for trading!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that EIGEN is now available for trading on Kraken!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-funding-and-trading\"><strong>Funding and trading<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Trading for EIGEN is live as of 04:00 AM UTC today, October 1, 2024.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Make sure to deposit your tokens into networks supported by Kraken. Deposits made using other networks will be lost.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/krakenpro.onl\/OBT6\/zv4i7860\" target=\"_blank\" rel=\"noopener\">Trade on Kraken<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\">The new tokens are tradeable on <a href=\"https:\/\/www.kraken.com\/\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\">Kraken Pro<\/a> with the following parameters:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/th><th><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/th><th><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Price decimal precision<\/mark><\/strong><\/th><th><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/th><th><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/th><\/tr><\/thead><tbody><tr><td>EIGEN<\/td><td>USD, EUR<\/td><td>3<\/td><td>1<\/td><td>1<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-these-assets\">Here\u2019s some more information about these assets:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/eigenlayer\">EIGEN<\/a> &#8211; <\/strong>EigenLayer is a protocol on Ethereum designed to extend Ethereum\u2019s crypto-economic security to new use cases via distributed systems called \u201cActively Validated Services\u201d (AVSs), which are defined as any system that requires its own distributed validation semantics for verification, such as sidechains, data availability (DA) layers, new virtual machines, etc.<br><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading has-text-align-left\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h2>\n\n\n\n<p class=\"has-text-align-left wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<br><\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"has-text-align-left wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake, or hold any cryptoasset or to engage in any specific trading strategy. Kraken makes no representation or warranty of any kind, express or implied, as to the accuracy, completeness, timeliness, suitability or validity of any such information and will not be liable for any errors, omissions, or delays in this information or any losses, injuries, or damages arising from its display or use. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that EIGEN is now available for trading on Kraken! Funding and trading Trading for EIGEN is live as of 04:00 AM UTC today, October 1, 2024. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens [&hellip;]<\/p>\n","protected":false},"author":230089406,"featured_media":26094,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1373],"language":[],"class_list":["post-26074","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-featured"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>EIGEN available for trading! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/eigen-available-for-trading\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"EIGEN available for trading!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that EIGEN is now available for trading on Kraken! Funding and trading Trading for EIGEN is live as of 04:00 AM UTC today, October 1, 2024. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/eigen-available-for-trading\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:publish