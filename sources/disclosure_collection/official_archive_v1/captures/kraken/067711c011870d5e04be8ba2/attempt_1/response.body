tUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Kraken\u2019s workforce: Forever remote-first - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/industry-news\/krakens-workforce-forever-remote-first","og_locale":"en_US","og_type":"article","og_title":"Kraken\u2019s workforce: Forever remote-first","og_description":"Since 2011, Kraken has been crushing the myth that innovation requires a centralized office.\u00a0Now, we're doubling down on our remote-first policy.","og_url":"https:\/\/blog.kraken.com\/news\/industry-news\/krakens-workforce-forever-remote-first","og_site_name":"Kraken Blog","article_published_time":"2024-09-19T15:00:05+00:00","article_modified_time":"2024-09-24T10:38:38+00:00","og_image":[{"width":1575,"height":700,"url":"https:\/\/blog.kra