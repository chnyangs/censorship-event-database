id-pass#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/product\\\/nft\\\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/nft\\\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass#primaryimage\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/10\\\/comp_hd_v02_banner_1536_700__1_.png?fit=1536%2C700&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2023\\\/10\\\/comp_hd_v02_banner_1536_700__1_.png?fit=1536%2C700&ssl=1\",\"width\":1536,\"height\":700},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/nft\\\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\\/\\\/blog.kraken.com\\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Introducing the ultimate free fan engagement experience: Williams Racing Collectibles+ Grid Pass\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"name\":\"Kraken Blog\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\\/\\\/blog.kraken.com\\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\",\"name\":\"Kraken Blog\",\"url\":\"https:\\\/\\\/blo