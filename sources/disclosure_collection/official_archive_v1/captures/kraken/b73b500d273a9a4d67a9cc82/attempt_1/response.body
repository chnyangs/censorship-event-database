e","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"4 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"Bivu Das joins Kraken as UK Managing Director","datePublished":"2023-10-27T13:30:36+00:00","dateModified":"2023-10-31T16:11:59+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director"},"wordCount":844,"commentCount":0,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/10\/Blog-Bivu-Das.png?fit=3070%2C1400&ssl=1","keywords":["featured","Kraken"],"articleSection":["News"],"inLanguage":"en-US","potentialAction":[{"@type":"CommentAction","name":"Comment","target":["https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director#respond"]}]},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director","url":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director","name":"Bivu Das joins Kraken as UK Managing Director - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director#primaryimage"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/bivu-das-joins-kraken-as-uk-managing-director#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/10\/Blog-Bivu-Das.png?fit=3070%2C1400&ssl=1","datePublished":"2023-10-27T13:3