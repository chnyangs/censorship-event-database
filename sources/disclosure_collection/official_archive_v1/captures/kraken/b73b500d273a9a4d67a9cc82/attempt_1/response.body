escription":"Collect your free pass and unlock immediate exclusive digital and physical perks and access to unique Williams Racing experiences, powered by Kraken. Kraken, the Official Crypto and Web3 Partner of Williams Racing, is excited to announce a new innovation in fan engagement and digital collectibles; Williams Racing Collectibles+ Grid Pass, powered by Kraken. The program [&hellip;]","og_url":"https:\/\/blog.kraken.com\/product\/nft\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass","og_site_name":"Kraken Blog","article_published_time":"2023-10-17T16:03:46+00:00","article_modified_time":"2023-10-31T15:14:41+00:00","og_image":[{"width":1536,"height":700,"url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/10\/comp_hd_v02_banner_1536_700__1_.png?fit=1536%2C700&ssl=1","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"5 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/product\/nft\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/product\/nft\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/05fd1aef04d178f2231400ddb85550a2"},"headline":"Introducing the ultimate free fan engagement experience: Williams Racing Collectibles+ Grid Pass","datePublished":"2023-10-17T16:03:46+00:00","dateModified":"2023-10-31T15:14:41+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/product\/nft\/introducing-the-ultimate-free-fan-engagement-experience-williams-racing-collectibles-grid-pass"},"wordCount":969,"commentCount":0,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\