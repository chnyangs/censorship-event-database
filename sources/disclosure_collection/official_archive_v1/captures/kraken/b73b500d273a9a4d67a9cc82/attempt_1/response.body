aken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-68M","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/10\/BATTLE-STATIONS.02A.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23608","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=23608"}],"version-history":[{"count":6,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23608\/revisions"}],"predecessor-version":[{"id":23629,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23608\/revisions\/23629"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/23616"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=23608"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=23608"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=23608"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=23608"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":23617,"date":"2023-10-04T10:15:11","date_gmt":"2023-10-04T14:15:11","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=23617"},"modified":"2023-10-04T10:15:12","modified_gmt":"2023-10-04T14:15:12","slug":"kraken-one-of-newsweeks-2023-top-100-uk-most-loved-workplaces","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/kraken-one-of-newsweeks-2023-top-100-uk-most-loved-workplaces","title":{"rendered":"Kraken one of Newsweek\u2019s 2023 Top 100 UK Most Loved Workplaces"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re proud to announce that we have been named #18 on Newsweek\u2019s Top 100 UK Most Loved Workplaces list. This recognition showcases our truly unique employer brand offering, which emphasises flexibility, career development and the well-being of our Krakenites.&nbsp;&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Newsweek\u2019s rankings, backed by the rigorous analysis of the Best Practice Institute, are based on survey results of more than two million employees from different industries and company sizes. Newsweek publishes its annual list of the Top 100 UK companies that build their business models around respect, care and employee appreciation.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cThe UK has a track record of pioneering innovative HR and workplace practices. We\u2019re incredibly proud to be regarded alongside the UK\u2019s best known companies for our strong employer brand credentials,\u201d said Pranesh Anthapur, Kraken\u2019s Chief People Officer.&nbsp;&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Anthapur added, \u201cOur employer brand approach is one of a kind, but we recognise and value our Krakenites\u2019 daily efforts to drive our overall mission of accelerating crypto adoption. In return, we have built a framework that provides flexibility, autonomy and holistic benefits to enable our people to love their workplace experience.\u201d&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Today\u2019s recognition follows our inclusion in Newsweek\u2019s <a href=\"https:\/\/www.newsweek.com\/rankings\/global-most-loved-workplaces-2023\">Top 100 Global Most Loved Workplaces list<\/a> in May 2023, and Newsweek\u2019s <a href=\"https:\/\/www.newsweek.com\/rankings\/most-loved-workplaces-america-2023\">Top 100 American Most Loved Workplaces list<\/a> last month.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">What makes Kraken such a great place to work? In addition to compelling career growth and learning opportunities, we offer holistic health and wellness benefits. These include truly flexible annual leave practices, access to in-house fitness and well-being coaches, as well as a generous grant to build a customised in-home office.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Krakenites are also invested in the success of the company and the broader industry. Nearly 40% receive a part of their salary in digital assets and many of our roles come with company share options included in the compensation package.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ready to join the revolution? Find your role at Kraken today!<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/careers\" target=\"_blank\" rel=\"noopener\">Careers at Kraken<\/a><\/div>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re proud to announce that we have been named #18 on Newsweek\u2019s Top 100 UK Most Loved Workplaces list. This recognition showcases our truly unique employer brand offering, which emphasises flexibility, career development and the well-being of our Krakenites.&nbsp;&nbsp; Newsweek\u2019s rankings, backed by the rigorous analysis of the Best Practice Institute, are based on survey [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":23620,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1403],"language":[],"class_list":["post-23617","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-kraken"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken one of Newsweek\u2019s 2023 Top 100 UK Most Loved Workplaces - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/kraken-one-of-newsweeks-2023-top-100-uk-most-loved-workplaces\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Kraken one of Newsweek\u2019s 2023 Top 100 UK Most Loved Workplaces\" \/>\n<meta property=\"og:description\" content=\"We\u2019re proud to announce that we have been named #18 on Newsweek\u2019s Top 100 UK Most Loved Workplaces list. This recognition showcases our truly unique employer brand offering, which emphasises flexibility