ttps:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=23588"}],"version-history":[{"count":9,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23588\/revisions"}],"predecessor-version":[{"id":23632,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23588\/revisions\/23632"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/21092"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=23588"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=23588"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=23588"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=23588"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":23573,"date":"2023-09-29T07:27:21","date_gmt":"2023-09-29T11:27:21","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=23573"},"modified":"2023-10-04T10:20:38","modified_gmt":"2023-10-04T14:20:38","slug":"eth-and-op-deposits-and-withdrawals-now-available-on-optimism","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/eth-and-op-deposits-and-withdrawals-now-available-on-optimism","title":{"rendered":"ETH and OP deposits and withdrawals now available on Optimism!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of <strong>Ethereum (ETH) and Optimism (OP) on Optimism. <\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Additionally, <strong>Optimism<\/strong> <strong>(OP) is now available on Kraken!<\/strong><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Funding and trading<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Optimism (OP) funding and trading are already live. You can transfer ETH or OP to your Kraken account by navigating to <a rel=\"noreferrer noopener\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\"><strong>Funding<\/strong><\/a> and selecting <strong>ETH or OP<\/strong>. From the drop-down menu, you can then select the desired deposit method (network): <strong>Optimism<\/strong>.<br><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Got ETH or OP on Optimism and a Kraken account? <\/em>\u2935\ufe0f<\/strong><\/p>\n\n\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\">\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/kraken.app.link\/7aAwLVjJrDb\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken<\/a>\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/krakenpro.app.link\/lGZBO3cKrDb\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken Pro<\/a>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">OP is tradeable on <a href=\"https:\/\/www.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/app\/trade\/op-usd\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Pro<\/a> with the following parameters:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table><tbody><tr><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#5841d8\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#5841d8\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#5841d8\" class=\"has-inline-color\">Asset decimal precision<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#5841d8\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#5841d8\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/td><\/tr><tr><td>OP<\/td><td>USD, EUR<\/td><td>4<\/td><td>4<\/td><td>0.5<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Here\u2019s what you need to know about the assets<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/ethereum\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Ethereum (ETH)<\/strong><\/a> is a global, open-source platform for decentralized applications. Ethereum is a marketplace of financial services, games and apps that is trustless, decentralized and secure. ETH is the cryptocurrency powering the Ethereum network. It&#8217;s used to pay for transactions, as a store of value or peer-to-peer payment method, or as collateral to generate entirely different crypto tokens that run on Ethereum. Learn how to add ETH to your crypto portfolio with our Learn Center article <a rel=\"noreferrer noopener\" href=\"https:\/\/www.kraken.com\/learn\/buy-ethereum-eth\" target=\"_blank\"><strong>How to Buy Ethereum (ETH)<\/strong><\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/optimism\">Optimism (OP)<\/a><\/strong> is a Layer 2 scaling solution implemented on the Ethereum network. It employs a technology known as optimistic rollups to aggregate multiple transactions, thereby alleviating congestion and lowering transaction fees on the Ethereum mainnet. OP is Optimism&#8217;s native <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\">governance token<\/a>, which allows OP token holders to participate in decisions regarding the protocol&#8217;s future direction, upgrades and parameters.<\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Ready to deposit but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noreferrer noopener\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Trade with caution<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">There is no guarantee that a limit order will execute. There is also no guarantee a market order will execute at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https:\/\/www.kraken.com\/referrals\" target=\"_blank\" rel=\"noreferrer noopener\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"213\" data-attachment-id=\"15784\" data-permalink=\"https:\/\/blog.kraken.com\/subhead_reflink-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1200%2C250&amp;ssl=1\" data-orig-size=\"1200,250\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"subhead_reflink (1)\" data-image-description=\"\" data-image-caption=\"&lt;p&gt;Referral cta image&lt;\/p&gt;\n\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?fit=1024%2C213&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1024%2C213&#038;ssl=1\" alt=\"Referral link image\" class=\"wp-image-15784\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=1024%2C213&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=300%2C63&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=768%2C160&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?resize=200%2C42&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2022\/10\/subhead_reflink-1.png?w=1200&amp;ssl=1 1200w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/a><\/figure>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of Ethereum (ETH) and Optimism (OP) on Optimism. Additionally, Optimism (OP) is now available on Kraken! Funding and trading Optimism (OP) funding and trading are already live. You can transfer ETH or OP to your Kraken account by navigating to Funding and selecting ETH [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":23576,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1457,1373,1813],"language":[],"class_list":["post-23573","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-eth","tag-featured","tag-op"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>ETH and OP deposits and withdrawals now available on Optimism! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/eth-and-op-deposits-and-withdrawals-now-available-on-optimism\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"ETH and OP deposits and withdrawals now available on Optimism!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re thrilled to announce that Kraken now supports deposits and withdrawals of Ethereum (ETH) and Optimism (OP) on Optimism. Additionally, Optimism (OP) is now available on Kraken! Funding and trading Optimism (OP) funding and trading are already live. You can transfer ETH or OP to your Kraken account by navigating to Funding and selecting ETH [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/eth-and-op-deposits-and-withdrawals-now-available-on-optimism\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-09-29T11:27:21+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-10-04T14:20:38+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/09\/ETH_Optimism_BlogInner-1024x467.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1024\" \/>\n\t<meta property=\"og:image:height\" content=\"467\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"2 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/eth-and-op-deposits-and-withdrawals-now-available-on-optimism#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/eth-and-op-deposits-and-withdrawals-now-available-on-optimism\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/05fd1aef04d178f2231400ddb85550a2\"},\"headline\":\"ETH and OP deposits and withdrawals now available on Optimism!\",\"datePublished\":\"2023-09-29T11:27:21+00:00\",\"dateModified\":\"2023-10-04T14:20:38+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/eth-and-op-deposits-and-withdrawals-now-available-on-optimism\"},\"wordCount\":374,\"commentCoun