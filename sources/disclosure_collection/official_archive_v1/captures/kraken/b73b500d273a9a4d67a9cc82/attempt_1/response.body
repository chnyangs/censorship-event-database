blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-690","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/10\/Blog-image-Partnership-announcement-1.jpg?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23622","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=23622"}],"version-history":[{"count":4,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23622\/revisions"}],"predecessor-version":[{"id":23627,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23622\/revisions\/23627"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/23669"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=23622"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=23622"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=23622"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=23622"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":23647,"date":"2023-10-16T08:30:04","date_gmt":"2023-10-16T12:30:04","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=23647"},"modified":"2023-10-24T08:27:12","modified_gmt":"2023-10-24T12:27:12","slug":"everything-must-evolve-even-finance-see-what-crypto-can-be","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/everything-must-evolve-even-finance-see-what-crypto-can-be","title":{"rendered":"Everything must evolve, even finance: See What Crypto Can Be"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><em>We\u2019re launching our first global marketing campaign to drive forward our mission of accelerating the adoption of crypto so everyone can achieve financial freedom and inclusion.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">There has been too much focus on what\u2019s broken in the current financial system and not enough on crypto\u2019s potential as a driver of financial freedom and inclusion. We\u2019re proud to help the world <a href=\"http:\/\/kraken.com\/seewhatcryptocanbe\"><strong>See What Crypto Can Be<\/strong><\/a> in our first-ever global campaign. It\u2019s all about showcasing the incredible potential of cryptocurrency to transform lives and revolutionize finance worldwide.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Driven by education, we\u2019re aiming to inspire. We\u2019re focusing on the tangible, life-changing advantages of crypto today, with an eye toward the limitless possibilities of crypto\u2019s future:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Crypto is all the time<\/strong>: Forget \u201cMonday to Friday\u201d and \u201cbusiness hours.\u201d Crypto allows you to trade, transact and engage when you want to.<\/li>\n\n\n\n<li><strong>Crypto is borderless<\/strong>: Crypto transcends physical and imaginary borders. No matter where you are, you can send funds quickly and easily to any part of the world.<\/li>\n\n\n\n<li><strong>Crypto is for everyone: <\/strong>It doesn\u2019t matter where you\u2019re from, where you live or what your credit score is. Crypto is a level financial playing field that benefits everyone.<\/li>\n\n\n\n<li><strong>Crypto is permissionless<\/strong>: Crypto is open, inclusive and controlled by no one. Complete control over your finances, without rubber stamps or lengthy application forms.<\/li>\n\n\n\n<li><strong>Crypto is fast<\/strong>: Forget about waiting in lines and waiting times, you can send, receive and trade crypto near-instantly.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Our mission is clear: <strong>We are here to accelerate the global adoption of crypto so everyone can achieve financial freedom and inclusion.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>How?<\/strong> By helping people understand the remarkable progress crypto represents and the role they can play in shaping the future financial landscape. And this is <strong>why<\/strong>:<\/p>\n\n\n\n<iframe loading=\"lazy\" width=\"560\" height=\"315\" src=\"https:\/\/www.youtube.com\/embed\/IF-DpTh_hJ8?si=hJx4_7uqkT9PaUWV\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen><\/iframe>\n\n\n\n<p class=\"has-text-align-center has-small-font-size wp-block-paragraph\"><em>Mother London was our creative partner on this campaign.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">It&#8217;s all about moving forward together and creating a better experience for everyone. As one of the longest running and most trusted crypto platforms, we\u2019ve seen many competitors come and go. We\u2019ve been here for almost every market environment there is \u2013 for more than a decade. Through it all, we have never wavered from our mission and our cause.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cThis is our first global campaign for a reason &#8212; for 12 years we have grown organically through a great product built on world-class design and performance with a foundation of security and client service,\u201d said David Ripley, Kraken CEO. \u201cNow is the perfect time for us to step forward and celebrate Kraken as a mission-driven brand centered around our clients, while helping the next billion people understand what crypto can offer them today and into the future.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We&#8217;re laying the foundation for the next crypto bull run by reaching out now to the audiences who will be at the forefront of the next wave of crypto adoption. We believe in focusing on facts and not hype, on education and not FOMO, on empathy and not anxiety.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.theblock.co\/post\/148929\/lack-of-knowledge-about-bitcoin-is-the-biggest-barrier-to-use-finds-new-study-by-block-inc\">51% of people say they haven\u2019t purchased any bitcoin because they don\u2019t know enough about it<\/a>, and we seek to empower them by <a href=\"https:\/\/www.kraken.com\/learn\" data-type=\"link\" data-id=\"https:\/\/www.kraken.com\/learn\">providing the knowledge and tools needed<\/a> to be part of this transformative journey.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cKraken has always valued education and providing the right resources to clients,\u201d said Mayur Gupta, Kraken CMO. \u201cThe benefits of crypto are available to all, and Kraken is committed to providing beginners with a safe and accessible bridge to this exciting world. We want people to know Kraken and understand that we have always stood for crypto\u2019s mission and doing what is best for clients with a deep commitment to continually improving their experience.\u201d&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Join us as we redefine the crypto narrative, putting the power of knowledge and the promise of a brighter financial future squarely in your hands. Get ready to embark on this incredible crypto adventure with us and <a href=\"http:\/\/kraken.com\/seewhatcryptocanbe\"><strong>See What Crypto Can Be<\/strong><\/a>.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/blog.kraken.com\/go\/campaign-signup\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Kraken will not undertake efforts to increase the value of any cryptoasset that you buy. Crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re launching our first global marketing campaign to drive forward our mission of accelerating the adoption of crypto so everyone can achieve financial freedom and inclusion. There has been too much focus on what\u2019s broken in the current financial system and not enough on crypto\u2019s potential as a driver of financial freedom and inclusion. We\u2019re [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":23670,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1373,1403],"language":[],"class_list":["post-23647","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-featured","tag-kraken"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Everything must evolve, even finance: See What Crypto Can Be - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/everything-must-evolve-even-finance-see-what-crypto-can-be\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Everything must evolve, even finance: See What Crypto Can Be\" \/>\n<meta property=\"og:description\" content=\"We\u2019re launching our first global marketing campaign to drive forward our mission of accelerating the adoption of crypto so everyone can achieve financial freedom and inclusion. There has been too much focus on what\u2019s broken in the current financial system and not enough on crypto\u2019s potential as a driver of financial freedom and inclusion. We\u2019re [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/everything-must-evolve-even-finance-see-what-crypto-can-be\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2023-10-16T12:30:04+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2023-10-24T12:27:12+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/10\/1535x700.png?fit=1535%2C700&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"1535\" \/>\n\t<meta property=\"og:image:height\" content=\"700\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/everything-must-evolve-even-finance-see-what-crypto-can-be#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/everything-must-evolve-even-finance-see-what-crypto-can-be\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\"},\"headline\":\"Everything must evolve, even finance: See What Crypto Can Be\",\"datePublished\":\"2023-10-16T12:30:04+00:00\",\"dateModified\":\"2023-10-24T12:27:12+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/everything-must-evolve-eve