\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=23573"}],"version-history":[{"count":15,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23573\/revisions"}],"predecessor-version":[{"id":23604,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/23573\/revisions\/23604"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/23576"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=23573"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=23573"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=23573"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=23573"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":23608,"date":"2023-10-03T13:13:21","date_gmt":"2023-10-03T17:13:21","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=23608"},"modified":"2023-10-05T11:02:29","modified_gmt":"2023-10-05T15:02:29","slug":"announcing-the-kraken-pro-battlestation-contest","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/announcing-the-kraken-pro-battlestation-contest","title":{"rendered":"Announcing the Kraken Pro Battlestation Contest"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">The Kraken Pro Battlestation Contest is upon us! The participant who submits the most impressive battlestation trading setup on X\/Twitter will win a $1,000 gift card from <a href=\"https:\/\/secretlab.co\/\">Secretlab<\/a> chairs.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re excited to see your submissions and offer you a chance to win $1,000 toward a new gaming chair from Secretlab.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Entries must be completed during the Campaign Period: Oct. 6, 2023 00:00 UTC &#8211; Oct. 13, 2023 06:00 UTC.<\/strong><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>How to participate<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Reply to <a href=\"https:\/\/twitter.com\/krakenpro\/status\/1709255231739957262\">this tweet<\/a> during the Campaign Period with a photo of your battlestation including the <a href=\"https:\/\/pro.kraken.com\/app\/trade\/btc-usd\">https:\/\/pro.kraken.com\/app\/trade\/btc-usd<\/a> logged out landing page<\/li>\n\n\n\n<li>Like and repost the tweet<\/li>\n\n\n\n<li>Follow <a href=\"https:\/\/www.twitter.com\/krakenpro\">@KrakenPro<\/a> on X\/Twitter<\/li>\n\n\n\n<li>Make sure your account is public for the duration of the Campaign Period<\/li>\n\n\n\n<li>One (1) participant who completes the steps above during the Campaign Period will be selected by Kraken based on each battlestation\u2019s look, aesthetic and overall setup to win a <a href=\"https:\/\/secretlab.co\/\">Secretlab.com<\/a> gift card valued at $1,000<\/li>\n\n\n\n<li>We will DM the winners from <a href=\"https:\/\/www.twitter.com\/krakenpro\">@KrakenPro<\/a> via X\/Twitter with a Google Form to collect necessary information<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Who can participate<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Users residing in the US, CA, AU, UK, NZ and some EU countries who are at least eighteen (18) years of age<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Notes:<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Giveaway item(s) are limited<\/li>\n\n\n\n<li>Participation in the giveaway is strictly optional<\/li>\n\n\n\n<li>No purchase is necessary to enter or win<\/li>\n\n\n\n<li>Kraken will disqualify any entry from participants who do not meet the eligibility requirements as solely and absolutely determined by Kraken<\/li>\n\n\n\n<li>The entrant who is selected to receive the giveaway item will need to fill out the Google Form within 48 hours of being notified of winning<\/li>\n\n\n\n<li>Kraken reserves the right to cancel the campaign or amend the campaign mechanics or rules at any time at our sole discretion without prior notice to you<\/li>\n\n\n\n<li>By participating in the Giveaway, entrants acknowledge having read and agreed to the Kraken Terms of Service, which is published at <a href=\"https:\/\/www.kraken.com\/legal\">https:\/\/www.kraken.com\/legal<\/a>, and the Kraken Global Marketing Privacy Notice, which is published at <a href=\"https:\/\/www.kraken.com\/legal\/privacy\">https:\/\/www.kraken.com\/legal\/privacy<\/a>. Entrants understand that Kraken will use the information provided for the purposes of assessing entrants\u2019 eligibility to participate in the Giveaway, identity verification, prize draw and prize redemption.&nbsp;<\/li>\n\n\n\n<li>In the event of any dispute, Kraken reserves the right to make all final decisions regarding the Giveaway<\/li>\n<\/ul>\n","protected":false},"excerpt":{"rendered":"<p>The Kraken Pro Battlestation Contest is upon us! The participant who submits the most impressive battlestation trading setup on X\/Twitter will win a $1,000 gift card from Secretlab chairs.&nbsp; We\u2019re excited to see your submissions and offer you a chance to win $1,000 toward a new gaming chair from Secretlab. Entries must be completed during [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":23616,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_p