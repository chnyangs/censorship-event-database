\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"The real story of the SEC\u2019s suit against Kraken, and why Kraken is moving to dismiss the case - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss","og_locale":"en_US","og_type":"article","og_title":"The real story of the SEC\u2019s suit against Kraken, and why Kraken is moving to dismiss the case","og_description":"On the morning of May 10, 2023, Kraken testified about the SEC\u2019s overreach in crypto before both the House Financial Services Committee and the House Agriculture Committee. Kraken testified that current laws do not adequately cover the digital asset industry, and that Congress could do more to put in place a set of rules to [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss","og_site_name":"Kraken Blog","article_published_time":"2024-02-23T00:48:52+00:00","article_modified_time":"2024-02-23T15:45:32+00:00","og_image":[{"width":1536,"height":700,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/11\/Blog-1536x700-1.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"5 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"The real story of the SEC\u2019s suit against Kraken, and why Kraken is moving to dismiss the case","datePublished":"2024-02-23T00:48:52+00:00","dateModified":"2024-02-23T15:45:32+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss"},"wordCount":1136,"commentCount":0,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/11\/Blog-1536x700-1.png?fit=1536%2C700&ssl=1","keywords":["Kraken"],"articleSection":["News"],"inLanguage":"en-US","potentialAction":[{"@type":"CommentAction","name":"Comment","target":["https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss#respond"]}]},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss","url":"https:\/\/blog.kraken.com\/news\/sec-kraken-dismiss","name":"The real story of the SEC\u2019s suit against Kraken, and why Kraken is moving to dismiss the case - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/new