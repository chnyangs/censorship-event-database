org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"Rise through the ranks with our new Futures Leaderboard","datePublished":"2024-02-13T13:51:57+00:00","dateModified":"2025-03-17T20:39:28+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard"},"wordCount":593,"commentCount":0,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Blog-Futures-Leaderboard.png?fit=1535%2C700&ssl=1","keywords":["featured","Kraken"],"articleSection":["Derivatives"],"inLanguage":"en-US","potentialAction":[{"@type":"CommentAction","name":"Comment","target":["https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard#respond"]}]},{"@type":"WebPage","@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard","url":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard","name":"Rise through the ranks with our new Futures Leaderboard - Kraken Blog","isPartOf":{"@id":"https:\/\/blog.kraken.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-through-the-ranks-with-our-new-futures-leaderboard#primaryimage"},"image":{"@id":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/rise-throu