=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6nD","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Blog_Header_1535x700.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24529","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=24529"}],"version-history":[{"count":15,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24529\/revisions"}],"predecessor-version":[{"id":24546,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24529\/revisions\/24546"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/24530"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=24529"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=24529"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=24529"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=24529"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":24548,"date":"2024-02-22T12:55:16","date_gmt":"2024-02-22T17:55:16","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=24548"},"modified":"2024-02-22T19:52:48","modified_gmt":"2024-02-23T00:52:48","slug":"join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app","title":{"rendered":"Join the thousands already trading futures on the Kraken Pro mobile app"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">It&#8217;s been just over a month since we launched advanced-feature futures trading* on the Kraken Pro mobile app, and the response has been phenomenal. Thousands of traders already enjoy the convenience of trading futures directly from their mobile devices.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The Kraken Pro mobile app\u2019s fresh new UI is built on our 5-year-battle-tested futures platform. Access advanced futures trading functionality from anywhere using your mobile device.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/krakenpro.app.link\/QHuYG6i2oHb\" target=\"_blank\" rel=\"noopener\">Try Kraken Pro mobile futures trading<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-take-the-kraken-pro-mobile-futures-trading-tour\"><strong>Take the Kraken Pro mobile futures trading tour<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Easy access anytime, anywhere. Get a convenient overview of your futures portfolio with balances, profit\/loss, ROI, margin health and open positions.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"676\" data-attachment-id=\"24552\" data-permalink=\"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\/attachment\/mobile-futures-blog-1\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?fit=2876%2C1900&amp;ssl=1\" data-orig-size=\"2876,1900\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Mobile-Futures-Blog-1\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?fit=1024%2C676&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=1024%2C676&#038;ssl=1\" alt=\"\" class=\"wp-image-24552\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=1024%2C676&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=300%2C198&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=768%2C507&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=1536%2C1015&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=2048%2C1353&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=1200%2C793&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-1.png?resize=151%2C100&amp;ssl=1 151w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Browse and sort through spot and futures markets, side by side, with both perpetual and fixed-maturity contracts available to trade. Open any market and analyze price charts with over 11 technical indicators, plus: order book, depth chart, real-time market trades and market overview.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"676\" data-attachment-id=\"24554\" data-permalink=\"https:\/\/blog.kraken.com\/product\/kraken-derivatives\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\/attachment\/mobile-futures-blog-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-2.png?fit=2876%2C1900&amp;ssl=1\" data-orig-size=\"2876,1900\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Mobile-Futures-Blog-2\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-2.png?fit=1024%2C676&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Mobile-Futures-Blog-2.png?resize=1024%2C676&#038;ssl=1\" alt=\"\" class=\"wp-image-24554\" srcset=\"https:\/\/i0.w