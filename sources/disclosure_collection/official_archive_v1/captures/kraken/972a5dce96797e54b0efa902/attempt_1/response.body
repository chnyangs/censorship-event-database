g time\" \/>\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\"},\"headline\":\"Join the thousands already trading futures on the Kraken Pro mobile app\",\"datePublished\":\"2024-02-22T17:55:16+00:00\",\"dateModified\":\"2024-02-23T00:52:48+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\"},\"wordCount\":386,\"commentCount\":0,\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/02\\\/image21.png?fit=1535%2C700&ssl=1\",\"keywords\":[\"featured\",\"Kraken\",\"trading\"],\"articleSection\":[\"Derivatives\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\",\"name\":\"Join the thousands already trading futures on the Kraken Pro mobile app - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#primaryimage\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/02\\\/image21.png?fit=1535%2C700&ssl=1\",\"datePublished\":\"2024-02-22T17:55:16+00:00\",\"dateModified\":\"2024-02-23T00:52:48+00:00\",\"breadcrumb\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#primaryimage\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/02\\\/image21.png?fit=1535%2C700&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/02\\\/image21.png?fit=1535%2C700&ssl=1\",\"width\":1535,\"height\":700},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/kraken-derivatives\\\/join-the-thousands-already-trading-futures-on-the-kraken-pro-mobile-app#br