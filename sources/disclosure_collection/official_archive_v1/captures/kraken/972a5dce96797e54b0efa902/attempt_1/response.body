FX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"New OTC RFQ pairs available for APT, ARB, INJ and TIA - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia","og_locale":"en_US","og_type":"article","og_title":"New OTC RFQ pairs available for APT, ARB, INJ and TIA","og_description":"Kraken OTC is pleased to announce that our RFQ system now supports new pairs for Aptos (APT), Arbitrum (ARB), Injective (INJ) and Celestia (TIA).","og_url":"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia","og_site_name":"Kraken Blog","article_published_time":"2024-02-19T18:23:31+00:00","article_modified_time":"2025-03-04T11:16:06+00:00","og_image":[{"width":3070,"height":1400,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/OTC-Blog-Dark-Style-02-1.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"3 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"New OTC RFQ pairs available for APT, ARB, INJ and TIA","datePublished":"2024-02-19T18:23:31+00:00","dateModified":"2025-03-04T11:16:06+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-av