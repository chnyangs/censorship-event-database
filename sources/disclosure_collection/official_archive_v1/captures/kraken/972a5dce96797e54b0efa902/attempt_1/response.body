author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6mK","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/07\/Blog-NEW-Consumer-web-1.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24474","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=24474"}],"version-history":[{"count":18,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24474\/revisions"}],"predecessor-version":[{"id":24904,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24474\/revisions\/24904"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/23055"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=24474"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=24474"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=24474"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=24474"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":24507,"date":"2024-02-19T13:23:31","date_gmt":"2024-02-19T18:23:31","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=24507"},"modified":"2025-03-04T06:16:06","modified_gmt":"2025-03-04T11:16:06","slug":"new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia","title":{"rendered":"New OTC RFQ pairs available for APT, ARB, INJ and TIA"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">The following pairs are now available to trade via <a href=\"https:\/\/pro.kraken.com\/app\/otc\/quote\">RFQ<\/a> within the OTC Portal:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table><tbody><tr><td>Base asset<\/td><td>Pair<\/td><\/tr><tr><td>APT<\/td><td>AUD, CAD, EUR, GBP, USD, USDC, USDT<\/td><\/tr><tr><td>ARB<\/td><td>AUD, CAD, EUR, GBP, USD, USDC, USDT<\/td><\/tr><tr><td>INJ<\/td><td>AUD, CAD, EUR, GBP, USDC, USDT<\/td><\/tr><tr><td>TIA<\/td><td>AUD, CAD, EUR, GBP, USD, USDC, USDT<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-what-you-need-to-know-about-apt-arb-inj-and-tia\">Here\u2019s what you need to know about APT, ARB, INJ and TIA:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Aptos (APT)<\/strong> is a decentralized blockchain and scalable Web3 infrastructure. Aptos\u2019 parallel execution engine and modular design allow for high transaction throughput and low latency. APTOS is the native token of the blockchain which is used to pay for network transaction fees, earn rewards for securing the protocol via staking and vote on decisions that affect the future of the platform.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Arbitrum (ARB)<\/strong> is a Layer 2 (L2) blockchain protocol built on top of the Ethereum blockchain that allows Ethereum transactions to be processed more efficiently.&nbsp; By increasing the amount of transactions Ethereum can process, as well as the speed at which it can process them, Arbitrum has the additional benefit of reducing transaction costs, known as gas fees, associated with using Ethereum and its various decentralized applications.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Arbitrum also allows developers to create and execute their own Ethereum-compatible smart contracts. These can be programmed to run decentralized applications that can interact with the broader Ethereum ecosystem without bogging down the main blockchain\u2019s performance.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Injective (INJ)<\/strong> is a decentralized exchange (DEX) that offers various features such as cross-chain margin trading, derivatives and forex futures trading. Built on the <a href=\"https:\/\/www.kraken.com\/learn\/what-is-cosmos-atom\">Cosmos blockchain<\/a>, an L2 application, Injective uses bridges to offer cross-chain capabilities for traders to trade across other networks. The exchange is operated by the INJ token, Injective\u2019s native cryptocurrency, which is used by makers and takers to pay for transaction fees on its network.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Celestia (TIA)<\/strong> Celestia is a modular data availability network that securely scales with the number of users, making it easy for anyone to launch their own blockchain.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-who-can-trade-via-rfq\">Who can trade via RFQ?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken OTC\u2019s RFQ system is available to OTC clients. To onboard to Kraken OTC, you must be a <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/201352206-Verification-level-requirements\">Pro-verified<\/a> Kraken client. Once this step is complete, reach out to the OTC desk to get started.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Existing institutional clients can speak with their Account Manager to onboard to Kraken OTC.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-is-kraken-otc\">What is Kraken OTC?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken OTC offers premium trading services to execute orders over $50,000 off the open exchange. OTC clients gain 24\/7 access to deep liquidity and competitive execution and settlement services whether trading over chat or our RFQ system.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/otc\" target=\"_blank\" rel=\"noopener\">Learn more about Kraken OTC<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p><i>Kraken OTC is pleased to announce that our RFQ system now supports new pairs for Aptos (APT), Arbitrum (ARB), Injective (INJ) and Celestia (TIA).<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":24506,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789],"tags":[1373,1403,1462],"language":[],"class_list":["post-24507","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","tag-featured","tag-kraken","tag-otc"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>New OTC RFQ pairs available for APT, ARB, INJ and TIA - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"New OTC RFQ pairs available for APT, ARB, INJ and TIA\" \/>\n<meta property=\"og:description\" content=\"Kraken OTC is pleased to announce that our RFQ system now supports new pairs for Aptos (APT), Arbitrum (ARB), Injective (INJ) and Celestia (TIA).\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/asset-listings\/new-otc-rfq-pairs-available-for-apt-arb-inj-and-tia\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2024-02-19T18:23:31+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-03-04T11:16:06+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/OTC-Blog-Dark-Style-02-1.png\" \/>\n\t<meta property=\"og:image:width\" content=\"3070\" \/>\n\t<meta property=\"og:image:height\" content=\"1400\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" c