ct\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/danielpintokraken\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Trading for Dymension (DYM) and Jupiter (JUP) starts now in Canada - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-dymension-dym-and-jupiter-jup-starts-now-in-canada","og_locale":"en_US","og_type":"article","og_title":"Trading for Dymension (DYM) and Jupiter (JUP) starts now in Canada","og_description":"We\u2019re thrilled to announce that Dymension (DYM) and Jupiter (JUP) are now available on Kraken for residents in Canada! Funding and trading DYM and JUP funding and trading are live in Canada. Add DYM and JUP to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.&nbsp; Only deposit DYM on Dymension [&hellip;]","og_url":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-dymension-dym-and-jupiter-jup-starts-now-in-canada","og_site_name":"Kraken Blog","article_published_time":"2024-03-07T10:59:40+00:00","article_modified_time":"2024-03-11T13:01:30+00:00","og_image":[{"width":3070,"height":1400,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2024\/03\/Blog-Banner-JUP-DYM.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc"