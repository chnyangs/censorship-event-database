670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6oW","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/02\/Blog-Banner.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24610","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=24610"}],"version-history":[{"count":16,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24610\/revisions"}],"predecessor-version":[{"id":24628,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24610\/revisions\/24628"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/24622"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=24610"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=24610"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=24610"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=24610"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":24679,"date":"2024-03-07T05:59:40","date_gmt":"2024-03-07T10:59:40","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=24679"},"modified":"2024-03-11T09:01:30","modified_gmt":"2024-03-11T13:01:30","slug":"trading-for-dymension-dym-and-jupiter-jup-starts-now-in-canada","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-dymension-dym-and-jupiter-jup-starts-now-in-canada","title":{"rendered":"Trading for Dymension (DYM) and Jupiter (JUP) starts now in Canada"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that <strong>Dymension (DYM) and Jupiter (JUP)<\/strong> are now available on Kraken for residents in Canada!<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-funding-and-trading\">Funding and trading<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">DYM and JUP funding and trading are live in Canada. Add DYM and JUP to your Kraken account by navigating to <a href=\"https:\/\/www.kraken.com\/u\/funding\"><strong>Funding<\/strong><\/a>, selecting the asset, and hitting <strong>Deposit.&nbsp;<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Only deposit DYM on Dymension and JUP on Solana. Deposits using other networks will be lost.<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Got DYM and\/or JUP and a Kraken account? \u2935\ufe0f<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\">\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken<\/a>\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/pro.kraken.com\/app\/funding\/deposit\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken Pro<\/a>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">DYM and JUP are tradeable on <a href=\"https:\/\/www.kraken.com\/\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\">Kraken Pro<\/a> with the following parameters:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table><tbody><tr><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7033f5\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7033f5\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7033f5\" class=\"has-inline-color\">Price decimal precision<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7033f5\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7033f5\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/td><\/tr><tr><td>DYM<\/td><td>USD, EUR<\/td><td>6<\/td><td>1<\/td><td>1<\/td><\/tr><tr><td>JUP<\/td><td>USD, EUR<\/td><td>3<\/td><td>10<\/td><td>8<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li><strong>Not available in the United Kingdom<\/strong><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-the-token\">Here\u2019s some more information about the token:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/dymension\">Dymension (DYM)<\/a><\/strong> is a blockchain network known for its RollApps. The blockchain focuses on the <a href=\"https:\/\/www.kraken.com\/learn\/what-play-to-earn-crypto-games\">play-to-earn gaming<\/a> and <a href=\"https:\/\/www.kraken.com\/learn\/what-is-decentralized-finance-defi\">decentralized finance (DeFi)<\/a> sectors, and is managed by the Dymension Hub. It enhances data handling through Data Availability Networks and offers a RollApp Development Kit for developers. The network\u2019s operations and user rewards system are anchored by the DYM token, which was initially distributed to the community through the Genesis Rolldrop, forming a key part of Dymension\u2019s strategic growth in the blockchain sector.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">More information about Dymension in the <a href=\"https:\/\/assets-cms.kraken.com\/files\/51n36hrp\/facade\/2b0fe36d8eabe115db28a39baf15f8926efc3ea7.pdf\">Crypto Asset Statement<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/jupiter\">Jupiter (JUP)<\/a> <\/strong>is a <a href=\"https:\/\/www.kraken.com\/learn\/what-is-decentralized-finance-defi\">decentralized finance (DeFi)<\/a> protocol on the <a href=\"https:\/\/www.kraken.com\/prices\/solana\">Solana blockchain<\/a> that began as a liquidity aggregator for token swaps and has expanded to include <a href=\"https:\/\/www.kraken.com\/learn\/trading\/perpetual-futures-contracts\">perpetual futures<\/a>. The <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\">governance token<\/a> of Jupiter, JUP, allows community members to vote on key decisions regarding the platform\u2019s development and operations.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">More information about Jupiter in the <a href=\"https:\/\/assets-cms.kraken.com\/files\/51n36hrp\/facade\/cf2ea504b1a1c1c83c58e3622536e5dfa4d0a1f3.pdf\">Crypto Asset Statement.<\/a><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><br><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.<\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any cryptoasset or to engage in any specific trading strategy. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Payward Canada Inc., operating as Kraken, has filed an application for registration in certain Canadian jurisdictions but has not yet obtained registration. Until such time as Payward Canada Inc., operating as Kraken, obtains registration, Payward Canada Inc. has agreed to abide by the terms of an undertaking available at the following page: <a href=\"https:\/\/www.securities-administrators.ca\/wp-content\/uploads\/2023\/04\/20230324-Kraken-PRU-publication-version.pdf\">https:\/\/www.securities-administrators.ca\/wp-content\/uploads\/2023\/04\/20230324-Kraken-PRU-publication-version.pdf<\/a>.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Dymension (DYM) and Jupiter (JUP) are now available on Kraken for residents in Canada! Funding and trading DYM and JUP funding and trading are live in Canada. Add DYM and JUP to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.&nbsp; Only deposit DYM on Dymension [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":24681,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content"