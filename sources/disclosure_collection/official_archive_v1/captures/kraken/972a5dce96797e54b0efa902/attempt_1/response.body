":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6op","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2023\/11\/Blog-1536x700-1.png?fit=1536%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24577","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=24577"}],"version-history":[{"count":7,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24577\/revisions"}],"predecessor-version":[{"id":24584,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/24577\/revisions\/24584"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/23994"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=24577"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=24577"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=24577"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=24577"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":24598,"date":"2024-02-28T08:06:08","date_gmt":"2024-02-28T13:06:08","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=24598"},"modified":"2024-02-29T12:03:49","modified_gmt":"2024-02-29T17:03:49","slug":"kraken-rewards-is-now-live","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/kraken-rewards-is-now-live","title":{"rendered":"Kraken Rewards is now live!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/features\/rewards\">Kraken Rewards<\/a> is our new feature that allows users to seamlessly earn returns on all of their eligible assets with a single click. This is an easy and flexible way to make crypto assets work harder, while also helping support the crypto ecosystem by helping validate transactions.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Gone are the days of manually clicking through your portfolio to earn on individual assets. With Kraken Rewards, we&#8217;ve automated the entire process for you. With our one-touch enrollment, it couldn\u2019t be easier to join the growing number of users earning rewards on their crypto.&nbsp;<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-to-start-earning-rewards-with-kraken\">How to start earning rewards with Kraken<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">To sign up all of your eligible crypto assets for Kraken Rewards, simply open your <a href=\"https:\/\/www.kraken.com\/sign-in\">Kraken web<\/a> or <a href=\"https:\/\/www.kraken.com\/features\/cryptocurrency-apps\">mobile app<\/a> account, navigate to the Rewards section and click the \u201cstart earning\u201d button.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">One tap is all it takes!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">What crypto assets can you generate rewards on? Kraken Rewards allows you to earn on 16 different cryptocurrencies, including Ether (ETH), Polkadot (DOT), Solana (SOL) and Cardano (ADA).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">All rewards are calculated daily and paid automatically into your account each week. Best of all, Kraken Rewards&#8217; rates will be the same as the zero-day bonding rates on our Pro platform, where applicable. This means you can enjoy the best Kraken rates available on whichever interface you love the most.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-use-in-combination-with-our-other-portfolio-management-tools\">Use in combination with our other portfolio management tools<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken Rewards allows you to grow your crypto holdings with earnings that compound over time. We\u2019ve carefully designed this new feature to go hand-in-hand with our existing suite of portfolio management tools, such as <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/recurring-orders\">Recurring Buys<\/a> and <a href=\"https:\/\/blog.kraken.com\/product\/new-features\/personalize-your-trading-strategy-with-custom-orders\">Custom Orders<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-rewards-that-keep-up-with-the-market\">Rewards that keep up with the market<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">From our 12 years in the industry, we understand better than most how fast crypto markets can move. To make the most of every moment, we know that you need to have fast access to your crypto assets, too.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">That&#8217;s why with Kraken Rewards, there are no lock-up periods \u2014 your funds are always accessible. Any of your crypto assets earning rewards can be immediately withdrawn, traded or used for other purposes such as margin collateral (if available in your location), at any time.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Not only that, but with our best-in-class security and award-winning customer support, you can rest assured that your crypto assets are in the best hands.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-kraken-rewards-recap\">Kraken Rewards recap<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Let\u2019s summarize the key benefits of <a href=\"https:\/\/www.kraken.com\/features\/rewards\">Kraken Rewards<\/a>:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Unlock a world of rewards: <\/strong>Earn rewards on all eligible crypto assets with a single touch.<\/li>\n\n\n\n<li><strong>Earn effortlessly:<\/strong> Reap up to 10+% annually (rates vary) without making a trade.<\/li>\n\n\n\n<li><strong>Regular payouts:<\/strong> Accumulate earnings daily and enjoy weekly payouts.<\/li>\n\n\n\n<li><strong>Liquid assets, solid returns<\/strong>: Trade or withdraw anytime, your assets are always accessible.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019re driven by our mission to accelerate the global adoption of crypto so that everyone can achieve financial freedom and inclusion. Kraken Rewards marks an important step toward that goal, with the fastest and easiest way to get the most out of your idle crypto assets.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Click below to see what sort of rewards you could be earning right now with Kraken Rewards.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/features\/rewards\" target=\"_blank\" rel=\"noopener\">Explore Kraken Rewards<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake or hold any crypto asset or to engage in any specific trading strategy. Kraken does not and will not work to increase or decrease the price of any particular crypto asset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the crypto asset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your crypto assets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p><i>At Kraken, we work tirelessly to develop products that help you to achieve financial freedom. Our latest effort in this area is finally ready: Behold, Kraken Rewards!<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":24600,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774,1823],"tags":[1373,1403,1443],"language":[],"class_list":["post-24598","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","category-staking","tag-featured","tag-kra