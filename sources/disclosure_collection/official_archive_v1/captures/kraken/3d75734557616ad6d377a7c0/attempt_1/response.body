er\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\\/\\\/blog.kraken.com\\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\",\"name\":\"Kraken Blog\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\":\"KrakenFX\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"url\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\\/\\\/secure.gravatar.com\\\/avatar\\\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g\",\"caption\":\"KrakenFX\"},\"url\":\"https:\\\/\\\/blog.kraken.com\\\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Kraken co-founds Crypto Information Sharing and Analysis Center (ISAC)\u00a0 - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/industry-news\/kraken-isac","og_locale":"en_US","og_type":"article","og_title":"Kraken co-founds Crypto Information Sharing and Analysis Center (ISAC)\u00a0","og_description":"We\u2019re pleased to be a founding member of the industry\u2019s first-ever Crypto Information Sharing and Analysis Center (ISAC). This not-for-profit organization will foster a collaborative approach to information sharing across the ecosystem to reduce cybersecurity exploits and improve trust in blockchain and cryptoasset technology.&nbsp;&nbsp;&nbsp; \u201cWhile Kraken has a proven track record for robust cybersecurity protocols, [&hellip;]","og_url":"https:\/\/blog.kraken.com\/news\/industry-news\/kraken-isac","og_site_name":"Kraken Blog","article_published_time":"2024-05-29T14:59:29+00:00","article_modified_time":"2024-05-30T19:10:14+00:00","og_image":[{"width":1536,"height":701,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2023\/05\/blog-illustration-hardware.jpg","type":"image\/jpeg"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"3 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/industry-news\/kraken-isac#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/industry-news\/kraken-isac"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"Kraken co-founds Crypto Information Sharing and Analysis Center (ISAC)\u00a0","datePublished":"2024-05-29T14:59:29+00:00","dateModified":"2024-05-30T19:10:14+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/industry-news\/kraken-isac"},"wordCount":539,"commentCount":0,"publ