l-bank-of-ireland#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/06\\\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1\",\"keywords\":[\"europe\",\"featured\",\"mica\",\"regulation\"],\"articleSection\":[\"News\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland\",\"name\":\"Kraken cements European leadership with MiCA license from Central Bank of Ireland - Kraken Blog\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland#primaryimage\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/06\\\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1\",\"datePublished\":\"2025-06-25T18:41:33+00:00\",\"dateModified\":\"2025-06-25T20:34:02+00:00\",\"breadcrumb\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland#primaryimage\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/06\\\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2025\\\/06\\\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1\",\"width\":3070,\"height\":1400},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/news\\\/mica-license-central-bank-of-ireland#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\\/\\\/blog.kraken.com\\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Kraken cements European leadership with MiCA license from Central Bank of Ireland\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#website\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"name\":\"Kraken Blog\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\\/\\\/blog.kraken.com\\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#organization\",\"name\":\"Kraken Blog\",\"url\":\"https:\\\/\\\/blog.kraken.com\\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\",\"url\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"contentUrl\":\"https:\\\/\\\/i0.wp.com\\\/blog.kraken.com\\\/wp-content\\\/uploads\\\/2024\\\/06\\\/New-Lockups%402x.png?fit=214%2C64&ssl=1\",\"width\":214,\"height\":64,\"caption\":\"Kraken Blog\"},\"image\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/logo\\\/image\\\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\",\"name\"