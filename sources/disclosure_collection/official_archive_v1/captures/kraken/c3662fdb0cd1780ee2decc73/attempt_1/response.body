.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7uG","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/NewAsset_Blog-2.png?fit=1535%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28810","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28810"}],"version-history":[{"count":6,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28810\/revisions"}],"predecessor-version":[{"id":28817,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28810\/revisions\/28817"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28811"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28810"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28810"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28810"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28810"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28797,"date":"2025-06-19T09:30:05","date_gmt":"2025-06-19T13:30:05","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28797"},"modified":"2025-06-19T16:58:32","modified_gmt":"2025-06-19T20:58:32","slug":"new-opportunities-for-btc-staking","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/staking\/new-opportunities-for-btc-staking","title":{"rendered":"Introducing Bitcoin staking: New opportunities for clients to earn yield on their BTC holdings"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re excited to announce the launch of <a href=\"https:\/\/www.kraken.com\/features\/btc-staking?utm_source=blog&amp;utm_medium=blog&amp;utm_campaign=2025_q2_kraken_global_btcstaking_awr&amp;utm_content=link\" target=\"_blank\" rel=\"noreferrer noopener\">Bitcoin (BTC) staking<\/a> through a new integration with <a href=\"https:\/\/babylonlabs.io\/\" target=\"_blank\" rel=\"noreferrer noopener\">Babylon<\/a>, a <a href=\"https:\/\/www.kraken.com\/learn\/bitcoin\" target=\"_blank\" rel=\"noreferrer noopener\">Bitcoin<\/a>-native staking protocol. This integration enables clients to earn passive rewards on their BTC without <a href=\"https:\/\/www.kraken.com\/learn\/what-is-blockchain-bridge\" target=\"_blank\" rel=\"noreferrer noopener\">bridging<\/a>, <a href=\"https:\/\/www.kraken.com\/learn\/what-are-wrapped-crypto-assets\" target=\"_blank\" rel=\"noreferrer noopener\">wrapping<\/a> or <a href=\"https:\/\/www.kraken.com\/learn\/what-are-crypto-loans\" target=\"_blank\" rel=\"noreferrer noopener\">lending it out<\/a>.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Beginning today, clients can choose to stake their BTC directly from Kraken. Their BTC is delegated, via Babylon, to secure <a href=\"https:\/\/www.kraken.com\/learn\/proof-of-work-vs-proof-of-stake#:~:text=Siacoin%20(SC)-,What%20is%20proof%2Dof%2Dstake%20(PoS),-Unlike%20the%20outright\" target=\"_blank\" rel=\"noreferrer noopener\">Proof-of-Stake (PoS) networks<\/a>. Staked Bitcoin rewards are paid in <a href=\"https:\/\/docs.babylonlabs.io\/guides\/overview\/babylon_genesis\/baby_tokenomics\/\" target=\"_blank\" rel=\"noreferrer noopener\">$BABY<\/a>, Babylon\u2019s native token.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Clients retain full ownership of their BTC, which never leaves the Bitcoin <a href=\"https:\/\/www.kraken.com\/learn\/what-is-blockchain-technology\" target=\"_blank\" rel=\"noreferrer noopener\">blockchain<\/a>. The staking mechanism is governed by a smart contract, so users and third parties can verify how rewards are handled. The BTC staking protocol also includes cryptographic safeguards to deter and penalize malicious behaviors. Clients can unstake at any time, with a 7-day unbonding period before funds are returned.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This launch marks a significant expansion of <a href=\"https:\/\/www.kraken.com\/features\/staking\" target=\"_blank\" rel=\"noreferrer noopener\">our growing staking suite<\/a> and further reinforces our leadership in product innovation. We were one of the first crypto exchanges to introduce custodial staking in 2019, enabling millions of users to earn rewards through our Earn platform.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken Global Head of Consumer Mark Greenberg: \u201cA substantial amount of bitcoin currently sits idle on our exchange, representing a significant opportunity cost for clients and a missed opportunity for the broader ecosystem. With this launch, clients can now earn a return on their BTC while also enabling emerging PoS blockchains to benefit from the economic weight of Bitcoin in order to validate transactions and bolster the security of their networks.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The BTC staking product is available starting today across all our platform interfaces, including <a href=\"https:\/\/www.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Pro<\/a>.\u00a0<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/features\/btc-staking?utm_source=blog&#038;utm_medium=blog&#038;utm_campaign=2025_q2_kraken_global_btcstaking_awr&#038;utm_content=link\" target=\"_blank\" rel=\"noopener\">Explore Bitcoin staking<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Geographic restrictions apply. Projected annual rate is an estimate based on the average staking rewards accrued over the past period, before commission, and is subject to change.&nbsp; Staking involves risks including no guarantee of rewards, potential loss from slashing or hacks, and depreciation in the value of assets while staked. Please refer to Kraken&#8217;s<\/em><a href=\"https:\/\/www.kraken.com\/legal\" target=\"_blank\" rel=\"noreferrer noopener\"><em> Terms of Service<\/em><\/a> <em>for additional information.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p><i>Integration with Bitcoin-native staking protocol Babylon introduces secure Bitcoin staking supporting Proof-of-Stake networks \u2013 a first for Kraken clients.<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":28850,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1823],"tags":[1404,1365,1373,1443],"language":[],"class_list":["post-28797","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-staking","tag-bitcoin","tag-btc","tag-featured","tag-staking"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Introducing Bitcoin staking: New opportunities for clients to earn yield on their BTC holdings - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/staking\/new-opportunities-for-btc-staking\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Introducing Bitcoin staking: New opportunities for clients to earn yield on their BTC holdings\" \/>\n<meta property=\"og:description\" content=\"Integration with Bitcoin-native staking protocol Babylon introduces secure Bitcoin staking supporting Proof-of-Stake networks \u2013 a first for Kraken clients.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/product\/staking\/new-opportunities-for-btc-staking\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-06-19T13:30:05+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-06-19T20:58:32+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/BTCStaking_1535x700@2X-1.png\" \/>\n\t<meta property=\"og:image:width\" content=\"3070\" \/>\n\t<meta property=\"og:image:height\" content=\"1400\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>\n\t<meta name=\"twitter:data2\" content=\"2 minutes\" \/>\n<script type=\"application\/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/staking\\\/new-opportunities-for-btc-staking#article\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/staking\\\/new-opportunities-for-btc-staking\"},\"author\":{\"name\":\"KrakenFX\",\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/#\\\/schema\\\/person\\\/87e55a5e8ea020a6e620192589a05abf\"},\"headline\":\"Introducing Bitcoin staking: New opportunities for clients to earn yield on their BTC holdings\",\"datePublished\":\"2025-06-19T13:30:05+00:00\",\"dateModified\":\"2025-06-19T20:58:32+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/blog.kraken.com\\\/product\\\/staking\\\/new-opportunities-for-btc-staking\"},\"wordCount\":346,\"commentCount\":0,\"publisher\":{\"@id\":\"https:\\\/\\\/b