-Template-15.png?fit=3070%2C1400&ssl=1","datePublished":"2025-06-25T18:41:33+00:00","dateModified":"2025-06-25T20:34:02+00:00","breadcrumb":{"@id":"https:\/\/blog.kraken.com\/news\/mica-license-central-bank-of-ireland#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/blog.kraken.com\/news\/mica-license-central-bank-of-ireland"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/news\/mica-license-central-bank-of-ireland#primaryimage","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1","width":3070,"height":1400},{"@type":"BreadcrumbList","@id":"https:\/\/blog.kraken.com\/news\/mica-license-central-bank-of-ireland#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/blog.kraken.com\/"},{"@type":"ListItem","position":2,"name":"Kraken cements European leadership with MiCA license from Central Bank of Ireland"}]},{"@type":"WebSite","@id":"https:\/\/blog.kraken.com\/#website","url":"https:\/\/blog.kraken.com\/","name":"Kraken Blog","description":"","publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/blog.kraken.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7w8","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/Blog-Licence-Announcement-Template-15.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28900","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28900"}],"version-history":[{"count":8,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28900\/revisions"}],"predecessor-version":[{"id":28918,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28900\/revisions\/28918"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28903"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28900"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28900"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28900"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28900"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28859,"date":"2025-06-25T16:32:58","date_gmt":"2025-06-25T20:32:58","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28859"},"modified":"2025-06-25T17:55:58","modified_gmt":"2025-06-25T21:55:58","slug":"maker-rebates-select-spot-pairs","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/maker-rebates-select-spot-pairs","title":{"rendered":"Announcing maker rebates on select spot pairs"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Starting <strong>June 27 at 12:00 UTC<\/strong>, we\u2019re introducing a <strong>new maker fee incentive structure<\/strong> on a select number of lower-liquidity spot pairs. This is part of our ongoing effort to improve market structure, encourage tighter spreads, and deepen order book liquidity where it\u2019s needed most.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-s-changing\"><strong>What\u2019s changing?<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Eligible pairs<\/strong> will now follow a <em>competitive rebate-driven fee schedule<\/em> for makers.<br><\/li>\n\n\n\n<li>Maker fees will decrease significantly for the selected pairs, at all volume tiers, with rebates offered at the top tiers.<br><\/li>\n\n\n\n<li><strong>Taker fees remain unchanged across all tiers.<\/strong><strong><br><\/strong><\/li>\n\n\n\n<li>This structure applies <strong>only to select spot pairs<\/strong> &#8212; chosen based on liquidity.<strong>All other spot pairs will continue under the standard fee schedule.<br><\/strong><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">The goal is simple: support deeper markets and&nbsp; tighter spreads through targeted liquidity incentives on recently underperforming pairs. All traders will automatically benefit from the improved maker fee structure based on 30-day rolling volumes\u2014no other action is required.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-new-maker-fee-schedule-for-eligible-pairs\"><strong>New maker fee schedule for eligible pairs<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">This maker fee schedule will apply only to the selected spot pairs:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>30-Day Volume (USD)<\/strong><\/td><td><strong>Maker Fee<\/strong><\/td><td><strong>Taker Fee<\/strong><\/td><\/tr><tr><td>$0+<\/td><td><strong>0.23%<\/strong><\/td><td>0.40%<\/td><\/tr><tr><td>$10,000+<\/td><td><strong>0.18%<\/strong><\/td><td>0.35%<\/td><\/tr><tr><td>$50,000+<\/td><td><strong>0.12%<\/strong><\/td><td>0.24%<\/td><\/tr><tr><td>$100,000+<\/td><td><strong>0.10%<\/strong><\/td><td>0.22%<\/td><\/tr><tr><td>$250,000+<\/td><td><strong>0.08%<\/strong><\/td><td>0.20%<\/td><\/tr><tr><td>$500,000+<\/td><td><strong>0.06%<\/strong><\/td><td>0.18%<\/td><\/tr><tr><td>$1,000,000+<\/td><td><strong>0.04%<\/strong><\/td><td>0.16%<\/td><\/tr><tr><td>$2,500,000+<\/td><td><strong>0.02%<\/strong><\/td><td>0.14%<\/td><\/tr><tr><td>$5,000,000+<\/td><td><strong>0.00%<\/strong><\/td><td>0.12%<\/td><\/tr><tr><td>$10,000,000+<\/td><td><strong>\u20130.02%<\/strong><\/td><td>0.10%<\/td><\/tr><tr><td>$100,000,000+*<\/td><td><strong>\u20130.02%<\/strong><\/td><td>0.08%<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udc49 Full list of eligible pairs is available <a href=\"https:\/\/support.kraken.com\/articles\/pairs-eligible-for-maker-fee-rebates\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-s-staying-the-same\"><strong>What\u2019s staying the same?<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Taker fees remain unchanged for <strong>all pairs<\/strong> and <strong>all tiers<\/strong>.<br><\/li>\n\n\n\n<li>Maker and taker fees on <strong>non-eligible pairs<\/strong> are not affected.<br><\/li>\n\n\n\n<li>The standard fee schedule remains in effect for the majority of trading activity.<br><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">We\u2019ll reassess pair eligibility, fee levels and the structure of liquidity incentives on a monthly basis as needed to reflect shifting liquidity dynamics. As always, our aim is to support more efficient markets, better execution and to deliver a better experience for all active traders.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">If you have questions, please contact support\/your relationship manager, or visit our support center for more information.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/support.kraken.com\/articles\/pairs-eligible-for-maker-fee-rebates\" target=\"_blank\" rel=\"noopener\">Explore all eligible spot pairs<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\">* Institutional clients with 30-day spot crypto volume over $100M and activity on <a href=\"https:\/\/www.kraken.com\/features\/futures\">Kraken Futures<\/a>, <a href=\"https:\/\/custody.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Custody<\/a> or <a href=\"https:\/\/staked.us\/\" target=\"_blank\" rel=\"noreferrer noopener\">Staked<\/a> get 0.08% taker fees and access to exclusive perks.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Starting June 27 at 12:00 UTC, we\u2019re introducing a new maker fee incentive structure on a select number of lower-liquidity spot pairs. This is part of our ongoing effort to improve market structure, encourage tighter spreads, and deepen order book liquidity where it\u2019s needed most. What\u2019s changing? The goal is simple: support deeper markets and&nbsp; [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":28916,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1793],"tags":[1373,1476],"language":[],"class_list":["post-28859","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-promotions","tag-featured","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Announcing maker rebates on select spot pairs - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/promotions\/maker-rebates-select-spot-pairs\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Announcing maker rebates on select spot pairs\" \/>\n<meta property=\"og:description\" content=\"Starting June 27 at 12:00 UTC, we\u2019re introducing a new maker fee incentive structure on a select numbe