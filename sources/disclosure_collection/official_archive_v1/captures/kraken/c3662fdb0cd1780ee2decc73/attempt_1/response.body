=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7ve","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/NewAsset_Blog-4.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28844","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28844"}],"version-history":[{"count":1,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28844\/revisions"}],"predecessor-version":[{"id":28846,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28844\/revisions\/28846"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28845"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28844"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28844"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28844"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28844"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28822,"date":"2025-06-20T10:00:07","date_gmt":"2025-06-20T14:00:07","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28822"},"modified":"2025-07-02T06:32:10","modified_gmt":"2025-07-02T10:32:10","slug":"kraken-relocates-headquarters-to-wyoming","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/kraken-relocates-headquarters-to-wyoming","title":{"rendered":"Kraken relocates headquarters to Wyoming"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Our global headquarters is now officially in Cheyenne, Wyoming, affirming our commitment to U.S.-based crypto innovation. Renowned as a pioneer in crypto regulation, Wyoming is home to many forward-thinking policymakers and entrepreneurs who recognize the incredible potential of the technology.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wyoming\u2019s commitment to innovation is both visible and extensive. The state has enacted over 30 crypto-specific laws, ranging from the formal recognition of digital assets as property, to the establishment of a dedicated fintech sandbox, to protections against compelled disclosure of private keys.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">This trailblazing approach to crypto regulation quickly caught our attention and put the Equality State on the map as a crypto hub.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">These innovative laws also inspired our early investment in Wyoming\u2019s growing digital asset ecosystem. In 2021, to celebrate our 10th anniversary, we awarded a $300,000 grant to the University of Wyoming in support of educational initiatives preparing students for the fast-growing crypto economy.<\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" data-attachment-id=\"28848\" data-permalink=\"https:\/\/blog.kraken.com\/news\/kraken-relocates-headquarters-to-wyoming\/attachment\/img_4988-2\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?fit=2048%2C1366&amp;ssl=1\" data-orig-size=\"2048,1366\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"IMG_4988\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?fit=1024%2C683&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=1024%2C683&#038;ssl=1\" alt=\"\" class=\"wp-image-28848\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=1024%2C683&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=300%2C200&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=768%2C512&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=1536%2C1025&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=1200%2C800&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?resize=150%2C100&amp;ssl=1 150w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/IMG_4988-1.jpg?w=2048&amp;ssl=1 2048w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>Wyoming U.S. Senator Cynthia Lummis and Kraken co-CEO Arjun Sethi<\/em><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">We have also sponsored the Wyoming Blockchain Stampede and Hackathon at UW, helping turn the campus into a hotbed of real-world crypto experimentation. These investments in the state crypto ecosystem have further deepened our presence in Wyoming.<\/p>\n\n\n\n<p class=\"has-text-align-left wp-block-paragraph\">Building on that foundation, last year we co-hosted the first-ever Wyoming Blockchain Symposium in Jackson Hole. The event brought together 250 leading builders, investors, and policymakers to catalyze forward-thinking crypto regulation, foster institutional understanding of the asset class and create a more decentralized financial system.<\/p>\n\n\n\n<p class=\"has-text-align-left wp-block-paragraph\">Wyoming\u2019s pro-crypto environment made it a uniquely well-situated backdrop for these important conversations.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Now, almost four years after our initial interest in Wyoming, it\u2019s time to further deepen our local presence by setting down roots in Cheyenne. This move doesn\u2019t change our globally distributed and remote-first workforce, it is recognition of the pro-crypto policymakers and constructive regulations that have made us feel at home.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">From Senator Cynthia Lummis\u2019 tireless advocacy on behalf of Bitcoin and the crypto industry, to the numerous state laws that drive responsible innovation, Wyoming has proven there is no state better suited for Kraken\u2019s headquarters.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cWyoming has been at the forefront of digital asset policy for nearly a decade and has created the perfect environment for digital asset companies to thrive,\u201d said Lummis. \u201cKraken\u2019s decision to relocate to the Equality State is a testament to Wyoming\u2019s forward-thinking approach and reinforces Wyoming\u2019s position as America\u2019s premier crypto hub.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Stay tuned as we continue to innovate, evolve, and redefine the future of money and finance, now from Cheyenne, Wyoming.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>Our global headquarters is now officially in Cheyenne, Wyoming, affirming our commitment to U.S.-based crypto innovation. Renowned as a pioneer in crypto regulation, Wyoming is home to many forward-thinking policymakers and entrepreneurs who recognize the incredible potential of the technology. Wyoming\u2019s commitment to innovation is both visible and extensive. The state has enacted over 30 [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":28831,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1373,1403,1945],"language":[],"class_list":["post-28822","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","tag-featured","tag-kraken","tag-wyoming"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Kraken relocates headquarters to Wyoming - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\"