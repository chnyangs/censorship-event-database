\/author\\\/alex-hatch\"}]}<\/script>\n<!-- \/ Yoast SEO Premium plugin. -->","yoast_head_json":{"title":"Crypto complacency: The hidden security threats at industry conferences - Kraken Blog","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/blog.kraken.com\/news\/industry-news\/crypto-conference-complacency","og_locale":"en_US","og_type":"article","og_title":"Crypto complacency: The hidden security threats at industry conferences","og_description":"Did you know: scammers attend crypto conferences too? It\u2019s unsettling, especially when you\u2019re surrounded by people you believe to be like-minded crypto enthusiasts. But it's the truth \u2013 and it\u2019s becoming more common.","og_url":"https:\/\/blog.kraken.com\/news\/industry-news\/crypto-conference-complacency","og_site_name":"Kraken Blog","article_published_time":"2025-06-05T12:49:04+00:00","article_modified_time":"2025-06-06T13:34:31+00:00","og_image":[{"width":1024,"height":467,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/ComplacencyA_Blog_Header_3070x1400-1024x467.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"4 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/news\/industry-news\/crypto-conference-complacency#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/news\/industry-news\/crypto-conference-complacency"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"Crypto complacency: The hidden security threats at industry conferences","datePublished":"2025-06-05T12:49:04+00:00","dateModified":"2025-06-06T13:34:31+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/news\/industry-news\/crypto-confe