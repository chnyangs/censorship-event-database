\/\/api.w.org\/{rel}","templated":true}]}},{"id":28698,"date":"2025-06-02T11:41:38","date_gmt":"2025-06-02T15:41:38","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28698"},"modified":"2025-06-03T08:34:15","modified_gmt":"2025-06-03T12:34:15","slug":"eurr-and-usdr-fee-discounts","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/eurr-and-usdr-fee-discounts","title":{"rendered":"Fee discounts on EURR and USDR trading available now!"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\" id=\"h-promotional-fee-schedule\"><strong>Promotional fee schedule<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Applies to all eligible trades (no volume requirements):<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Maker: 0 bps (free)<\/li>\n\n\n\n<li>Taker: 1 bps<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-eligible-trading-pairs\"><strong>Eligible trading pairs<\/strong><\/h2>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-eurr-pairs\"><strong>EURR pairs:<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>EURR\/EUR<\/li>\n\n\n\n<li>EURR\/USD<\/li>\n\n\n\n<li>EURR\/USDC<\/li>\n\n\n\n<li>EURR\/USDT<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-usdr-pairs\"><strong>USDR pairs:<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>USDR\/USD<\/li>\n\n\n\n<li>USDR\/USDC<\/li>\n\n\n\n<li>USDR\/USDT<\/li>\n\n\n\n<li>USDR\/EUR<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/lvd54303\" target=\"_blank\" rel=\"noopener\">Trade on Kraken<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\">Here\u2019s some more information about these assets:<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-stablr-eur-eurr\"><strong>StablR EUR (EURR)<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/stablr-euro\" target=\"_blank\" rel=\"noreferrer noopener\">EURR<\/a> is a fully collateralized stablecoin pegged 1:1 to the euro, designed for seamless cross-border transactions and DeFi applications. Backed by a mix of cash reserves and real-world assets, EURR offers stability and liquidity for users seeking a reliable euro-denominated digital asset.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-stablr-usd-usdr\"><strong>StablR USD (USDR)<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/stablr-usd\" target=\"_blank\" rel=\"noreferrer noopener\">USDR<\/a> is a stablecoin pegged to the U.S. dollar, backed by real-world assets (RWAs) such as tokenized real estate and yield-bearing securities. Unlike traditional stablecoins, USDR generates passive income through its backing, making it a unique alternative in the decentralized finance (DeFi) ecosystem.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Please note<\/strong>, <strong>geographic restrictions may apply<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noreferrer noopener\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-\"><\/h3>\n","protected":false},"excerpt":{"rendered":"<p><i>We\u2019re excited to announce that Kraken clients can now enjoy reduced trading fees on select EURR and USDR pairs for the next three months, starting today, June 2, 2025.<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":28700,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1793],"tags":[1373,1403,1476],"language":[],"class_list":["post-28698","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-promotions","tag-featured","tag-kraken","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Fee discounts on EURR and USDR trading available now! - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/promotions\/eurr-and-usdr-fee-discounts\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Fee discounts on EURR and USDR trading available now!\" \/>\n<meta property=\"og:description\" content=\"We\u2019re excited to announce tha