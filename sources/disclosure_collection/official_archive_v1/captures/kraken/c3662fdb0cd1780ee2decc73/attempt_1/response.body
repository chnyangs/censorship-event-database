 asset we\u2019ve listed &#8212; is now available for trading on Kraken! Funding and trading DOG trading is live as of today, June 27, 2025. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; [&hellip;]","og_url":"https:\/\/blog.kraken.com\/product\/asset-listings\/dog-is-available-for-trading","og_site_name":"Kraken Blog","article_published_time":"2025-06-27T14:11:17+00:00","article_modified_time":"2025-06-27T14:11:18+00:00","og_image":[{"width":1535,"height":700,"url":"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/NewAsset_Blog-1-2.png","type":"image\/png"}],"author":"KrakenFX","twitter_card":"summary_large_image","twitter_misc":{"Written by":"KrakenFX","Est. reading time":"2 minutes"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/dog-is-available-for-trading#article","isPartOf":{"@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/dog-is-available-for-trading"},"author":{"name":"KrakenFX","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf"},"headline":"Runes now available: DOG is live for trading!","datePublished":"2025-06-27T14:11:17+00:00","dateModified":"2025-06-27T14:11:18+00:00","mainEntityOfPage":{"@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/dog-is-available-for-trading"},"wordCount":262,"commentCount":0,"publisher":{"@id":"https:\/\/blog.kraken.com\/#organization"},"image":{"@id":"https:\/\/blog.kraken.com\/product\/asset-listings\/dog-is-available-for-trading#primaryimage"},"thumbnailUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/NewAsset_Blog-1-2.png?fit=1535%2C700&ssl=1","keywords":["featured","Kraken","trading"],"articleSection":["Asset Listings"],"inLanguage":"en-US","potentialAction":[{"@type":"CommentAction","name":"Comment","target":["https:\/\/blog.kraken.com\/product\/asset-listings\/dog-i