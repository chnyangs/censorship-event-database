"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/blog.kraken.com\/#organization","name":"Kraken Blog","url":"https:\/\/blog.kraken.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7pY","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/xEquities-Blog-Partnership-1535x700%402x-1.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28518","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28518"}],"version-history":[{"count":12,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28518\/revisions"}],"predecessor-version":[{"id":28739,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28518\/revisions\/28739"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28658"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28518"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28518"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28518"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28518"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28542,"date":"2025-05-22T18:00:51","date_gmt":"2025-05-22T22:00:51","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28542"},"modified":"2025-05-23T09:01:56","modified_gmt":"2025-05-23T13:01:56","slug":"pizza-day-contest-2025","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/promotions\/pizza-day-contest-2025","title":{"rendered":"Announcing the Kraken x Barstool (win-a-whole-bitcoin) BTC Pizza Day Price Prediction Contest"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">If you\u2019ve ever dreamed of snagging life-changing money with almost no effort while half asleep on your couch, your time is now! Beginning <strong>May 22 \u2013 <\/strong><a href=\"https:\/\/blog.kraken.com\/crypto-education\/bitcoin-pizza-day-2024\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Bitcoin Pizza Day<\/strong><\/a> \u2013 Barstool Sports and Kraken are making that dream a potential reality for anyone bold enough to take a stab at the future price of the world\u2019s first crypto.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Nail it, and you\u2019ll be walking off with your very own piping hot slice of digital gold\u2026 for the cost of typing a number into a box.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-how-this-beautiful-madness-works\"><strong>How this beautiful madness works<\/strong><\/h2>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>Step<\/strong><\/td><td><strong>What to do<\/strong><\/td><td><strong>Time window (ET)<\/strong><\/td><\/tr><tr><td><strong>1. Hit the form<\/strong><\/td><td>Cruise to <a href=\"http:\/\/kraken.com\/barstoolcontest\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>the contest page<\/strong><\/a><\/td><td>May 22 @ 9 a.m. \u2192 <br>July 4 @ 11:59 p.m.<\/td><\/tr><tr><td><strong>2. Make your prophecy<\/strong><\/td><td>Enter one (1) price for <strong>1 BTC<\/strong> in whole U.S. dollars<\/td><td>Same window \u2013 only <strong>one guess per human<\/strong><\/td><\/tr><tr><td><strong>3. Cross fingers<\/strong><\/td><td>Kraken captures the official BTC-USD price at <strong>9:30 a.m. on July 28 (our 14th anniversary!)<\/strong><\/td><td>July 28, 2025 @ 9:30 a.m.<\/td><\/tr><tr><td><strong>4. Bask in glory<\/strong><\/td><td>Closest guess = <strong>wins an entire Bitcoin<\/strong> (ties split the pot)<\/td><td>Winner(s) emailed before Aug 31<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-why-should-you-care\"><strong>Why should you care?<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>It\u2019s a chance at (a lot of) literally free money.<\/strong> No buy-in. No trading. No hidden hoops.<br><\/li>\n\n\n\n<li><strong>It\u2019s an entire Bitcoin.<\/strong> Not 0.0002 BTC. Not \u201c$50 in sats.\u201d One. Whole. Bitcoin.<br><\/li>\n\n\n\n<li><strong>Odds you can actually grasp.<\/strong> This isn\u2019t a 300-million-ticket lottery. You\u2019re only battling fellow Stoolies and crypto degens with the steely reserve to guess a number.<br><\/li>\n\n\n\n<li><strong>Historic bragging rights.<\/strong> <a href=\"http:\/\/kraken.com\/barstoolcontest\" target=\"_blank\" rel=\"noreferrer noopener\">Guess the price of Bitcoin<\/a> to the dollar on Kraken\u2019s anniversary and parade around forever as a blockchainian Nostradamus.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-mark-your-calendars-and-your-pizza-boxes\"><strong>Mark your calendars (and your pizza boxes)<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>May 22:<\/strong> Bitcoin Pizza Day kickoff, contest opens<br><\/li>\n\n\n\n<li><strong>July 4:<\/strong> Fireworks, hot dogs and your <strong>last chance<\/strong> to enter<br><\/li>\n\n\n\n<li><strong>July 28, 9:30 a.m.:<\/strong> Kraken turns 14, the price is frozen, destiny decides<br><\/li>\n\n\n\n<li><strong>August:<\/strong> Kraken slides into your inbox if the crypto gods whisper your name<br><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-who-s-behind-the-curtain\"><strong>Who\u2019s behind the curtain?<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Kraken<\/strong>, the battle-tested exchange Dave Portnoy trusts for his own crypto bags.<br><\/li>\n\n\n\n<li><strong>Barstool Sports\/Davey Day Trader Global<\/strong>, because high-stakes hijinks need a proper hype man.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Together we\u2019re stirring the sauce, tossing one pepperoni-covered Bitcoin into the air and seeing whose plate it lands on.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-everybody-must-know-the-rules\"><strong>Everybody must know the rules<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>U.S. residents only<\/strong><strong><br><\/strong><\/li>\n\n\n\n<li><strong>One entry per person<\/strong><br><\/li>\n\n\n\n<li>Full legalese lives in the <a href=\"http:\/\/www.kraken.com\/pizzadaybarstoolcontestterms\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>T&amp;Cs<\/strong><\/a><\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-ready-to-flex-those-price-prediction-muscles\">\u26a1\ufe0f<strong>Ready to flex those price-prediction muscles?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Head to <a href=\"http:\/\/kraken.com\/barstoolcontest\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>kraken.com\/barstoolcontest<\/strong><\/a> on May 22 and drop your best guess.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Someone\u2019s walking away with a coin worth more than a few years\u2019 rent or a lifetime supply of pizza (at 2025 BTC Pizza Day prices, that\u2019s about two $20 pizzas every week&#8230; for 50 years).<br><br>Might as well be you.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/barstoolcontest\" target=\"_blank\" rel=\"noopener\">Enter our BTC Pizza Day Price Prediction Contest<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>NO PURCHASE NECESSARY TO ENTER OR WIN. A purchase, transaction, or payment of any kind will not increase your chances of winning. Void where prohibited by law. Kraken Bitcoin Pizza Day: BTC Price Prediction Contest is open only to legal residents of the United States (excluding ME, NY, WA) who are at least 18 years or older at time of entry. Contest period begins at 9:00 a.m. EST on May 22, 2025 and ends at 11:59 p.m. EST on July 4, 2025. Limit one entry per person. Potential winner(s) will be contacted by email and must have a Kraken account to claim prize. For Official Rules, see:&nbsp;<a href=\"http:\/\/www.kraken.com\/pizzadaybarstoolcontestterms\" target=\"_blank\" rel=\"noreferrer noopener\">www.kraken.com\/pizzadaybarstoolcontestterms<\/a>. Sponsor: Payward Interactive, Inc., 106 E. Lincolnway, 4th floor, Cheyenne, WY 82001.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p><i>One guess, everybody knows the rules. And someone will win a whole freakin\u2019 bitcoin.<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":28544,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1793],"tags":[1404,1365,1718,1373,1403],"language":[],"class_list":["post-28542","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-promotions","tag-bitcoin","tag-btc","tag-contest","tag-featured","tag-kraken"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Announcing the Kraken x Barstool (win-a-whole-bitcoin) BTC Pizza Day Price Prediction Contest - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/promotions\/pizza-day-contest-2025\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Announcing the Kraken x Barstool (win-a-whole-bitcoin) BTC Pizza Day Price Prediction Contest\" \/>\n<meta property=\"og:description\" content=\"One guess, everybody knows the rules. And someone will win a whole freakin\u2019 bitcoi