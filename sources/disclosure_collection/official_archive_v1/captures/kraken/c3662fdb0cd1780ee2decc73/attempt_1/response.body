v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28932"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28932\/revisions"}],"predecessor-version":[{"id":28935,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28932\/revisions\/28935"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28933"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28932"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28932"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28932"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28932"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28939,"date":"2025-06-27T14:48:05","date_gmt":"2025-06-27T18:48:05","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28939"},"modified":"2025-06-30T08:54:50","modified_gmt":"2025-06-30T12:54:50","slug":"portfolio-metrics","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/pro\/portfolio-metrics","title":{"rendered":"Asset level portfolio performance stats now live on Kraken Pro"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Your trades tell a story.<strong> Now you can read it &#8212; clearly, in real time.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With new <a href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\"><strong>asset level portfolio performance metrics<\/strong><\/a> now built into Kraken Pro, you can instantly see how every asset in your portfolio is performing &#8212; whether you\u2019re holding long or reacting fast to market moves.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">On both <strong><a href=\"http:\/\/p.k.xyz\/9f1e\/n6uot7il\" target=\"_blank\" rel=\"noreferrer noopener\">web and mobile<\/a><\/strong>, you can now view:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\ud83d\udcc8 Unrealized P&amp;L<\/li>\n\n\n\n<li>\ud83d\udcb5 Cost Basis<\/li>\n\n\n\n<li>\ud83d\udccd Average Price<\/li>\n<\/ul>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\" target=\"_blank\" rel=\"noopener\">Open portfolio metrics<\/a><\/div>\n<div>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"135\" data-attachment-id=\"28944\" data-permalink=\"https:\/\/blog.kraken.com\/product\/pro\/portfolio-metrics\/attachment\/pnl-balances-tab\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?fit=3380%2C444&amp;ssl=1\" data-orig-size=\"3380,444\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"pnl balances tab\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?fit=1024%2C135&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=1024%2C135&#038;ssl=1\" alt=\"\" class=\"wp-image-28944\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=1024%2C135&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=300%2C39&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=768%2C101&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=1536%2C202&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=2048%2C269&amp;ssl=1 2048w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=1200%2C158&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?resize=200%2C26&amp;ssl=1 200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-balances-tab.png?w=3000&amp;ssl=1 3000w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>See your cost basis, average price, and unrealized P&amp;L across assets<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-do-these-stats-mean\"><strong>What do these stats mean?<\/strong><\/h2>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>Metric<\/strong><\/td><td><strong>What it tells you<\/strong><\/td><\/tr><tr><td>Average Price<\/td><td>Your true entry &#8212; what you paid for each asset, weighted by balance<\/td><\/tr><tr><td>Cost Basis<\/td><td>Your total stake (average price \u00d7 current balance)<\/td><\/tr><tr><td>Unrealized P&amp;L<\/td><td>Your potential gain\/loss if you sold now<\/td><\/tr><tr><td>Unrealized P&amp;L %<\/td><td>How far up or down your position is, in percentage terms<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<div style=\"height:32px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"28946\" data-permalink=\"https:\/\/blog.kraken.com\/product\/pro\/portfolio-metrics\/attachment\/pnl-asset\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?fit=1600%2C900&amp;ssl=1\" data-orig-size=\"1600,900\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"pnl asset\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-28946\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?resize=178%2C100&amp;ssl=1 178w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-asset.png?w=1600&amp;ssl=1 1600w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>BTC showing +35.04% Unrealized P&amp;L &#8212; a high-conviction trade playing out<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Five ways traders are using these stats<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Take profits with precision<\/strong><strong><br><\/strong> Got a rule to trim at +20%? Your Unrealized P&amp;L % tells you exactly when you\u2019ve hit it.<br><em>Dogecoin at +67%? Might be time to lock it in.<\/em><em><br><\/em><\/li>\n\n\n\n<li><strong>Reassess underperformers<br><\/strong> ETH at -4.6%? This might be the nudge to reevaluate &#8212; or double down.<br><\/li>\n\n\n\n<li><strong>Improve entries over time<\/strong><strong><br><\/strong> See a small loss in a long-term position you still believe in? Add more and lower your average price.<br><\/li>\n\n\n\n<li><strong>Adjust risk before it\u2019s too late<\/strong><strong><br><\/strong> A slipping P&amp;L can help you catch trend reversals before they get worse.<br><\/li>\n\n\n\n<li><strong>Track your strategy \u2013 no spreadsheet required<\/strong> Use average price vs. current price to review the quality of your entries. Log it, learn, and adapt.<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-attachment-id=\"28948\" data-permalink=\"https:\/\/blog.kraken.com\/product\/pro\/portfolio-metrics\/attachment\/pnl-metrics\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?fit=1600%2C900&amp;ssl=1\" data-orig-size=\"1600,900\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"pnl metrics\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?fit=1024%2C576&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=1024%2C576&#038;ssl=1\" alt=\"\" class=\"wp-image-28948\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=1024%2C576&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=300%2C169&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=768%2C432&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=1536%2C864&amp;ssl=1 1536w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=1200%2C675&amp;ssl=1 1200w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?resize=178%2C100&amp;ssl=1 178w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-metrics.png?w=1600&amp;ssl=1 1600w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Where to find it<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">You\u2019ll see these stats live in three places on Kraken Pro Web:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>The<a href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\" target=\"_blank\" rel=\"noreferrer noopener\"> <strong>Portfolio tab<\/strong><\/a><\/li>\n\n\n\n<li>The <a href=\"https:\/\/pro.kraken.com\/app\/home\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Home page<\/strong><\/a><\/li>\n\n\n\n<li>The <a href=\"https:\/\/pro.kraken.com\/app\/trade\/\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Balances tab<\/strong><\/a> (add this to your Trade page layout)<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udcf1 On mobile, just head to the <strong><a href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\" target=\"_blank\" rel=\"noreferrer noopener\">Portfolio tab<\/a><\/strong> and tap any asset to see its performance.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><a href=\"https:\/\/pro.kraken.com\/app\" target=\"_blank\" rel=\" noreferrer noopener\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"472\" height=\"1024\" data-attachment-id=\"28951\" data-permalink=\"https:\/\/blog.kraken.com\/product\/pro\/portfolio-metrics\/attachment\/pnl-mobile\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?fit=1179%2C2556&amp;ssl=1\" data-orig-size=\"1179,2556\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"pnl Mobile\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?fit=472%2C1024&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=472%2C1024&#038;ssl=1\" alt=\"\" class=\"wp-image-28951\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=472%2C1024&amp;ssl=1 472w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=138%2C300&amp;ssl=1 138w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=768%2C1665&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=709%2C1536&amp;ssl=1 709w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=945%2C2048&amp;ssl=1 945w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?resize=46%2C100&amp;ssl=1 46w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/pnl-Mobile.png?w=1179&amp;ssl=1 1179w\" sizes=\"auto, (max-width: 472px) 100vw, 472px\" \/><\/a><\/figure>\n<\/div>\n\n\n<h2 class=\"wp-block-heading\"><strong>Pro tips for power users<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Track trends<\/strong> &#8212; Use Unrealized P&amp;L % to find your strongest plays<\/li>\n\n\n\n<li><strong>Improve timing<\/strong> &#8212; Spot winners early or flag risks before they turn into losses<\/li>\n\n\n\n<li><strong>Simplify journaling<\/strong> &#8212; Use these stats as the base for your trade journal and execution reviews<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>A quick reminder<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u26a0\ufe0f These metrics are for <a href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\" target=\"_blank\" rel=\"noreferrer noopener\">portfolio tracking<\/a> purposes only &#8212; not tax reporting. Your region may have its own rules for calculating cost basis and capital gains.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Ready to see how your portfolio is really performing?<\/strong><\/h2>\n\n\n\n<ol class=\"wp-block-list\">\n<li>Open Kraken Pro on <strong>web or mobile<\/strong><\/li>\n\n\n\n<li>Head to the <strong><a href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\">Portfolio<\/a> tab<\/strong> or <strong>Trade page \u2192 Balances<\/strong><\/li>\n\n\n\n<li>View your Unrealized P&amp;L, Cost Basis, and Average Price for every asset &#8212; and use it to guide your next move!&nbsp;<\/li>\n<\/ol>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you\u2019re capturing short-term volatility or building for the long haul, these metrics bring powerful clarity to every trade \ud83e\udd1d<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/n6uot7il\" target=\"_blank\" rel=\"noopener\">Open portfolio metrics<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p><i>Track your unrealized P&#038;L, average price, and cost basis directly in your asset portfolio view \u2014 across web and mobile.<\/i><\/p>\n","protected":false},"author":230089386,"featured_media":28940,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1790,1794],"tags":[1373,1397,1722,1476],"language":[],"class_list":["post-28939","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-new-features","category-pro","tag-featured","tag-new-feature