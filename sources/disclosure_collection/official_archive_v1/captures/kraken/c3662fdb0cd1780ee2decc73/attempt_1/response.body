:"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7qm","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/DarkPizzaDay2025_3070x1400.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28542","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28542"}],"version-history":[{"count":15,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28542\/revisions"}],"predecessor-version":[{"id":28566,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28542\/revisions\/28566"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28544"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28542"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28542"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28542"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28542"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28567,"date":"2025-05-23T10:26:21","date_gmt":"2025-05-23T14:26:21","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28567"},"modified":"2025-05-23T10:51:59","modified_gmt":"2025-05-23T14:51:59","slug":"expanded-usd-margin-pairs-available-for-moodeng","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/expanded-usd-margin-pairs-available-for-moodeng","title":{"rendered":"Expanded USD margin pairs available for MOODENG"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce support for a new USD margin pair for Moo Deng (MOODENG) &#8212; taking our total to over 220+ markets enabled for margin trading on Kraken Pro!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Margin trading is now available for the new trading pair:&nbsp;<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td>Pair base<\/td><td>Pair name<\/td><td>Available Leverage<\/td><td>Long Position Limit<\/td><td>Short Position Limit<\/td><\/tr><tr><td>MOODENG<\/td><td><a href=\"https:\/\/pro.kraken.com\/app\/trade\/margin-moodeng-usd\" target=\"_blank\" rel=\"noreferrer noopener\">MOODENG\/USD<\/a><\/td><td>3x<\/td><td>130,000<\/td><td>130,000<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-\"><\/h3>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/moodengpair\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-the-token\">Here\u2019s some more information about the token:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/moo-deng\" target=\"_blank\" rel=\"noreferrer noopener\">Moo Deng (MOODENG)<\/a> is a memecoin based on the famous pygmy hippopotamus at the Khao Kheow Open Zoo in Si Racha, Chonburi, Thailand. The Solana-based token is held by fans of the hippo, whose community congregates on X and Telegram. As a memecoin, MOODENG has no stated utility, its value instead arising from the vibrancy of its community and the virality of Moo Deng the hippo.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Before you start, what you should know:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">In order to <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/202967016-How-to-trade-using-margin\" target=\"_blank\" rel=\"noreferrer noopener\">trade using margin<\/a>, you will need to hold at least one <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/204585998-Collateral-currency\" target=\"_blank\" rel=\"noreferrer noopener\">collateral currency<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The availability of margin trading services is subject to <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/4402532394260-Client-eligibility-for-margin-trading-services-\" target=\"_blank\" rel=\"noreferrer noopener\">certain limitations and eligibility criteria<\/a>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Margin trading incurs additional fees for opening, closing and holding a position. Learn more about the <a href=\"https:\/\/www.kraken.com\/features\/fee-schedule#margin\" target=\"_blank\" rel=\"noreferrer noopener\">different rates and fees<\/a>.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Will Kraken offer more pairs on margin?<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details before launch \u2013 not even which pairs we are considering. All of Kraken\u2019s listed margin pairs are available <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/227876608-Margin-trading-pairs-and-their-maximum-leverage\" target=\"_blank\" rel=\"noreferrer noopener\">on our website<\/a>. Our client engagement specialists cannot answer any questions about which pairs we may be listing in the future.&nbsp;<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Trade with caution<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">There is no guarantee that a limit order will execute. There is no guarantee of margin pool availability at all times. There is also no guarantee of a market order executing at a certain price. The availability and liquidity of the particular digital asset will impact these types of orders. <em>Ready to trade but don\u2019t have a Kraken account yet? <\/em><a href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noreferrer noopener\"><em>Sign up today<\/em><\/a><em>!<\/em><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/moodengpair\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Availability of margin trading services is subject to <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/4402532394260-Client-eligibility-for-margin-trading-services-\" target=\"_blank\" rel=\"noreferrer noopener\">certain limitations and eligibility criteria<\/a>. Trading using margin involves an element of risk and may not be suitable for everyone. Read <a href=\"https:\/\/www.kraken.com\/legal#margin-disclosure-statement\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken&#8217;s Margin Disclosure Statement<\/a> to learn more.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce support for a new USD margin pair for Moo Deng (MOODENG) &#8212; taking our total to over 220+ markets enabled for margin trading on Kraken Pro! Margin trading is now available for the new trading pair:&nbsp; Pair base Pair name Available Leverage Long Position Limit Short Position Limit MOODENG MOODENG\/USD 3x [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":28568,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789],"tags":[1373,1403,1491,1476],"language":[],"class_list":["post-28567","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","tag-featured","tag-kraken","tag-margin-trading","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Expanded USD margin pairs available for MOODENG - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/asset-listings\/expanded-usd-margin-pairs-available-for-moodeng\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta