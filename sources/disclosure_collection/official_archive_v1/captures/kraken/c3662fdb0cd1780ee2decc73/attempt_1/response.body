g?fit=214%2C64&ssl=1","contentUrl":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/New-Lockups%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7vt","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/06\/tiers2x-1.png?fit=3040%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28859","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=28859"}],"version-history":[{"count":9,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28859\/revisions"}],"predecessor-version":[{"id":28925,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/28859\/revisions\/28925"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/28916"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=28859"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=28859"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=28859"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=28859"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":28763,"date":"2025-06-25T17:36:50","date_gmt":"2025-06-25T21:36:50","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=28763"},"modified":"2025-06-26T19:13:59","modified_gmt":"2025-06-26T23:13:59","slug":"markdown-on-kraken-desktop","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/desktop\/markdown-on-kraken-desktop","title":{"rendered":"Charts, checklists &amp; cheat sheets: Introducing Markdown on Kraken Desktop"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Trading isn\u2019t just about placing orders; it\u2019s about capturing insights the moment they strike.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With Kraken Desktop\u2019s new<strong> <\/strong><a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/how-to-use-the-markdown-module\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Markdown module<\/strong><\/a>, you can pin rich, formatted notes, images and links directly alongside your charts and <a href=\"https:\/\/www.kraken.com\/learn\/what-is-ladder-trading\" target=\"_blank\" rel=\"noreferrer noopener\">ladders<\/a> &#8212; so your next big idea never gets lost in a separate notebook or browser tab.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/desktop\" target=\"_blank\" rel=\"noopener\">Download Kraken Desktop<\/a><\/div>\n<div>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"607\" data-attachment-id=\"28613\" data-permalink=\"https:\/\/blog.kraken.com\/daily-trader_2025_05_12_17_29_52\" data-orig-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/Daily-Trader_2025_05_12_17_29_52.png?fit=2968%2C1760&amp;ssl=1\" data-orig-size=\"2968,1760\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"Daily Trader_2025_05_12_17_29_52\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/Daily-Trader_2025_05_12_17_29_52.png?fit=1024%2C607&amp;ssl=1\" src=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/Daily-Trader_2025_05_12_17_29_52.png?resize=1024%2C607&#038;ssl=1\" alt=\"\" class=\"wp-image-28613\" srcset=\"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/Daily-Trader_2025_05_12_17_29_52.png?resize=1024%2C607&amp;ssl=1 1024w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/Daily-Trader_2025_05_12_17_29_52.png?resize=300%2C178&amp;ssl=1 300w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/05\/Daily-Trader_2025_05_12_17_29_52.png?resize=768%2C455&amp;ssl=1 768w, https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/202