6cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7E9","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/07\/NewAsset_Blog-21-1.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29397","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29397"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29397\/revisions"}],"predecessor-version":[{"id":29514,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29397\/revisions\/29514"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29398"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29397"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29397"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29397"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29397"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29523,"date":"2025-08-07T08:17:54","date_gmt":"2025-08-07T12:17:54","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29523"},"modified":"2025-08-08T10:16:02","modified_gmt":"2025-08-08T14:16:02","slug":"trade-shortcuts","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/desktop\/trade-shortcuts","title":{"rendered":"Trade Shortcuts now live on Kraken Desktop"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><strong>Your trading reflexes, upgraded.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">With the new <a href=\"https:\/\/support.kraken.com\/articles\/trade-shortcuts\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Trade Shortcut module<\/strong><\/a> in Kraken Desktop, you can now place pre-configured trades instantly \u2014 no forms, no hesitation.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Build custom buttons for any strategy, from quick entries and exits to smart OSO setups.<br>Speed, precision, and control \u2014 now at your fingertips.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/desktop\" target=\"_blank\" rel=\"noopener\">Trade Shortcuts on Kraken Desktop<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\">On Kraken Desktop, you can now:<br>   \u26a1 Create and execute one-click trades<br>   \ud83c\udfaf Automate take profits and stop losses<br>   \ud83e\udde0 Dynamically adjust to the active market<\/p>\n\n\n\n\t\t<figure class=\"wp-block-jetpack-videopress jetpack-videopress-player\" style=\"\" >\n\t\t\t<div class=\"jetpack-videopress-player__wrapper\"> <iframe title=\"VideoPress Video Player\" aria-label='VideoPress Video Player' width='500' height='281' src='https:\/\/videopress.com\/embed\/Jt4GGLcw?cover=1&amp;autoPlay=1&amp;controls=1&amp;loop=1&amp;muted=1&amp;persistVolume=0&amp;playsinline=0&amp;preloadContent=metadata&amp;useAverageColor=1&amp;hd=0' frameborder='0' allowfullscreen data-resize-to-parent=\"true\" allow='clipboard-write'><\/iframe><script src='https:\/\/v0.wordpress.com\/js\/next\/videopress-iframe.js?m=1739540970'><\/script><\/div>\n\t\t\t\n\t\t\t\n\t\t<\/figure>\n\t\t\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>Trade with unmatched speed \u2014 one-click entries, exits and OSO setups.<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-do-these-trade-shortcut-settings-mean\"><strong>What do these Trade Shortcut settings mean?<\/strong><\/h2>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>Option<\/strong><\/td><td><strong>What it lets you do<\/strong><\/td><\/tr><tr><td><strong>Market<\/strong><\/td><td>Pin to a fixed market or adapt dynamically based on your active module<\/td><\/tr><tr><td><strong>Order Type<\/strong><\/td><td>Market, Limit, Ask\/Bid, Stop Loss, Take Profit, Trailing Stop (and more)<\/td><\/tr><tr><td><strong>Funding Type<\/strong><\/td><td>Trade with Spot or Margin funds<\/td><\/tr><tr><td><strong>Quantity<\/strong><\/td><td>Set fixed size or use a % of available balance<\/td><\/tr><tr><td><strong>Trigger Signal<\/strong><\/td><td>Use Last, Index, or Mark Price for execution logic<\/td><\/tr><tr><td><strong>Price Offsets<\/strong><\/td><td>Use negative\/positive offsets for limit orders or trigger distances<\/td><\/tr><tr><td><strong>Attached OSO<\/strong><\/td><td>Automatically link Take Profit and Stop Loss with OCO logic<\/td><\/tr><tr><td><strong>Reduce Only<\/strong><\/td><td>Prevent increasing position size \u2014 use to manage exits only<\/td><\/tr><tr><td><strong>Sound Events<\/strong><\/td><td>Get audible cues for Filled, Rejected, or Partially Filled orders<\/td><\/tr><tr><td><strong>Labels<\/strong><\/td><td>Auto-generated from order config \u2014 or create custom names<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<div style=\"height:46px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<blockquote class=\"twitter-tweet tw-align-center\"><p lang=\"en\" dir=\"ltr\">Setting up a limit buy shortcut with built-in TP\/SL logic <a href=\"https:\/\/t.co\/JRhmBujuCp\">pic.twitter.com\/JRhmBujuCp<\/a><\/p>&mdash; Kraken Desktop (@KrakenDesktop) <a href=\"https:\/\/twitter.com\/KrakenDesktop\/status\/1952349564045820317?ref_src=twsrc%5Etfw\">August 4, 2025<\/a><\/blockquote> <script async src=\"https:\/\/platform.twitter.com\/widgets.js\" charset=\"utf-8\"><\/script>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>Five ways traders are using Trade Shortcuts<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Make fast entries without hesitation<\/strong><strong><br><\/strong>Market moving? A one-click shortcut lets you enter instantly \u2014 with predefined size and risk controls.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Set your profit targets without hovering<\/strong><strong><br><\/strong>Attach take profit levels that auto-trigger with precision \u2014 even while you&#8217;re watching another chart.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Exit losers, fast<\/strong><strong><br><\/strong>Keep a \u201cSell Market \u2013 Reduce Only\u201d shortcut always ready to flatten losing positions on demand.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Automate your discipline<br><\/strong>Set fixed-size entries and stops to enforce consistent trading rules \u2014 no second-guessing.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Switch strategies with one preset<br><\/strong>Create Trade Shortcut presets for different market conditions (e.g., \u201cChoppy,\u201d \u201cBreakout,\u201d \u201cReversal\u201d).<\/p>\n\n\n\n<blockquote class=\"twitter-tweet tw-align-center\"><p lang=\"en\" dir=\"ltr\">Your trades. Your rules. No delay. <a href=\"https:\/\/t.co\/kTtybLUvnK\">pic.twitter.com\/kTtybLUvnK<\/a><\/p>&mdash; Kraken Desktop (@KrakenDesktop) <a href=\"https:\/\/twitter.com\/KrakenDesktop\/status\/1951298598081106412?ref_src=twsrc%5Etfw\">August 1, 2025<\/a><\/blockquote> <script async src=\"https:\/\/platform.twitter.com\/widgets.js\" charset=\"utf-8\"><\/script>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-where-to-find-it\"><strong>Where to find it<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">You\u2019ll see Trade Shortcuts live in <a href=\"https:\/\/www.kraken.com\/desktop\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Desktop<\/a>:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>In any board or split module layout<\/li>\n\n\n\n<li>Via the \u201cConfigure\u201d panel \u2192 Trade Shortcut<\/li>\n\n\n\n<li>Inside the \u201cEdit Module\u201d panel for customizing buttons<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\"><em>\u2139\ufe0f Trade Shortcuts are currently available only on <\/em><a href=\"https:\/\/www.kraken.com\/desktop\" target=\"_blank\" rel=\"noreferrer noopener\"><em>Kraken Desktop<\/em><\/a><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Pro tips for power users<\/strong><\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Use auto-labeling for clear intent (e.g., \u201cBuy Limit 25% 1TP\/1SL\u201d)<\/li>\n\n\n\n<li>Keep your emergency exits (e.g., full sell Reduce Only) at the top<\/li>\n\n\n\n<li>Create presets for different strategies and markets<\/li>\n\n\n\n<li>Turn on \u201cSkip confirmation\u201d for true single-click trading<\/li>\n\n\n\n<li>Review your OSO setups before high-volatility sessions<\/li>\n<\/ul>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https:\/\/www.kraken.com\/desktop\/share\/board?name=Quick%20Trade#%227Rt%2Fb9q69qtYmZ5078RaAqS0%2Fa9rN21S98oe7P6zW0VuYsC3Js7sBMpF%2Fe7vHNtJCIO20L726a6TpoLj8%2FuHj88JCy%2BSScaSzDteeP1UcPOB3nDtHXt%2FMJXxiAqv4SmacekdN%2FeCA98%2FaLUaHl0H8Ukq%2FjcgrMM0g44fdNvNAwf1Rca5YOYTVdcs62c00%2FhVM8WZrh54x37Xbwat4Oiw02777U7rsNv1bxveSMk8B