%402x.png?fit=214%2C64&ssl=1","width":214,"height":64,"caption":"Kraken Blog"},"image":{"@id":"https:\/\/blog.kraken.com\/#\/schema\/logo\/image\/"}},{"@type":"Person","@id":"https:\/\/blog.kraken.com\/#\/schema\/person\/87e55a5e8ea020a6e620192589a05abf","name":"KrakenFX","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/376cf5127aff2ae0a43942a0566f9d379956601670650244112b4fdb4b8c31e3?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/alex-hatch"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-7HY","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2025\/08\/NewAsset_Blog-3-5.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29634","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29634"}],"version-history":[{"count":5,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29634\/revisions"}],"predecessor-version":[{"id":29666,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29634\/revisions\/29666"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29635"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29634"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29634"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29634"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29634"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29675,"date":"2025-08-28T13:24:27","date_gmt":"2025-08-28T17:24:27","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29675"},"modified":"2025-08-28T13:24:28","modified_gmt":"2025-08-28T17:24:28","slug":"us-department-of-commerce","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/us-department-of-commerce","title":{"rendered":"U.S. Department of Commerce selects Kraken as partner in historic initiative to enhance transparency of economic data"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Kraken has been selected by the U.S. Department of Commerce to facilitate a groundbreaking initiative <a href=\"https:\/\/www.commerce.gov\/news\/press-releases\/2025\/08\/department-commerce-posts-2nd-quarter-gross-domestic-product-blockchain\" target=\"_blank\" rel=\"noreferrer noopener\">unveiled this morning<\/a> by President Donald Trump and Secretary Howard Lutnick. The initiative, which will distribute U.S. gross domestic product (GDP) data on nine major public blockchains, marks a milestone in the use of blockchain technology to enhance transparency in economic data.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">As part of this historic effort, Kraken has onboarded the Department of Commerce as a client and helped the department procure cryptocurrencies &#8212;\u00a0including Bitcoin (BTC), Ethereum (ETH), Solana (SOL), Avalanche (AVAX), Stellar (XLM), Polygon (POL) and Tron (TRX) &#8212; to pay for the transaction fees required for publishing cryptographic proofs of GDP data.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">By recording hashes of this critical economic information onchain, the Department of Commerce is ensuring that U.S. GDP data is verifiable, tamper-resistant and globally accessible. This sets a new standard for transparency in government reporting.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cThis is a landmark moment for both our industry and our country,\u201d said Arjun Sethi, Kraken co-CEO. \u201cWe commend President Trump and Secretary Lutnick for their vision in bringing this initiative to life, and we are honored to play a role in its execution. By harnessing blockchain technology to distribute GDP data, the U.S. is setting a global example of how transparency, trust and innovation can come together to drive progress.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cToday\u2019s announcement is a powerful example of how government and industry can work together to advance innovation across the global economy,\u201d said Jonathan Jacyhm, Kraken Global Head of Policy and Government Relations. \u201cThe message is clear: Blockchain technology is not just the future of financial infrastructure, it is now becoming the present.\u201d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The initiative reflects the Trump Administration\u2019s broader commitment to integrating blockchain technology into critical government functions, reinforcing the United States position as a global leader in digital innovation. It also marks a milestone for a G7 economy using public blockchains to disseminate official economic statistics.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Kraken remains committed to providing secure, reliable and efficient services to support the Department of Commerce in this project and any future initiatives.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>Kraken has been selected by the U.S. Department of Commerce to facilitate a groundbreaking initiative unveiled this morning by President Donald Trump and Secretary Howard Lutnick. The initiative, which will distribute U.S. gross domestic product (GDP) data on nine major public blockchains, marks a milestone in the use of blockchain technology to enhance transparency in [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":25944,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[],"language":[],"class_list":["post-29675","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>U.S. Department of Commerce selects Kraken as partner in historic initiative to enhance transparency of economic data - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/us-department-of-commerce\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta pr