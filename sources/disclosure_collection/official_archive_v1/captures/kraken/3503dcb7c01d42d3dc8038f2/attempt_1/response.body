t\/uploads\/2025\/08\/NewAsset_Blog-4.png?fit=3070%2C1400&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29577","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29577"}],"version-history":[{"count":3,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29577\/revisions"}],"predecessor-version":[{"id":29585,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29577\/revisions\/29585"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29579"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29577"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29577"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29577"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29577"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29596,"date":"2025-08-20T09:30:03","date_gmt":"2025-08-20T13:30:03","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29596"},"modified":"2025-08-20T10:09:40","modified_gmt":"2025-08-20T14:09:40","slug":"capitalise-ai","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/capitalise-ai","title":{"rendered":"Announcing the acquisition of Capitalise.ai, bringing no-code trading automation to Kraken Pro"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re excited to announce the acquisition of the assets and technology of <a href=\"http:\/\/capitalise.ai\" target=\"_blank\" rel=\"noreferrer noopener\">Capitalise.ai<\/a>, an Israel-based pioneer of no-code, natural-language trading automation.\u00a0<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Founded in 2015, Capitalise.ai developed a natural-language platform that transforms everyday text into executable trading strategies. Its proprietary language model and big data infrastructure can ingest real-time and historical data across equities, crypto, FX, futures, options and more.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A phased rollout of Capitalise.ai\u2019s functionality within <a href=\"https:\/\/pro.kraken.com\/\" target=\"_blank\" rel=\"noreferrer noopener\">Kraken Pro<\/a> is expected to begin later this year.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-unlocking-the-power-of-natural-language-trading\"><strong>Unlocking the power of natural-language trading<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">As the Pro platform has evolved, making full use of its advanced features has increasingly required both technical skill and deep trading expertise. Capitalise.ai removes that barrier, enabling clients of all backgrounds to design, test and automate complex strategies using simple, everyday language.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">By integrating Capitalise.ai\u2019s technology into Kraken Pro, users will soon be able to automate sophisticated strategies across digital and traditional asset classes without writing a single line of code.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cThis acquisition gives Kraken Pro clients a powerful new way to act on ideas in real time: testing, optimizing, and executing bespoke strategies with unprecedented speed and confidence,\u201d said Shannon Kurtas, Kraken Head of Exchange.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u201cCapitalise.ai\u2019s technology transforms how people interact with financial data, breaking down barriers that have long kept scalable, advanced strategies in the hands of a few. This is a major leap forward in democratizing access to pro-grade trading tools.\u201d<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-coming-soon-proven-innovation-at-kraken-scale\"><strong>Coming soon: Proven innovation, at Kraken scale<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Capitalise.ai technology has been deployed by a number of TradFi brokers and exchanges with compelling results, proving to be one of the most engaging automation tools in the retail and institutional space.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Capitalise.ai\u2019s co-founders \u2013 CEO Amir Shiovich and CPO Shahar Rabin \u2013 along with key product and engineering talent, will join Kraken and continue to innovate within the Kraken Pro business unit.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/pro.kraken.com\/\" target=\"_blank\" rel=\"noopener\">Explore Kraken Pro<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>No-code trading strategy research, design, backtesting and automated execution across asset classes<\/p>\n","protected":false},"author":230089386,"featured_media":29598,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774,1794],"tags":[1911,1373,1722,1476],"language":[],"class_list":["post-29596","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news","category-pro","tag-ai","tag-featured","tag-kraken-pro","tag-trading"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Announcing the acquisition of Capitalise.ai, bringing no-code trading automation to Kraken Pro - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/news\/capitalise-ai\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Announcing the acquisition of Capitalise.ai, bringing no-code trading automation to Kraken Pro\" \/>\n<meta property=\"og:description\" content=\"No-code trading strategy research, design, backtesting and automated execution across asset classes\" \/>\n<meta property=\"og:url\" content=\"https:\/\/blog.kraken.com\/news\/capitalise-ai\" \/>\n<meta property=\"og:site_name\" content=\"Kraken Blog\" \/>\n<meta property=\"article:published_time\" content=\"2025-08-20T13:30:03+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2025-08-20T14:09:40+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/blog.kraken.com\/wp-content\/uploads\/2025\/08\/Blog@2x-1024x467.png\" \/>\n\t<meta property=\"og:image:width\" content=\"1024\" \/>\n\t<meta property=\"og:image:height\" content=\"467\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/png\" \/>\n<meta name=\"author\" content=\"KrakenFX\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:label1\" content=\"Written by\" \/>\n\t<meta name=\"twitter:data1\" content=\"KrakenFX\" \/>\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" \/>