sts\/29761\/revisions\/29765"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29763"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29761"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29761"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29761"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29761"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29742,"date":"2025-09-04T09:36:45","date_gmt":"2025-09-04T13:36:45","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29742"},"modified":"2025-09-04T12:40:59","modified_gmt":"2025-09-04T16:40:59","slug":"kraken-acquires-breakout","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/news\/kraken-acquires-breakout","title":{"rendered":"Get funded to trade crypto: Kraken x Breakout is live"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">If you&#8217;re an experienced crypto trader looking to scale your strategy &#8212; without putting personal funds on the line &#8212; we\u2019ve got something new for you.<\/p>\n\n\n\n\t\t<figure class=\"wp-block-jetpack-videopress jetpack-videopress-player\" style=\"\" >\n\t\t\t<div class=\"jetpack-videopress-player__wrapper\"> <iframe title=\"VideoPress Video Player\" aria-label='VideoPress Video Player' width='500' height='281' src='https:\/\/videopress.com\/embed\/WOVLCfZl?cover=1&amp;autoPlay=1&amp;controls=1&amp;loop=1&amp;muted=1&amp;persistVolume=0&amp;playsinline=0&amp;preloadContent=metadata&amp;useAverageColor=1&amp;hd=0' frameborder='0' allowfullscreen data-resize-to-parent=\"true\" allow='clipboard-write'><\/iframe><script src='https:\/\/v0.wordpress.com\/js\/next\/videopress-iframe.js?m=1739540970'><\/script><\/div>\n\t\t\t\n\t\t\t\n\t\t<\/figure>\n\t\t\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.businesswire.com\/news\/home\/20250904012956\/en\/Kraken-Completes-Major-Acquisition-of-Breakout-to-Offer-Prop-Trading-to-Clients-Globally\">Kraken has acquired Breakout<\/a><\/strong>, a prop trading platform that lets you access up to $200,000 in live trading capital and keep\u00a0up to 90% of your profits. Just pass a one-step evaluation and start trading. There\u2019s no deposit required (other than the cost of the evaluation).<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"http:\/\/breakoutprop.com\/kraken\" target=\"_blank\" rel=\"noopener\">Get funded with Breakout<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-what-is-breakout\"><strong>What is Breakout?<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"http:\/\/kraken.com\/breakout\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Breakout<\/strong><\/a><strong> <\/strong>is a <strong>crypto-native proprietary trading firm<\/strong> built to empower traders. By demonstrating your skill through a trading evaluation, you can get funded with up to $200,000 in funded capital and keep up to 90% of the profits.<br><br>Now backed by <strong>Kraken&#8217;s infrastructure and global platform<\/strong>, Breakout allows traders to size up and scale their edge with <strong>zero personal capital at risk<\/strong>.<\/p>\n\n\n\n<iframe loading=\"lazy\" width=\"560\" height=\"315\" src=\"https:\/\/www.youtube.com\/embed\/xOtYKSnMFpQ?si=PGU40QBMZqgChzMj\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-how-it-works\"><strong>How it Works:<\/strong><\/h3>\n\n\n\n<ol class=\"wp-block-list\">\n<li>Sign up at <a href=\"http:\/\/breakoutprop.com\/kraken\" target=\"_blank\" rel=\"noreferrer noopener\">breakoutprop.com\/kraken<\/a>&nbsp;with the email linked to your Kraken account<\/li>\n\n\n\n<li>Pass the evaluation and qualify for up to $200K in trading capital\n<ul class=\"wp-block-list\">\n<li><strong>Enter promo code KRAK for a 2% evaluation discount<\/strong><\/li>\n<\/ul>\n<\/li>\n\n\n\n<li>Start trading <a href=\"https:\/\/www.breakoutprop.com\/symbols\/\" target=\"_blank\" rel=\"noreferrer noopener\">50+ crypto pairs<\/a> with low latency, deep liquidity and tight spreads<\/li>\n\n\n\n<li>Keep up to 90% of profits, with fast USDC&nbsp;payouts<\/li>\n<\/ol>\n\n\n\n<p class=\"wp-block-paragraph\">\u2139\ufe0f <em>Learn more about Breakout\u2019s equity drawdown rules <\/em><a href=\"https:\/\/www.breakoutprop.com\/article\/mastering-drawdown-a-guide-to-equity-limits-at-breakout\/\" target=\"_blank\" rel=\"noreferrer noopener\"><em>here<\/em><\/a><em>.&nbsp;<\/em><\/p>\n\n\n\n\t\t<figure class=\"wp-block-jetpack-videopress jetpack-videopress-player\" style=\"\" >\n\t\t\t<div class=\"jetpack-videopress-player__wrapper\"> <iframe title=\"VideoPress Video Player\" aria-label='VideoPress Video Player' width='500' height='281' src='https:\/\/videopress.com\/embed\/ff6MIiIr?cover=1&amp;autoPlay=1&amp;controls=1&amp;loop=1&amp;muted=1&amp;persistVolume=0&amp;playsinline=0&amp;preloadContent=metadata&amp;useAverageColor=1&amp;hd=0' frameborder='0' allowfullscreen data-resize-to-parent=\"true\" allow='clipboard-write'><\/iframe><script src='https:\/\/v0.wordpress.com\/js\/next\/videopress-iframe.js?m=1739540970'><\/script><\/div>\n\t\t\t\n\t\t\t\n\t\t<\/figure>\n\t\t\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><em>Setting up&nbsp; a new trading layout in the Breakout web terminal<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-why-kraken-x-breakout\"><strong>Why Kraken x Breakout?<\/strong><\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u2705 Up to $200K in funded trading accounts<\/strong><\/li>\n\n\n\n<li><strong>\u2705 No personal capital required (other than the cost of the evaluation)<\/strong><\/li>\n\n\n\n<li><strong>\u2705 Transparent rules and evaluation process<\/strong><\/li>\n\n\n\n<li><strong>\u2705 Up to 90% profit share with on-demand payouts<\/strong><\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you\u2019re already active or just breaking out, this is your chance to level up!<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"http:\/\/breakoutprop.com\/kraken\" target=\"_blank\" rel=\"noopener\">Get funded with Breakout<\/a><\/div>\n<div>\n","protected":false},"excerpt":{"rendered":"<p>Access up to $200,000 in trading capital with no personal deposit. Keep up to 90% of your gains.<\/p>\n","protected":false},"author":230089386,"featured_media":29744,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1774],"tags":[1373,1476],"language":[],"class_list":["post-29742","post","type-post","