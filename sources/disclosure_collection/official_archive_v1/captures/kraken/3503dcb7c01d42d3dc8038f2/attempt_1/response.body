types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29586"}],"version-history":[{"count":8,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29586\/revisions"}],"predecessor-version":[{"id":29611,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29586\/revisions\/29611"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29590"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29586"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29586"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29586"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29586"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29602,"date":"2025-08-20T13:04:21","date_gmt":"2025-08-20T17:04:21","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29602"},"modified":"2025-08-20T13:04:23","modified_gmt":"2025-08-20T17:04:23","slug":"sapien-is-available-for-trading","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/sapien-is-available-for-trading","title":{"rendered":"SAPIEN is available for trading!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that SAPIEN is available for trading on Kraken!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-funding-and-trading\"><strong>Funding and trading<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/p.k.xyz\/9f1e\/ize5ssu3\" target=\"_blank\" rel=\"noreferrer noopener\">SAPIEN trading<\/a> is live as of August 20, 2025.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Make sure to deposit your tokens into networks supported by Kraken. Deposits made using other networks will be lost.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/ize5ssu3\" target=\"_blank\" rel=\"noopener\">Trade on Kraken<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-this-asset\">Here\u2019s some more information about this asset<strong>:<\/strong><\/h2>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-sapien-sapien\">Sapien (SAPIEN)<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Sapien is a global network transforming collective human knowledge into verifiable AI training data. Its Proof of Quality system ensures trusted, human-in-the-loop data, while the SAPIEN token powers incentives for contributors and enterprises.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Please note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li><strong>Geographic restrictions may apply<\/strong><\/li>\n<\/ul>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>, and all future tokens will be announced on our <a href=\"http:\/\/kraken.com\/listings\" target=\"_blank\" rel=\"noreferrer noopener\">Listings Roadmap<\/a> and <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">social media profiles<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that SAPIEN is available for trading on Kraken! Funding and trading SAPIEN trading is live as of August 20, 2025. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens into networks supported by Kraken. Deposits [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":29604,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_