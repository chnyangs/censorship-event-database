p\/v2\/posts\/29858","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089386"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=29858"}],"version-history":[{"count":2,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29858\/revisions"}],"predecessor-version":[{"id":29900,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/29858\/revisions\/29900"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/29859"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=29858"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=29858"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=29858"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=29858"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":29874,"date":"2025-09-12T08:12:13","date_gmt":"2025-09-12T12:12:13","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=29874"},"modified":"2025-09-12T08:12:14","modified_gmt":"2025-09-12T12:12:14","slug":"xaut-is-available-for-trading","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/xaut-is-available-for-trading","title":{"rendered":"XAUt is available for trading!"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that XAUt is available for trading on Kraken!<\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-funding-and-trading\"><strong>Funding and trading<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/p.k.xyz\/9f1e\/rzl3hned\" target=\"_blank\" rel=\"noreferrer noopener\">XAUt trading<\/a> is live as of September 12, 2025.<\/p>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-8f761849 wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp;<\/p>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">Make sure to deposit your tokens into networks supported by Kraken. Deposits made using other networks will be lost.<\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/p.k.xyz\/9f1e\/rzl3hned\" target=\"_blank\" rel=\"noopener\">Trade on Kraken<\/a><\/div>\n<div>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-this-asset\">Here\u2019s some more information about this asset<strong>:<\/strong><\/h2>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-tether-gold-xaut\">Tether Gold (XAUt)<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">According to Tether, Tether Gold (XAUt) is a digital asset backed 1:1 by LBMA-certified physical gold stored in Swiss vaults, offering digital ownership, 24\/7 trading and redemption options.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Please note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li><strong>Geographic restrictions may apply<\/strong><\/li>\n<\/ul>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get Started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-will-kraken-make-more-assets-available\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\" target=\"_blank\" rel=\"noreferrer noopener\">here<\/a>, and all future tokens will be announced on our <a href=\"http:\/\/kraken.com\/listings\" target=\"_blank\" rel=\"noreferrer noopener\">Listings Roadmap<\/a> and <a href=\"https:\/\/x.com\/krakenfx\" target=\"_blank\" rel=\"noreferrer noopener\">social media profiles<\/a>. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that XAUt is available for trading on Kraken! Funding and trading XAUt trading is live as of September 12, 2025. To add an asset to your Kraken account, navigate to Funding, select the asset you\u2019re after, and hit \u2018Deposit\u2019.&nbsp; Make sure to deposit your tokens into networks supported by Kraken. Deposits [&hellip;]<\/p>\n","protected":false},"author":230089386,"featured_media":29876,"comment_status":"open","ping_statu