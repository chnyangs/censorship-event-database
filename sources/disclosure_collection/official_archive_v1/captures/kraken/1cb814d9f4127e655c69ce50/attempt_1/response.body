ts":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=25264"}],"version-history":[{"count":13,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25264\/revisions"}],"predecessor-version":[{"id":25306,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25264\/revisions\/25306"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/25329"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=25264"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=25264"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=25264"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=25264"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":25295,"date":"2024-06-06T10:48:47","date_gmt":"2024-06-06T14:48:47","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=25295"},"modified":"2024-06-21T11:01:06","modified_gmt":"2024-06-21T15:01:06","slug":"trading-for-pendle-starts-on-june-6","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-pendle-starts-on-june-6","title":{"rendered":"Trading for Pendle starts on June 6"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that<strong> Pendle (PENDLE), <\/strong>is now available on Kraken!<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-funding-and-trading\">Funding and trading<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">PENDLE\u00a0funding is now available and trading starts on June 6. Add your token to your Kraken account by navigating to <a href=\"https:\/\/www.kraken.com\/u\/funding\"><strong>Funding<\/strong><\/a>, selecting the asset, and hitting <strong>Deposit.\u00a0<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Make sure to deposit your tokens into the networks supported by Kraken. Deposits made using other networks will be lost.<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Got PENDLE? and a Kraken account? \u2935\ufe0f<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\">\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken<\/a>\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/pro.kraken.com\/app\/portfolio\/overview#dialog\/funding\/deposit\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken Pro<\/a>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">PENDLE is tradeable on <a href=\"https:\/\/www.kraken.com\/\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\">Kraken Pro<\/a> with the following parameters:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Price decimal precision<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/td><td><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/td><\/tr><tr><td>PENDLE<\/td><td>USD, EUR<\/td><td>4<\/td><td>2<\/td><td>2<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;<\/strong><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-the-token\">Here\u2019s some more information about the token:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/pendle\">Pendle (PENDLE)<\/a><\/strong> aims to help users maximize their DeFi yield. It does so by wrapping yield-bearing tokens, making them compatible with Pendle\u2019s own AMM and giving users greater control over their <a href=\"https:\/\/www.kraken.com\/learn\/what-is-yield-farming\">yield strategy<\/a>. The PENDLE token was originally launched as a utility token, with a view of later allowing participation in <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\">governance<\/a>.<\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!&nbsp;<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Will Kraken make more assets available?<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake, or hold any cryptoasset or to engage in any specific trading strategy. Kraken makes no representation or warranty of any kind, express or implied, as to the accuracy, completeness, timeliness, suitability or validity of any such information and will not be liable for any errors, omissions, or delays in this information or any losses, injuries, or damages arising from its display or use. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Pendle (PENDLE), is now available on Kraken! Funding and trading PENDLE\u00a0funding is now available and trading starts on June 6. Add your token to your Kraken account by navigating to Funding, selecting the asset, and hitting Deposit.\u00a0 Make sure to deposit your tokens into the networks supported by Kraken. Deposits [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":25328,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1843],"language":[],"class_list":["post-25295","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-pendle"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for Pendle starts on June 6 - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-pendle-starts-on-june-6\" \/>\n<meta property=\"og:loc