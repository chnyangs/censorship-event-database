avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/16c47affada0c14e53e9e35216ec483ad12bcc35fd4cea0d6a2dd22cde9a6038?s=96&d=identicon&r=g","caption":"KrakenFX"},"url":"https:\/\/blog.kraken.com\/author\/danielpintokraken"}]}},"jetpack_likes_enabled":false,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/peDd1v-6zv","jetpack_featured_media_url":"https:\/\/i0.wp.com\/blog.kraken.com\/wp-content\/uploads\/2024\/06\/7-asset-listing-blog.png?fit=1536%2C700&ssl=1","_links":{"self":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25265","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/users\/230089380"}],"replies":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/comments?post=25265"}],"version-history":[{"count":10,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25265\/revisions"}],"predecessor-version":[{"id":25321,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/posts\/25265\/revisions\/25321"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media\/25330"}],"wp:attachment":[{"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/media?parent=25265"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/categories?post=25265"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/tags?post=25265"},{"taxonomy":"language","embeddable":true,"href":"https:\/\/blog.kraken.com\/wp-json\/wp\/v2\/language?post=25265"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":25264,"date":"2024-06-04T11:16:36","date_gmt":"2024-06-04T15:16:36","guid":{"rendered":"https:\/\/blog.kraken.com\/?p=25264"},"modified":"2024-06-13T07:47:06","modified_gmt":"2024-06-13T11:47:06","slug":"trading-for-tremp-tnsr-zeus-and-more-starts-now","status":"publish","type":"post","link":"https:\/\/blog.kraken.com\/product\/asset-listings\/trading-for-tremp-tnsr-zeus-and-more-starts-now","title":{"rendered":"Trading for TREMP, TNSR, ZEUS and more starts now"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">We\u2019re thrilled to announce that<strong> Wen (WEN), Jeo Boden (BODEN), Doland Tremp (TREMP), Tensor (TNSR), Zeus Network (ZEUS) <\/strong>and<strong> Nosana (NOS) <\/strong>are now available on Kraken!<\/p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"h-funding-and-trading\">Funding and trading<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">WEN, BODEN, TREMP, TNSR, ZEUS and NOS &nbsp;funding and trading are live. Add these tokens to your Kraken account by navigating to <a href=\"https:\/\/www.kraken.com\/u\/funding\"><strong>Funding<\/strong><\/a>, selecting the asset, and hitting <strong>Deposit.&nbsp;<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Make sure to deposit your tokens using the networks supported by Kraken. Deposits made using other networks will be lost.<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Got TREMP, TNSR or ZEUS and a Kraken account? \u2935\ufe0f<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\">\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/u\/funding\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken<\/a>\n    <a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/pro.kraken.com\/app\/portfolio\/overview#dialog\/funding\/deposit\" target=\"_blank\" rel=\"noopener\">Deposit with Kraken Pro<\/a>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">WEN, BODEN, TREMP, TNSR, ZEUS and NOS are tradeable on <a href=\"https:\/\/www.kraken.com\/\">Kraken<\/a> and <a href=\"https:\/\/pro.kraken.com\/\">Kraken Pro<\/a> with the following parameters:<br><\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th class=\"has-text-align-left\" data-align=\"left\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Asset<\/mark><\/strong><\/th><th class=\"has-text-align-left\" data-align=\"left\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Pair<\/mark><\/strong><\/th><th class=\"has-text-align-left\" data-align=\"left\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Price decimal precision<\/mark><\/strong><\/th><th class=\"has-text-align-left\" data-align=\"left\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum order size<\/mark><\/strong><\/th><th class=\"has-text-align-left\" data-align=\"left\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#7132f5\" class=\"has-inline-color\">Minimum deposit<\/mark><\/strong><\/th><\/tr><\/thead><tbody><tr><td class=\"has-text-align-left\" data-align=\"left\">WEN<\/td><td class=\"has-text-align-left\" data-align=\"left\">USD, EUR<\/td><td class=\"has-text-align-left\" data-align=\"left\">1<\/td><td class=\"has-text-align-left\" data-align=\"left\">25,000<\/td><td class=\"has-text-align-left\" data-align=\"left\">25,000<\/td><\/tr><tr><td class=\"has-text-align-left\" data-align=\"left\">BODEN<\/td><td class=\"has-text-align-left\" data-align=\"left\">USD, EUR<\/td><td class=\"has-text-align-left\" data-align=\"left\">3<\/td><td class=\"has-text-align-left\" data-align=\"left\">10<\/td><td class=\"has-text-align-left\" data-align=\"left\">10<\/td><\/tr><tr><td class=\"has-text-align-left\" data-align=\"left\">TREMP<\/td><td class=\"has-text-align-left\" data-align=\"left\">USD, EUR<\/td><td class=\"has-text-align-left\" data-align=\"left\">3<\/td><td class=\"has-text-align-left\" data-align=\"left\">5<\/td><td class=\"has-text-align-left\" data-align=\"left\">5<\/td><\/tr><tr><td class=\"has-text-align-left\" data-align=\"left\">TNSR<\/td><td class=\"has-text-align-left\" data-align=\"left\">USD, EUR<\/td><td class=\"has-text-align-left\" data-align=\"left\">3<\/td><td class=\"has-text-align-left\" data-align=\"left\">10<\/td><td class=\"has-text-align-left\" data-align=\"left\">10<\/td><\/tr><tr><td class=\"has-text-align-left\" data-align=\"left\">ZEUS<\/td><td class=\"has-text-align-left\" data-align=\"left\">USD, EUR<\/td><td class=\"has-text-align-left\" data-align=\"left\">3<\/td><td class=\"has-text-align-left\" data-align=\"left\">11<\/td><td class=\"has-text-align-left\" data-align=\"left\">11<\/td><\/tr><tr><td class=\"has-text-align-left\" data-align=\"left\">NOS<\/td><td class=\"has-text-align-left\" data-align=\"left\">USD, EUR<\/td><td class=\"has-text-align-left\" data-align=\"left\">4<\/td><td class=\"has-text-align-left\" data-align=\"left\">1<\/td><td class=\"has-text-align-left\" data-align=\"left\">1<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Note:&nbsp;&nbsp;<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Trading via Kraken App and Instant Buy will be available once the liquidity conditions are met<\/strong><em> (when a sufficient number of buyers and sellers have entered the market for their orders to be efficiently matched).<\/em><\/li>\n\n\n\n<li>Not available in United Kingdom<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-here-s-some-more-information-about-the-tokens\">Here\u2019s some more information about the tokens:<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/wenwencoin\">Wen (WEN)<\/a><\/strong> bills itself as \u2018the first community coin based on a fractional NFT.\u2019 Fittingly, each unit of the currency represents an ownership stake in the poem immortalized as a <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\">non-fungible token<\/a>. Wen was the first token launched on <a href=\"https:\/\/www.kraken.com\/prices\/jupiter\">Jupiter\u2019s<\/a> LFG launchpad.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/jeo-boden\">Jeo Boden (BODEN)<\/a><\/strong> is based on Joe Biden and depicts the US President in a satirical cartoon format. The meme itself has been adopted by a thriving community, who take to social media to share its various iterations. The project\u2019s native unit, BODEN, can be sent, stored and received by <a href=\"https:\/\/www.kraken.com\/prices\/solana\">Solana<\/a> users.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/doland-tremp\"><strong>Doland Tremp (TREMP)<\/strong><\/a> is based on Donal Trump and depicts him in a satirical cartoon format. Like BODEN, it stands out due to a strong community that propagates the meme across social channels. TREMP can be sent, stored and received by <a href=\"https:\/\/www.kraken.com\/prices\/solana\">Solana<\/a> users.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><a href=\"https:\/\/www.kraken.com\/prices\/tensor\">Tensor (TNSR)<\/a><\/strong> is one of Solana\u2019s largest <a href=\"https:\/\/www.kraken.com\/learn\/what-are-non-fungible-tokens-nft\">non-fungible token (NFT)<\/a> marketplaces, distinguishing itself from competitors by catering chiefly to power users. The wider Tensor suite aims to revolutionize trading through the delivery of critical NFT infrastructure. TNSR, its native token, is a <a href=\"https:\/\/www.kraken.com\/learn\/what-is-a-governance-token\">governance token<\/a> that allows users to weigh in on decisions raised within the Tensor DAO. Learn more about DAO in our article <a href=\"https:\/\/www.kraken.com\/learn\/what-is-decentralized-autonomous-organization-dao\">What is a DAO? (Decentralized Autonomous Organization)<\/a><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/zeus-network\"><strong>Zeus Network (ZEUS)<\/strong><\/a> is a permissionless communication layer that allows blockchains to connect to Solana. On a mission to ensure greater interoperability, it leverages a decentralized network of <a href=\"https:\/\/www.kraken.com\/learn\/what-are-blockchain-nodes-clients\">nodes<\/a> to effectively aggregate and relay transactions across chains.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.kraken.com\/prices\/nosana\"><strong>Nosana (NOS)<\/strong><\/a> is a decentralized GPU grid that creates a market for unused compute power. Using Nosana, AI developers can rapidly train models without dedicated hardware, while hardware owners can earn competitive fees for renting out GPU. The NOS token serves as the native currency within the Nosana ecosystem.<\/p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong><em>Ready to trade but don&#8217;t have a Kraken account yet? <\/em><\/strong><a href=\"https:\/\/www.kraken.com\/sign-up\"><strong><em>Sign up today<\/em><\/strong><\/a><strong><em>!&nbsp;<\/em><\/strong><\/p>\n\n\n\n<div style=\"width: 100%; height: auto; text-align: center;\"><a class=\"btn btn-primary\" style=\"display: inline-block; padding: 12px 32px; font-size: 16px; font-weight: bold; text-align: center; text-decoration: none; transition: opacity 0.2s linear 0s; line-height: 24px; border-radius: 90px; color: #FFFFFF; background-color: #5D45DC; border: 1px solid #5D45DC;\" href=\"https:\/\/www.kraken.com\/sign-up\" target=\"_blank\" rel=\"noopener\">Get started with Kraken<\/a><\/div>\n<div>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Will Kraken make more assets available?<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Yes! But our policy is to never reveal any details until shortly before launch \u2013 including which assets we are considering. All of Kraken\u2019s available tokens can be found <a href=\"https:\/\/support.kraken.com\/hc\/en-us\/articles\/360000678446-Cryptocurrencies-available-on-Kraken\">here<\/a>, and all future tokens will be announced on Kraken\u2019s blog and social media profiles. Our client engagement specialists cannot answer any questions about which assets we may be making available in the future.&nbsp;<\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<p class=\"wp-block-paragraph\"><em>These materials are for general information purposes only and are not investment advice or a recommendation or solicitation to buy, sell, stake, or hold any cryptoasset or to engage in any specific trading strategy. Kraken makes no representation or warranty of any kind, express or implied, as to the&nbsp;accuracy, completeness, timeliness, suitability or validity of any such information and will not be liable for any errors, omissions, or delays in this information or any losses, injuries, or damages arising from its display or use. Kraken does not and will not work to increase or decrease the price of any particular cryptoasset it makes available. Some crypto products and markets are unregulated, and you may not be protected by government compensation and\/or regulatory protection schemes. The unpredictable nature of the cryptoasset markets can lead to loss of funds. Tax may be payable on any return and\/or on any increase in the value of your cryptoassets and you should seek independent advice on your taxation position. Geographic restrictions may apply.<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>We\u2019re thrilled to announce that Wen (WEN), Jeo Boden (BODEN), Doland Tremp (TREMP), Tensor (TNSR), Zeus Network (ZEUS) and Nosana (NOS) are now available on Kraken! Funding and trading WEN, BODEN, TREMP, TNSR, ZEUS and NOS &nbsp;funding and trading are live. Add these tokens to your Kraken account by navigating to Funding, selecting the asset, [&hellip;]<\/p>\n","protected":false},"author":230089380,"featured_media":25329,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_jetpack_newsletter_access":"","_jetpack_dont_email_post_to_subs":false,"_jetpack_newsletter_tier_id":0,"_jetpack_memberships_contains_paywalled_content":false,"_wpcom_ai_launchpad_first_post":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_post_was_ever_published":false},"categories":[1789,1426],"tags":[1846,1373,1849,1552,1847,1844,1845,1848],"language":[],"class_list":["post-25264","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-asset-listings","category-product","tag-boden","tag-featured","tag-nos","tag-sol","tag-tnsr","tag-tremp","tag-wen","tag-zeus"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v23.2 (Yoast SEO v28.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Trading for TREMP, TNSR, ZEUS and more starts now - Kraken Blog<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/blog.kraken.com\/product\/trading-for-tremp-tnsr-zeus-and-more-starts-now\" \/>\n<meta property=\"og:l