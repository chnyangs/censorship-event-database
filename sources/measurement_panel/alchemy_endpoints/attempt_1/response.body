\"token\":\"FRAX\"},{\"id\":\"rootstock-testnet\",\"chainName\":\"Rootstock\",\"networkName\":\"Testnet\",\"slug\":\"rootstock-testnet\",\"chainId\":31,\"gasToken\":\"tRBTC\",\"blockExplorer\":\"https://explorer.testnet.rootstock.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"DebugApi\"],\"websiteUrl\":\"https://rootstock.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/rootstock-api-quickstart\",\"githubUrl\":\"https://github.com/rsksmart\",\"blockSpeed\":\"33s\",\"bridgeUrl\":\"https://rootstock.io/bridge\",\"name\":\"Rootstock Testnet\",\"about\":\"This is the primary testnet for Rootstock.\",\"buildOnAlchemy\":\"Alchemy offers Rootstock testnet RPC endpoints and data APIs, so you can access highly reliable read/write data while testing your code on Rootstock testnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://dev.rootstock.io/\"},{\"id\":\"superseed-sepolia\",\"chainName\":\"Superseed\",\"networkName\":\"Sepolia\",\"slug\":\"superseed-sepolia\",\"chainId\":53302,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia-explorer.superseed.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://superseed.xyz/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/superseed-api-quickstart\",\"githubUrl\":\"https://github.com/superseed-xyz\",\"name\":\"Superseed Sepolia\",\"about\":\"This is the primary testnet for Superseed.\",\"buildOnAlchemy\":\"Alchemy provides Superseed Sepolia RPC endpoints, dashboard analytics, debugging tools, and more, so you can thoroughly and confidently test your code. Spend less time on your infra and move faster with Alchemy.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.superseed.xyz/\",\"token\":\"SUPR\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"id\":\"lens-sepolia\",\"chainName\":\"Lens\",\"networkName\":\"Sepolia\",\"slug\":\"lens-sepolia\",\"chainId\":37111,\"gasToken\":\"GRASS\",\"blockExplorer\":\"https://explorer.testnet.lens.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://app.t2.world/article/clw6l2z0018727620mc1dq26xr2\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/lens-api-quickstart\",\"bridgeUrl\":\"https://portal.staging.lens.zksync.dev/bridge/\",\"name\":\"Lens Sepolia\",\"about\":\"Lens Sepolia is the primary testnet for the Lens network.\",\"buildOnAlchemy\":\"Alchemy offers Lens Sepolia RPC endpoints and a suite of data APIs, so you can test your code with performant, highly reliable data.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://lens.xyz/docs/chain/overview\",\"faucetUrl\":\"https://www.alchemy.com/faucets/lens-sepolia\"},{\"id\":\"avax-mainnet\",\"chainName\":\"Avalanche\",\"networkName\":\"Mainnet\",\"slug\":\"avalanche\",\"chainId\":43114,\"gasToken\":\"AVAX\",\"blockExplorer\":\"https://subnets.avax.network/c-chain/\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"Websockets\",\"PricesApi\",\"DebugApi\"],\"websiteUrl\":\"https://avax.network/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/avalanche-api-quickstart\",\"githubUrl\":\"https://github.com/ava-labs\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://core.app/bridge/\",\"name\":\"Avalanche Mainnet\",\"about\":\"Avalanche C-Chain is an EVM-compatible smart contract chain within the Avalanche network, offering sub-second finality and low fees. It serves as the main entry point for Ethereum apps into Avalanche’s ecosystem. Custom subnets let projects launch dedicated, customizable blockchains while tapping into Avalanche liquidity.\",\"buildOnAlchemy\":\"Alchemy offers performant Avalanche RPC endpoints that give you reliable read and write data in real time. With enriched data APIs, push notifications, block streaming, and more, Alchemy tools help you build faster on Avalanche.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.avax.network/\",\"token\":\"AVAX\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/avalanche\"},{\"id\":\"shape-sepolia\",\"chainName\":\"Shape\",\"networkName\":\"Sepolia\",\"slug\":\"shape-sepolia\",\"chainId\":11011,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.shapescan.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"DebugApi\",\"TransactionSimulationApi\",\"UserOperationsApi\"],\"websiteUrl\":\"https://shape.network/\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Shape Sepolia\",\"about\":\"Shape Sepolia is the primary testnet for Shape.\",\"buildOnAlchemy\":\"Alchemy provides Shape Sepolia RPC endpoints, enriched data APIs, a suite of debugging tools, and more, so you can confidently experiment and test your code before shipping to Shape mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.shape.network/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"shape-sepolia-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/shape-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/shape-testnet\",\"publicRpcUrl\":\"https://shape-sepolia.g.alchemy.com/public\",\"publicWssUrl\":\"wss://shape-sepolia.g.alchemy.com/public\"},{\"id\":\"robinhood-testnet\",\"chainName\":\"Robinhood Chain\",\"networkName\":\"Testnet\",\"slug\":\"robinhood-testnet\",\"chainId\":46630,\"gasToken\":\"ETH\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"Webhooks\",\"PricesApi\"],\"name\":\"Robinhood Chain Testnet\",\"about\":\"This is the primary testnet for Robinhood Chain.\",\"buildOnAlchemy\":\"Alchemy offers Robinhood Chain testnet RPC endpoints and websockets, so you can access reliable and accurate onchain data and build with real-time block streams before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.robinhood.com/chain/\",\"token\":\"ETH\"},{\"id\":\"litecoin-mainnet\",\"chainName\":\"Litecoin\",\"networkName\":\"Mainnet\",\"slug\":\"litecoin\",\"chainId\":null,\"gasToken\":\"LTC\",\"blockExplorer\":\"https://blockchair.com/litecoin/transaction/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Blast\"],\"websiteUrl\":\"https://litecoin.org/\",\"alchemyDocsUrl\":\"https://github.com/litecoin-project/litecoin/tree/master/doc\",\"githubUrl\":\"https://github.com/litecoin-project/litecoin\",\"name\":\"Litecoin Mainnet\",\"about\":\"Litecoin is a UTXO Layer-1 blockchain launched in 2011 as one of the earliest Bitcoin forks. It uses Scrypt proof-of-work and 2.5-minute block times to enable faster, lower-fee transfers than Bitcoin while keeping a similar security model.\",\"buildOnAlchemy\":\"Alchemy offers reliable Litecoin RPC endpoints, so you can connect to the Litecoin network with performant, real-time read and write data.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://litecoin.info/docs\",\"token\":\"LTC\"},{\"id\":\"monad-testnet\",\"chainName\":\"Monad\",\"networkName\":\"Testnet\",\"slug\":\"monad-testnet\",\"chainId\":10143,\"gasToken\":\"MON\",\"blockExplorer\":\"https://testnet.monadexplorer.com/\",\"isTestnet\":true,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"Webhooks\",\"UserOperationsApi\",\"GasManagerApi\",\"EmbeddedAccounts\",\"BundlerApi\",\"Subgraphs\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://monad.xyz/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/monad-api-quickstart\",\"githubUrl\":\"https://github.com/category-labs/monad\",\"name\":\"Monad Testnet\",\"about\":\"This is the primary testnet for the Monad chain. Monad is fully compatible with Ethereum while offering 10K+ transactions per second and low gas fees.\",\"buildOnAlchemy\":\"Alchemy provides Monad testnet RPC endpoints, a range of debugging tools, rich data APIs, and more, so you can test your code with confidence before shipping to Monad mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.monad.xyz/\",\"token\":\"MONAD\",\"faucetUrl\":\"https://www.alchemy.com/faucets/monad-testnet\"},{\"id\":\"sui-testnet\",\"chainName\":\"Sui\",\"networkName\":\"Testnet\",\"slug\":\"sui-testnet\",\"chainId\":null,\"gasToken\":\"SUI\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Grpc\"],\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/sui-api-quickstart\",\"name\":\"SUI Testnet\",\"about\":\"This is the primary testnet for Sui.\",\"buildOnAlchemy\":\"Alchemy offers block-perfect data via reliable and familiar API endpoints. Test your app with data you can trust.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sui.io/\",\"token\":\"SUI\"},{\"id\":\"celo-sepolia\",\"chainName\":\"Celo\",\"networkName\":\"Sepolia\",\"slug\":\"celo-sepolia\",\"chainId\":11142220,\"gasToken\":\"CELO\",\"blockExplorer\":\"https://celo-sepolia.blockscout.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"BundlerApi\",\"GasManagerApi\",\"EmbeddedAccounts\",\"Webhooks\",\"TokenApi\",\"TransfersApi\"],\"websiteUrl\":\"https://celo.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/celo-api-quickstart\",\"githubUrl\":\"https://github.com/celo-org\",\"blockSpeed\":\"1s\",\"bridgeUrl\":\"https://docs.celo.org/protocol/bridge\",\"name\":\"Celo Sepolia\",\"about\":\"This is the new primary testnet for Celo and replaces the Alfajores network when Holesky sunsets in Septembet 2025.\",\"buildOnAlchemy\":\"Alchemy provides Celo Sepolia RPC endpoints. Simplify your testing with Alchemy data and tooling.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celo.org/\",\"token\":\"CELO\"},{\"id\":\"gnosis-mainnet\",\"chainName\":\"Gnosis\",\"networkName\":\"Mainnet\",\"slug\":\"gnosis\",\"chainId\":100,\"gasToken\":\"xDAI\",\"blockExplorer\":\"https://gnosisscan.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"PricesApi\"],\"websiteUrl\":\"https://gnosischain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/gnosis-chain-api-quickstart\",\"githubUrl\":\"https://github.com/gnosis\",\"blockSpeed\":\"5s\",\"bridgeUrl\":\"https://bridge.gnosischain.com/\",\"name\":\"Gnosis Mainnet\",\"about\":\"Gnosis (formerly xDai) is an EVM-compatible L1 that pairs a stable gas token (xDAI) with security generated by a network of 350K+ validators. Built-in Safe multisig support and bridge SDKs streamline governance, treasury, and cross-chain UX.\",\"buildOnAlchemy\":\"Alchemy offers Gnosis RPC endpoints designed for reliability and operating at scale. In addition, Alchemy provides you with enriched data APIs, push notifications, and data streaming, so you can build better applications.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gnosischain.com/\",\"token\":\"GNO\"},{\"id\":\"flow-mainnet\",\"chainName\":\"Flow EVM\",\"networkName\":\"Mainnet\",\"slug\":\"flow\",\"chainId\":747,\"gasToken\":\"FLOW\",\"blockExplorer\":\"https://evm-mainnet.flowscan.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://flow.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/flow-api-quickstart\",\"githubUrl\":\"https://github.com/onflow/flow-evm-gateway\",\"blockSpeed\":\"\u003c1s\",\"name\":\"Flow EVM Mainnet\",\"about\":\"Flow is a high-throughput PoS L1 designed by Dappy Labs for consumer experiences like NBA Top Shot and Mattel Creations. Its multi-node architecture parallelizes workloads, keeping fees low even during viral onchain activity.\",\"buildOnAlchemy\":\"Alchemy provides Flow RPC endpoints that give you reliable, real-time data. In addition to RPC endpoints, Alchemy also offers websocket support, so you can stream block data directly to your app.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://developers.flow.com/\",\"token\":\"FLOW\"},{\"id\":\"rise-testnet\",\"chainName\":\"Rise\",\"networkName\":\"Testnet\",\"slug\":\"rise-testnet\",\"chainId\":11155931,\"gasToken\":\"ETH\",\"blockExplorer\":\"http://rise-testnet.explorer.alchemy.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\",\"Subgraphs\",\"DebugApi\"],\"websiteUrl\":\"https://www.riselabs.xyz/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/rise-api-quickstart\",\"githubUrl\":\"https://github.com/risechain\",\"bridgeUrl\":\"https://bridge-ui.testnet.riselabs.xyz\",\"name\":\"Rise Testnet\",\"about\":\"Rise is an Ethereum L2 designed to drive speed and high throughput while offering Ethereum finality, with 5ms latency and 100K TPS. This is the primary test environment for Rise, and the team is actively working towards mainnet launch.\",\"buildOnAlchemy\":\"Alchemy offers Rise testnet RPC endpoints along with a suite of devtools, including enriched data APIs, block data streaming, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.risechain.com/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\"},{\"id\":\"hyperliquid-testnet\",\"chainName\":\"Hyperliquid\",\"networkName\":\"Testnet\",\"slug\":\"hyperliquid-testnet\",\"chainId\":998,\"gasToken\":\"HYPE\",\"blockExplorer\":\"https://testnet.purrsec.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\"],\"websiteUrl\":\"https://hyperfoundation.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/hyperliquid-api-quickstart\",\"githubUrl\":\"https://github.com/hyperliquid-dex\",\"name\":\"HyperEVM Testnet\",\"about\":\"This is the primary test environment for HyperEVM.\",\"buildOnAlchemy\":\"Alchemy offers builders real-time data from enterprise-grade RPC endpoints, block data streams via websockets, gas sponsorship, bundler infrastructure, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://hyperliquid.gitbook.io/hyperliquid-docs\",\"token\":\"HYPE\"},{\"id\":\"eth-sepoliabeacon\",\"chainName\":\"Ethereum\",\"networkName\":\"Sepolia Beacon\",\"slug\":\"ethereum-sepolia-beacon\",\"chainId\":null,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.etherscan.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\"],\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ethereum-api-quickstart\",\"name\":\"Ethereum Sepolia-Beacon\",\"about\":\"The Sepolia network for the Ethereum Beacon chain is a test network for app builders. Unlike the Beacon Hoodi network, the Sepolia network is run by a permissioned (closed) set of validators and an unlimited supply of test ETH. This makes the network more reliable and forgiving for rapid iteration and devs testing apps and smart contracts.\",\"buildOnAlchemy\":\"Access reliable Beacon Sepolia network data with Alchemy's endpoints. With a trusted infra partner, you can focus on testing and hardening your code and improving your app's user experience, instead of building out your backend infrastructure.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"id\":\"bitcoin-signet\",\"chainName\":\"Bitcoin\",\"networkName\":\"Signet\",\"slug\":\"bitcoin-signet\",\"chainId\":null,\"gasToken\":\"BTC\",\"blockExplorer\":\"https://mempool.space/signet\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\"],\"websiteUrl\":\"https://bitcoin.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/bitcoin-api-quickstart\",\"githubUrl\":\"https://github.com/bitcoin\",\"name\":\"Bitcoin Signet\",\"about\":\"Bitcoin Signet is a test environment that is more stable than Bitcoin testnet because unlike Bitcoin testnet, Signet is a controlled environment where a designated authority is responsible for signing new blocks. It’s designed for advanced protocol and infrastructure testing in private or dev-only settings.\",\"buildOnAlchemy\":\"Alchemy provides Bitcoin Signet RPC endpoints, so you can access performant and reliable read/write data at scale.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"id\":\"megaeth-testnet\",\"chainName\":\"MegaETH\",\"networkName\":\"Testnet\",\"slug\":\"megaeth-testnet\",\"chainId\":6343,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://www.megaexplorer.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://megaeth.com/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/megaeth-api-quickstart\",\"githubUrl\":\"https://github.com/megaeth-labs\",\"name\":\"MegaETH Testnet\",\"about\":\"This is the primary test network for MegaETH\",\"buildOnAlchemy\":\"Alchemy offers a suite of products for developers on MegaETH testnet, including reliable RPC endpoints for onchain data, a debugging API to understand transactions, and websockets for block streaming.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.megaeth.com/\"},{\"id\":\"eth-hoodibeacon\",\"chainName\":\"Ethereum\",\"networkName\":\"Hoodi Beacon\",\"slug\":\"ethereum-hoodi-beacon\",\"chainId\":null,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://hoodi.etherscan.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\"],\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ethereum-api-quickstart\",\"name\":\"Ethereum Hoodi-Beacon\",\"about\":\"The Hoodi network for the Ethereum Beacon chain is a test network that is replacing Beacon's Holesky network. Unlike the Beacon Sepolia network, the Hoodi network is designed for protocol and staking/validator testing and offers a permissionless validator network, more closely mimicking Beacon mainnet.\",\"buildOnAlchemy\":\"With Alchemy's RPC endpoints, you can access reliable and performant data for the Beacon Hoodi network and focus on hardening your code instead of troubleshooting infra.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"id\":\"opt-mainnet\",\"chainName\":\"OP Mainnet\",\"slug\":\"optimism\",\"chainId\":10,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://optimistic.etherscan.io\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionSimulationApi\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"PricesApi\",\"TraceApi\"],\"websiteUrl\":\"https://optimism.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/optimism-api-quickstart\",\"githubUrl\":\"https://github.com/ethereum-optimism\",\"blockSpeed\":\"1-2s\",\"bridgeUrl\":\"https://app.optimism.io/bridge/deposit\",\"name\":\"OP Mainnet\",\"about\":\"OP Mainnet (Optimism) is an optimistic rollup built on the OP Stack, pairing low fees with a governance model that funnels sequencer revenue into public-goods funding. It anchors a fast-growing ecosystem of L2-native apps and is the backbone of the Superchain, a collective of L2 blockchains all built using the OP Stack.\",\"buildOnAlchemy\":\"Alchemy offers high-performance Optimism RPC endpoints that ensure consistent uptime for production-grade rollup applications. Along with reliable data, Alchemy makes it easy to build, monitor, and scale apps on Optimism with a range of devtools, including analytics dashboards, smart notification tools, and gas sponsorship.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.optimism.io/\",\"token\":\"OP\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/optimism-sepolia\"},{\"id\":\"bitcoincash-testnet\",\"chainName\":\"Bitcoin Cash\",\"networkName\":\"Testnet\",\"slug\":\"bitcoin-cash-testnet\",\"chainId\":null,\"gasToken\":\"BCH\",\"blockExplorer\":\"https://blockchair.com/bitcoin-cash/testnet/transaction/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Blast\"],\"websiteUrl\":\"https://bitcoincash.org/\",\"alchemyDocsUrl\":\"https://docs.bitcoincash.org/\",\"githubUrl\":\"https://github.com/bitcoin-cash-node/bitcoin-cash-node\",\"name\":\"Bitcoin Cash Testnet\",\"about\":\"Bitcoin Cash Testnet is a public test environment that mimics Bitcoin Cash mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Bitcoin Cash testnet RPC endpoints, so you can test your application with reliable read/write data before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bitcoincash.org/\",\"token\":\"BCH\"},{\"id\":\"bob-mainnet\",\"chainName\":\"BOB\",\"networkName\":\"Mainnet\",\"slug\":\"bob\",\"chainId\":60808,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.gobob.xyz/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.gobob.xyz/\",\"githubUrl\":\"https://github.com/bob-collective/bob\",\"blockSpeed\":\"2-3s\",\"name\":\"BOB Mainnet\",\"about\":\"BOB is building the Bank of Bitcoin, reimagining banking for the Bitcoin age. One platform for everything - swapping, saving, earning \u0026 borrowing - all on Bitcoin rails.\",\"buildOnAlchemy\":\"Alchemy offers BOB RPC endpoints and websockets, ensuring that you have accurate, real-time, and reliable data and block event streams for whatever you're building.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gobob.xyz/\"},{\"id\":\"hyperliquid-mainnet\",\"chainName\":\"Hyperliquid\",\"networkName\":\"Mainnet\",\"slug\":\"hyperliquid\",\"chainId\":999,\"gasToken\":\"HYPE\",\"blockExplorer\":\"https://www.hyperscan.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Webhooks\",\"TokenApi\",\"TransfersApi\"],\"websiteUrl\":\"https://hyperfoundation.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/hyperliquid-api-quickstart\",\"githubUrl\":\"https://github.com/hyperliquid-dex\",\"name\":\"HyperEVM Mainnet\",\"about\":\"HyperEVM is an EVM execution layer embedded in Hyperliquid’s L1 and secured by the same HyperBFT consensus as HyperCore. HyperEVM lets you build apps that can directly integrate with Hyperliquid’s on‑chain spot and perp order books, bringing programmability to one of the most exciting spaces onchain today.\",\"buildOnAlchemy\":\"Alchemy provides HyperEVM RPC endpoints with industry-leading reliability and performance. Scale your app onchain with a suite of different devtools, including reliable onchain data, block data streams via websockets, debugging capabilities with Alchemy's Debug API, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://hyperliquid.gitbook.io/hyperliquid-docs\",\"token\":\"HYPE\"},{\"id\":\"katana-bokuto\",\"chainName\":\"Katana\",\"networkName\":\"Bokuto\",\"slug\":\"katana-bokuto\",\"chainId\":737373,\"gasToken\":\"ETH\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"name\":\"Katana Bokuto\",\"about\":\"Katana Bokuto is Katana's primary testnet. Developers can use it to test DeFi applications and integrations in Katana's 1-second block environment before deploying to Katana mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Katana Bokuto RPC endpoints and websockets, so you can test with reliable onchain data and real-time block streams before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.katana.network/\",\"token\":\"ETH\"},{\"id\":\"abstract-testnet\",\"chainName\":\"Abstract\",\"networkName\":\"Testnet\",\"slug\":\"abstract-testnet\",\"chainId\":11124,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.testnet.abs.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Webhooks\",\"Websockets\"],\"websiteUrl\":\"https://abs.xyz/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/abstract-api-quickstart\",\"githubUrl\":\"https://github.com/Abstract-Foundation\",\"name\":\"Abstract Testnet\",\"about\":\"This is the primary testnet for the Abstract chain.\",\"buildOnAlchemy\":\"Alchemy provides Abstract testnet RPC endpoints, dashboard analytics, enriched data APIs, and more. With Alchemy's devtools, building is just easier.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.abs.xyz/\",\"framework\":\"ZK\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/abstract-testnet\"},{\"id\":\"eth-mainnet\",\"chainName\":\"Ethereum\",\"networkName\":\"Mainnet\",\"slug\":\"ethereum\",\"chainId\":1,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://etherscan.io\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionSimulationApi\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"TraceApi\",\"Websockets\",\"Webhooks\",\"PricesApi\"],\"websiteUrl\":\"https://ethereum.org\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ethereum-api-quickstart\",\"githubUrl\":\"https://github.com/ethereum\",\"blockSpeed\":\"12-15s\",\"bridgeUrl\":\"https://www.alchemy.com/list-of/web3-bridges-on-ethereum\",\"name\":\"Ethereum Mainnet\",\"about\":\"Ethereum is the leading smart contract platform powering decentralized applications across DeFi, NFTs, gaming, and more. As the most widely adopted blockchain with the largest developer community, Ethereum is the foundation of Web3.\",\"buildOnAlchemy\":\"Alchemy provides highly reliable Ethereum RPC endpoints that connect your app to the Ethereum network. Along with real-time read and write data, Alchemy offers a suite of tools to build on Ethereum, including enriched data services, deployment tools, and infrastructure trusted by the largest builders onchain.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\",\"publicRpcUrl\":\"https://eth-mainnet.g.alchemy.com/public\"},{\"id\":\"mantle-mainnet\",\"chainName\":\"Mantle\",\"networkName\":\"Mainnet\",\"slug\":\"mantle\",\"chainId\":5000,\"gasToken\":\"MNT\",\"blockExplorer\":\"https://explorer.mantle.xyz/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.mantle.xyz/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/mantle-chain-api-quickstart\",\"githubUrl\":\"https://github.com/mantlenetworkio\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://bridge.mantle.xyz/\",\"name\":\"Mantle Mainnet\",\"about\":\"Mantle is a modular optimistic rollup on Ethereum that integrates EigenDA for low-cost, high-performance data availability, driving down fees without sacrificing security. Backed by the BitDAO ecosystem, Mantle provides a large treasury-supported platform to align liquidity, builders, and governance.\",\"buildOnAlchemy\":\"Alchemy offers Mantle RPC endpoints that bring you reliable, scalable, and performant data. In addition, Alchemy also offers push notifications and data streaming, so you can more easily build on Mantle.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs-v2.mantle.xyz/\",\"token\":\"MNT\"},{\"id\":\"bitcoin-testnet\",\"chainName\":\"Bitcoin\",\"networkName\":\"Testnet\",\"slug\":\"bitcoin-testnet\",\"chainId\":null,\"gasToken\":\"BTC\",\"blockExplorer\":\"https://mempool.space/testnet\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\"],\"websiteUrl\":\"https://bitcoin.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/bitcoin-api-quickstart\",\"githubUrl\":\"https://github.com/bitcoin\",\"name\":\"Bitcoin Testnet\",\"about\":\"Bitcoin Testnet is a public test environment that mimics Bitcoin mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Bitcoin testnet RPC endpoints, so you can access reliable read/write data in real time.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"id\":\"scroll-mainnet\",\"chainName\":\"Scroll\",\"networkName\":\"Mainnet\",\"slug\":\"scroll\",\"chainId\":534352,\"gasToken\":\"SCROLL\",\"blockExplorer\":\"https://scrollscan.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"Websockets\",\"TokenApi\",\"TransfersApi\",\"Webhooks\",\"Subgraphs\",\"PricesApi\",\"DebugApi\"],\"websiteUrl\":\"https://scroll.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/scroll-api-quickstart\",\"githubUrl\":\"https://github.com/scroll-tech\",\"blockSpeed\":\"2-3s\",\"bridgeUrl\":\"https://scroll.io/bridge\",\"name\":\"Scroll Mainnet\",\"about\":\"Scroll is a zkEVM rollup offering bytecode equivalence with Ethereum. Developed in close alignment with the Ethereum Foundation, Scroll is designed as censorship-resistant infrastructure for large-scale applications.\",\"buildOnAlchemy\":\"Alchemy offers fast, reliable Scroll RPC endpoints as well as helpful infrastructure for apps on Scroll, including enriched data APIs, push notifications, and data streaming.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.scroll.io/en/home/\",\"token\":\"SCROLL\"},{\"id\":\"celo-mainnet\",\"chainName\":\"Celo\",\"networkName\":\"Mainnet\",\"slug\":\"celo\",\"chainId\":42220,\"gasToken\":\"CELO\",\"blockExplorer\":\"https://celoscan.io/\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"Websockets\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"DebugApi\",\"NftApi\"],\"websiteUrl\":\"https://celo.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/celo-api-quickstart\",\"githubUrl\":\"https://github.com/celo-org\",\"blockSpeed\":\"1s\",\"bridgeUrl\":\"https://docs.celo.org/protocol/bridge\",\"name\":\"Celo Mainnet\",\"about\":\"Celo is a mobile-first, EVM-compatible L2 built with OP-Stack (the chain was formerly an L1 and migrated to Optimism in March 2025). It features ultra-light clients, phone number mapping, and gas fee abstraction for easy smartphone onboarding, and its support of cUSD and cEUR stablecoins power payments in 100+ countries.\",\"buildOnAlchemy\":\"Alchemy offers reliable Celo RPC endpoints designed for availability at scale. In addition, Alchemy offers enriched data APIs and a range of developer tools that make it easy to build and scale on Celo.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celo.org/\",\"token\":\"CELO\"},{\"id\":\"cronos-testnet\",\"chainName\":\"Cronos\",\"networkName\":\"Testnet\",\"slug\":\"cronos-testnet\",\"chainId\":338,\"gasToken\":\"CRO\",\"blockExplorer\":\"https://explorer.cronos.org/testnet\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://crypto.com\",\"name\":\"Cronos Testnet\",\"about\":\"This is the primary testnet for Cronos.\",\"buildOnAlchemy\":\"Alchemy offers Cronos testnet RPC endpoints, websockets, a Debug API, bundler infrastructure, and gas sponsorship so you can test and harden your app before shipping to mainnet.\"},{\"id\":\"xmtp-ropsten\",\"chainName\":\"XMTP\",\"networkName\":\"Ropsten\",\"slug\":\"xmtp-ropsten\",\"chainId\":351243127,\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Subgraphs\",\"DebugApi\"],\"websiteUrl\":\"https://xmtp.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/xmtp-api-quickstart\",\"githubUrl\":\"https://github.com/xmtp\",\"name\":\"XMTP Ropsten\",\"about\":\"This is the primary testnet for the XMTP network.\",\"buildOnAlchemy\":\"Alchemy offers performant Ropsten RPC endpoints, websockets, and subgraphs that simplify your testing on XMTP. With reliable data at your fingertips, you can focus on preparing your app for mainnet instead of stabilizing your infrastructure.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.xmtp.org/\"},{\"id\":\"linea-mainnet\",\"chainName\":\"Linea\",\"networkName\":\"Mainnet\",\"slug\":\"linea\",\"chainId\":59144,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://lineascan.build\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Websockets\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"PricesApi\",\"NftApi\",\"DebugApi\"],\"websiteUrl\":\"https://linea.build/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/linea-chain-api-quickstart\",\"githubUrl\":\"https://github.com/Consensys/linea\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://bridge.linea.build/\",\"name\":\"Linea Mainnet\",\"about\":\"Linea is a zkEVM rollup developed by Consensys, offering byte-code equivalence to Ethereum. The chain also has tight integrations with other Consensys projects, including MetaMask and Infura. With Linea, you can access sub-second confirmations and native account abstraction while staying inside a familiar Ethereum tooling stack.\",\"buildOnAlchemy\":\"Alchemy offers reliable Linea RPC endpoints for onchain development. In addition to real-time data, Alchemy enriched data APIs, push notifications, and event streaming to help you build on Linea.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.linea.build/\"},{\"id\":\"mantle-sepolia\",\"chainName\":\"Mantle\",\"networkName\":\"Sepolia\",\"slug\":\"mantle-sepolia\",\"chainId\":5003,\"gasToken\":\"MNT\",\"blockExplorer\":\"https://explorer.sepolia.mantle.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.mantle.xyz/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/mantle-chain-api-quickstart\",\"githubUrl\":\"https://github.com/mantlenetworkio\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://bridge.mantle.xyz/\",\"name\":\"Mantle Sepolia\",\"about\":\"Mantle Sepolia is the primary testnet for the Mantle chain.\",\"buildOnAlchemy\":\"Alchemy offers Mantle Sepolia RPC endpoints, so you can access reliable read and write data fo Mantle's primary testing environment.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs-v2.mantle.xyz/\",\"token\":\"MNT\"},{\"id\":\"arc-mainnet\",\"chainName\":\"Arc\",\"networkName\":\"Mainnet\",\"slug\":\"arc\",\"chainId\":5042,\"gasToken\":\"ETH\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"DebugApi\",\"Websockets\",\"BundlerApi\",\"GasManagerApi\",\"Webhooks\",\"PricesApi\",\"TraceApi\",\"TransfersApi\"],\"name\":\"Arc Mainnet\",\"about\":\"Arc is an open, EVM-compatible Layer-1 built for real-time money movement and agentic economic activity. It uses stablecoins as gas, starting with USDC, and targets deterministic sub-second finality with predictable, dollar-based fees.\",\"buildOnAlchemy\":\"Alchemy offers Arc mainnet RPC endpoints, websockets, a Debug API, and more. With Alchemy's suite of devtools, developers have everything they need to run apps at scale on Arc.\",\"category\":\"L1\",\"websiteUrl\":\"https://arc.io/\",\"officialDocsUrl\":\"https://docs.arc.io/\"},{\"id\":\"citrea-mainnet\",\"chainName\":\"Citrea\",\"networkName\":\"Mainnet\",\"slug\":\"citrea\",\"chainId\":4114,\"gasToken\":\"cBTC\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://citrea.xyz/\",\"name\":\"Citrea Mainnet\",\"about\":\"Citrea hopes to be Bitcoin's first zero-knowledge rollup. Currently in testnet, this network uses Bitcoin for both settlement and data availability, and its smart contracts help turn Bitcoin into a programmable asset, all without making any changes to the Bitcoin core protocol itself.\",\"buildOnAlchemy\":\"Alchemy offers Citrea mainnet RPC endpoints and websockets, so you can access reliable and accurate onchain data. In addition, we support Citrea with our Debug API, so you can more easily inspect and debug onchain transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.citrea.xyz/\",\"token\":\"cBTC\"},{\"id\":\"humanity-mainnet\",\"chainName\":\"Humanity\",\"networkName\":\"Mainnet\",\"slug\":\"humanity\",\"chainId\":6985385,\"gasToken\":\"H\",\"blockExplorer\":\"https://humanity-mainnet.explorer.alchemy.com\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"TraceApi\"],\"websiteUrl\":\"https://www.humanity.org\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/humanity-api-quickstart\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://bridge.arbitrum.io/\",\"name\":\"Humanity Mainnet\",\"about\":\"Humanity is a Sybil-resistant blockchain that proves user identities with zero knowledge proofs (protecting user data). It powers bot-free social networks, fraud-resistant transactions, access-controlled venues, and more.\",\"buildOnAlchemy\":\"Alchemy offers reliable Humanity RPC endpoints, ensuring you always have access to real-time read and write data you can trust.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.humanity.org/guide/introduction\",\"token\":\"H\",\"faucetUrl\":\"https://www.alchemy.com/faucets/humanity-testnet\"},{\"id\":\"starknet-mainnet\",\"chainName\":\"Starknet\",\"networkName\":\"Mainnet\",\"slug\":\"starknet\",\"chainId\":23448594291968336,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://voyager.online/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Webhooks\"],\"websiteUrl\":\"https://starknet.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/starknet-api-quickstart\",\"githubUrl\":\"https://github.com/starkware-libs\",\"blockSpeed\":\"20-60s\",\"bridgeUrl\":\"https://starkgate.starknet.io/\",\"name\":\"Starknet Mainnet\",\"about\":\"Starknet is a zk-rollup powered by the Cairo programming language, bringing STARK validity proofs to Ethereum for provably scalable computation. Starknet's native account abstraction and recursive proofs open the door to on-chain games and complex DeFi logic.\",\"buildOnAlchemy\":\"Alchemy offers reliable Starknet RPC endpoints optimized for low latency and high throughput. Alongside performant data, you can access real-time push notifications via webhooks, block data streaming with websockets, and zero-config analytics to simplify building on Starknet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.starknet.io/\",\"token\":\"STRK\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/starknet-sepolia\"},{\"id\":\"xlayer-testnet\",\"chainName\":\"X Layer\",\"networkName\":\"Testnet\",\"slug\":\"xlayer-testnet\",\"chainId\":1952,\"gasToken\":\"OKB\",\"blockExplorer\":\"https://www.oklink.com/x-layer-testnet\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://www.okx.com/xlayer\",\"name\":\"X Layer Testnet\",\"about\":\"This is the primary testnet for X Layer, OKX's zkEVM L2. Developers can build and test EVM-compatible applications with free test tokens before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy offers X Layer testnet RPC endpoints, websockets, and a Debug API, so you can test and debug your code with reliable data before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://web3.okx.com/xlayer/docs\",\"token\":\"OKB\"},{\"id\":\"robinhood-mainnet\",\"chainName\":\"Robinhood Chain\",\"networkName\":\"Mainnet\",\"slug\":\"robinhood\",\"chainId\":4663,\"gasToken\":\"ETH\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"Webhooks\",\"PricesApi\",\"BundlerApi\",\"GasManagerApi\"],\"name\":\"Robinhood Chain Mainnet\",\"about\":\"Robinhood Chain is a permissionless, Ethereum-compatible L2 from Robinhood built on Arbitrum. It is designed for onchain financial infrastructure across tokenized real-world assets, crypto, and traditional markets.\",\"buildOnAlchemy\":\"Alchemy offers Robinhood Chain mainnet RPC endpoints and websockets, so you can access reliable onchain data and stream real-time block events in production. You can also use supported APIs for tokens, NFTs, transfers, webhooks, prices, bundling, and gas sponsorship.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.robinhood.com/chain/\",\"token\":\"ETH\"},{\"id\":\"zetachain-testnet\",\"chainName\":\"ZetaChain\",\"networkName\":\"Testnet\",\"slug\":\"zetachain-testnet\",\"chainId\":7001,\"gasToken\":\"ZETA\",\"blockExplorer\":\"https://athens.explorer.zetachain.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.zetachain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/zetachain-api-quickstart\",\"githubUrl\":\"https://github.com/zeta-chain\",\"blockSpeed\":\"2s\",\"name\":\"ZetaChain Testnet\",\"about\":\"ZetaChain testnet is the primary test environment for Zetachain, enabling you to build and test cross-chain apps with unified contract logic.\",\"buildOnAlchemy\":\"Alchemy supports ZetaChain testnet with reliable RPC endpoints, so you can easily connect to ZetaChain's test environment and harden your code.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://www.zetachain.com/docs/\",\"token\":\"ZETA\"},{\"id\":\"jovay-mainnet\",\"chainName\":\"Jovay\",\"networkName\":\"Mainnet\",\"slug\":\"jovay\",\"chainId\":5734951,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.jovay.io/home\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://jovay.io/\",\"name\":\"Jovay Mainnet\",\"about\":\"Jovay is an enterprise-focused Ethereum L2 that uses an AI-optimized TEE-ZK architecture for scalability and zero-trust security. Designed for real-world asset tokenization and institutional DeFi, Jovay bridges compliance-ready financial infrastructure with onchain liquidity.\",\"buildOnAlchemy\":\"Alchemy offers reliable Jovay RPC endpoints and real-time block data streaming via websockets, so you can build enterprise-grade applications on Jovay with performant onchain data.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.jovay.io/\",\"token\":\"ETH\"},{\"id\":\"sui-mainnet\",\"chainName\":\"Sui\",\"networkName\":\"Mainnet\",\"slug\":\"sui\",\"chainId\":null,\"gasToken\":\"SUI\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Grpc\"],\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/sui-api-quickstart\",\"name\":\"SUI Mainnet\",\"about\":\"Sui is a high-performance L1 from Mysten Labs that leverages an object-centric data model and the Move programming language to parallelize transactions. Native chain features like zkLogin and sponsored transactions create a familiar Web2 experience, great for consumer apps, gaming, and more.\",\"buildOnAlchemy\":\"Alchemy offers reliable Sui RPC endpoints that serve real-time and block-perfect data. Your reliable connection to the Sui network is never more than one API call away.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sui.io/\",\"token\":\"SUI\"},{\"id\":\"aptos-mainnet\",\"chainName\":\"Aptos\",\"networkName\":\"Mainnet\",\"slug\":\"aptos\",\"chainId\":null,\"gasToken\":\"APT\",\"blockExplorer\":\"https://explorer.aptoslabs.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Grpc\"],\"websiteUrl\":\"https://aptosnetwork.com/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/aptos-api-quickstart\",\"githubUrl\":\"https://github.com/aptos-labs\",\"name\":\"Aptos Mainnet\",\"about\":\"Aptos is a high-performance L1 from former Diem engineers that uses the Move language and Block-STM parallel execution to confirm transactions in sub-seconds at high throughput. Its developer-centric tooling, resource accounts, and safety-first design make it a strong fit for consumer apps, games, and DeFi at scale.\",\"buildOnAlchemy\":\"Alchemy offers reliable Aptos mainnet RPC endpoints, so you can easily connect to the Aptos network and build apps at scale.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://aptos.dev/\",\"token\":\"APT\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/aptos\"},{\"id\":\"litecoin-testnet\",\"chainName\":\"Litecoin\",\"networkName\":\"Testnet\",\"slug\":\"litecoin-testnet\",\"chainId\":null,\"gasToken\":\"LTC\",\"blockExplorer\":\"https://blockchair.com/litecoin/testnet/transaction/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Blast\"],\"websiteUrl\":\"https://litecoin.org/\",\"alchemyDocsUrl\":\"https://github.com/litecoin-project/litecoin/tree/master/doc\",\"githubUrl\":\"https://github.com/litecoin-project/litecoin\",\"name\":\"Litecoin Testnet\",\"about\":\"Litecoin Testnet is a public test environment that mimics Litecoin mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Litecoin testnet RPC endpoints, so you can test your application with reliable read/write data before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://litecoin.info/docs\",\"token\":\"LTC\"},{\"id\":\"plasma-mainnet\",\"chainName\":\"Plasma\",\"networkName\":\"Mainnet\",\"slug\":\"plasma\",\"chainId\":9745,\"gasToken\":\"XPL\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"DebugApi\",\"TraceApi\",\"Webhooks\"],\"websiteUrl\":\"https://www.plasma.to\",\"alchemyDocsUrl\":\"https://docs.plasma.to\",\"blockSpeed\":\"1s\",\"name\":\"Plasma Mainnet\",\"about\":\"Plasma is an L1 blockchain designed ground-up for stablecoins. With ties to Tether, Plasma delivers near-instant transfers with zero fees. Alongside throughput that can support global reach, Plasma offers Bitcoin-backed security with periodic anchoring to the most battle-tested blockchain.\",\"buildOnAlchemy\":\"Alchemy offers reliable Plasma RPC API endpoints and websockets, so that accurate and real-time data for Plasma is never more than one request away.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://www.plasma.to/docs/\",\"token\":\"XPL\"},{\"id\":\"linea-sepolia\",\"chainName\":\"Linea\",\"networkName\":\"Sepolia\",\"slug\":\"linea-sepolia\",\"chainId\":59141,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.lineascan.build\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Websockets\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"DebugApi\"],\"websiteUrl\":\"https://linea.build/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/linea-chain-api-quickstart\",\"githubUrl\":\"https://github.com/Consensys/linea\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://bridge.linea.build/\",\"name\":\"Linea Sepolia\",\"about\":\"This is the primary test environment for the Linea chain.\",\"buildOnAlchemy\":\"Alchemy provides Linea Sepolia RPC endpoints and a set of data APIs, so you can access reliable and real-time read/write data. With Alchemy, you can test thoroughly and ship to mainnet confidently.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.linea.build/\"},{\"id\":\"shape-mainnet\",\"chainName\":\"Shape\",\"networkName\":\"Mainnet\",\"slug\":\"shape\",\"chainId\":360,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://shapescan.xyz/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Webhooks\",\"Websockets\",\"Subgraphs\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"DebugApi\",\"TransactionSimulationApi\",\"UserOperationsApi\"],\"websiteUrl\":\"https://shape.network/\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Shape Mainnet\",\"about\":\"Shape is an Ethereum L2 purpose-built for NFT creators. Creators on Shape can claim 80% of sequencer fees that users spend when interacting with their contracts. Same security as Ethereum, same tech stack, better costs and creator incentives.\",\"buildOnAlchemy\":\"Alchemy offers reliable Shape RPC endpoints as well as a range of dev tooling that enables you to build onchain applications, including enriched data APIs, push notifications, and data streaming.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.shape.network/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"shape-mainnet-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/shape-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/shape\",\"publicRpcUrl\":\"https://shape-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://shape-mainnet.g.alchemy.com/public\"},{\"id\":\"worldmobilechain-mainnet\",\"chainName\":\"World Mobile Chain\",\"networkName\":\"Mainnet\",\"slug\":\"worldmobilechain\",\"chainId\":869,\"gasToken\":\"WMTX\",\"blockExplorer\":\"https://explorer.worldmobile.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\"],\"name\":\"World Mobile Chain Mainnet\",\"about\":\"World Mobile Chain is an EVM-compatible L3 on Base and is purpose built for telecoms. With a product stack offering AirNodes, VPN, storage-as-a-service, eSIMs, decentralized identifiers, and more, World Mobile Chain opens the door for DePIN use cases, connectivity in underserved regions, and full data sovereignty.\",\"buildOnAlchemy\":\"Alchemy offers World Mobile Chain endpoints and websockets, so you can access reliable and performant network data whenever you need it.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.worldmobile.io/\",\"token\":\"WMTX\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\"},{\"id\":\"mythos-mainnet\",\"chainName\":\"Mythos\",\"networkName\":\"Mainnet\",\"slug\":\"mythos\",\"chainId\":42018,\"gasToken\":\"ETH\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"BundlerApi\",\"GasManagerApi\",\"EmbeddedAccounts\",\"DebugApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\"],\"name\":\"Mythos Mainnet\",\"about\":\"Mythos is a gaming-focused blockchain designed to make Web3 game development and distribution feel seamless. It provides a shared infrastructure for onchain assets, marketplaces, and gameplay economies, allowing developers to ship scalable games while giving players true ownership and interoperability across the Mythos ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers a suite of infrastructure and devtools to streamline building on Mythos, including enterprise-grade RPC endpoints, block event streams via websockets, bundler infrastructure, gas sponsorship, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.mythos.com/\",\"token\":\"MYTH\"},{\"id\":\"katana-mainnet\",\"chainName\":\"Katana\",\"networkName\":\"Mainnet\",\"slug\":\"katana\",\"chainId\":747474,\"gasToken\":\"ETH\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"name\":\"Katana Mainnet\",\"about\":\"Katana is a DeFi blockchain designed for deep liquidity and sustainable yield. It concentrates liquidity in core applications and recycles network revenue back into the ecosystem, making it a strong fit for lending, borrowing, and trading apps.\",\"buildOnAlchemy\":\"Alchemy offers Katana mainnet RPC endpoints and websockets, so you can access reliable onchain data and real-time block streams for production applications.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.katana.network/\",\"token\":\"ETH\"},{\"id\":\"lens-mainnet\",\"chainName\":\"Lens\",\"networkName\":\"Mainnet\",\"slug\":\"lens\",\"chainId\":232,\"gasToken\":\"GHO\",\"blockExplorer\":\"https://explorer.lens.xyz/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.lens.xyz/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/lens-api-quickstart\",\"githubUrl\":\"https://github.com/lens-protocol\",\"name\":\"Lens Mainnet\",\"about\":\"Lens Network is a zkEVM rollup purpose built for LensProtocol's composable social graph. Native handles, follows, and collects are first-class primitives in Lens, letting builders spin up Web3 social apps in minutes.\",\"buildOnAlchemy\":\"Alchemy provides Lens RPC endpoints as well as websockets for block data streaming that enable you to reliably connect to Lens and operate at scale.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://lens.xyz/docs/chain/overview\"},{\"id\":\"mode-sepolia\",\"chainName\":\"Mode\",\"networkName\":\"Sepolia\",\"slug\":\"mode-sepolia\",\"chainId\":919,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.explorer.mode.network/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://mode.com\",\"githubUrl\":\"https://github.com/mode-network\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://bridge.mode.network\",\"name\":\"Mode Sepolia\",\"about\":\"This is the primary test network for Mode.\",\"buildOnAlchemy\":\"Alchemy provides Mode testnet RPC endpoints and websockets, so you can harden your application and prepare for mainnet with accurate data and reliable infrastructure.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.mode.network/\",\"token\":\"MODE\"},{\"id\":\"berachain-mainnet\",\"chainName\":\"Berachain\",\"networkName\":\"Mainnet\",\"slug\":\"berachain\",\"chainId\":80094,\"gasToken\":\"BERA\",\"blockExplorer\":\"https://berascan.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Webhooks\"],\"websiteUrl\":\"https://www.berachain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/berachain-api-quickstart\",\"githubUrl\":\"https://github.com/berachain\",\"blockSpeed\":\"2-3s\",\"bridgeUrl\":\"https://examples.layerzero.network/bridge\",\"name\":\"Berachain Mainnet\",\"about\":\"Berachain is an EVM-compatible L1 built with the Cosmos SDK. The chain introduces a novel Proof of Liquidity consensus mechanism that aligns staking with block production. Berachain combines performant infrastructure with a meme-powered community and DeFi-native governance.\",\"buildOnAlchemy\":\"Alchemy provides high-performance Berachain RPC endpoints, enriched data APIs, and a range of services for helping builders launch with reliable infrastructure.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.berachain.com/\",\"token\":\"BERA\"},{\"id\":\"opt-sepolia\",\"chainName\":\"OP Mainnet\",\"networkName\":\"Sepolia\",\"slug\":\"optimism-sepolia\",\"chainId\":11155420,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia-optimism.etherscan.io\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionSimulationApi\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"TraceApi\"],\"websiteUrl\":\"https://optimism.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/optimism-api-quickstart\",\"githubUrl\":\"https://github.com/ethereum-optimism\",\"blockSpeed\":\"1-2s\",\"bridgeUrl\":\"https://app.optimism.io/bridge/deposit\",\"name\":\"OP Mainnet Sepolia\",\"about\":\"OP Sepolia is the OP Stack’s Ethereum-aligned testnet supporting OP mainnet and other Superchain deployments that use Optimism's OP Stack.\",\"buildOnAlchemy\":\"Alchemy provides OP Sepolia RPC endpoints and a variety of devtools to help you test your code, including data APIs and debugging tools. Test exhaustively and ship confidently with Alchemy.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.optimism.io/\",\"token\":\"OP\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/optimism-sepolia\"},{\"id\":\"stable-mainnet\",\"chainName\":\"Stable\",\"networkName\":\"Mainnet\",\"slug\":\"stable\",\"chainId\":988,\"gasToken\":\"USDT\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"name\":\"Stable Mainnet\",\"about\":\"Stable is a L1 \\\"stablechain\\\" designed for USDT payments that uses USDT for gas and is optimized for high volume payment transactions.\",\"buildOnAlchemy\":\"Alchemy offers performant RPC endpoints and a suite of other devtools, including event streaming, transaction bundling, gasless transactions, debugging tools, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.stable.xyz/\",\"token\":\"STABLE\",\"faucetUrl\":\"https://www.alchemy.com/faucets/stable-testnet\"},{\"id\":\"soneium-minato\",\"chainName\":\"Soneium\",\"networkName\":\"Minato\",\"slug\":\"soneium-minato\",\"chainId\":1946,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer-testnet.soneium.org/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"Webhooks\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Subgraphs\",\"DebugApi\"],\"websiteUrl\":\"https://soneium.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/soneium-api-quickstart\",\"githubUrl\":\"https://github.com/Soneium\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Soneium Minato\",\"about\":\"Minato is the primary testnet for Soneium.\",\"buildOnAlchemy\":\"Alchemy provides Soneium Minato RPC endpoints and enriched data APIs, so you can confidently experiment and test your code on Soneium before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.soneium.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"faucetUrl\":\"https://www.alchemy.com/faucets/soneium-minato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/soneium-testnet\"},{\"id\":\"flow-testnet\",\"chainName\":\"Flow EVM\",\"networkName\":\"Testnet\",\"slug\":\"flow-testnet\",\"chainId\":545,\"gasToken\":\"FLOW\",\"blockExplorer\":\"https://evm-testnet.flowscan.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Websockets\"],\"websiteUrl\":\"https://flow.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/flow-api-quickstart\",\"githubUrl\":\"https://github.com/onflow/flow-evm-gateway\",\"blockSpeed\":\"\u003c1s\",\"name\":\"Flow EVM Testnet\",\"about\":\"This network is the primary test environment for the Flow ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers Flow testnet RPC endpoints and other devtools, so you can confidently test your code with industry-leading reliability.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://developers.flow.com/\",\"token\":\"FLOW\"},{\"id\":\"blast-mainnet\",\"chainName\":\"Blast\",\"networkName\":\"Mainnet\",\"slug\":\"blast\",\"chainId\":81457,\"gasToken\":\"BLAST\",\"blockExplorer\":\"https://blastscan.io/\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"PricesApi\",\"DebugApi\"],\"websiteUrl\":\"https://blast.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/blast-chain-api-quickstart\",\"githubUrl\":\"https://github.com/BLASTchain/blast\",\"blockSpeed\":\"1-2s\",\"bridgeUrl\":\"https://blast.io/en/bridge\",\"name\":\"Blast Mainnet\",\"about\":\"Blast is an EVM-compatible L2 offering native yield on ETH and stablecoin balances by default. The chain combines rollup scalability with built-in DeFi incentives, enabling users and apps alike to earn without staking or wrapping assets. Backed by the Blur team, Blast merges passive yield mechanics with a growth-focused ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers enterprise-ready Blast RPC endpoints. Along with performant and reliable data, you have access to a range of devtools to build on Blast, including enriched data APIs, push notifications, and data streaming.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.blast.io/about-blast\",\"token\":\"BLAST\"},{\"id\":\"abstract-mainnet\",\"chainName\":\"Abstract\",\"networkName\":\"Mainnet\",\"slug\":\"abstract\",\"chainId\":2741,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://abscan.org/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Websockets\",\"Webhooks\"],\"websiteUrl\":\"https://abs.xyz/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/abstract-api-quickstart\",\"githubUrl\":\"https://github.com/Abstract-Foundation\",\"name\":\"Abstract Mainnet\",\"about\":\"Abstract is an L2 ZK rollup built on Ethereum, designed to easily bring consumers onchain. With a global wallet that enables native account abstraction, gas sponsorship, and social logins, the Abstract chain makes it easy to onboard mainstream users to your app.\",\"buildOnAlchemy\":\"With Alchemy, you can access reliable Abstract RPC endpoints and a range of infrastructure services, including push notifications and rich data APIs.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.abs.xyz/\",\"framework\":\"ZK\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/abstract-testnet\"},{\"id\":\"crossfi-mainnet\",\"chainName\":\"CrossFi\",\"networkName\":\"Mainnet\",\"slug\":\"crossfi\",\"chainId\":4158,\"gasToken\":\"XFI\",\"blockExplorer\":\"https://xfiscan.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://crossfi.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/crossfi-chain-api-quickstart\",\"githubUrl\":\"https://github.com/crossfichain\",\"blockSpeed\":\"5s\",\"name\":\"CrossFi Mainnet\",\"about\":\"CrossFi is a cross-chain finance layer that tokenizes real-world collateral (gold, fiat, commodities) and moves it natively across EVM and Cosmos ecosystems. Its hybrid custody model lets TradFi institutions plug into DeFi yield without touching wrapped assets.\",\"buildOnAlchemy\":\"Alchemy offers reliable and performant CrossFi RPC endpoints. Along with real-time data, you also have access to Alchemy's Debug API for gaining insight into onchain transactions as well as data streaming via websocket.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.crossfi.org\",\"token\":\"XFI\",\"faucetUrl\":\"https://www.alchemy.com/faucets/crossfi-testnet\"},{\"id\":\"arc-testnet\",\"chainName\":\"Arc\",\"networkName\":\"Testnet\",\"slug\":\"arc-testnet\",\"chainId\":5042002,\"gasToken\":\"USDC\",\"blockExplorer\":\"https://testnet.arcscan.app/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"DebugApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Webhooks\",\"PricesApi\",\"TraceApi\",\"TransfersApi\"],\"websiteUrl\":\"https://arc.io/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/chains#arc-apis\",\"name\":\"Arc Testnet\",\"about\":\"Arc Testnet is Arc’s network for building and testing applications before mainnet deployment.\",\"buildOnAlchemy\":\"Alchemy offers Arc testnet RPC endpoints, websockets, and a Debug API. Developers can also use the Bundler API and gas sponsorship before deploying to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.arc.io/\"},{\"id\":\"story-mainnet\",\"chainName\":\"DATA Network\",\"networkName\":\"Mainnet\",\"slug\":\"story\",\"chainId\":1514,\"gasToken\":\"DATA\",\"blockExplorer\":\"https://explorer.story.foundation/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"TransfersApi\",\"NftApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"TokenApi\",\"Subgraphs\"],\"websiteUrl\":\"https://datafdn.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/data-network-api-quickstart\",\"githubUrl\":\"https://github.com/piplabs\",\"name\":\"Story Mainnet\",\"about\":\"Story is an EVM-compatible L1 that tokenizes intellectual property into programmable onchain assets, embedding licensing terms, revenue splits, AI-driven derivations, and more. It treats IP as the scarce store-of-value for the coming generative-AI economy\",\"buildOnAlchemy\":\"Alchemy offers Story RPC endpoints, enriched data APIs, block data streaming, and more, enabling you to easily build and scale apps on Story.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.datafdn.org/introduction\",\"token\":\"DATA\"},{\"id\":\"monad-mainnet\",\"chainName\":\"Monad\",\"networkName\":\"Mainnet\",\"slug\":\"monad\",\"chainId\":143,\"gasToken\":\"MON\",\"blockExplorer\":\"https://mainnet-beta.monvision.io/\",\"isTestnet\":false,\"supportedProducts\":[\"UserOperationsApi\",\"GasManagerApi\",\"EmbeddedAccounts\",\"BundlerApi\",\"DebugApi\",\"NodeApi\",\"Websockets\",\"NftApi\",\"PricesApi\",\"TokenApi\",\"TransfersApi\",\"Webhooks\"],\"websiteUrl\":\"https://monad.xyz/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/monad-api-quickstart\",\"githubUrl\":\"https://github.com/category-labs/monad\",\"name\":\"Monad Mainnet\",\"about\":\"Monad is a next generation L1 blockchain that is fully compatible with Ethereum while offering 10K+ transactions per second and low gas fees.\",\"buildOnAlchemy\":\"Alchemy offers a number of tools to help you build on Monad, including real-time data from reliable RPC endpoints, block event streams via websockets, gasless transactions, bundler infrastructure, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.monad.xyz/\",\"token\":\"MONAD\",\"faucetUrl\":\"https://www.alchemy.com/faucets/monad-testnet\"},{\"id\":\"superseed-mainnet\",\"chainName\":\"Superseed\",\"networkName\":\"Mainnet\",\"slug\":\"superseed\",\"chainId\":5330,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.superseed.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://superseed.xyz/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/superseed-api-quickstart\",\"githubUrl\":\"https://github.com/superseed-xyz\",\"name\":\"Superseed Mainnet\",\"about\":\"Superseed is a chain designed around self-repaying loans. Built on the Optimism stack, this L2 uses a new financial primitive of \\\"supercollateral\\\" to supercharge DeFi protocols in its ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers Superseed RPC endpoints, debugging tools, and block data streaming. Launch your app faster with industry-leading reliability.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.superseed.xyz/\",\"token\":\"SUPR\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"id\":\"unichain-sepolia\",\"chainName\":\"Unichain\",\"networkName\":\"Sepolia\",\"slug\":\"unichain-sepolia\",\"chainId\":1301,\"gasToken\":\"ETH\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Subgraphs\",\"GasManagerApi\",\"EmbeddedAccounts\",\"BundlerApi\",\"Websockets\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Webhooks\"],\"websiteUrl\":\"https://unichain.io/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/unichain-api-quickstart\",\"githubUrl\":\"https://github.com/uniswap\",\"name\":\"Unichain Sepolia\",\"about\":\"Unichain Sepolia is the primary testnet for Unichain.\",\"buildOnAlchemy\":\"Alchemy provides Unichain Sepolia RPC endpoints, data APIs, debug tools, usage analytics, and more, so you can confidently test your code before shipping to mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.unichain.org/docs\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/unichain-testnet\"},{\"id\":\"worldchain-sepolia\",\"chainName\":\"World Chain\",\"networkName\":\"Sepolia\",\"slug\":\"worldchain-sepolia\",\"chainId\":4801,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://worldchain-sepolia-explorer.alchemy.com\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"NftApi\"],\"websiteUrl\":\"https://worldcoin.org/world-chain\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/worldchain-api-quickstart\",\"githubUrl\":\"https://github.com/worldcoin/world-chain\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"World Chain Sepolia\",\"about\":\"World Chain Sepolia is the primary testnet for World Chain.\",\"buildOnAlchemy\":\"Alchemy provides World Chain Sepolia RPC endpoints, rich data APIs, gas sponsorship, and more, so you can confidently build on World Chain.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.world.org/\",\"token\":\"WLD\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"worldchain-sepolia-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/world-chain-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/worldchain-testnet\",\"publicRpcUrl\":\"https://worldchain-sepolia.g.alchemy.com/public\",\"publicWssUrl\":\"wss://worldchain-sepolia.g.alchemy.com/public\"},{\"id\":\"zora-mainnet\",\"chainName\":\"Zora\",\"networkName\":\"Mainnet\",\"slug\":\"zora\",\"chainId\":7777777,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.zora.energy\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BlockTimestampApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"NftApi\"],\"websiteUrl\":\"https://zora.co\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/zora-api-quickstart\",\"githubUrl\":\"https://github.com/ourzora\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Zora Mainnet\",\"about\":\"Zora is a creator-first, OP-Stack L2 designed for NFTs and media-centric apps. Zora offers free mints, programmable royalties, and protocol modules for drops, editions, and auctions. The chain gained notoriety earlier in the year with the launch of the Zora app (a social feed that enabled creators to launch their own coin and earn for posting).\",\"buildOnAlchemy\":\"Alchemy provides reliable Zora Mainnet RPC endpoints as well as enriched data APIs, making it seamless to connect your app to the Zora network and ship creator-first experiences at scale.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.zora.co/\",\"token\":\"ZORA\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"id\":\"unichain-mainnet\",\"chainName\":\"Unichain\",\"networkName\":\"Mainnet\",\"slug\":\"unichain\",\"chainId\":130,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://unichain.blockscout.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"GasManagerApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"Websockets\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Webhooks\"],\"websiteUrl\":\"https://unichain.io/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/unichain-api-quickstart\",\"githubUrl\":\"https://github.com/uniswap\",\"name\":\"Unichain Mainnet\",\"about\":\"Unichain is an OP-Stack L2 that unifies fragmented onchain liquidity via order flow auction, routing and executing trades at the best prices across all its connected AMMs. Built in oracles and MEV-resistant matching make Unichain a popular settlement layer for DeFi aggregators.\",\"buildOnAlchemy\":\"Alchemy offers Unichain RPC endpoints and a host of infrastructure services, including enriched data APIs, push notifications, gas sponsorship, and more. Let Alchemy handle your infra while you focus on shipping value to your users.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.unichain.org/docs\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/unichain\"},{\"id\":\"celestiabridge-mainnet\",\"chainName\":\"CelestiaBridge\",\"networkName\":\"Mainnet\",\"slug\":\"celestiabridge\",\"chainId\":null,\"gasToken\":\"CELESTIA\",\"blockExplorer\":\"https://celestiabridge.com\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\"],\"websiteUrl\":\"https://celestia.org/\",\"githubUrl\":\"https://github.com/celestiaorg\",\"name\":\"CelestiaBridge Mainnet\",\"about\":\"CelestiaBridge refers to the bridge-node layer that connects Celestia’s consensus network with its data-availability network. These nodes relay block data, verify that it’s available, and expose it to rollups that use Celestia as their DA layer. In practice, this is the infrastructure that lets modular L2s post data to Celestia and still be verifiable by light clients, the plumbing that makes “modular blockchains” actually work.\",\"buildOnAlchemy\":\"Alchemy offers CelestiaBridge RPC endpoints, so your app can easily connect to the network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celestia.org/\",\"token\":\"TIA\"},{\"id\":\"xlayer-mainnet\",\"chainName\":\"X Layer\",\"networkName\":\"Mainnet\",\"slug\":\"xlayer\",\"chainId\":196,\"gasToken\":\"OKB\",\"blockExplorer\":\"https://www.oklink.com/x-layer\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://www.okx.com/xlayer\",\"name\":\"X Layer Mainnet\",\"about\":\"X Layer is a zkEVM Layer 2 built by OKX using Polygon CDK. It uses OKB as its native gas token and connects OKX's 50M+ users with the broader Ethereum ecosystem, offering low fees and full EVM compatibility via zero-knowledge proofs.\",\"buildOnAlchemy\":\"Alchemy offers reliable X Layer RPC endpoints, block data streaming via websockets, and a Debug API for inspecting onchain transactions, so you can build and scale with confidence.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://web3.okx.com/xlayer/docs\",\"token\":\"OKB\"},{\"id\":\"polygon-amoy\",\"chainName\":\"Polygon PoS\",\"networkName\":\"Amoy\",\"slug\":\"matic-amoy\",\"chainId\":80002,\"gasToken\":\"MATIC\",\"blockExplorer\":\"https://www.oklink.com/amoy\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionSimulationApi\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"Websockets\",\"Webhooks\"],\"websiteUrl\":\"https://polygon.technology/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/polygon-api-quickstart\",\"githubUrl\":\"https://github.com/maticnetwork\",\"blockSpeed\":\"2-3s\",\"bridgeUrl\":\"https://portal.polygon.technology/bridge\",\"name\":\"Polygon PoS Amoy\",\"about\":\"Amoy is Polygon PoS’s main testnet, designed for developers to test contracts, tools, and apps in a low-cost and safe environment that mirrors Polygon PoS mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Polygon Amoy RPC endpoints to streamline your testing on Polygon. With an array of devtools and data APIs, you have everything you need to harden your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.polygon.technology/\",\"token\":\"MATIC\",\"faucetUrl\":\"https://www.alchemy.com/faucets/polygon-amoy\"},{\"id\":\"polygon-mainnet\",\"chainName\":\"Polygon PoS\",\"networkName\":\"Mainnet\",\"slug\":\"matic\",\"chainId\":137,\"gasToken\":\"MATIC\",\"blockExplorer\":\"https://polygonscan.com\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionSimulationApi\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"PricesApi\"],\"websiteUrl\":\"https://polygon.technology/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/polygon-api-quickstart\",\"githubUrl\":\"https://github.com/maticnetwork\",\"blockSpeed\":\"2-3s\",\"bridgeUrl\":\"https://portal.polygon.technology/bridge\",\"name\":\"Polygon PoS Mainnet\",\"about\":\"Polygon PoS is Ethereum’s flagship side-chain offering ultra-low fees and full EVM compatibility, letting mainstream brands like Reddit and Nike reach millions of users. Its broad validator set and deep liquidity make it the default on-ramp to the Polygon ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers reliable Polygon RPC endpoints designed for scalable access to the network. In addition to performant read and write data, Alchemy provides devtools including enriched data apis, push notifications, and seamless WebSocket support to help you build and scale effortlessly.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.polygon.technology/\",\"token\":\"MATIC\",\"faucetUrl\":\"https://www.alchemy.com/faucets/polygon-amoy\"},{\"id\":\"injective-mainnet\",\"chainName\":\"Injective\",\"networkName\":\"Mainnet\",\"slug\":\"injective\",\"chainId\":1776,\"gasToken\":\"INJ\",\"blockExplorer\":\"https://explorer.injective.network/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://injective.com/\",\"name\":\"Injective Mainnet\",\"about\":\"Injective is a Cosmos-SDK L1 purpose-built for finance, offering sub-second block times and zero gas fees for end users. With native support for decentralized exchanges, derivatives, prediction markets, and cross-chain trading, Injective is a leading chain for onchain financial applications.\",\"buildOnAlchemy\":\"Alchemy offers reliable Injective mainnet RPC endpoints and real-time block data streaming via websockets, so you can build financial applications on Injective with performant and accurate onchain data.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.injective.network/\",\"token\":\"INJ\"},{\"id\":\"kaia-testnet\",\"chainName\":\"Kaia\",\"networkName\":\"Testnet\",\"slug\":\"kaia-testnet\",\"chainId\":1001,\"gasToken\":\"KAIA\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"name\":\"Kaia Testnet\",\"about\":\"Kaia Testnet is the Kairos public test network for Kaia. Developers can test EVM-compatible smart contracts and app integrations before deploying to Kaia mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Kaia testnet RPC endpoints and websockets, so you can build with reliable testnet data and real-time block streams before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.kaia.io/\",\"token\":\"KAIA\"},{\"id\":\"tempo-mainnet\",\"chainName\":\"Tempo\",\"networkName\":\"Mainnet\",\"slug\":\"tempo\",\"chainId\":4217,\"gasToken\":\"USDC\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://tempo.xyz/\",\"name\":\"Tempo Mainnet\",\"about\":\"Tempo is a Layer-1 blockchain backed by Stripe and Paradigm that’s purpose-built for payments at internet scale. Unlike general-purpose chains, Tempo is architected around the demands of production payment systems: predictable fees, sub-second finality, over 100K TPS, and dedicated payment lanes that guarantee blockspace for transfers even during congestion. Tempo also introduces the Machine Payments Protocol (MPP), an open standard for how AI agents pay for services, along with native account abstraction, a compliance-ready token standard (TIP-20), and the ability to pay gas in stablecoins.\",\"buildOnAlchemy\":\"Alchemy provides Day 1 mainnet infrastructure for Tempo, including enterprise-grade RPC endpoints, block event streaming via websockets, a Debug API for inspecting transactions, and full support for Tempo’s unique primitives including TIP-20 tokens and payment lane features.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.tempo.xyz/\"},{\"id\":\"stable-testnet\",\"chainName\":\"Stable\",\"networkName\":\"Testnet\",\"slug\":\"stable-testnet\",\"chainId\":2201,\"gasToken\":\"USDT\",\"blockExplorer\":\"https://stable-explorer.testnet.chain0.dev/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\"],\"name\":\"Stable Testnet\",\"about\":\"This is the primary testnet for Stable.\",\"buildOnAlchemy\":\"Alchemy offers performant Stable testnet infrastructure, including block-perfect data via familiar API endpoints, block streams via websockets, bundler infrastructure, gas sponsorship, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.stable.xyz/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/stable-testnet\"},{\"id\":\"tron-mainnet\",\"chainName\":\"Tron\",\"networkName\":\"Mainnet\",\"slug\":\"tron\",\"chainId\":728126428,\"gasToken\":\"TRX\",\"blockExplorer\":\"https://tronscan.org/#/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Grpc\"],\"websiteUrl\":\"https://tron.network/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/tron-api-quickstart\",\"githubUrl\":\"https://github.com/tronprotocol\",\"name\":\"Tron Mainnet\",\"about\":\"Tron is a high-throughput L1 that has become one of the largest rails for stablecoin transfers, especially in emerging markets. With consistently low fees and EVM-compatability, Tron has become a popular chain for builders worldwide.\",\"buildOnAlchemy\":\"Alchemy offers performant Tron RPC endpoints, so you can reliably build onchain.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.tron.network/\",\"token\":\"TRX\"},{\"id\":\"kaia-mainnet\",\"chainName\":\"Kaia\",\"networkName\":\"Mainnet\",\"slug\":\"kaia\",\"chainId\":8217,\"gasToken\":\"KAIA\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"name\":\"Kaia Mainnet\",\"about\":\"Kaia is an EVM-compatible Layer-1 blockchain formed by the merger of Klaytn and Finschia. Built for mass Web3 adoption, Kaia gives developers a high-performance network for consumer apps, payments, DeFi, and other onchain finance use cases.\",\"buildOnAlchemy\":\"Alchemy offers Kaia mainnet RPC endpoints and websockets, so you can access reliable onchain data and stream real-time block events for production applications.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.kaia.io/\",\"token\":\"KAIA\"},{\"id\":\"solana-mainnet\",\"chainName\":\"Solana\",\"networkName\":\"Mainnet\",\"slug\":\"solana\",\"chainId\":null,\"gasToken\":\"SOL\",\"blockExplorer\":\"https://explorer.solana.com\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"PricesApi\",\"Webhooks\",\"GasManagerApi\",\"EmbeddedAccounts\",\"Websockets\",\"Grpc\"],\"websiteUrl\":\"https://solana.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/solana-api-quickstart\",\"githubUrl\":\"https://github.com/solana-labs\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://www.alchemy.com/list-of/web3-bridges-on-solana\",\"name\":\"Solana Mainnet\",\"about\":\"Solana is a high-speed blockchain known for its fast transaction processing and low fees, making it a preferred choice for high-volume apps that demand performance. With the second largest developer community, Solana pushes the boundaries of what's possible onchain today.\",\"buildOnAlchemy\":\"Alchemy provides highly reliable and performant Solana RPC endpoints that connect your app to the Solana network. Along with real-time read and write data, Alchemy offers enriched data services, push notifications, and more, making building on Solana easy for solo devs and enterprise alike.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://solana.com/docs\",\"token\":\"SOL\"},{\"id\":\"tron-testnet\",\"chainName\":\"Tron\",\"networkName\":\"Testnet\",\"slug\":\"tron-testnet\",\"chainId\":3448148188,\"gasToken\":\"TRX\",\"blockExplorer\":\"https://nile.tronscan.org/#/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Grpc\"],\"websiteUrl\":\"https://tron.network/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/tron-api-quickstart\",\"githubUrl\":\"https://github.com/tronprotocol\",\"name\":\"Tron Testnet\",\"about\":\"This is the primary testnet for the Tron network.\",\"buildOnAlchemy\":\"Tron offers reliable Tron testnet RPC endpoints. Focus less on your infrastructure and more on your customers with Alchemy.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.tron.network/\",\"token\":\"TRX\"},{\"id\":\"zetachain-mainnet\",\"chainName\":\"ZetaChain\",\"networkName\":\"Mainnet\",\"slug\":\"zetachain\",\"chainId\":7000,\"gasToken\":\"ZETA\",\"blockExplorer\":\"https://explorer.zetachain.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"PricesApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.zetachain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/zetachain-api-quickstart\",\"githubUrl\":\"https://github.com/zeta-chain\",\"blockSpeed\":\"2s\",\"name\":\"ZetaChain Mainnet\",\"about\":\"ZetaChain is a Cosmos-SDK omnichain L1 with built-in cross-chain message passing, letting developers call contracts across Bitcoin, Ethereum and Cosmos zones from a single hub. This focus on multichain interoperability easily enables apps to build across multiple ecosystems without relying on bridges and wrapped tokens.\",\"buildOnAlchemy\":\"Alchemy provides reliable ZetaChain RPC endpoints that enable you to build onchain. You can also access app analytics from the Alchemy dashboard as well as a range of devtools that can help you build in production, including push notifications, block streaming, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://www.zetachain.com/docs/\",\"token\":\"ZETA\"},{\"id\":\"pharos-atlantic\",\"chainName\":\"Pharos\",\"networkName\":\"Atlantic\",\"slug\":\"pharos-atlantic\",\"chainId\":688689,\"gasToken\":\"PHRS\",\"blockExplorer\":\"https://atlantic.pharosscan.xyz/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://www.pharos.xyz/\",\"name\":\"Pharos Atlantic\",\"about\":\"Atlantic is Pharos's primary public testnet. It lets developers test EVM-compatible applications on Pharos's high-performance Layer-1 before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Pharos Atlantic RPC endpoints and websockets, so you can test your app with reliable onchain data and real-time block streams before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.pharos.xyz/\",\"token\":\"PHRS\"},{\"id\":\"berachain-bepolia\",\"chainName\":\"Berachain\",\"networkName\":\"Bepolia\",\"slug\":\"berachain-bepolia\",\"chainId\":80069,\"gasToken\":\"BERA\",\"blockExplorer\":\"https://bepolia.beratrail.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"Webhooks\"],\"websiteUrl\":\"https://www.berachain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/berachain-api-quickstart\",\"githubUrl\":\"https://github.com/berachain\",\"blockSpeed\":\"2-3s\",\"bridgeUrl\":\"https://examples.layerzero.network/bridge\",\"name\":\"Berachain Bepolia\",\"about\":\"Bepolia is the primary testnet for Berachain.\",\"buildOnAlchemy\":\"Alchemy offers Berachain Bepolia RPC endpoints, debugging tools, and dashboard analytics, so you can experiment and test your code before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.berachain.com/\",\"token\":\"BERA\"},{\"id\":\"sei-mainnet\",\"chainName\":\"Sei\",\"networkName\":\"Mainnet\",\"slug\":\"sei\",\"chainId\":1329,\"gasToken\":\"SEI\",\"blockExplorer\":\"https://www.seiscan.app/pacific-1\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"Subgraphs\"],\"websiteUrl\":\"https://www.sei.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/sei-api-quickstart\",\"githubUrl\":\"https://github.com/sei-protocol\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://www.sei.network/bridge\",\"name\":\"Sei Mainnet\",\"about\":\"Sei is a Cosmos-SDK L1, optimized for order-book DeFi, leveraging parallel transaction processing to achieve 300ms block times. With native price matching, Sei is ideal for bringing the experiences of traditional financial institutions and CEXs onchain.\",\"buildOnAlchemy\":\"Alchemy provides reliable Sei RPC endpoints that enable you to build onchain. In addition, Alchemy offers a Debug API for getting insights into onchain transactions, websockets for block data streaming, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sei.io/\",\"token\":\"SEI\"},{\"id\":\"jovay-testnet\",\"chainName\":\"Jovay\",\"networkName\":\"Testnet\",\"slug\":\"jovay-testnet\",\"chainId\":2019775,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia-explorer.jovay.io/home\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://jovay.io/\",\"name\":\"Jovay Testnet\",\"about\":\"This is the primary testnet for Jovay. Developers can build and test applications against Jovay's enterprise L2 environment before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Jovay testnet RPC endpoints and websockets, so you can access reliable data and harden your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.jovay.io/\",\"token\":\"ETH\"},{\"id\":\"ronin-mainnet\",\"chainName\":\"Ronin\",\"networkName\":\"Mainnet\",\"slug\":\"ronin\",\"chainId\":2020,\"gasToken\":\"RON\",\"blockExplorer\":\"https://explorer.roninchain.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\"],\"websiteUrl\":\"https://roninchain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ronin-api-quickstart\",\"githubUrl\":\"https://github.com/axieinfinity\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://app.roninchain.com/bridge?ts=ETH\",\"name\":\"Ronin Mainnet\",\"about\":\"Ronin is a gaming-first blockchain developed by Sky Mavis and powers titles like Axie Infinity, handling millions of daily transactions at sub-cent gas fees. Ronin is a proven platform for scaling player-owned game economies.\",\"buildOnAlchemy\":\"Alchemy providers Ronin RPC endpoints and scalable infrastructure services, including enriched data APIs, push notifications, debugging tools, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.roninchain.com/\",\"token\":\"RON\"},{\"id\":\"zora-sepolia\",\"chainName\":\"Zora\",\"networkName\":\"Sepolia\",\"slug\":\"zora-sepolia\",\"chainId\":999999999,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.explorer.zora.energy\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"NftApi\"],\"websiteUrl\":\"https://zora.co\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/zora-api-quickstart\",\"githubUrl\":\"https://github.com/ourzora\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Zora Sepolia\",\"about\":\"Zora Sepolia is the primary testnet for Zora.\",\"buildOnAlchemy\":\"Alchemy provides Zora Sepolia RPC endpoints and data APIs, so you can confidently test your code before shipping to mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.zora.co/\",\"token\":\"ZORA\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"id\":\"bitcoin-testnet4\",\"chainName\":\"Bitcoin\",\"networkName\":\"Testnet4\",\"slug\":\"bitcoin-testnet4\",\"chainId\":null,\"gasToken\":\"BTC\",\"blockExplorer\":\"https://mempool.space/testnet4\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\"],\"websiteUrl\":\"https://bitcoin.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/bitcoin-api-quickstart\",\"githubUrl\":\"https://github.com/bitcoin\",\"name\":\"Bitcoin Testnet4\",\"about\":\"Bitcoin Testnet4 is the current public Bitcoin test network, replacing Testnet3. It offers a fresh chain with fewer blocks, more stable difficulty adjustment, and lower fees, so developers and infrastructure can test Bitcoin software and integrations without mainnet risk.\",\"buildOnAlchemy\":\"Alchemy offers Bitcoin Testnet4 RPC endpoints, so you can access reliable read and write data in real time for testing.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"id\":\"alpen-testnet\",\"chainName\":\"Alpen\",\"networkName\":\"Testnet\",\"slug\":\"alpen-testnet\",\"chainId\":20310,\"gasToken\":\"BTC\",\"blockExplorer\":\"https://explorer.testnet.alpen.org\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"TraceApi\",\"Websockets\"],\"name\":\"Alpen Testnet\",\"about\":\"Alpen is a Bitcoin rollup built by Alpen Labs that brings an EVM-compatible execution layer to Bitcoin. Secured by zero-knowledge proofs and using BTC as its gas token, Alpen lets developers build expressive smart contract applications on top of Bitcoin.\",\"buildOnAlchemy\":\"Alchemy offers Alpen testnet RPC endpoints and websockets, so you can access reliable and accurate onchain data. In addition, we support Alpen with our Debug and Trace APIs, so you can more easily inspect and debug onchain transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.alpen.org/\",\"token\":\"BTC\"},{\"id\":\"citrea-testnet\",\"chainName\":\"Citrea\",\"networkName\":\"Testnet\",\"slug\":\"citrea-testnet\",\"chainId\":5115,\"gasToken\":\"cBTC\",\"blockExplorer\":\"https://explorer.testnet.citrea.xyz\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://citrea.xyz/\",\"name\":\"CITREA Testnet\",\"about\":\"This is the primary testnet for Citrea.\",\"buildOnAlchemy\":\"Alchemy offers Citrea testnet RPC endpoints and websockets, so you can access reliable and accurate onchain data. In addition, we support Citrea with our Debug API, so you can more easily inspect and debug onchain transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.citrea.xyz/\",\"token\":\"cBTC\"},{\"id\":\"aptos-testnet\",\"chainName\":\"Aptos\",\"networkName\":\"Testnet\",\"slug\":\"aptos-testnet\",\"chainId\":null,\"gasToken\":\"APT\",\"blockExplorer\":\"https://explorer.aptoslabs.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Grpc\"],\"websiteUrl\":\"https://aptosnetwork.com/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/aptos-api-quickstart\",\"githubUrl\":\"https://github.com/aptos-labs\",\"name\":\"Aptos Testnet\",\"about\":\"This is the primary testnet network for Aptos.\",\"buildOnAlchemy\":\"Alchemy offers Aptos testnet RPC endpoints, so you can easily and reliably connect to the network and ready your app for mainnet deployment.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://aptos.dev/\",\"token\":\"APT\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/aptos-testnet\"},{\"id\":\"worldchain-mainnet\",\"chainName\":\"World Chain\",\"networkName\":\"Mainnet\",\"slug\":\"worldchain\",\"chainId\":480,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://worldchain-mainnet-explorer.alchemy.com\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"PricesApi\",\"NftApi\"],\"websiteUrl\":\"https://worldcoin.org/world-chain\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/worldchain-api-quickstart\",\"githubUrl\":\"https://github.com/worldcoin/world-chain\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"World Chain Mainnet\",\"about\":\"World Chain is an Ethereum rollup powered by Alchemy that connects to World ID, an anonymous identity verification protocol with over 15M verified humans. It natively integrates these anonymous identities to prioritize human transactions with priority block space, gas rebates, and keeping transactions affordable for real users, not for bots.\",\"buildOnAlchemy\":\"Alchemy provides World RPC endpoints designed for global availability and optimized for reliability. Along with tools like push notifications and enriched data APIs, Alchemy makes it easier to launch and scale applications on World with confidence.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.world.org/\",\"token\":\"WLD\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"worldchain-mainnet-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/world-chain-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/worldchain\",\"publicRpcUrl\":\"https://worldchain-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://worldchain-mainnet.g.alchemy.com/public\"},{\"id\":\"blast-sepolia\",\"chainName\":\"Blast\",\"networkName\":\"Sepolia\",\"slug\":\"blast-sepolia\",\"chainId\":168587773,\"gasToken\":\"BLAST\",\"blockExplorer\":\"https://sepolia.blastscan.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"DebugApi\"],\"websiteUrl\":\"https://blast.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/blast-chain-api-quickstart\",\"githubUrl\":\"https://github.com/BLASTchain/blast\",\"blockSpeed\":\"1-2s\",\"bridgeUrl\":\"https://blast.io/en/bridge\",\"name\":\"Blast Sepolia\",\"about\":\"Blast Sepolia is the primary testnet for the Blast L2, allowing you to test your application against Blast's native yield.\",\"buildOnAlchemy\":\"Alchemy provides Blast Sepolia RPC endpoints and a suite of data APIs so you can seamlessly connect to Blast's test environment. With Alchemy's reliable data, you can harden your code and confidently ship to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.blast.io/about-blast\",\"token\":\"BLAST\"},{\"id\":\"eth-sepolia\",\"chainName\":\"Ethereum\",\"networkName\":\"Sepolia\",\"slug\":\"ethereum-sepolia\",\"chainId\":11155111,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.etherscan.io\",\"isTestnet\":true,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionSimulationApi\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"TraceApi\",\"Websockets\",\"Webhooks\"],\"websiteUrl\":\"https://ethereum.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ethereum-api-quickstart\",\"githubUrl\":\"https://github.com/ethereum\",\"blockSpeed\":\"12-15s\",\"bridgeUrl\":\"https://www.alchemy.com/list-of/web3-bridges-on-ethereum\",\"name\":\"Ethereum Sepolia\",\"about\":\"Sepolia is Ethereum’s main public testnet for smart contract development and infrastructure testing. Sepolia replicates mainnet behavior with low-stakes test ETH and consistent uptime for code iteration and production-hardening.\",\"buildOnAlchemy\":\"Alchemy offers performant Sepolia RPC endpoints that simplify your testing on Ethereum. With a suite of data APIs and devtools and data APIs, you can make sure your code is production-ready before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":