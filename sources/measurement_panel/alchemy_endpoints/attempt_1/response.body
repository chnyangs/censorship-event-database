oken\":\"XLM\"},{\"id\":\"sonic-testnet\",\"chainName\":\"Sonic\",\"networkName\":\"Testnet\",\"slug\":\"sonic-testnet\",\"chainId\":14601,\"gasToken\":\"S\",\"blockExplorer\":\"https://testnet.sonicscan.org/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"TraceApi\"],\"websiteUrl\":\"https://www.soniclabs.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/sonic-api-quickstart\",\"githubUrl\":\"https://github.com/0xsoniclabs/Sonic\",\"blockSpeed\":\"\u003c1s\",\"name\":\"Sonic Testnet\",\"about\":\"This is the primary testnet for the Sonic chain.\",\"buildOnAlchemy\":\"Alchemy offers performant Sonic testnet RPC endpoints, as well as websockets and a Debug API, so you can test your application with reliable data as you prepare for mainnet deployment.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.soniclabs.com/\",\"token\":\"S\"},{\"id\":\"ink-mainnet\",\"chainName\":\"Ink\",\"networkName\":\"Mainnet\",\"slug\":\"ink\",\"chainId\":57073,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.inkonchain.com/\",\"isTestnet\":false,\"supportedProducts\":[\"GasManagerApi\",\"EmbeddedAccounts\",\"BundlerApi\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"Websockets\",\"NodeApi\",\"DebugApi\"],\"websiteUrl\":\"https://inkonchain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ink-api-quickstart\",\"githubUrl\":\"https://github.com/inkonchain\",\"blockSpeed\":\"\u003c1s\",\"name\":\"Ink Mainnet\",\"about\":\"Ink is a DeFi chain built by Kraken to serve as a seamless birdge to DeFi. Built on the Optimism Superchain, Ink is tightly integrated with Kraken's centralized exchange with on/off ramps that connect your app to all of Kraken's user base.\",\"buildOnAlchemy\":\"Alchemy provides reliable Ink RPC endpoints trusted by enterprise and solo devs alike. Along with this read and write data, Alchemy offers a suite of enriched data APIs to help you ship better onchain experiences, along with push notifications, block streaming, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.inkonchain.com/\",\"token\":\"INK\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Gelato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/ink\"},{\"id\":\"anime-sepolia\",\"chainName\":\"Anime\",\"networkName\":\"Sepolia\",\"slug\":\"anime-sepolia\",\"chainId\":6900,\"gasToken\":\"ANIME\",\"isTestnet\":true,\"supportedProducts\":[\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Webhooks\",\"TransfersApi\",\"Websockets\",\"TokenApi\",\"NodeApi\",\"DebugApi\"],\"websiteUrl\":\"https://www.anime.com\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/anime-api-quickstart\",\"name\":\"Anime Sepolia\",\"about\":\"This is the primary testnet for Anime.\",\"buildOnAlchemy\":\"Alchemy offers performant Anime Sepolia RPC endpoints and a suite of devtools, including rich data APIs, block event streaming, push notifications, gas sponsorship, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://whitepaper.animechain.ai/\",\"token\":\"ANIMECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\"},{\"id\":\"eth-mainnetbeacon\",\"chainName\":\"Ethereum\",\"networkName\":\"Mainnet Beacon\",\"slug\":\"ethereum-beacon\",\"chainId\":null,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://etherscan.io\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"TraceApi\"],\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ethereum-api-quickstart\",\"name\":\"Ethereum Beacon\",\"about\":\"The Ethereum Beacon Chain is the consensus-layer backbone of Ethereum’s Proof-of-Stake. Separate but connected to the Ethereum L1 (which handles smart contract execution), the Beacon chain coordinates validators, staking, and block finality, and is responsible for securing the Ethereum network.\",\"buildOnAlchemy\":\"Leverage Alchemy's endpoints, so you can access reliable and performant data for the Beacon network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"id\":\"solana-devnet\",\"chainName\":\"Solana\",\"networkName\":\"Devnet\",\"slug\":\"solana-devnet\",\"chainId\":null,\"gasToken\":\"SOL\",\"blockExplorer\":\"https://explorer.solana.com/?cluster=devnet\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Webhooks\",\"GasManagerApi\",\"EmbeddedAccounts\",\"Websockets\",\"Grpc\"],\"websiteUrl\":\"https://solana.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/solana-api-quickstart\",\"githubUrl\":\"https://github.com/solana-labs\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://www.alchemy.com/list-of/web3-bridges-on-solana\",\"name\":\"Solana Devnet\",\"about\":\"Solana Devnet is the primary testing environment for Solana. It supports full validator simulation, program deployment, and app integration with Solana’s parallel runtime.\",\"buildOnAlchemy\":\"Alchemy provides Solana Devnet RPC endpoints, transaction logs, dashboard analytics, and more, so you can confidently test and harden your code before shipping to Solana mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://solana.com/docs\",\"token\":\"SOL\"},{\"id\":\"bnb-testnet\",\"chainName\":\"BNB Smart Chain\",\"networkName\":\"Testnet\",\"slug\":\"bnb-testnet\",\"chainId\":97,\"gasToken\":\"BNB\",\"blockExplorer\":\"https://testnet.bscscan.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Websockets\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://bnbchain.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/bnb-smart-chain-api-quickstart\",\"githubUrl\":\"https://github.com/bnb-chain\",\"blockSpeed\":\"3s\",\"bridgeUrl\":\"https://www.bnbchain.org/en/bnb-chain-bridge\",\"nam