le/chunks/0lviq-ixr-tea.js\",\"/_next/static/immutable/chunks/3gansv_07ajc5.js\",\"/_next/static/immutable/chunks/2dahy62y1i8ip.js\",\"/_next/static/immutable/chunks/2co60z_h7xovh.js\",\"/_next/static/immutable/chunks/0o_wikt_68w7l.js\",\"/_next/static/immutable/chunks/3dt7o8qb0mu0u.js\",\"/_next/static/immutable/chunks/2bkplcnmrp_3a.js\",\"/_next/static/immutable/chunks/1ilnlulnqgjnu.js\",\"/_next/static/immutable/chunks/1qimlv2ga1c2a.js\",\"/_next/static/immutable/chunks/2wk-rha2zny8r.js\",\"/_next/static/immutable/chunks/0zt1aryund1wf.js\",\"/_next/static/immutable/chunks/1s-yszu4cvyuq.js\"],\"default\"]\n6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://www.alchemy.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Chain Resource Directory\\\",\\\"item\\\":\\\"https://www.alchemy.com/rpc\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Ethereum\\\",\\\"item\\\":\\\"https://www.alchemy.com/rpc/ethereum\\\"}]}\"}}],[\"$\",\"$L25\",null,{\"src\":\"/images/rpc-details-bg.jpg\",\"alt\":\"Chain details background\",\"fill\":true,\"className\":\"-z-10\"}],[\"$\",\"div\",null,{\"className\":\"flex max-w-4xl items-center justify-between lg:my-8 xl:mx-auto\",\"children\":[\"$L44\",[\"$\",\"$L45\",null,{}]]}],[\"$\",\"$L46\",null,{\"chainData\":{\"about\":\"Ethereum is the leading smart contract platform powering decentralized applications across DeFi, NFTs, gaming, and more. As the most widely adopted blockchain with the largest developer community, Ethereum is the foundation of Web3.\",\"buildOnAlchemy\":\"Alchemy provides highly reliable Ethereum RPC endpoints that connect your app to the Ethereum network. Along with real-time read and write data, Alchemy offers a suite of tools to build on Ethereum, including enriched data services, deployment tools, and infrastructure trusted by the largest builders onchain.\"},\"networks\":[{\"id\":\"base-mainnet\",\"chainName\":\"Base\",\"networkName\":\"Mainnet\",\"slug\":\"base\",\"chainId\":8453,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://basescan.org\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"TransactionSimulationApi\",\"PricesApi\"],\"websiteUrl\":\"https://base.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/base-api-quickstart\",\"githubUrl\":\"https://github.com/base-org\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Base Mainnet\",\"about\":\"Base is an OP Stack L2 developed by Coinbase to bring the next billion users onchain. It offers low fees, high throughput, and deep integration with Coinbase’s exchange and fiat rails. With strong developer tools and ecosystem incentives, it’s a gateway for mainstream Web3 apps.\",\"buildOnAlchemy\":\"Alchemy offers reliable and performant Base RPC endpoints that connect your app to the Base network. Alongside real-time read and write data, Alchemy provides a suite of devtools for Base, including push notifications, data streams, enriched APIs, and a full development platform trusted by teams building at scale.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.base.org/\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/base-sepolia\",\"publicRpcUrl\":\"https://base-mainnet.g.alchemy.com/public\"},{\"id\":\"rise-mainnet\",\"chainName\":\"Rise\",\"networkName\":\"Mainnet\",\"slug\":\"rise\",\"chainId\":4153,\"gasToken\":\"ETH\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://www.riselabs.xyz/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/rise-api-quickstart\",\"githubUrl\":\"https://github.com/risechain\",\"name\":\"Rise Mainnet\",\"about\":\"Rise is an Ethereum L2 designed for high-speed, high-throughput applications while preserving Ethereum finality. Rise mainnet gives builders a production network for low-latency onchain apps across trading, gaming, and consumer experiences.\",\"buildOnAlchemy\":\"Alchemy offers Rise mainnet RPC endpoints and websockets, so you can access reliable onchain data and stream real-time block events for production applications.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.risechain.com/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\"},{\"id\":\"metis-mainnet\",\"chainName\":\"Metis\",\"networkName\":\"Mainnet\",\"slug\":\"metis\",\"chainId\":1088,\"gasToken\":\"METIS\",\"blockExplorer\":\"https://explorer.metis.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"PricesApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://www.metis.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/metis-chain-api-quickstart\",\"githubUrl\":\"https://github.com/MetisProtocol\",\"blockSpeed\":\"1-2s\",\"bridgeUrl\":\"https://bridge.metis.io/home\",\"name\":\"Metis Mainnet\",\"about\":\"Metis is an optimistic rollup built on Ethereum that introduces native support for DACs—Decentralized Autonomous Companies. The network blends scalability with tools for onchain governance, reputation, and operational coordination.\",\"buildOnAlchemy\":\"Alchemy provides reliable Metis RPC endpoints as well as real time push notifications, block data streams, and more, in order to enable you to rapidly build on Metis.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.metis.io/dev\",\"token\":\"METIS\"},{\"id\":\"plasma-testnet\",\"chainName\":\"Plasma\",\"networkName\":\"Testnet\",\"slug\":\"plasma-testnet\",\"chainId\":9746,\"gasToken\":\"XPL\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"DebugApi\",\"TraceApi\"],\"websiteUrl\":\"https://www.plasma.to\",\"alchemyDocsUrl\":\"https://docs.plasma.to\",\"blockSpeed\":\"1s\",\"name\":\"Plasma Testnet\",\"about\":\"This is the primary testnet for the Plasma chain.\",\"buildOnAlchemy\":\"Alchemy offers Plasma testnet RPC endpoints and websockets, so you can harden your code with reliable data and get ready for production.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.plasma.to/docs\",\"token\":\"XPL\"},{\"id\":\"megaeth-mainnet\",\"chainName\":\"MegaETH\",\"networkName\":\"Mainnet\",\"slug\":\"megaeth\",\"chainId\":4326,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://www.megaexplorer.xyz/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://www.megaeth.com/\",\"githubUrl\":\"https://github.com/megaeth-labs\",\"name\":\"MegaETH Mainnet\",\"about\":\"MegaETH is an Ethereum L2 described as a “real-time blockchain,” with sub-10 ms block times and 100,000+ transactions per second. By pushing execution to web2-style latency and using Ethereum for settlement and EigenDA-style data availability, it makes on-chain trading, gaming, and social feel instant onchain.\",\"buildOnAlchemy\":\"Alchemy offers reliable and performant data via enterprise-grade MegaETH RPC endpoints and websockets. In addition, we offer a Debug API for MegaETH mainnet, so you can better understand transaction statuses onchain.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.megaeth.com/\"},{\"id\":\"zksync-mainnet\",\"chainName\":\"ZKsync\",\"networkName\":\"Mainnet\",\"slug\":\"zksync\",\"chainId\":324,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer.zksync.io\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"Subgraphs\",\"Websockets\",\"Webhooks\",\"PricesApi\",\"DebugApi\"],\"websiteUrl\":\"https://zksync.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/zksync-api-quickstart\",\"githubUrl\":\"https://github.com/matter-labs\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://portal.zksync.io/bridge/?network=mainnet\",\"name\":\"ZKsync Mainnet\",\"about\":\"zkSync Era is an Ethereum zkEVM rollup that emphasizes account abstraction and L2 composability. It offers fast finality, low fees, and secure execution with a developer-friendly UX. zkSync aims to unlock new app design patterns while preserving Ethereum tooling.\",\"buildOnAlchemy\":\"Alchemy provides performant ZKsync RPC endpoints designed for fast, secure dapp development. Paired with real-time notification support and enriched data APIs, Alchemy gives developers the resources they need to build scalable apps on ZKsync.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.zksync.io/\",\"token\":\"ZK\",\"faucetUrl\":\"https://www.alchemy.com/faucets/zksync-sepolia\"},{\"id\":\"bitcoincash-mainnet\",\"chainName\":\"Bitcoin Cash\",\"networkName\":\"Mainnet\",\"slug\":\"bitcoin-cash\",\"chainId\":null,\"gasToken\":\"BCH\",\"blockExplorer\":\"https://blockchair.com/bitcoin-cash/transaction/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Blast\"],\"websiteUrl\":\"https://bitcoincash.org/\",\"alchemyDocsUrl\":\"https://docs.bitcoincash.org/\",\"githubUrl\":\"https://github.com/bitcoin-cash-node/bitcoin-cash-node\",\"name\":\"Bitcoin Cash Mainnet\",\"about\":\"Bitcoin Cash is a UTXO Layer-1 blockchain that forked from Bitcoin in 2017. It uses larger blocks for higher throughput, supporting faster and cheaper transactions while preserving Bitcoin's proof-of-work security model.\",\"buildOnAlchemy\":\"Alchemy provides reliable Bitcoin Cash RPC endpoints, so you can access performant, real-time read and write data for one of the longest-running Bitcoin forks.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bitcoincash.org/\",\"token\":\"BCH\"},{\"id\":\"apechain-mainnet\",\"chainName\":\"ApeChain\",\"networkName\":\"Mainnet\",\"slug\":\"apechain\",\"chainId\":33139,\"gasToken\":\"APE\",\"blockExplorer\":\"https://apechain.calderaexplorer.xyz\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"PricesApi\"],\"websiteUrl\":\"https://apechain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/apechain-api-quickstart\",\"blockSpeed\":\"2-3s\",\"bridgeUrl\":\"https://curtis.bridge.caldera.xyz/\",\"name\":\"ApeChain Mainnet\",\"about\":\"ApeChain is an Arbitrum Orbit L3 created by the ApeCoin DAO and purpose built for Yuga Labs games and the wider BAYC ecosystem. Native APE gas and custom gaming primitives let studios launch great user experiences without leaving the Ape community's token economy.\",\"buildOnAlchemy\":\"Alchemy offers ApeChain RPC endpoints, giving you access to industry-leading data reliability. In addition, you can leverage a suite of data APIs to build richer onchain experiences for your users.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.apechain.com/\",\"token\":\"APECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\",\"provider\":\"Caldera\"},{\"id\":\"settlus-mainnet\",\"chainName\":\"Settlus\",\"networkName\":\"Mainnet\",\"slug\":\"settlus\",\"chainId\":5371,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://mainnet.settlus.network/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"NftApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://settlus.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/settlus-api-quickstart\",\"githubUrl\":\"https://github.com/settlus\",\"blockSpeed\":\"\u003c1s\",\"name\":\"Settlus Mainnet\",\"about\":\"Settlus provides a transparent settlement system for creators via its L2 chain built with the OP-Stack. Offering programmable payouts, royalty rights, and more, Settlus gives power to the creator economy.\",\"buildOnAlchemy\":\"Alchemy offers Settlus testnet RPC endpoints and a range of enriched data APIs to handle all of your read and write needs at scale. In addition, Alchemy offers push notifications and block data streaming to make sure you get all of the information you need, in real time.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.settlus.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"settlus-mainnet-sequencer.g.alchemy.com/\",\"publicRpcUrl\":\"https://settlus-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://settlus-mainnet.g.alchemy.com/public\"},{\"id\":\"crossfi-testnet\",\"chainName\":\"CrossFi\",\"networkName\":\"Testnet\",\"slug\":\"crossfi-testnet\",\"chainId\":4157,\"gasToken\":\"XFI\",\"blockExplorer\":\"https://test.xfiscan.com\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://crossfi.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/crossfi-chain-api-quickstart\",\"githubUrl\":\"https://github.com/crossfichain\",\"blockSpeed\":\"5s\",\"name\":\"CrossFi Testnet\",\"about\":\"This it the primary test environment for CrossFi.\",\"buildOnAlchemy\":\"Alchemy provides CrossFi testnet RPC endpoints, debugging tools, and more, so you can harden your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.crossfi.org\",\"token\":\"XFI\",\"faucetUrl\":\"https://www.alchemy.com/faucets/crossfi-testnet\"},{\"id\":\"astar-mainnet\",\"chainName\":\"Astar\",\"networkName\":\"Mainnet\",\"slug\":\"astar\",\"chainId\":592,\"gasToken\":\"ASTR\",\"blockExplorer\":\"https://testnet.arcscan.app/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://astar.network/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/astar-api-quickstart\",\"githubUrl\":\"https://github.com/AstarNetwork\",\"blockSpeed\":\"12s\",\"bridgeUrl\":\"https://portal.astar.network/astar-zkevm/bridge/ethereum\",\"name\":\"Astar Mainnet\",\"about\":\"Astar is a Polkadot parachain that supports both EVM and WASM contracts, and is designed for multichain interoperability. Its app-staking model rewards builders and token-holders, bootstrapping a vibrant cross-chain ecosystem. Astar is popular in Japan and APAC with strong enterprise support.\",\"buildOnAlchemy\":\"Alchemy provides performant Astar RPC endpoints that connect you to a multichain smart contract platform. With real-time analytics and production-ready tools, Alchemy helps developers build efficiently on Astar.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.astar.network/\",\"token\":\"ASTR\"},{\"id\":\"bitcoin-mainnet\",\"chainName\":\"Bitcoin\",\"networkName\":\"Mainnet\",\"slug\":\"bitcoin\",\"chainId\":null,\"gasToken\":\"BTC\",\"blockExplorer\":\"https://mempool.space/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\"],\"websiteUrl\":\"https://bitcoin.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/bitcoin-api-quickstart\",\"githubUrl\":\"https://github.com/bitcoin\",\"name\":\"Bitcoin Mainnet\",\"about\":\"Bitcoin is the original blockchain network and is the most secure, decentralized cryptocurrency in existence. It introduced peer-to-peer value transfer and remains a censorship-resistant store of value with a fixed 21M supply. As a base layer, it supports emerging L2s like Lightning and Stacks.\",\"buildOnAlchemy\":\"Alchemy provides reliable Bitcoin RPC endpoints, so you can access performant, real time, read and write data to the mother chain. Building on Bitcoin just got a bit easier.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"id\":\"pharos-mainnet\",\"chainName\":\"Pharos\",\"networkName\":\"Mainnet\",\"slug\":\"pharos\",\"chainId\":1672,\"gasToken\":\"PROS\",\"blockExplorer\":\"https://pharos.socialscan.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://www.pharos.xyz/\",\"name\":\"Pharos Mainnet\",\"about\":\"Pharos is a high-performance Layer-1 blockchain focused on real-world assets, open finance, and enterprise-scale DeFi. Its modular architecture, deep-parallel execution, and built-in compliance tooling are designed to deliver real-time financial applications onchain.\",\"buildOnAlchemy\":\"Alchemy offers Pharos mainnet RPC endpoints and websockets, so you can access reliable onchain data and real-time block streams for production applications.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.pharos.xyz/\",\"token\":\"PROS\"},{\"id\":\"rootstock-mainnet\",\"chainName\":\"Rootstock\",\"networkName\":\"Mainnet\",\"slug\":\"rootstock\",\"chainId\":30,\"gasToken\":\"RBTC\",\"blockExplorer\":\"https://explorer.rootstock.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"TokenApi\",\"TransfersApi\",\"Websockets\",\"NftApi\",\"DebugApi\",\"TraceApi\"],\"websiteUrl\":\"https://rootstock.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/rootstock-api-quickstart\",\"githubUrl\":\"https://github.com/rsksmart\",\"blockSpeed\":\"33s\",\"bridgeUrl\":\"https://rootstock.io/bridge\",\"name\":\"Rootstock Mainnet\",\"about\":\"Rootstock is an EVM-compatible Bitcoin sidechain, bringing Solidity smart contracts to the world of Bitcoin. Users can bridge their Bitcoin into Rootstock and deploy BTC liquidity into Solidity-powered DeFi.\",\"buildOnAlchemy\":\"Alchemy provides Rootstock RPC endpoints and a range of enriched data APIs that enable you to connect to the Rootstock network, pull onchain information directly into your application, and broadcast transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://dev.rootstock.io/\"},{\"id\":\"stellar-mainnet\",\"chainName\":\"Stellar\",\"networkName\":\"Mainnet\",\"slug\":\"stellar\",\"chainId\":null,\"gasToken\":\"XLM\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"Websockets\",\"Webhooks\"],\"name\":\"Stellar Mainnet\",\"about\":\"Stellar is a decentralized blockchain purpose-built for financial services, powering cross-border payments, asset tokenization, and stablecoin infrastructure at scale. With sub-cent transaction fees and near-instant finality, Stellar is used by major institutions including Franklin Templeton, PayPal, and MoneyGram.\",\"buildOnAlchemy\":\"Alchemy offers reliable Stellar RPC endpoints and real-time block data streaming via websockets, so you can connect to the Stellar network and build financial applications at scale.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.stellar.org/\",\"token\":\"XLM\"},{\"id\":\"base-sepolia\",\"chainName\":\"Base\",\"networkName\":\"Sepolia\",\"slug\":\"base-sepolia\",\"chainId\":84532,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.basescan.org\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"BundlerApi\",\"DebugApi\",\"EmbeddedAccounts\",\"Subgraphs\",\"TransactionReceiptsApi\",\"UserOperationsApi\",\"GasManagerApi\",\"Websockets\",\"Webhooks\",\"TransactionSimulationApi\"],\"websiteUrl\":\"https://base.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/base-api-quickstart\",\"githubUrl\":\"https://github.com/base-org\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Base Sepolia\",\"about\":\"This network is the primary testing environment for Base.\",\"buildOnAlchemy\":\"Alchemy offers Base Sepolia RPC endpoints and a range of debugging tools including debuggers, transaction simulation, tracing, and more, so you can confidently test and harden your code in Base's testing environment.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.base.org/\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/base-sepolia\"},{\"id\":\"cronos-mainnet\",\"chainName\":\"Cronos\",\"networkName\":\"Mainnet\",\"slug\":\"cronos\",\"chainId\":25,\"gasToken\":\"CRO\",\"blockExplorer\":\"https://explorer.cronos.org\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"DebugApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\"],\"websiteUrl\":\"https://crypto.com\",\"name\":\"Cronos Mainnet\",\"about\":\"Cronos is an EVM-compatible Layer 1 built on the Cosmos SDK and supported by Crypto.com. It gives developers familiar Ethereum tooling plus connectivity to the broader Cosmos ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers Cronos mainnet RPC endpoints, websockets, a Debug API, bundler infrastructure, and gas sponsorship so you can build reliable production applications.\"},{\"id\":\"gensyn-mainnet\",\"chainName\":\"Gensyn\",\"networkName\":\"Mainnet\",\"slug\":\"gensyn\",\"chainId\":685689,\"gasToken\":\"ETH\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"DebugApi\"],\"websiteUrl\":\"https://www.gensyn.ai/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/gensyn-api-quickstart\",\"githubUrl\":\"https://github.com/gensyn-ai\",\"name\":\"Gensyn Mainnet\",\"about\":\"Gensyn is a marketplace protocol for AI compute, helping turn idle GPU clusters into on-demand compute for ML engineers. Using \\\"proof of learning\\\" consensus to verify model training without re-running workloads, Gensyn solves the issue of compute verification without incurring the expense of the compute itself.\",\"buildOnAlchemy\":\"Alchemy offers reliable Gensyn RPC endpoints and real-time block data streaming via websockets. In addition, Alchemy provides gas sponsorship and a Debug API for inspecting onchain transactions, so you can build great user experiences on Gensyn.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.gensyn.ai/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\"},{\"id\":\"zksync-sepolia\",\"chainName\":\"ZKsync\",\"networkName\":\"Sepolia\",\"slug\":\"zksync-sepolia\",\"chainId\":300,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.explorer.zksync.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"TokenApi\",\"TransfersApi\",\"Subgraphs\",\"Websockets\",\"Webhooks\",\"DebugApi\"],\"websiteUrl\":\"https://zksync.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/zksync-api-quickstart\",\"githubUrl\":\"https://github.com/matter-labs\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://portal.zksync.io/bridge?network=sepolia\",\"name\":\"ZKsync Sepolia\",\"about\":\"This network is the primary testing environment for ZKsync.\",\"buildOnAlchemy\":\"Alchemy provides ZKsync Sepolia RPC endpoints and a range of data APIs, so you can confidently debug and test your code before shipping to ZKsync mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.zksync.io/\",\"token\":\"ZK\",\"faucetUrl\":\"https://www.alchemy.com/faucets/zksync-sepolia\"},{\"id\":\"tempo-moderato\",\"chainName\":\"Tempo\",\"networkName\":\"Moderato\",\"slug\":\"tempo-moderato\",\"chainId\":42431,\"gasToken\":\"USDC\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://tempo.xyz/\",\"name\":\"Tempo Moderato\",\"about\":\"This is the primary testnet for Tempo.\",\"buildOnAlchemy\":\"Alchemy offers Tempo Moderato RPC endpoints, websockets, and a Debug API, so you can test your application with reliable data before deploying to Tempo mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.tempo.xyz/\"},{\"id\":\"boba-mainnet\",\"chainName\":\"Boba\",\"networkName\":\"Mainnet\",\"slug\":\"boba\",\"chainId\":288,\"gasTo