chemy\":\"Access a range of Alchemy devtools to build on ADI testnet, including our RPC API, Debug API, and websockets. Partner with the leading onchain infra provider, so you can focus on building your application.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.adi.foundation/\"},{\"id\":\"ronin-saigon\",\"chainName\":\"Ronin\",\"networkName\":\"Saigon\",\"slug\":\"ronin-saigon\",\"chainId\":202601,\"gasToken\":\"RON\",\"blockExplorer\":\"https://explorer.saigon.roninchain.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\",\"Webhooks\"],\"websiteUrl\":\"https://roninchain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ronin-api-quickstart\",\"githubUrl\":\"https://github.com/axieinfinity\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://saigon-app.roninchain.com/bridge?ts=ETH\",\"name\":\"Ronin Saigon\",\"about\":\"Saigon is Ronin’s primary testnet.\",\"buildOnAlchemy\":\"Alchemy offers Ronin Saigon RPC endpoints and a suite of rich data APIs, so you can test your code with industry-leading data reliability.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.roninchain.com/\",\"token\":\"RON\"},{\"id\":\"story-aeneid\",\"chainName\":\"DATA Network\",\"networkName\":\"Aeneid\",\"slug\":\"story-aeneid\",\"chainId\":1315,\"gasToken\":\"DATA\",\"blockExplorer\":\"https://aeneid.explorer.story.foundation/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"TransfersApi\",\"NftApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Subgraphs\"],\"websiteUrl\":\"https://datafdn.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/data-network-api-quickstart\",\"githubUrl\":\"https://github.com/piplabs\",\"name\":\"Story Aeneid\",\"about\":\"This is the primary testnet for the Story blockchain.\",\"buildOnAlchemy\":\"Alchemy provides Story Aeneid RPC endpoints, enriched data APIs, block event streaming, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.datafdn.org/introduction\",\"token\":\"DATA\"},{\"id\":\"sei-testnet\",\"chainName\":\"Sei\",\"networkName\":\"Testnet\",\"slug\":\"sei-testnet\",\"chainId\":1328,\"gasToken\":\"SEI\",\"blockExplorer\":\"https://www.seiscan.app/atlantic-2\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://www.sei.io/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/sei-api-quickstart\",\"githubUrl\":\"https://github.com/sei-protocol\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://www.sei.network/bridge\",\"name\":\"Sei Testnet\",\"about\":\"This network is the primary test environment for Sei, supporting contract testing against Sei's parallel order execution and native price matching.\",\"buildOnAlchemy\":\"Alchemy provides Sei testnet RPC endpoints and a Debug API, so you can access reliable read/write data and harden your code to make it production-ready.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sei.io/\",\"token\":\"SEI\"},{\"id\":\"ink-sepolia\",\"chainName\":\"Ink\",\"networkName\":\"Sepolia\",\"slug\":\"ink-sepolia\",\"chainId\":763373,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://explorer-sepolia.inkonchain.com\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"GasManagerApi\",\"EmbeddedAccounts\",\"BundlerApi\",\"Subgraphs\",\"Webhooks\",\"Websockets\",\"TokenApi\",\"TransfersApi\"],\"websiteUrl\":\"https://inkonchain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ink-api-quickstart\",\"githubUrl\":\"https://github.com/inkonchain\",\"blockSpeed\":\"\u003c1s\",\"name\":\"Ink Sepolia\",\"about\":\"Ink Sepolia is the primary testnet for Kraken's Ink chain.\",\"buildOnAlchemy\":\"Alchemy provides reliable Ink Sepolia RPC endpoints, rich data APIs, usage analytics in the Alchemy dashboard, and more, so you can easily and confidently ship DeFi apps on Ink.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.inkonchain.com/\",\"token\":\"INK\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Gelato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/ink-testnet\"},{\"id\":\"starknet-sepolia\",\"chainName\":\"Starknet\",\"networkName\":\"Sepolia\",\"slug\":\"starknet-sepolia\",\"chainId\":3.934021330259978e+23,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia.voyager.online/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Webhooks\"],\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/starknet-api-quickstart\",\"githubUrl\":\"https://github.com/starkware-libs\",\"blockSpeed\":\"20-60s\",\"bridgeUrl\":\"https://starkgate.starknet.io/\",\"name\":\"Starknet Sepolia\",\"about\":\"Starknet Sepolia enables developers to test Cairo-based smart contracts on Starknet’s zk-rollup architecture. It simulates the network’s high-performance, zk-native environment for contract deployment and tooling integration.\",\"buildOnAlchemy\":\"Alchemy offers Starknet Sepolia RPC endpoints and a range of devtools to help you test and debug your code before shipping to Starknet mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.starknet.io/\",\"token\":\"STRK\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/starknet-sepolia\"},{\"id\":\"adi-mainnet\",\"chainName\":\"ADI\",\"networkName\":\"Mainnet\",\"slug\":\"adi\",\"chainId\":36900,\"gasToken\":\"ADI\",\"blockExplorer\":\"https://explorer.adifoundation.ai\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\"],\"websiteUrl\":\"https://www.adi.foundation/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/adi-api-quickstart\",\"name\":\"ADI Mainnet\",\"about\":\"ADI is a new EVM L2 blockchain backed by UAE institutions that will power the United Arab Emirates' upcoming stablecoin as well as apps across emerging markets.\",\"buildOnAlchemy\":\"Alchemy offers a suite of devtools to simplify development on ADI, including enterprise-grade RPC endpoints, event streaming via websockets, and a debugging API\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.adi.foundation/\"},{\"id\":\"opbnb-mainnet\",\"chainName\":\"opBNB\",\"networkName\":\"Mainnet\",\"slug\":\"opbnb\",\"chainId\":204,\"gasToken\":\"opBNB\",\"blockExplorer\":\"https://opbnbscan.com/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"GasManagerApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"PricesApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://bnbchain.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/opbnb-chain-api-quickstart\",\"githubUrl\":\"https://github.com/bnb-chain/opbnb\",\"blockSpeed\":\"1s\",\"bridgeUrl\":\"https://opbnb-bridge.bnbchain.org/deposit\",\"name\":\"opBNB Mainnet\",\"about\":\"opBNB is Binance's OP-Stack L2, marrying Ethereum's security with BNB chain's large user funnel and deep liqudity. With a deep integration to Binance's infrastructure, opBNB is a fast onramp for consumer apps looking to reach a massive user base.\",\"buildOnAlchemy\":\"Alchemy provides reliable opBNB RPC endpoints optimized for enterprise-grade availability and scalability. In addition to industry-leading data availability, Alchemy offers a suite of tools for building on opBNB, including data streaming, enriched data APIs, and more.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.bnbchain.org/bnb-opbnb/overview/\"},{\"id\":\"bnb-mainnet\",\"chainName\":\"BNB Smart Chain\",\"networkName\":\"Mainnet\",\"slug\":\"bnb\",\"chainId\":56,\"gasToken\":\"BNB\",\"blockExplorer\":\"https://bscscan.com\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"Subgraphs\",\"Websockets\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"PricesApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"TraceApi\",\"DebugApi\"],\"websiteUrl\":\"https://bnbchain.org/\",\"alchemyDocsUrl\":\"https://www.alchemy.com/docs/reference/bnb-smart-chain-api-quickstart\",\"githubUrl\":\"https://github.com/bnb-chain\",\"blockSpeed\":\"3s\",\"bridgeUrl\":\"https://www.bnbchain.org/en/bnb-chain-bridge\",\"name\":\"BNB Smart Chain Mainnet\",\"about\":\"BNB Smart Chain is a fast, low-fee EVM-compatible blockchain backed by Binance. With strong activity across DeFi, gaming, and NFTs, BSC supports high-volume apps in emerging markets and offers a tight integration with Binance’s user base, liquidity, ecosystem bridges, and tooling.\",\"buildOnAlchemy\":\"Alchemy offers BNB Smart Chain RPC endpoints with high availability and consistent uptime. With a suite of tools including rich data APIs, block data streaming, and gas sponsorship, Alchemy equips builders with tools and data for building on BNB.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bnbchain.org/bnb-smart-chain/\",\"token\":\"BNB\",\"publicRpcUrl\":\"https://bnb-mainnet.g.alchemy.com/public\"},{\"id\":\"eth-hoodi\",\"chainName\":\"Ethereum\",\"networkName\":\"Hoodi\",\"slug\":\"ethereum-hoodi\",\"chainId\":560048,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://hoodi.etherscan.io/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Subgraphs\",\"DebugApi\",\"TraceApi\"],\"websiteUrl\":\"https://ethereum.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/ethereum-api-quickstart\",\"githubUrl\":\"https://github.com/ethereum\",\"blockSpeed\":\"12-15s\",\"bridgeUrl\":\"https://www.alchemy.com/list-of/web3-bridges-on-ethereum\",\"name\":\"Ethereum Hoodi\",\"about\":\"Hoodi is a new Ethereum testnet that replaces the Holesky network. Hoodi is used to simulate Ethereum's validator network, and is used primarily to test validator and staking functionality.\",\"buildOnAlchemy\":\"Alchemy’s offers Hoodi RPC endpoints that simplify testing validator and staking functionality on Ethereum. With a suite of devtools and data APIs, you can make sure your code is production-ready before shipping to Ethereum mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"id\":\"sonic-mainnet\",\"chainName\":\"Sonic\",\"networkName\":\"Mainnet\",\"slug\":\"sonic\",\"chainId\":146,\"gasToken\":\"S\",\"blockExplorer\":\"https://explorer.soniclabs.com\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\",\"Websockets\",\"Subgraphs\",\"Webhooks\",\"TraceApi\"],\"websiteUrl\":\"https://www.soniclabs.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/sonic-api-quickstart\",\"githubUrl\":\"https://github.com/Fantom-Foundation\",\"blockSpeed\":\"\u003c1s\",\"bridgeUrl\":\"https://www.sonic.xyz/bridge\",\"name\":\"Sonic Mainnet\",\"about\":\"Sonic is the next evolution of Fantom, a fast, EVM-compatible L1 offering 10,000 TPS and sub-second finality. App developers can also earn up to 90% of the protocol fees generated by their application, making Sonic a founder-friendly chain.\",\"buildOnAlchemy\":\"Alchemy offers industry-leading Sonic RPC endpoints as well as push notifications, block data streaming, and a Debug API for grokking transactions. With Alchemy, building on Sonic is easier.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.soniclabs.com/\",\"token\":\"S\"},{\"id\":\"gnosis-chiado\",\"chainName\":\"Gnosis\",\"networkName\":\"Chiado\",\"slug\":\"gnosis-chiado\",\"chainId\":10200,\"gasToken\":\"xDAI\",\"blockExplorer\":\"https://gnosis-chiado.blockscout.com/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"Webhooks\",\"Subgraphs\",\"TokenApi\",\"TransfersApi\"],\"websiteUrl\":\"https://gnosischain.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/gnosis-chain-api-quickstart\",\"githubUrl\":\"https://github.com/gnosis\",\"blockSpeed\":\"5s\",\"bridgeUrl\":\"https://bridge.gnosischain.com/\",\"name\":\"Gnosis Chiado\",\"about\":\"Chiado is the primary testnet for the Gnosis Chain.\",\"buildOnAlchemy\":\"Alchemy provides Gnosis Chiado RPC endpoints and data APIs, so you can reliably connect to Gnosis test environment with performant and highly available data.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gnosischain.com/\",\"token\":\"GNO\"},{\"id\":\"anime-mainnet\",\"chainName\":\"Anime\",\"networkName\":\"Mainnet\",\"slug\":\"anime\",\"chainId\":69000,\"gasToken\":\"ANIME\",\"blockExplorer\":\"https://explorer-animechain-39xf6m45e3.t.conduit.xyz\",\"isTestnet\":false,\"supportedProducts\":[\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Webhooks\",\"TransfersApi\",\"NftApi\",\"Websockets\",\"NodeApi\",\"DebugApi\"],\"websiteUrl\":\"https://www.anime.com\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/anime-api-quickstart\",\"name\":\"Anime Mainnet\",\"about\":\"Anime is a blockchain purpose-built for anime IP, fandoms, and NFT-first experiences. Created by the Azuki team, Anime gives studios and fans tamper-proof provenance and licensing rails, issues at the core of AI-generated content.\",\"buildOnAlchemy\":\"Alchemy provides reliable Anime RPC endpoints, real-time block data streaming via websockets, push notifications, and more, so you can easily build on Anime.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://whitepaper.animechain.ai/\",\"token\":\"ANIMECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\"},{\"id\":\"avax-fuji\",\"chainName\":\"Avalanche\",\"networkName\":\"Fuji\",\"slug\":\"avalanche-fuji\",\"chainId\":43113,\"gasToken\":\"AVAX\",\"blockExplorer\":\"https://subnets-test.avax.network/c-chain/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"NftApi\",\"Subgraphs\",\"Webhooks\",\"TokenApi\",\"TransfersApi\",\"Websockets\",\"DebugApi\"],\"websiteUrl\":\"https://avax.network/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/avalanche-api-quickstart\",\"githubUrl\":\"https://github.com/ava-labs\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://core.app/bridge/\",\"name\":\"Avalanche Fuji\",\"about\":\"Fuji is Avalanche’s primary testnet supporting smart contract testing, subnets, and validator configuration.\",\"buildOnAlchemy\":\"Alchemy provides Avalanche Fuji RPC endpoints and a suite of Data APIs, so you can easily connect to the Fuji network, debug and harden your code, and confidently ship to Avalanche mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.avax.network/\",\"token\":\"AVAX\"},{\"id\":\"moonbeam-mainnet\",\"chainName\":\"Moonbeam\",\"networkName\":\"Mainnet\",\"slug\":\"moonbeam\",\"chainId\":1284,\"gasToken\":\"GLMR\",\"blockExplorer\":\"https://moonscan.io/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"DebugApi\"],\"websiteUrl\":\"https://moonbeam.network\",\"githubUrl\":\"https://github.com/PureStake/moonbeam\",\"blockSpeed\":\"6s\",\"bridgeUrl\":\"https://moonbeam.network/network/bridges/\",\"name\":\"Moonbeam Mainnet\",\"about\":\"Moonbeam is Polkadot's first parachain, bringing EVM-compatibility and familiar tools for Ethereum devs, while offering native cross-chain messaging across other Polkadot ecosystems. With over 200 live apps across real world assets, gaming, DeFi, emerging markets, and more, Moonbeam merges Ethereum UX with Polkadot's interoperability.\",\"buildOnAlchemy\":\"Alchemy offers Moonbeam RPC endpoints, so you can access reliable and accurate onchain data for every kind of application.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.moonbeam.network/\",\"token\":\"GLMR\"},{\"id\":\"soneium-mainnet\",\"chainName\":\"Soneium\",\"networkName\":\"Mainnet\",\"slug\":\"soneium\",\"chainId\":1868,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://soneium.blockscout.com/\",\"isTestnet\":false,\"supportedProducts\":[\"BlockTimestampApi\",\"NodeApi\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Webhooks\",\"Subgraphs\",\"Websockets\",\"TokenApi\",\"TransfersApi\",\"NftApi\"],\"websiteUrl\":\"https://soneium.org/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/soneium-api-quickstart\",\"githubUrl\":\"https://github.com/Soneium\",\"blockSpeed\":\"2s\",\"bridgeUrl\":\"https://superbridge.app/soneium\",\"name\":\"Soneium Mainnet\",\"about\":\"Soneium is a next-gen, high-performance blockchain built to power DeFi and NFT platforms with low-latency and secure architecture. Designed for developers building cutting-edge blockchain applications, it supports scalable blockchain infrastructure for global apps.\",\"buildOnAlchemy\":\"Alchemy offers enterprise-ready Soneium RPC endpoints as well as enriched data APIs and a suite of developer tools for launching and scaling applications on Soneium.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.soneium.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/soneium-minato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/soneium\"},{\"id\":\"injective-testnet\",\"chainName\":\"Injective\",\"networkName\":\"Testnet\",\"slug\":\"injective-testnet\",\"chainId\":1439,\"gasToken\":\"INJ\",\"blockExplorer\":\"https://testnet.explorer.injective.network/\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\"],\"websiteUrl\":\"https://injective.com/\",\"name\":\"Injective Testnet\",\"about\":\"This is the primary testnet for Injective. Developers can test trading flows, financial applications, and cross-chain integrations in a safe environment before deploying to Injective mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Injective testnet RPC endpoints and websockets, so you can test your application with reliable data and prepare for production.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.injective.network/\",\"token\":\"INJ\"},{\"id\":\"frax-sepolia\",\"chainName\":\"Frax\",\"networkName\":\"Sepolia\",\"slug\":\"frax-sepolia\",\"chainId\":2523,\"gasToken\":\"frxETH\",\"blockExplorer\":\"https://explorer.testnet-sepolia.frax.com\",\"isTestnet\":true,\"websiteUrl\":\"https://frax.com/\",\"alchemyDocsUrl\":\"https://docs.alchemy.com/reference/frax-api-quickstart\",\"githubUrl\":\"https://github.com/FraxFinance/fraxtal\",\"blockSpeed\":\"1-2s\",\"bridgeUrl\":\"https://superbridge.app/\",\"name\":\"Frax Sepolia\",\"about\":\"Frax Sepolia is the primary testnet for Fraxtal, enabling developers to experiment with and test stablecoin integrations, lending protocols, and AMM infrastructure. It simulates the Frax ecosystem’s vertical DeFi stack, including Frax, Fraxlend, and Fraxswap, in a low-risk environment.\",\"buildOnAlchemy\":\"Alchemy can offer a range of tools to help you connect to the Frax Sepolia network. To request support for a particular tool, click \\\"request support\\\" for the corresponding tool on this page.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.frax.com/fraxtal\",\"token\":\"FRAX\"},{\"id\":\"dogecoin-mainnet\",\"chainName\":\"Dogecoin\",\"networkName\":\"Mainnet\",\"slug\":\"dogecoin\",\"chainId\":null,\"gasToken\":\"DOGE\",\"blockExplorer\":\"https://blockchair.com/dogecoin/transaction/\",\"isTestnet\":false,\"supportedProducts\":[\"NodeApi\",\"Blast\"],\"websiteUrl\":\"https://dogecoin.com/\",\"alchemyDocsUrl\":\"https://github.com/dogecoin/dogecoin/tree/master/doc\",\"githubUrl\":\"https://github.com/dogecoin/dogecoin\",\"name\":\"Dogecoin Mainnet\",\"about\":\"Dogecoin is a UTXO Layer-1 blockchain that launched in 2013 as a fork of Litecoin. Originally created as a meme cryptocurrency, Dogecoin has grown into one of the most widely-held tokens, using Scrypt proof-of-work and 1-minute block times to enable fast, low-fee transfers.\",\"buildOnAlchemy\":\"Alchemy provides reliable Dogecoin RPC endpoints, so you can access performant, real-time read and write data for the Dogecoin network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://dogecoin.com/dogepedia/\",\"token\":\"DOGE\"},{\"id\":\"boba-sepolia\",\"chainName\":\"Boba\",\"networkName\":\"Sepolia\",\"slug\":\"boba-sepolia\",\"chainId\":28882,\"gasToken\":\"ETH\",\"blockExplorer\":\"https://sepolia-blockscout.boba.network\",\"isTestnet\":true,\"supportedProducts\":[\"NodeApi\",\"Websockets\",\"BundlerApi\",\"EmbeddedAccounts\",\"GasManagerApi\",\"Subgraphs\",\"DebugApi\"],\"websiteUrl\":\"https://boba.network/\",\"name\":\"Boba Sepolia\",\"about\":\"This is the primary testnet for Boba.\",\"buildOnAlchemy\":\"Alchemy offers Boba Sepolia RPC endpoints, websockets, a Debug API, bundler infrastructure, gas sponsorship, and subgraphs so you can test and harden your app before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.boba.network/\",\"token\":\"BOBA\"}],\"daikonNetwork\":\"$6:3:props:networks:46\",\"title\":\"RPC \u0026 resources\",\"description\":\"Endpoints, websockets, and devtools\",\"allChainDetails\":[{\"name\":\"Cronos Mainnet\",\"slug\":\"cronos\",\"id\":\"cronos-mainnet\",\"about\":\"Cronos is an EVM-compatible Layer 1 built on the Cosmos SDK and supported by Crypto.com. It gives developers familiar Ethereum tooling plus connectivity to the broader Cosmos ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers Cronos mainnet RPC endpoints, websockets, a Debug API, bundler infrastructure, and gas sponsorship so you can build reliable production applications.\"},{\"name\":\"Cronos Testnet\",\"slug\":\"cronos-testnet\",\"id\":\"cronos-testnet\",\"about\":\"This is the primary testnet for Cronos.\",\"buildOnAlchemy\":\"Alchemy offers Cronos testnet RPC endpoints, websockets, a Debug API, bundler infrastructure, and gas sponsorship so you can test and harden your app before shipping to mainnet.\"},{\"name\":\"CITREA Testnet\",\"slug\":\"citrea-testnet\",\"id\":\"citrea-testnet\",\"about\":\"This is the primary testnet for Citrea.\",\"buildOnAlchemy\":\"Alchemy offers Citrea testnet RPC endpoints and websockets, so you can access reliable and accurate onchain data. In addition, we support Citrea with our Debug API, so you can more easily inspect and debug onchain transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.citrea.xyz/\",\"token\":\"cBTC\"},{\"name\":\"Citrea Mainnet\",\"slug\":\"citrea\",\"id\":\"citrea-mainnet\",\"about\":\"Citrea hopes to be Bitcoin's first zero-knowledge rollup. Currently in testnet, this network uses Bitcoin for both settlement and data availability, and its smart contracts help turn Bitcoin into a programmable asset, all without making any changes to the Bitcoin core protocol itself.\",\"buildOnAlchemy\":\"Alchemy offers Citrea mainnet RPC endpoints and websockets, so you can access reliable and accurate onchain data. In addition, we support Citrea with our Debug API, so you can more easily inspect and debug onchain transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.citrea.xyz/\",\"token\":\"cBTC\"},{\"name\":\"Alpen Testnet\",\"slug\":\"alpen-testnet\",\"id\":\"alpen-testnet\",\"about\":\"Alpen is a Bitcoin rollup built by Alpen Labs that brings an EVM-compatible execution layer to Bitcoin. Secured by zero-knowledge proofs and using BTC as its gas token, Alpen lets developers build expressive smart contract applications on top of Bitcoin.\",\"buildOnAlchemy\":\"Alchemy offers Alpen testnet RPC endpoints and websockets, so you can access reliable and accurate onchain data. In addition, we support Alpen with our Debug and Trace APIs, so you can more easily inspect and debug onchain transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.alpen.org/\",\"token\":\"BTC\"},{\"name\":\"Tempo Mainnet\",\"slug\":\"tempo\",\"id\":\"tempo-mainnet\",\"about\":\"Tempo is a Layer-1 blockchain backed by Stripe and Paradigm that’s purpose-built for payments at internet scale. Unlike general-purpose chains, Tempo is architected around the demands of production payment systems: predictable fees, sub-second finality, over 100K TPS, and dedicated payment lanes that guarantee blockspace for transfers even during congestion. Tempo also introduces the Machine Payments Protocol (MPP), an open standard for how AI agents pay for services, along with native account abstraction, a compliance-ready token standard (TIP-20), and the ability to pay gas in stablecoins.\",\"buildOnAlchemy\":\"Alchemy provides Day 1 mainnet infrastructure for Tempo, including enterprise-grade RPC endpoints, block event streaming via websockets, a Debug API for inspecting transactions, and full support for Tempo’s unique primitives including TIP-20 tokens and payment lane features.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.tempo.xyz/\"},{\"name\":\"Tempo Moderato\",\"slug\":\"tempo-moderato\",\"id\":\"tempo-moderato\",\"about\":\"This is the primary testnet for Tempo.\",\"buildOnAlchemy\":\"Alchemy offers Tempo Moderato RPC endpoints, websockets, and a Debug API, so you can test your application with reliable data before deploying to Tempo mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.tempo.xyz/\"},{\"name\":\"MegaETH Mainnet\",\"slug\":\"megaeth\",\"id\":\"megaeth-mainnet\",\"about\":\"MegaETH is an Ethereum L2 described as a “real-time blockchain,” with sub-10 ms block times and 100,000+ transactions per second. By pushing execution to web2-style latency and using Ethereum for settlement and EigenDA-style data availability, it makes on-chain trading, gaming, and social feel instant onchain.\",\"buildOnAlchemy\":\"Alchemy offers reliable and performant data via enterprise-grade MegaETH RPC endpoints and websockets. In addition, we offer a Debug API for MegaETH mainnet, so you can better understand transaction statuses onchain.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.megaeth.com/\"},{\"name\":\"Mythos Mainnet\",\"slug\":\"mythos\",\"id\":\"mythos-mainnet\",\"about\":\"Mythos is a gaming-focused blockchain designed to make Web3 game development and distribution feel seamless. It provides a shared infrastructure for onchain assets, marketplaces, and gameplay economies, allowing developers to ship scalable games while giving players true ownership and interoperability across the Mythos ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers a suite of infrastructure and devtools to streamline building on Mythos, including enterprise-grade RPC endpoints, block event streams via websockets, bundler infrastructure, gas sponsorship, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.mythos.com/\",\"token\":\"MYTH\"},{\"name\":\"MegaETH Testnet\",\"slug\":\"megaeth-testnet\",\"id\":\"megaeth-testnet\",\"about\":\"This is the primary test network for MegaETH\",\"buildOnAlchemy\":\"Alchemy offers a suite of products for developers on MegaETH testnet, including reliable RPC endpoints for onchain data, a debugging API to understand transactions, and websockets for block streaming.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.megaeth.com/\"},{\"name\":\"ADI Mainnet\",\"slug\":\"adi\",\"id\":\"adi-mainnet\",\"about\":\"ADI is a new EVM L2 blockchain backed by UAE institutions that will power the United Arab Emirates' upcoming stablecoin as well as apps across emerging markets.\",\"buildOnAlchemy\":\"Alchemy offers a suite of devtools to simplify development on ADI, including enterprise-grade RPC endpoints, event streaming via websockets, and a debugging API\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.adi.foundation/\"},{\"name\":\"ADI Testnet\",\"slug\":\"adi-testnet\",\"id\":\"adi-testnet\",\"about\":\"This is the primary testnet for the ADI network.\",\"buildOnAlchemy\":\"Access a range of Alchemy devtools to build on ADI testnet, including our RPC API, Debug API, and websockets. Partner with the leading onchain infra provider, so you can focus on building your application.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.adi.foundation/\"},{\"name\":\"Stable Mainnet\",\"slug\":\"stable\",\"id\":\"stable-mainnet\",\"about\":\"Stable is a L1 \\\"stablechain\\\" designed for USDT payments that uses USDT for gas and is optimized for high volume payment transactions.\",\"buildOnAlchemy\":\"Alchemy offers performant RPC endpoints and a suite of other devtools, including event streaming, transaction bundling, gasless transactions, debugging tools, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.stable.xyz/\",\"token\":\"STABLE\",\"faucetUrl\":\"https://www.alchemy.com/faucets/stable-testnet\"},{\"name\":\"Stable Testnet\",\"slug\":\"stable-testnet\",\"id\":\"stable-testnet\",\"about\":\"This is the primary testnet for Stable.\",\"buildOnAlchemy\":\"Alchemy offers performant Stable testnet infrastructure, including block-perfect data via familiar API endpoints, block streams via websockets, bundler infrastructure, gas sponsorship, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.stable.xyz/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/stable-testnet\"},{\"name\":\"CelestiaBridge Mainnet\",\"slug\":\"celestiabridge\",\"id\":\"celestiabridge-mainnet\",\"about\":\"CelestiaBridge refers to the bridge-node layer that connects Celestia’s consensus network with its data-availability network. These nodes relay block data, verify that it’s available, and expose it to rollups that use Celestia as their DA layer. In practice, this is the infrastructure that lets modular L2s post data to Celestia and still be verifiable by light clients, the plumbing that makes “modular blockchains” actually work.\",\"buildOnAlchemy\":\"Alchemy offers CelestiaBridge RPC endpoints, so your app can easily connect to the network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celestia.org/\",\"token\":\"TIA\"},{\"name\":\"Monad Mainnet\",\"slug\":\"monad\",\"id\":\"monad-mainnet\",\"about\":\"Monad is a next generation L1 blockchain that is fully compatible with Ethereum while offering 10K+ transactions per second and low gas fees.\",\"buildOnAlchemy\":\"Alchemy offers a number of tools to help you build on Monad, including real-time data from reliable RPC endpoints, block event streams via websockets, gasless transactions, bundler infrastructure, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.monad.xyz/\",\"token\":\"MONAD\",\"faucetUrl\":\"https://www.alchemy.com/faucets/monad-testnet\"},{\"name\":\"Aptos Testnet\",\"slug\":\"aptos-testnet\",\"id\":\"aptos-testnet\",\"about\":\"This is the primary testnet network for Aptos.\",\"buildOnAlchemy\":\"Alchemy offers Aptos testnet RPC endpoints, so you can easily and reliably connect to the network and ready your app for mainnet deployment.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://aptos.dev/\",\"token\":\"APT\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/aptos-testnet\"},{\"name\":\"Aptos Mainnet\",\"slug\":\"aptos\",\"id\":\"aptos-mainnet\",\"about\":\"Aptos is a high-performance L1 from former Diem engineers that uses the Move language and Block-STM parallel execution to confirm transactions in sub-seconds at high throughput. Its developer-centric tooling, resource accounts, and safety-first design make it a strong fit for consumer apps, games, and DeFi at scale.\",\"buildOnAlchemy\":\"Alchemy offers reliable Aptos mainnet RPC endpoints, so you can easily connect to the Aptos network and build apps at scale.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://aptos.dev/\",\"token\":\"APT\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/aptos\"},{\"name\":\"Arc Mainnet\",\"slug\":\"arc\",\"id\":\"arc-mainnet\",\"about\":\"Arc is an open, EVM-compatible Layer-1 built for real-time money movement and agentic economic activity. It uses stablecoins as gas, starting with USDC, and targets deterministic sub-second finality with predictable, dollar-based fees.\",\"buildOnAlchemy\":\"Alchemy offers Arc mainnet RPC endpoints, websockets, a Debug API, and more. With Alchemy's suite of devtools, developers have everything they need to run apps at scale on Arc.\",\"category\":\"L1\",\"websiteUrl\":\"https://arc.io/\",\"officialDocsUrl\":\"https://docs.arc.io/\"},{\"name\":\"Arc Testnet\",\"slug\":\"arc-testnet\",\"id\":\"arc-testnet\",\"about\":\"Arc Testnet is Arc’s network for building and testing applications before mainnet deployment.\",\"buildOnAlchemy\":\"Alchemy offers Arc testnet RPC endpoints, websockets, and a Debug API. Developers can also use the Bundler API and gas sponsorship before deploying to mainnet.\",\"category\":\"L1\",\"websiteUrl\":\"https://arc.io/\",\"officialDocsUrl\":\"https://docs.arc.io/\"},{\"name\":\"CelestiaBridge Mocha\",\"slug\":\"celestiabridge-mocha\",\"id\":\"celestiabridge-mocha\",\"about\":\"This is the primary testnet for CelestiaBridge.\",\"buildOnAlchemy\":\"Alchemy offers reliable RPC endpoints for the CelestiaBridge Mocha network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celestia.org/\",\"token\":\"TIA\"},{\"name\":\"Tron Testnet\",\"slug\":\"tron-testnet\",\"id\":\"tron-testnet\",\"about\":\"This is the primary testnet for the Tron network.\",\"buildOnAlchemy\":\"Tron offers reliable Tron testnet RPC endpoints. Focus less on your infrastructure and more on your customers with Alchemy.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.tron.network/\",\"token\":\"TRX\"},{\"name\":\"Tron Mainnet\",\"slug\":\"tron\",\"id\":\"tron-mainnet\",\"about\":\"Tron is a high-throughput L1 that has become one of the largest rails for stablecoin transfers, especially in emerging markets. With consistently low fees and EVM-compatability, Tron has become a popular chain for builders worldwide.\",\"buildOnAlchemy\":\"Alchemy offers performant Tron RPC endpoints, so you can reliably build onchain.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.tron.network/\",\"token\":\"TRX\"},{\"name\":\"SUI Mainnet\",\"slug\":\"sui\",\"id\":\"sui-mainnet\",\"about\":\"Sui is a high-performance L1 from Mysten Labs that leverages an object-centric data model and the Move programming language to parallelize transactions. Native chain features like zkLogin and sponsored transactions create a familiar Web2 experience, great for consumer apps, gaming, and more.\",\"buildOnAlchemy\":\"Alchemy offers reliable Sui RPC endpoints that serve real-time and block-perfect data. Your reliable connection to the Sui network is never more than one API call away.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sui.io/\",\"token\":\"SUI\"},{\"name\":\"SUI Testnet\",\"slug\":\"sui-testnet\",\"id\":\"sui-testnet\",\"about\":\"This is the primary testnet for Sui.\",\"buildOnAlchemy\":\"Alchemy offers block-perfect data via reliable and familiar API endpoints. Test your app with data you can trust.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sui.io/\",\"token\":\"SUI\"},{\"name\":\"HyperEVM Mainnet\",\"slug\":\"hyperliquid\",\"id\":\"hyperliquid-mainnet\",\"about\":\"HyperEVM is an EVM execution layer embedded in Hyperliquid’s L1 and secured by the same HyperBFT consensus as HyperCore. HyperEVM lets you build apps that can directly integrate with Hyperliquid’s on‑chain spot and perp order books, bringing programmability to one of the most exciting spaces onchain today.\",\"buildOnAlchemy\":\"Alchemy provides HyperEVM RPC endpoints with industry-leading reliability and performance. Scale your app onchain with a suite of different devtools, including reliable onchain data, block data streams via websockets, debugging capabilities with Alchemy's Debug API, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://hyperliquid.gitbook.io/hyperliquid-docs\",\"token\":\"HYPE\"},{\"name\":\"HyperEVM Testnet\",\"slug\":\"hyperliquid-testnet\",\"id\":\"hyperliquid-testnet\",\"about\":\"This is the primary test environment for HyperEVM.\",\"buildOnAlchemy\":\"Alchemy offers builders real-time data from enterprise-grade RPC endpoints, block data streams via websockets, gas sponsorship, bundler infrastructure, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://hyperliquid.gitbook.io/hyperliquid-docs\",\"token\":\"HYPE\"},{\"name\":\"Metis Mainnet\",\"slug\":\"metis\",\"id\":\"metis-mainnet\",\"about\":\"Metis is an optimistic rollup built on Ethereum that introduces native support for DACs—Decentralized Autonomous Companies. The network blends scalability with tools for onchain governance, reputation, and operational coordination.\",\"buildOnAlchemy\":\"Alchemy provides reliable Metis RPC endpoints as well as real time push notifications, block data streams, and more, in order to enable you to rapidly build on Metis.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.metis.io/dev\",\"token\":\"METIS\"},{\"name\":\"Base Mainnet\",\"slug\":\"base\",\"id\":\"base-mainnet\",\"about\":\"Base is an OP Stack L2 developed by Coinbase to bring the next billion users onchain. It offers low fees, high throughput, and deep integration with Coinbase’s exchange and fiat rails. With strong developer tools and ecosystem incentives, it’s a gateway for mainstream Web3 apps.\",\"buildOnAlchemy\":\"Alchemy offers reliable and performant Base RPC endpoints that connect your app to the Base network. Alongside real-time read and write data, Alchemy provides a suite of devtools for Base, including push notifications, data streams, enriched APIs, and a full development platform trusted by teams building at scale.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.base.org/\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/base-sepolia\",\"publicRpcUrl\":\"https://base-mainnet.g.alchemy.com/public\"},{\"name\":\"Superseed Mainnet\",\"slug\":\"superseed\",\"id\":\"superseed-mainnet\",\"about\":\"Superseed is a chain designed around self-repaying loans. Built on the Optimism stack, this L2 uses a new financial primitive of \\\"supercollateral\\\" to supercharge DeFi protocols in its ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers Superseed RPC endpoints, debugging tools, and block data streaming. Launch your app faster with industry-leading reliability.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.superseed.xyz/\",\"token\":\"SUPR\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"name\":\"Ethereum Mainnet\",\"slug\":\"ethereum\",\"id\":\"eth-mainnet\",\"about\":\"Ethereum is the leading smart contract platform powering decentralized applications across DeFi, NFTs, gaming, and more. As the most widely adopted blockchain with the largest developer community, Ethereum is the foundation of Web3.\",\"buildOnAlchemy\":\"Alchemy provides highly reliable Ethereum RPC endpoints that connect your app to the Ethereum network. Along with real-time read and write data, Alchemy offers a suite of tools to build on Ethereum, including enriched data services, deployment tools, and infrastructure trusted by the largest builders onchain.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\",\"publicRpcUrl\":\"https://eth-mainnet.g.alchemy.com/public\"},{\"name\":\"Ethereum Sepolia\",\"slug\":\"ethereum-sepolia\",\"id\":\"eth-sepolia\",\"about\":\"Sepolia is Ethereum’s main public testnet for smart contract development and infrastructure testing. Sepolia replicates mainnet behavior with low-stakes test ETH and consistent uptime for code iteration and production-hardening.\",\"buildOnAlchemy\":\"Alchemy offers performant Sepolia RPC endpoints that simplify your testing on Ethereum. With a suite of data APIs and devtools and data APIs, you can make sure your code is production-ready before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"name\":\"Ethereum Hoodi\",\"slug\":\"ethereum-hoodi\",\"id\":\"eth-hoodi\",\"about\":\"Hoodi is a new Ethereum testnet that replaces the Holesky network. Hoodi is used to simulate Ethereum's validator network, and is used primarily to test validator and staking functionality.\",\"buildOnAlchemy\":\"Alchemy’s offers Hoodi RPC endpoints that simplify testing validator and staking functionality on Ethereum. With a suite of devtools and data APIs, you can make sure your code is production-ready before shipping to Ethereum mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"name\":\"Polygon PoS Mainnet\",\"slug\":\"matic\",\"id\":\"polygon-mainnet\",\"about\":\"Polygon PoS is Ethereum’s flagship side-chain offering ultra-low fees and full EVM compatibility, letting mainstream brands like Reddit and Nike reach millions of users. Its broad validator set and deep liquidity make it the default on-ramp to the Polygon ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers reliable Polygon RPC endpoints designed for scalable access to the network. In addition to performant read and write data, Alchemy provides devtools including enriched data apis, push notifications, and seamless WebSocket support to help you build and scale effortlessly.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.polygon.technology/\",\"token\":\"MATIC\",\"faucetUrl\":\"https://www.alchemy.com/faucets/polygon-amoy\"},{\"name\":\"Polygon PoS Amoy\",\"slug\":\"matic-amoy\",\"id\":\"polygon-amoy\",\"about\":\"Amoy is Polygon PoS’s main testnet, designed for developers to test contracts, tools, and apps in a low-cost and safe environment that mirrors Polygon PoS mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Polygon Amoy RPC endpoints to streamline your testing on Polygon. With an array of devtools and data APIs, you have everything you need to harden your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.polygon.technology/\",\"token\":\"MATIC\",\"faucetUrl\":\"https://www.alchemy.com/faucets/polygon-amoy\"},{\"name\":\"Arbitrum Mainnet\",\"slug\":\"arbitrum\",\"id\":\"arb-mainnet\",\"about\":\"Arbitrum is an optimistic rollup that inherits Ethereum security while delivering sub-cent gas fees and high throughput. Arbitrum's Orbit and Stylus tooling attract builders deploying complex, low-latency apps without leaving the Ethereum ecosystem.\",\"buildOnAlchemy\":\"Alchemy provides enterprise-grade Arbitrum RPC endpoints with low-latency and industry-leading throughput. You can also access tools like transaction tracing, real-time alerts, debugging APIs, and a full-featured dashboard to support your Arbitrum app.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.arbitrum.io/welcome/get-started\",\"token\":\"ARB\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/arbitrum-sepolia\",\"publicRpcUrl\":\"https://arb-mainnet.g.alchemy.com/public\"},{\"name\":\"Arbitrum Sepolia\",\"slug\":\"arbitrum-sepolia\",\"id\":\"arb-sepolia\",\"about\":\"Arbitrum Sepolia is the official testnet for Arbitrum One, providing developers with a safe rollup environment to test apps and cross-chain interactions.\",\"buildOnAlchemy\":\"Alchemy provides Arbitrum Sepolia RPC endpoints, so you can reliably test your code before shipping to mainnet. With a suite of devtools and data APIs, you have everything you need to confidently debug and harden your code.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.arbitrum.io/welcome/get-started\",\"token\":\"ARB\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/arbitrum-sepolia\"},{\"name\":\"OP Mainnet\",\"slug\":\"optimism\",\"id\":\"opt-mainnet\",\"about\":\"OP Mainnet (Optimism) is an optimistic rollup built on the OP Stack, pairing low fees with a governance model that funnels sequencer revenue into public-goods funding. It anchors a fast-growing ecosystem of L2-native apps and is the backbone of the Superchain, a collective of L2 blockchains all built using the OP Stack.\",\"buildOnAlchemy\":\"Alchemy offers high-performance Optimism RPC endpoints that ensure consistent uptime for production-grade rollup applications. Along with reliable data, Alchemy makes it easy to build, monitor, and scale apps on Optimism with a range of devtools, including analytics dashboards, smart notification tools, and gas sponsorship.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.optimism.io/\",\"token\":\"OP\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/optimism-sepolia\"},{\"name\":\"OP Mainnet Sepolia\",\"slug\":\"optimism-sepolia\",\"id\":\"opt-sepolia\",\"about\":\"OP Sepolia is the OP Stack’s Ethereum-aligned testnet supporting OP mainnet and other Superchain deployments that use Optimism's OP Stack.\",\"buildOnAlchemy\":\"Alchemy provides OP Sepolia RPC endpoints and a variety of devtools to help you test your code, including data APIs and debugging tools. Test exhaustively and ship confidently with Alchemy.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.optimism.io/\",\"token\":\"OP\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/optimism-sepolia\"},{\"name\":\"Starknet Mainnet\",\"slug\":\"starknet\",\"id\":\"starknet-mainnet\",\"about\":\"Starknet is a zk-rollup powered by the Cairo programming language, bringing STARK validity proofs to Ethereum for provably scalable computation. Starknet's native account abstraction and recursive proofs open the door to on-chain games and complex DeFi logic.\",\"buildOnAlchemy\":\"Alchemy offers reliable Starknet RPC endpoints optimized for low latency and high throughput. Alongside performant data, you can access real-time push notifications via webhooks, block data streaming with websockets, and zero-config analytics to simplify building on Starknet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.starknet.io/\",\"token\":\"STRK\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/starknet-sepolia\"},{\"name\":\"Starknet Sepolia\",\"slug\":\"starknet-sepolia\",\"id\":\"starknet-sepolia\",\"about\":\"Starknet Sepolia enables developers to test Cairo-based smart contracts on Starknet’s zk-rollup architecture. It simulates the network’s high-performance, zk-native environment for contract deployment and tooling integration.\",\"buildOnAlchemy\":\"Alchemy offers Starknet Sepolia RPC endpoints and a range of devtools to help you test and debug your code before shipping to Starknet mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.starknet.io/\",\"token\":\"STRK\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/starknet-sepolia\"},{\"name\":\"Solana Mainnet\",\"slug\":\"solana\",\"id\":\"solana-mainnet\",\"about\":\"Solana is a high-speed blockchain known for its fast transaction processing and low fees, making it a preferred choice for high-volume apps that demand performance. With the second largest developer community, Solana pushes the boundaries of what's possible onchain today.\",\"buildOnAlchemy\":\"Alchemy provides highly reliable and performant Solana RPC endpoints that connect your app to the Solana network. Along with real-time read and write data, Alchemy offers enriched data services, push notifications, and more, making building on Solana easy for solo devs and enterprise alike.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://solana.com/docs\",\"token\":\"SOL\"},{\"name\":\"Solana Devnet\",\"slug\":\"solana-devnet\",\"id\":\"solana-devnet\",\"about\":\"Solana Devnet is the primary testing environment for Solana. It supports full validator simulation, program deployment, and app integration with Solana’s parallel runtime.\",\"buildOnAlchemy\":\"Alchemy provides Solana Devnet RPC endpoints, transaction logs, dashboard analytics, and more, so you can confidently test and harden your code before shipping to Solana mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://solana.com/docs\",\"token\":\"SOL\"},{\"name\":\"Astar Mainnet\",\"slug\":\"astar\",\"id\":\"astar-mainnet\",\"about\":\"Astar is a Polkadot parachain that supports both EVM and WASM contracts, and is designed for multichain interoperability. Its app-staking model rewards builders and token-holders, bootstrapping a vibrant cross-chain ecosystem. Astar is popular in Japan and APAC with strong enterprise support.\",\"buildOnAlchemy\":\"Alchemy provides performant Astar RPC endpoints that connect you to a multichain smart contract platform. With real-time analytics and production-ready tools, Alchemy helps developers build efficiently on Astar.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.astar.network/\",\"token\":\"ASTR\"},{\"name\":\"Base Sepolia\",\"slug\":\"base-sepolia\",\"id\":\"base-sepolia\",\"about\":\"This network is the primary testing environment for Base.\",\"buildOnAlchemy\":\"Alchemy offers Base Sepolia RPC endpoints and a range of debugging tools including debuggers, transaction simulation, tracing, and more, so you can confidently test and harden your code in Base's testing environment.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.base.org/\",\"settlement\":\"Ethereum Sepolia\",\"faucetUrl\":\"https://www.alchemy.com/faucets/base-sepolia\"},{\"name\":\"Frax Mainnet\",\"slug\":\"frax\",\"id\":\"frax-mainnet\",\"about\":\"Fraxtal is an OP-Stack L2 built by the Frax team to power its stablecoin ecosystem, lending markets, and AMMs. A tight integration with Frax's DeFi primitives lets DeFi builders compose new protocols and apps quickly, and the chain features protocol-level MEV capture and native yield distribution to optimize economic sustainability.\",\"buildOnAlchemy\":\"Alchemy supports the Frax chain with enterprise-grade RPC endpoints, enriched data APIs, gas sponsorship, and more, making it easy to build and scale on Frax.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.frax.com/fraxtal\",\"token\":\"FRAX\"},{\"name\":\"Frax Sepolia\",\"slug\":\"frax-sepolia\",\"id\":\"frax-sepolia\",\"about\":\"Frax Sepolia is the primary testnet for Fraxtal, enabling developers to experiment with and test stablecoin integrations, lending protocols, and AMM infrastructure. It simulates the Frax ecosystem’s vertical DeFi stack, including Frax, Fraxlend, and Fraxswap, in a low-risk environment.\",\"buildOnAlchemy\":\"Alchemy can offer a range of tools to help you connect to the Frax Sepolia network. To request support for a particular tool, click \\\"request support\\\" for the corresponding tool on this page.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.frax.com/fraxtal\",\"token\":\"FRAX\"},{\"name\":\"ZKsync Mainnet\",\"slug\":\"zksync\",\"id\":\"zksync-mainnet\",\"about\":\"zkSync Era is an Ethereum zkEVM rollup that emphasizes account abstraction and L2 composability. It offers fast finality, low fees, and secure execution with a developer-friendly UX. zkSync aims to unlock new app design patterns while preserving Ethereum tooling.\",\"buildOnAlchemy\":\"Alchemy provides performant ZKsync RPC endpoints designed for fast, secure dapp development. Paired with real-time notification support and enriched data APIs, Alchemy gives developers the resources they need to build scalable apps on ZKsync.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.zksync.io/\",\"token\":\"ZK\",\"faucetUrl\":\"https://www.alchemy.com/faucets/zksync-sepolia\"},{\"name\":\"ZKsync Sepolia\",\"slug\":\"zksync-sepolia\",\"id\":\"zksync-sepolia\",\"about\":\"This network is the primary testing environment for ZKsync.\",\"buildOnAlchemy\":\"Alchemy provides ZKsync Sepolia RPC endpoints and a range of data APIs, so you can confidently debug and test your code before shipping to ZKsync mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.zksync.io/\",\"token\":\"ZK\",\"faucetUrl\":\"https://www.alchemy.com/faucets/zksync-sepolia\"},{\"name\":\"BNB Smart Chain Mainnet\",\"slug\":\"bnb\",\"id\":\"bnb-mainnet\",\"about\":\"BNB Smart Chain is a fast, low-fee EVM-compatible blockchain backed by Binance. With strong activity across DeFi, gaming, and NFTs, BSC supports high-volume apps in emerging markets and offers a tight integration with Binance’s user base, liquidity, ecosystem bridges, and tooling.\",\"buildOnAlchemy\":\"Alchemy offers BNB Smart Chain RPC endpoints with high availability and consistent uptime. With a suite of tools including rich data APIs, block data streaming, and gas sponsorship, Alchemy equips builders with tools and data for building on BNB.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bnbchain.org/bnb-smart-chain/\",\"token\":\"BNB\",\"publicRpcUrl\":\"https://bnb-mainnet.g.alchemy.com/public\"},{\"name\":\"BNB Smart Chain Testnet\",\"slug\":\"bnb-testnet\",\"id\":\"bnb-testnet\",\"about\":\"The BNB Smart Chain testnet offers a low-cost environment for deploying and testing EVM-compatible smart contracts. It mirrors BSC mainnet and supports full Binance ecosystem tooling.\",\"buildOnAlchemy\":\"Alchemy provides BNB Smart Chain testnet RPC endpoints and a suite of data APIs, so you can seamlessly connect with BNB Smart Chain's test environment, thoroughly test your code, and then confidently ship to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bnbchain.org/bnb-smart-chain/\",\"token\":\"BNB\"},{\"name\":\"Blast Mainnet\",\"slug\":\"blast\",\"id\":\"blast-mainnet\",\"about\":\"Blast is an EVM-compatible L2 offering native yield on ETH and stablecoin balances by default. The chain combines rollup scalability with built-in DeFi incentives, enabling users and apps alike to earn without staking or wrapping assets. Backed by the Blur team, Blast merges passive yield mechanics with a growth-focused ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers enterprise-ready Blast RPC endpoints. Along with performant and reliable data, you have access to a range of devtools to build on Blast, including enriched data APIs, push notifications, and data streaming.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.blast.io/about-blast\",\"token\":\"BLAST\"},{\"name\":\"Blast Sepolia\",\"slug\":\"blast-sepolia\",\"id\":\"blast-sepolia\",\"about\":\"Blast Sepolia is the primary testnet for the Blast L2, allowing you to test your application against Blast's native yield.\",\"buildOnAlchemy\":\"Alchemy provides Blast Sepolia RPC endpoints and a suite of data APIs so you can seamlessly connect to Blast's test environment. With Alchemy's reliable data, you can harden your code and confidently ship to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.blast.io/about-blast\",\"token\":\"BLAST\"},{\"name\":\"ZetaChain Mainnet\",\"slug\":\"zetachain\",\"id\":\"zetachain-mainnet\",\"about\":\"ZetaChain is a Cosmos-SDK omnichain L1 with built-in cross-chain message passing, letting developers call contracts across Bitcoin, Ethereum and Cosmos zones from a single hub. This focus on multichain interoperability easily enables apps to build across multiple ecosystems without relying on bridges and wrapped tokens.\",\"buildOnAlchemy\":\"Alchemy provides reliable ZetaChain RPC endpoints that enable you to build onchain. You can also access app analytics from the Alchemy dashboard as well as a range of devtools that can help you build in production, including push notifications, block streaming, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://www.zetachain.com/docs/\",\"token\":\"ZETA\"},{\"name\":\"ZetaChain Testnet\",\"slug\":\"zetachain-testnet\",\"id\":\"zetachain-testnet\",\"about\":\"ZetaChain testnet is the primary test environment for Zetachain, enabling you to build and test cross-chain apps with unified contract logic.\",\"buildOnAlchemy\":\"Alchemy supports ZetaChain testnet with reliable RPC endpoints, so you can easily connect to ZetaChain's test environment and harden your code.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://www.zetachain.com/docs/\",\"token\":\"ZETA\"},{\"name\":\"Avalanche Mainnet\",\"slug\":\"avalanche\",\"id\":\"avax-mainnet\",\"about\":\"Avalanche C-Chain is an EVM-compatible smart contract chain within the Avalanche network, offering sub-second finality and low fees. It serves as the main entry point for Ethereum apps into Avalanche’s ecosystem. Custom subnets let projects launch dedicated, customizable blockchains while tapping into Avalanche liquidity.\",\"buildOnAlchemy\":\"Alchemy offers performant Avalanche RPC endpoints that give you reliable read and write data in real time. With enriched data APIs, push notifications, block streaming, and more, Alchemy tools help you build faster on Avalanche.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.avax.network/\",\"token\":\"AVAX\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/avalanche\"},{\"name\":\"Avalanche Fuji\",\"slug\":\"avalanche-fuji\",\"id\":\"avax-fuji\",\"about\":\"Fuji is Avalanche’s primary testnet supporting smart contract testing, subnets, and validator configuration.\",\"buildOnAlchemy\":\"Alchemy provides Avalanche Fuji RPC endpoints and a suite of Data APIs, so you can easily connect to the Fuji network, debug and harden your code, and confidently ship to Avalanche mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.avax.network/\",\"token\":\"AVAX\"},{\"name\":\"Linea Mainnet\",\"slug\":\"linea\",\"id\":\"linea-mainnet\",\"about\":\"Linea is a zkEVM rollup developed by Consensys, offering byte-code equivalence to Ethereum. The chain also has tight integrations with other Consensys projects, including MetaMask and Infura. With Linea, you can access sub-second confirmations and native account abstraction while staying inside a familiar Ethereum tooling stack.\",\"buildOnAlchemy\":\"Alchemy offers reliable Linea RPC endpoints for onchain development. In addition to real-time data, Alchemy enriched data APIs, push notifications, and event streaming to help you build on Linea.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.linea.build/\"},{\"name\":\"Linea Sepolia\",\"slug\":\"linea-sepolia\",\"id\":\"linea-sepolia\",\"about\":\"This is the primary test environment for the Linea chain.\",\"buildOnAlchemy\":\"Alchemy provides Linea Sepolia RPC endpoints and a set of data APIs, so you can access reliable and real-time read/write data. With Alchemy, you can test thoroughly and ship to mainnet confidently.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.linea.build/\"},{\"name\":\"Mantle Mainnet\",\"slug\":\"mantle\",\"id\":\"mantle-mainnet\",\"about\":\"Mantle is a modular optimistic rollup on Ethereum that integrates EigenDA for low-cost, high-performance data availability, driving down fees without sacrificing security. Backed by the BitDAO ecosystem, Mantle provides a large treasury-supported platform to align liquidity, builders, and governance.\",\"buildOnAlchemy\":\"Alchemy offers Mantle RPC endpoints that bring you reliable, scalable, and performant data. In addition, Alchemy also offers push notifications and data streaming, so you can more easily build on Mantle.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs-v2.mantle.xyz/\",\"token\":\"MNT\"},{\"name\":\"Mantle Sepolia\",\"slug\":\"mantle-sepolia\",\"id\":\"mantle-sepolia\",\"about\":\"Mantle Sepolia is the primary testnet for the Mantle chain.\",\"buildOnAlchemy\":\"Alchemy offers Mantle Sepolia RPC endpoints, so you can access reliable read and write data fo Mantle's primary testing environment.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs-v2.mantle.xyz/\",\"token\":\"MNT\"},{\"name\":\"opBNB Mainnet\",\"slug\":\"opbnb\",\"id\":\"opbnb-mainnet\",\"about\":\"opBNB is Binance's OP-Stack L2, marrying Ethereum's security with BNB chain's large user funnel and deep liqudity. With a deep integration to Binance's infrastructure, opBNB is a fast onramp for consumer apps looking to reach a massive user base.\",\"buildOnAlchemy\":\"Alchemy provides reliable opBNB RPC endpoints optimized for enterprise-grade availability and scalability. In addition to industry-leading data availability, Alchemy offers a suite of tools for building on opBNB, including data streaming, enriched data APIs, and more.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.bnbchain.org/bnb-opbnb/overview/\"},{\"name\":\"opBNB Testnet\",\"slug\":\"opbnb-testnet\",\"id\":\"opbnb-testnet\",\"about\":\"This network is the primary test environment for opBNB.\",\"buildOnAlchemy\":\"Alchemy offers reliable opBNB testnet RPC endpoints, enriched data APIs, and a suite of devtools so you can confidently test your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.bnbchain.org/bnb-opbnb/overview/\"},{\"name\":\"Gnosis Mainnet\",\"slug\":\"gnosis\",\"id\":\"gnosis-mainnet\",\"about\":\"Gnosis (formerly xDai) is an EVM-compatible L1 that pairs a stable gas token (xDAI) with security generated by a network of 350K+ validators. Built-in Safe multisig support and bridge SDKs streamline governance, treasury, and cross-chain UX.\",\"buildOnAlchemy\":\"Alchemy offers Gnosis RPC endpoints designed for reliability and operating at scale. In addition, Alchemy provides you with enriched data APIs, push notifications, and data streaming, so you can build better applications.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gnosischain.com/\",\"token\":\"GNO\"},{\"name\":\"Gnosis Chiado\",\"slug\":\"gnosis-chiado\",\"id\":\"gnosis-chiado\",\"about\":\"Chiado is the primary testnet for the Gnosis Chain.\",\"buildOnAlchemy\":\"Alchemy provides Gnosis Chiado RPC endpoints and data APIs, so you can reliably connect to Gnosis test environment with performant and highly available data.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gnosischain.com/\",\"token\":\"GNO\"},{\"name\":\"Flow EVM Mainnet\",\"slug\":\"flow\",\"id\":\"flow-mainnet\",\"about\":\"Flow is a high-throughput PoS L1 designed by Dappy Labs for consumer experiences like NBA Top Shot and Mattel Creations. Its multi-node architecture parallelizes workloads, keeping fees low even during viral onchain activity.\",\"buildOnAlchemy\":\"Alchemy provides Flow RPC endpoints that give you reliable, real-time data. In addition to RPC endpoints, Alchemy also offers websocket support, so you can stream block data directly to your app.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://developers.flow.com/\",\"token\":\"FLOW\"},{\"name\":\"Flow EVM Testnet\",\"slug\":\"flow-testnet\",\"id\":\"flow-testnet\",\"about\":\"This network is the primary test environment for the Flow ecosystem.\",\"buildOnAlchemy\":\"Alchemy offers Flow testnet RPC endpoints and other devtools, so you can confidently test your code with industry-leading reliability.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://developers.flow.com/\",\"token\":\"FLOW\"},{\"name\":\"CrossFi Mainnet\",\"slug\":\"crossfi\",\"id\":\"crossfi-mainnet\",\"about\":\"CrossFi is a cross-chain finance layer that tokenizes real-world collateral (gold, fiat, commodities) and moves it natively across EVM and Cosmos ecosystems. Its hybrid custody model lets TradFi institutions plug into DeFi yield without touching wrapped assets.\",\"buildOnAlchemy\":\"Alchemy offers reliable and performant CrossFi RPC endpoints. Along with real-time data, you also have access to Alchemy's Debug API for gaining insight into onchain transactions as well as data streaming via websocket.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.crossfi.org\",\"token\":\"XFI\",\"faucetUrl\":\"https://www.alchemy.com/faucets/crossfi-testnet\"},{\"name\":\"CrossFi Testnet\",\"slug\":\"crossfi-testnet\",\"id\":\"crossfi-testnet\",\"about\":\"This it the primary test environment for CrossFi.\",\"buildOnAlchemy\":\"Alchemy provides CrossFi testnet RPC endpoints, debugging tools, and more, so you can harden your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.crossfi.org\",\"token\":\"XFI\",\"faucetUrl\":\"https://www.alchemy.com/faucets/crossfi-testnet\"},{\"name\":\"Berachain Mainnet\",\"slug\":\"berachain\",\"id\":\"berachain-mainnet\",\"about\":\"Berachain is an EVM-compatible L1 built with the Cosmos SDK. The chain introduces a novel Proof of Liquidity consensus mechanism that aligns staking with block production. Berachain combines performant infrastructure with a meme-powered community and DeFi-native governance.\",\"buildOnAlchemy\":\"Alchemy provides high-performance Berachain RPC endpoints, enriched data APIs, and a range of services for helping builders launch with reliable infrastructure.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.berachain.com/\",\"token\":\"BERA\"},{\"name\":\"Berachain Bepolia\",\"slug\":\"berachain-bepolia\",\"id\":\"berachain-bepolia\",\"about\":\"Bepolia is the primary testnet for Berachain.\",\"buildOnAlchemy\":\"Alchemy offers Berachain Bepolia RPC endpoints, debugging tools, and dashboard analytics, so you can experiment and test your code before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.berachain.com/\",\"token\":\"BERA\"},{\"name\":\"Scroll Mainnet\",\"slug\":\"scroll\",\"id\":\"scroll-mainnet\",\"about\":\"Scroll is a zkEVM rollup offering bytecode equivalence with Ethereum. Developed in close alignment with the Ethereum Foundation, Scroll is designed as censorship-resistant infrastructure for large-scale applications.\",\"buildOnAlchemy\":\"Alchemy offers fast, reliable Scroll RPC endpoints as well as helpful infrastructure for apps on Scroll, including enriched data APIs, push notifications, and data streaming.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.scroll.io/en/home/\",\"token\":\"SCROLL\"},{\"name\":\"ApeChain Mainnet\",\"slug\":\"apechain\",\"id\":\"apechain-mainnet\",\"about\":\"ApeChain is an Arbitrum Orbit L3 created by the ApeCoin DAO and purpose built for Yuga Labs games and the wider BAYC ecosystem. Native APE gas and custom gaming primitives let studios launch great user experiences without leaving the Ape community's token economy.\",\"buildOnAlchemy\":\"Alchemy offers ApeChain RPC endpoints, giving you access to industry-leading data reliability. In addition, you can leverage a suite of data APIs to build richer onchain experiences for your users.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.apechain.com/\",\"token\":\"APECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\",\"provider\":\"Caldera\"},{\"name\":\"ApeChain Curtis\",\"slug\":\"apechain-curtis\",\"id\":\"apechain-curtis\",\"about\":\"Curtis is the primary testnet for Apechain.\",\"buildOnAlchemy\":\"Alchemy provides Apechain Curtis RPC endpoints and several data APIs, so you can confidently test your code with reliable and performant data.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.apechain.com/\",\"token\":\"APECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\",\"provider\":\"Caldera\"},{\"name\":\"Celo Mainnet\",\"slug\":\"celo\",\"id\":\"celo-mainnet\",\"about\":\"Celo is a mobile-first, EVM-compatible L2 built with OP-Stack (the chain was formerly an L1 and migrated to Optimism in March 2025). It features ultra-light clients, phone number mapping, and gas fee abstraction for easy smartphone onboarding, and its support of cUSD and cEUR stablecoins power payments in 100+ countries.\",\"buildOnAlchemy\":\"Alchemy offers reliable Celo RPC endpoints designed for availability at scale. In addition, Alchemy offers enriched data APIs and a range of developer tools that make it easy to build and scale on Celo.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celo.org/\",\"token\":\"CELO\"},{\"name\":\"Soneium Mainnet\",\"slug\":\"soneium\",\"id\":\"soneium-mainnet\",\"about\":\"Soneium is a next-gen, high-performance blockchain built to power DeFi and NFT platforms with low-latency and secure architecture. Designed for developers building cutting-edge blockchain applications, it supports scalable blockchain infrastructure for global apps.\",\"buildOnAlchemy\":\"Alchemy offers enterprise-ready Soneium RPC endpoints as well as enriched data APIs and a suite of developer tools for launching and scaling applications on Soneium.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.soneium.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/soneium-minato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/soneium\"},{\"name\":\"Soneium Minato\",\"slug\":\"soneium-minato\",\"id\":\"soneium-minato\",\"about\":\"Minato is the primary testnet for Soneium.\",\"buildOnAlchemy\":\"Alchemy provides Soneium Minato RPC endpoints and enriched data APIs, so you can confidently experiment and test your code on Soneium before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.soneium.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"faucetUrl\":\"https://www.alchemy.com/faucets/soneium-minato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/soneium-testnet\"},{\"name\":\"Zora Mainnet\",\"slug\":\"zora\",\"id\":\"zora-mainnet\",\"about\":\"Zora is a creator-first, OP-Stack L2 designed for NFTs and media-centric apps. Zora offers free mints, programmable royalties, and protocol modules for drops, editions, and auctions. The chain gained notoriety earlier in the year with the launch of the Zora app (a social feed that enabled creators to launch their own coin and earn for posting).\",\"buildOnAlchemy\":\"Alchemy provides reliable Zora Mainnet RPC endpoints as well as enriched data APIs, making it seamless to connect your app to the Zora network and ship creator-first experiences at scale.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.zora.co/\",\"token\":\"ZORA\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"name\":\"Zora Sepolia\",\"slug\":\"zora-sepolia\",\"id\":\"zora-sepolia\",\"about\":\"Zora Sepolia is the primary testnet for Zora.\",\"buildOnAlchemy\":\"Alchemy provides Zora Sepolia RPC endpoints and data APIs, so you can confidently test your code before shipping to mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.zora.co/\",\"token\":\"ZORA\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"name\":\"World Chain Mainnet\",\"slug\":\"worldchain\",\"id\":\"worldchain-mainnet\",\"about\":\"World Chain is an Ethereum rollup powered by Alchemy that connects to World ID, an anonymous identity verification protocol with over 15M verified humans. It natively integrates these anonymous identities to prioritize human transactions with priority block space, gas rebates, and keeping transactions affordable for real users, not for bots.\",\"buildOnAlchemy\":\"Alchemy provides World RPC endpoints designed for global availability and optimized for reliability. Along with tools like push notifications and enriched data APIs, Alchemy makes it easier to launch and scale applications on World with confidence.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.world.org/\",\"token\":\"WLD\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"worldchain-mainnet-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/world-chain-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/worldchain\",\"publicRpcUrl\":\"https://worldchain-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://worldchain-mainnet.g.alchemy.com/public\"},{\"name\":\"World Chain Sepolia\",\"slug\":\"worldchain-sepolia\",\"id\":\"worldchain-sepolia\",\"about\":\"World Chain Sepolia is the primary testnet for World Chain.\",\"buildOnAlchemy\":\"Alchemy provides World Chain Sepolia RPC endpoints, rich data APIs, gas sponsorship, and more, so you can confidently build on World Chain.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.world.org/\",\"token\":\"WLD\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"worldchain-sepolia-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/world-chain-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/worldchain-testnet\",\"publicRpcUrl\":\"https://worldchain-sepolia.g.alchemy.com/public\",\"publicWssUrl\":\"wss://worldchain-sepolia.g.alchemy.com/public\"},{\"name\":\"Shape Mainnet\",\"slug\":\"shape\",\"id\":\"shape-mainnet\",\"about\":\"Shape is an Ethereum L2 purpose-built for NFT creators. Creators on Shape can claim 80% of sequencer fees that users spend when interacting with their contracts. Same security as Ethereum, same tech stack, better costs and creator incentives.\",\"buildOnAlchemy\":\"Alchemy offers reliable Shape RPC endpoints as well as a range of dev tooling that enables you to build onchain applications, including enriched data APIs, push notifications, and data streaming.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.shape.network/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"shape-mainnet-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/shape-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/shape\",\"publicRpcUrl\":\"https://shape-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://shape-mainnet.g.alchemy.com/public\"},{\"name\":\"Shape Sepolia\",\"slug\":\"shape-sepolia\",\"id\":\"shape-sepolia\",\"about\":\"Shape Sepolia is the primary testnet for Shape.\",\"buildOnAlchemy\":\"Alchemy provides Shape Sepolia RPC endpoints, enriched data APIs, a suite of debugging tools, and more, so you can confidently experiment and test your code before shipping to Shape mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.shape.network/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"shape-sepolia-sequencer.g.alchemy.com/\",\"faucetUrl\":\"https://www.alchemy.com/faucets/shape-sepolia\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/shape-testnet\",\"publicRpcUrl\":\"https://shape-sepolia.g.alchemy.com/public\",\"publicWssUrl\":\"wss://shape-sepolia.g.alchemy.com/public\"},{\"name\":\"Monad Testnet\",\"slug\":\"monad-testnet\",\"id\":\"monad-testnet\",\"about\":\"This is the primary testnet for the Monad chain. Monad is fully compatible with Ethereum while offering 10K+ transactions per second and low gas fees.\",\"buildOnAlchemy\":\"Alchemy provides Monad testnet RPC endpoints, a range of debugging tools, rich data APIs, and more, so you can test your code with confidence before shipping to Monad mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.monad.xyz/\",\"token\":\"MONAD\",\"faucetUrl\":\"https://www.alchemy.com/faucets/monad-testnet\"},{\"name\":\"Sei Mainnet\",\"slug\":\"sei\",\"id\":\"sei-mainnet\",\"about\":\"Sei is a Cosmos-SDK L1, optimized for order-book DeFi, leveraging parallel transaction processing to achieve 300ms block times. With native price matching, Sei is ideal for bringing the experiences of traditional financial institutions and CEXs onchain.\",\"buildOnAlchemy\":\"Alchemy provides reliable Sei RPC endpoints that enable you to build onchain. In addition, Alchemy offers a Debug API for getting insights into onchain transactions, websockets for block data streaming, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sei.io/\",\"token\":\"SEI\"},{\"name\":\"Sei Testnet\",\"slug\":\"sei-testnet\",\"id\":\"sei-testnet\",\"about\":\"This network is the primary test environment for Sei, supporting contract testing against Sei's parallel order execution and native price matching.\",\"buildOnAlchemy\":\"Alchemy provides Sei testnet RPC endpoints and a Debug API, so you can access reliable read/write data and harden your code to make it production-ready.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.sei.io/\",\"token\":\"SEI\"},{\"name\":\"Sonic Mainnet\",\"slug\":\"sonic\",\"id\":\"sonic-mainnet\",\"about\":\"Sonic is the next evolution of Fantom, a fast, EVM-compatible L1 offering 10,000 TPS and sub-second finality. App developers can also earn up to 90% of the protocol fees generated by their application, making Sonic a founder-friendly chain.\",\"buildOnAlchemy\":\"Alchemy offers industry-leading Sonic RPC endpoints as well as push notifications, block data streaming, and a Debug API for grokking transactions. With Alchemy, building on Sonic is easier.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.soniclabs.com/\",\"token\":\"S\"},{\"name\":\"Lens Mainnet\",\"slug\":\"lens\",\"id\":\"lens-mainnet\",\"about\":\"Lens Network is a zkEVM rollup purpose built for LensProtocol's composable social graph. Native handles, follows, and collects are first-class primitives in Lens, letting builders spin up Web3 social apps in minutes.\",\"buildOnAlchemy\":\"Alchemy provides Lens RPC endpoints as well as websockets for block data streaming that enable you to reliably connect to Lens and operate at scale.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://lens.xyz/docs/chain/overview\"},{\"name\":\"Lens Sepolia\",\"slug\":\"lens-sepolia\",\"id\":\"lens-sepolia\",\"about\":\"Lens Sepolia is the primary testnet for the Lens network.\",\"buildOnAlchemy\":\"Alchemy offers Lens Sepolia RPC endpoints and a suite of data APIs, so you can test your code with performant, highly reliable data.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://lens.xyz/docs/chain/overview\",\"faucetUrl\":\"https://www.alchemy.com/faucets/lens-sepolia\"},{\"name\":\"Rootstock Mainnet\",\"slug\":\"rootstock\",\"id\":\"rootstock-mainnet\",\"about\":\"Rootstock is an EVM-compatible Bitcoin sidechain, bringing Solidity smart contracts to the world of Bitcoin. Users can bridge their Bitcoin into Rootstock and deploy BTC liquidity into Solidity-powered DeFi.\",\"buildOnAlchemy\":\"Alchemy provides Rootstock RPC endpoints and a range of enriched data APIs that enable you to connect to the Rootstock network, pull onchain information directly into your application, and broadcast transactions.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://dev.rootstock.io/\"},{\"name\":\"Rootstock Testnet\",\"slug\":\"rootstock-testnet\",\"id\":\"rootstock-testnet\",\"about\":\"This is the primary testnet for Rootstock.\",\"buildOnAlchemy\":\"Alchemy offers Rootstock testnet RPC endpoints and data APIs, so you can access highly reliable read/write data while testing your code on Rootstock testnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://dev.rootstock.io/\"},{\"name\":\"Unichain Mainnet\",\"slug\":\"unichain\",\"id\":\"unichain-mainnet\",\"about\":\"Unichain is an OP-Stack L2 that unifies fragmented onchain liquidity via order flow auction, routing and executing trades at the best prices across all its connected AMMs. Built in oracles and MEV-resistant matching make Unichain a popular settlement layer for DeFi aggregators.\",\"buildOnAlchemy\":\"Alchemy offers Unichain RPC endpoints and a host of infrastructure services, including enriched data APIs, push notifications, gas sponsorship, and more. Let Alchemy handle your infra while you focus on shipping value to your users.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.unichain.org/docs\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/unichain\"},{\"name\":\"Unichain Sepolia\",\"slug\":\"unichain-sepolia\",\"id\":\"unichain-sepolia\",\"about\":\"Unichain Sepolia is the primary testnet for Unichain.\",\"buildOnAlchemy\":\"Alchemy provides Unichain Sepolia RPC endpoints, data APIs, debug tools, usage analytics, and more, so you can confidently test your code before shipping to mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.unichain.org/docs\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/unichain-testnet\"},{\"name\":\"Abstract Mainnet\",\"slug\":\"abstract\",\"id\":\"abstract-mainnet\",\"about\":\"Abstract is an L2 ZK rollup built on Ethereum, designed to easily bring consumers onchain. With a global wallet that enables native account abstraction, gas sponsorship, and social logins, the Abstract chain makes it easy to onboard mainstream users to your app.\",\"buildOnAlchemy\":\"With Alchemy, you can access reliable Abstract RPC endpoints and a range of infrastructure services, including push notifications and rich data APIs.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.abs.xyz/\",\"framework\":\"ZK\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/abstract-testnet\"},{\"name\":\"Abstract Testnet\",\"slug\":\"abstract-testnet\",\"id\":\"abstract-testnet\",\"about\":\"This is the primary testnet for the Abstract chain.\",\"buildOnAlchemy\":\"Alchemy provides Abstract testnet RPC endpoints, dashboard analytics, enriched data APIs, and more. With Alchemy's devtools, building is just easier.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.abs.xyz/\",\"framework\":\"ZK\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"faucetUrl\":\"https://www.alchemy.com/faucets/abstract-testnet\"},{\"name\":\"Ink Mainnet\",\"slug\":\"ink\",\"id\":\"ink-mainnet\",\"about\":\"Ink is a DeFi chain built by Kraken to serve as a seamless birdge to DeFi. Built on the Optimism Superchain, Ink is tightly integrated with Kraken's centralized exchange with on/off ramps that connect your app to all of Kraken's user base.\",\"buildOnAlchemy\":\"Alchemy provides reliable Ink RPC endpoints trusted by enterprise and solo devs alike. Along with this read and write data, Alchemy offers a suite of enriched data APIs to help you ship better onchain experiences, along with push notifications, block streaming, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.inkonchain.com/\",\"token\":\"INK\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Gelato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/ink\"},{\"name\":\"Ink Sepolia\",\"slug\":\"ink-sepolia\",\"id\":\"ink-sepolia\",\"about\":\"Ink Sepolia is the primary testnet for Kraken's Ink chain.\",\"buildOnAlchemy\":\"Alchemy provides reliable Ink Sepolia RPC endpoints, rich data APIs, usage analytics in the Alchemy dashboard, and more, so you can easily and confidently ship DeFi apps on Ink.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.inkonchain.com/\",\"token\":\"INK\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Gelato\",\"snapshotsUrl\":\"https://www.alchemy.com/snapshots/ink-testnet\"},{\"name\":\"Robinhood Chain Mainnet\",\"slug\":\"robinhood\",\"id\":\"robinhood-mainnet\",\"about\":\"Robinhood Chain is a permissionless, Ethereum-compatible L2 from Robinhood built on Arbitrum. It is designed for onchain financial infrastructure across tokenized real-world assets, crypto, and traditional markets.\",\"buildOnAlchemy\":\"Alchemy offers Robinhood Chain mainnet RPC endpoints and websockets, so you can access reliable onchain data and stream real-time block events in production. You can also use supported APIs for tokens, NFTs, transfers, webhooks, prices, bundling, and gas sponsorship.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.robinhood.com/chain/\",\"token\":\"ETH\"},{\"name\":\"Robinhood Chain Testnet\",\"slug\":\"robinhood-testnet\",\"id\":\"robinhood-testnet\",\"about\":\"This is the primary testnet for Robinhood Chain.\",\"buildOnAlchemy\":\"Alchemy offers Robinhood Chain testnet RPC endpoints and websockets, so you can access reliable and accurate onchain data and build with real-time block streams before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.robinhood.com/chain/\",\"token\":\"ETH\"},{\"name\":\"Ronin Mainnet\",\"slug\":\"ronin\",\"id\":\"ronin-mainnet\",\"about\":\"Ronin is a gaming-first blockchain developed by Sky Mavis and powers titles like Axie Infinity, handling millions of daily transactions at sub-cent gas fees. Ronin is a proven platform for scaling player-owned game economies.\",\"buildOnAlchemy\":\"Alchemy providers Ronin RPC endpoints and scalable infrastructure services, including enriched data APIs, push notifications, debugging tools, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.roninchain.com/\",\"token\":\"RON\"},{\"name\":\"Ronin Saigon\",\"slug\":\"ronin-saigon\",\"id\":\"ronin-saigon\",\"about\":\"Saigon is Ronin’s primary testnet.\",\"buildOnAlchemy\":\"Alchemy offers Ronin Saigon RPC endpoints and a suite of rich data APIs, so you can test your code with industry-leading data reliability.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.roninchain.com/\",\"token\":\"RON\"},{\"name\":\"Degen Mainnet\",\"slug\":\"degen\",\"id\":\"degen-mainnet\",\"about\":\"Degen is a creator- and community-focused Arbitrum Orbit L3 that uses the viral DEGEN tipping token as its gas asset, making micro-rewards and meme trading essentially free. Designed for community coordination and creator rewards, Degen makes social interaction easily composable.\",\"buildOnAlchemy\":\"Use Alchemy’s Degen RPC endpoints to reliably connect to the Degen network. In addition, Alchemy provides enriched data APIs, block data streaming via websockets, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://explorer.degen.tips/api-docs\",\"token\":\"DEGEN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\",\"provider\":\"Alchemy\",\"publicRpcUrl\":\"https://degen-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://degen-mainnet.g.alchemy.com/public\"},{\"name\":\"Settlus Mainnet\",\"slug\":\"settlus\",\"id\":\"settlus-mainnet\",\"about\":\"Settlus provides a transparent settlement system for creators via its L2 chain built with the OP-Stack. Offering programmable payouts, royalty rights, and more, Settlus gives power to the creator economy.\",\"buildOnAlchemy\":\"Alchemy offers Settlus testnet RPC endpoints and a range of enriched data APIs to handle all of your read and write needs at scale. In addition, Alchemy offers push notifications and block data streaming to make sure you get all of the information you need, in real time.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.settlus.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"settlus-mainnet-sequencer.g.alchemy.com/\",\"publicRpcUrl\":\"https://settlus-mainnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://settlus-mainnet.g.alchemy.com/public\"},{\"name\":\"Settlus Sepolia\",\"slug\":\"settlus-sepolia\",\"id\":\"settlus-septestnet\",\"about\":\"This is the primary testing environment for Settlus.\",\"buildOnAlchemy\":\"Alchemy provides Settlus Sepolia RPC endpoints, dashboard analytics, rich data APIs, and more. With Alchemy devtools and infra, you can ship faster.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.settlus.org/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"sequencerEndpoint\":\"settlus-sep-testnet-sequencer.g.alchemy.com/\",\"publicRpcUrl\":\"https://settlus-septestnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://settlus-septestnet.g.alchemy.com/public\"},{\"name\":\"Superseed Sepolia\",\"slug\":\"superseed-sepolia\",\"id\":\"superseed-sepolia\",\"about\":\"This is the primary testnet for Superseed.\",\"buildOnAlchemy\":\"Alchemy provides Superseed Sepolia RPC endpoints, dashboard analytics, debugging tools, and more, so you can thoroughly and confidently test your code. Spend less time on your infra and move faster with Alchemy.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.superseed.xyz/\",\"token\":\"SUPR\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Conduit\"},{\"name\":\"Gensyn Mainnet\",\"slug\":\"gensyn\",\"id\":\"gensyn-mainnet\",\"about\":\"Gensyn is a marketplace protocol for AI compute, helping turn idle GPU clusters into on-demand compute for ML engineers. Using \\\"proof of learning\\\" consensus to verify model training without re-running workloads, Gensyn solves the issue of compute verification without incurring the expense of the compute itself.\",\"buildOnAlchemy\":\"Alchemy offers reliable Gensyn RPC endpoints and real-time block data streaming via websockets. In addition, Alchemy provides gas sponsorship and a Debug API for inspecting onchain transactions, so you can build great user experiences on Gensyn.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.gensyn.ai/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\"},{\"name\":\"Gensyn Testnet\",\"slug\":\"gensyn-testnet\",\"id\":\"gensyn-testnet\",\"about\":\"This is Gensyn's primary testnet.\",\"buildOnAlchemy\":\"Alchemy offers Gensyn testnet RPC endpoints and websockets, as well as gas sponsorship and a Debug API, so you can test your app with reliable onchain data before shipping to mainnet.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.gensyn.ai/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\",\"provider\":\"Alchemy\",\"faucetUrl\":\"https://www.alchemy.com/faucets/gensyn-testnet\",\"publicRpcUrl\":\"https://gensyn-testnet.g.alchemy.com/public\",\"publicWssUrl\":\"wss://gensyn-testnet.g.alchemy.com/public\"},{\"name\":\"Bitcoin Mainnet\",\"slug\":\"bitcoin\",\"id\":\"bitcoin-mainnet\",\"about\":\"Bitcoin is the original blockchain network and is the most secure, decentralized cryptocurrency in existence. It introduced peer-to-peer value transfer and remains a censorship-resistant store of value with a fixed 21M supply. As a base layer, it supports emerging L2s like Lightning and Stacks.\",\"buildOnAlchemy\":\"Alchemy provides reliable Bitcoin RPC endpoints, so you can access performant, real time, read and write data to the mother chain. Building on Bitcoin just got a bit easier.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"name\":\"Bitcoin Testnet\",\"slug\":\"bitcoin-testnet\",\"id\":\"bitcoin-testnet\",\"about\":\"Bitcoin Testnet is a public test environment that mimics Bitcoin mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Bitcoin testnet RPC endpoints, so you can access reliable read/write data in real time.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"name\":\"Bitcoin Signet\",\"slug\":\"bitcoin-signet\",\"id\":\"bitcoin-signet\",\"about\":\"Bitcoin Signet is a test environment that is more stable than Bitcoin testnet because unlike Bitcoin testnet, Signet is a controlled environment where a designated authority is responsible for signing new blocks. It’s designed for advanced protocol and infrastructure testing in private or dev-only settings.\",\"buildOnAlchemy\":\"Alchemy provides Bitcoin Signet RPC endpoints, so you can access performant and reliable read/write data at scale.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"name\":\"Bitcoin Testnet4\",\"slug\":\"bitcoin-testnet4\",\"id\":\"bitcoin-testnet4\",\"about\":\"Bitcoin Testnet4 is the current public Bitcoin test network, replacing Testnet3. It offers a fresh chain with fewer blocks, more stable difficulty adjustment, and lower fees, so developers and infrastructure can test Bitcoin software and integrations without mainnet risk.\",\"buildOnAlchemy\":\"Alchemy offers Bitcoin Testnet4 RPC endpoints, so you can access reliable read and write data in real time for testing.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developer.bitcoin.org/\",\"token\":\"BTC\"},{\"name\":\"Rise Mainnet\",\"slug\":\"rise\",\"id\":\"rise-mainnet\",\"about\":\"Rise is an Ethereum L2 designed for high-speed, high-throughput applications while preserving Ethereum finality. Rise mainnet gives builders a production network for low-latency onchain apps across trading, gaming, and consumer experiences.\",\"buildOnAlchemy\":\"Alchemy offers Rise mainnet RPC endpoints and websockets, so you can access reliable onchain data and stream real-time block events for production applications.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.risechain.com/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\"},{\"name\":\"Rise Testnet\",\"slug\":\"rise-testnet\",\"id\":\"rise-testnet\",\"about\":\"Rise is an Ethereum L2 designed to drive speed and high throughput while offering Ethereum finality, with 5ms latency and 100K TPS. This is the primary test environment for Rise, and the team is actively working towards mainnet launch.\",\"buildOnAlchemy\":\"Alchemy offers Rise testnet RPC endpoints along with a suite of devtools, including enriched data APIs, block data streaming, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.risechain.com/\",\"framework\":\"Optimism\",\"dataAvailability\":\"Ethereum\",\"settlement\":\"Ethereum\"},{\"name\":\"Humanity Mainnet\",\"slug\":\"humanity\",\"id\":\"humanity-mainnet\",\"about\":\"Humanity is a Sybil-resistant blockchain that proves user identities with zero knowledge proofs (protecting user data). It powers bot-free social networks, fraud-resistant transactions, access-controlled venues, and more.\",\"buildOnAlchemy\":\"Alchemy offers reliable Humanity RPC endpoints, ensuring you always have access to real-time read and write data you can trust.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.humanity.org/guide/introduction\",\"token\":\"H\",\"faucetUrl\":\"https://www.alchemy.com/faucets/humanity-testnet\"},{\"name\":\"Story Mainnet\",\"slug\":\"story\",\"id\":\"story-mainnet\",\"about\":\"Story is an EVM-compatible L1 that tokenizes intellectual property into programmable onchain assets, embedding licensing terms, revenue splits, AI-driven derivations, and more. It treats IP as the scarce store-of-value for the coming generative-AI economy\",\"buildOnAlchemy\":\"Alchemy offers Story RPC endpoints, enriched data APIs, block data streaming, and more, enabling you to easily build and scale apps on Story.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.datafdn.org/introduction\",\"token\":\"DATA\"},{\"name\":\"Story Aeneid\",\"slug\":\"story-aeneid\",\"id\":\"story-aeneid\",\"about\":\"This is the primary testnet for the Story blockchain.\",\"buildOnAlchemy\":\"Alchemy provides Story Aeneid RPC endpoints, enriched data APIs, block event streaming, and more.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.datafdn.org/introduction\",\"token\":\"DATA\"},{\"name\":\"Anime Mainnet\",\"slug\":\"anime\",\"id\":\"anime-mainnet\",\"about\":\"Anime is a blockchain purpose-built for anime IP, fandoms, and NFT-first experiences. Created by the Azuki team, Anime gives studios and fans tamper-proof provenance and licensing rails, issues at the core of AI-generated content.\",\"buildOnAlchemy\":\"Alchemy provides reliable Anime RPC endpoints, real-time block data streaming via websockets, push notifications, and more, so you can easily build on Anime.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://whitepaper.animechain.ai/\",\"token\":\"ANIMECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\"},{\"name\":\"Anime Sepolia\",\"slug\":\"anime-sepolia\",\"id\":\"anime-sepolia\",\"about\":\"This is the primary testnet for Anime.\",\"buildOnAlchemy\":\"Alchemy offers performant Anime Sepolia RPC endpoints and a suite of devtools, including rich data APIs, block event streaming, push notifications, gas sponsorship, and more.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://whitepaper.animechain.ai/\",\"token\":\"ANIMECOIN\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\"},{\"name\":\"Celo Sepolia\",\"slug\":\"celo-sepolia\",\"id\":\"celo-sepolia\",\"about\":\"This is the new primary testnet for Celo and replaces the Alfajores network when Holesky sunsets in Septembet 2025.\",\"buildOnAlchemy\":\"Alchemy provides Celo Sepolia RPC endpoints. Simplify your testing with Alchemy data and tooling.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.celo.org/\",\"token\":\"CELO\"},{\"name\":\"XMTP Ropsten\",\"slug\":\"xmtp-ropsten\",\"id\":\"xmtp-ropsten\",\"about\":\"This is the primary testnet for the XMTP network.\",\"buildOnAlchemy\":\"Alchemy offers performant Ropsten RPC endpoints, websockets, and subgraphs that simplify your testing on XMTP. With reliable data at your fingertips, you can focus on preparing your app for mainnet instead of stabilizing your infrastructure.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.xmtp.org/\"},{\"name\":\"Sonic Testnet\",\"slug\":\"sonic-testnet\",\"id\":\"sonic-testnet\",\"about\":\"This is the primary testnet for the Sonic chain.\",\"buildOnAlchemy\":\"Alchemy offers performant Sonic testnet RPC endpoints, as well as websockets and a Debug API, so you can test your application with reliable data as you prepare for mainnet deployment.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.soniclabs.com/\",\"token\":\"S\"},{\"name\":\"Ethereum Beacon\",\"slug\":\"ethereum-beacon\",\"id\":\"eth-mainnetbeacon\",\"about\":\"The Ethereum Beacon Chain is the consensus-layer backbone of Ethereum’s Proof-of-Stake. Separate but connected to the Ethereum L1 (which handles smart contract execution), the Beacon chain coordinates validators, staking, and block finality, and is responsible for securing the Ethereum network.\",\"buildOnAlchemy\":\"Leverage Alchemy's endpoints, so you can access reliable and performant data for the Beacon network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"name\":\"Ethereum Hoodi-Beacon\",\"slug\":\"ethereum-hoodi-beacon\",\"id\":\"eth-hoodibeacon\",\"about\":\"The Hoodi network for the Ethereum Beacon chain is a test network that is replacing Beacon's Holesky network. Unlike the Beacon Sepolia network, the Hoodi network is designed for protocol and staking/validator testing and offers a permissionless validator network, more closely mimicking Beacon mainnet.\",\"buildOnAlchemy\":\"With Alchemy's RPC endpoints, you can access reliable and performant data for the Beacon Hoodi network and focus on hardening your code instead of troubleshooting infra.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"name\":\"Ethereum Sepolia-Beacon\",\"slug\":\"ethereum-sepolia-beacon\",\"id\":\"eth-sepoliabeacon\",\"about\":\"The Sepolia network for the Ethereum Beacon chain is a test network for app builders. Unlike the Beacon Hoodi network, the Sepolia network is run by a permissioned (closed) set of validators and an unlimited supply of test ETH. This makes the network more reliable and forgiving for rapid iteration and devs testing apps and smart contracts.\",\"buildOnAlchemy\":\"Access reliable Beacon Sepolia network data with Alchemy's endpoints. With a trusted infra partner, you can focus on testing and hardening your code and improving your app's user experience, instead of building out your backend infrastructure.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://ethereum.org/en/developers/docs/\",\"token\":\"ETH\",\"faucetUrl\":\"https://www.alchemy.com/faucets/ethereum-sepolia\"},{\"name\":\"World Mobile Chain Mainnet\",\"slug\":\"worldmobilechain\",\"id\":\"worldmobilechain-mainnet\",\"about\":\"World Mobile Chain is an EVM-compatible L3 on Base and is purpose built for telecoms. With a product stack offering AirNodes, VPN, storage-as-a-service, eSIMs, decentralized identifiers, and more, World Mobile Chain opens the door for DePIN use cases, connectivity in underserved regions, and full data sovereignty.\",\"buildOnAlchemy\":\"Alchemy offers World Mobile Chain endpoints and websockets, so you can access reliable and performant network data whenever you need it.\",\"category\":\"ROLLUP\",\"officialDocsUrl\":\"https://docs.worldmobile.io/\",\"token\":\"WMTX\",\"framework\":\"Arbitrum\",\"dataAvailability\":\"Anytrust\",\"settlement\":\"Arbitrum\"},{\"name\":\"Plasma Mainnet\",\"slug\":\"plasma\",\"id\":\"plasma-mainnet\",\"about\":\"Plasma is an L1 blockchain designed ground-up for stablecoins. With ties to Tether, Plasma delivers near-instant transfers with zero fees. Alongside throughput that can support global reach, Plasma offers Bitcoin-backed security with periodic anchoring to the most battle-tested blockchain.\",\"buildOnAlchemy\":\"Alchemy offers reliable Plasma RPC API endpoints and websockets, so that accurate and real-time data for Plasma is never more than one request away.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://www.plasma.to/docs/\",\"token\":\"XPL\"},{\"name\":\"Plasma Testnet\",\"slug\":\"plasma-testnet\",\"id\":\"plasma-testnet\",\"about\":\"This is the primary testnet for the Plasma chain.\",\"buildOnAlchemy\":\"Alchemy offers Plasma testnet RPC endpoints and websockets, so you can harden your code with reliable data and get ready for production.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.plasma.to/docs\",\"token\":\"XPL\"},{\"name\":\"BOB Mainnet\",\"slug\":\"bob\",\"id\":\"bob-mainnet\",\"about\":\"BOB is building the Bank of Bitcoin, reimagining banking for the Bitcoin age. One platform for everything - swapping, saving, earning \u0026 borrowing - all on Bitcoin rails.\",\"buildOnAlchemy\":\"Alchemy offers BOB RPC endpoints and websockets, ensuring that you have accurate, real-time, and reliable data and block event streams for whatever you're building.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gobob.xyz/\"},{\"name\":\"BOB Sepolia\",\"slug\":\"bob-sepolia\",\"id\":\"bob-sepolia\",\"about\":\"This is the primary test network for BOB.\",\"buildOnAlchemy\":\"Alchemy provides reliable onchain data via BOB Sepolia RPC endpoints and websockets, as well as a Debug API, so you can inspect and debug onchain transactions. With Alchemy tools, you can test your code with infrastructure you can trust as you get ready for mainnet deployment.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.gobob.xyz/\"},{\"name\":\"Boba Mainnet\",\"slug\":\"boba\",\"id\":\"boba-mainnet\",\"about\":\"Boba Network is an EVM-compatible Ethereum Layer 2 optimistic rollup built on the OP Stack. It is known for Hybrid Compute, which lets smart contracts call offchain APIs and bring results back onchain in a single transaction.\",\"buildOnAlchemy\":\"Alchemy offers Boba mainnet RPC endpoints, websockets, a Debug API, bundler infrastructure, gas sponsorship, and subgraphs so you can build reliable production applications.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.boba.network/\",\"token\":\"BOBA\"},{\"name\":\"Boba Sepolia\",\"slug\":\"boba-sepolia\",\"id\":\"boba-sepolia\",\"about\":\"This is the primary testnet for Boba.\",\"buildOnAlchemy\":\"Alchemy offers Boba Sepolia RPC endpoints, websockets, a Debug API, bundler infrastructure, gas sponsorship, and subgraphs so you can test and harden your app before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.boba.network/\",\"token\":\"BOBA\"},{\"name\":\"Moonbeam Mainnet\",\"slug\":\"moonbeam\",\"id\":\"moonbeam-mainnet\",\"about\":\"Moonbeam is Polkadot's first parachain, bringing EVM-compatibility and familiar tools for Ethereum devs, while offering native cross-chain messaging across other Polkadot ecosystems. With over 200 live apps across real world assets, gaming, DeFi, emerging markets, and more, Moonbeam merges Ethereum UX with Polkadot's interoperability.\",\"buildOnAlchemy\":\"Alchemy offers Moonbeam RPC endpoints, so you can access reliable and accurate onchain data for every kind of application.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.moonbeam.network/\",\"token\":\"GLMR\"},{\"name\":\"Mode Mainnet\",\"slug\":\"mode\",\"id\":\"mode-mainnet\",\"about\":\"Mode is an OP Stack L2 in the Optimism Superchain, and powered by \\\"DeFAI\\\" with a strong focus emphasis on enabling DeFi and AI agents. With a native perpetuals DEX and an AI Terminal to drive AI agent activity, Mode is building a new onchain economy that rewards contributions to network growth.\",\"buildOnAlchemy\":\"Alchemy offers Mode RPC endpoints and websockets, ensuring that you have reliable, performant, and accurate onchain data. The best UX starts with a stable foundation.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.mode.network/\",\"token\":\"MODE\"},{\"name\":\"Mode Sepolia\",\"slug\":\"mode-sepolia\",\"id\":\"mode-sepolia\",\"about\":\"This is the primary test network for Mode.\",\"buildOnAlchemy\":\"Alchemy provides Mode testnet RPC endpoints and websockets, so you can harden your application and prepare for mainnet with accurate data and reliable infrastructure.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.mode.network/\",\"token\":\"MODE\"},{\"name\":\"Pharos Mainnet\",\"slug\":\"pharos\",\"id\":\"pharos-mainnet\",\"about\":\"Pharos is a high-performance Layer-1 blockchain focused on real-world assets, open finance, and enterprise-scale DeFi. Its modular architecture, deep-parallel execution, and built-in compliance tooling are designed to deliver real-time financial applications onchain.\",\"buildOnAlchemy\":\"Alchemy offers Pharos mainnet RPC endpoints and websockets, so you can access reliable onchain data and real-time block streams for production applications.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.pharos.xyz/\",\"token\":\"PROS\"},{\"name\":\"Pharos Atlantic\",\"slug\":\"pharos-atlantic\",\"id\":\"pharos-atlantic\",\"about\":\"Atlantic is Pharos's primary public testnet. It lets developers test EVM-compatible applications on Pharos's high-performance Layer-1 before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Pharos Atlantic RPC endpoints and websockets, so you can test your app with reliable onchain data and real-time block streams before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.pharos.xyz/\",\"token\":\"PHRS\"},{\"name\":\"X Layer Mainnet\",\"slug\":\"xlayer\",\"id\":\"xlayer-mainnet\",\"about\":\"X Layer is a zkEVM Layer 2 built by OKX using Polygon CDK. It uses OKB as its native gas token and connects OKX's 50M+ users with the broader Ethereum ecosystem, offering low fees and full EVM compatibility via zero-knowledge proofs.\",\"buildOnAlchemy\":\"Alchemy offers reliable X Layer RPC endpoints, block data streaming via websockets, and a Debug API for inspecting onchain transactions, so you can build and scale with confidence.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://web3.okx.com/xlayer/docs\",\"token\":\"OKB\"},{\"name\":\"X Layer Testnet\",\"slug\":\"xlayer-testnet\",\"id\":\"xlayer-testnet\",\"about\":\"This is the primary testnet for X Layer, OKX's zkEVM L2. Developers can build and test EVM-compatible applications with free test tokens before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy offers X Layer testnet RPC endpoints, websockets, and a Debug API, so you can test and debug your code with reliable data before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://web3.okx.com/xlayer/docs\",\"token\":\"OKB\"},{\"name\":\"Jovay Mainnet\",\"slug\":\"jovay\",\"id\":\"jovay-mainnet\",\"about\":\"Jovay is an enterprise-focused Ethereum L2 that uses an AI-optimized TEE-ZK architecture for scalability and zero-trust security. Designed for real-world asset tokenization and institutional DeFi, Jovay bridges compliance-ready financial infrastructure with onchain liquidity.\",\"buildOnAlchemy\":\"Alchemy offers reliable Jovay RPC endpoints and real-time block data streaming via websockets, so you can build enterprise-grade applications on Jovay with performant onchain data.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.jovay.io/\",\"token\":\"ETH\"},{\"name\":\"Jovay Testnet\",\"slug\":\"jovay-testnet\",\"id\":\"jovay-testnet\",\"about\":\"This is the primary testnet for Jovay. Developers can build and test applications against Jovay's enterprise L2 environment before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Jovay testnet RPC endpoints and websockets, so you can access reliable data and harden your code before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.jovay.io/\",\"token\":\"ETH\"},{\"name\":\"Stellar Mainnet\",\"slug\":\"stellar\",\"id\":\"stellar-mainnet\",\"about\":\"Stellar is a decentralized blockchain purpose-built for financial services, powering cross-border payments, asset tokenization, and stablecoin infrastructure at scale. With sub-cent transaction fees and near-instant finality, Stellar is used by major institutions including Franklin Templeton, PayPal, and MoneyGram.\",\"buildOnAlchemy\":\"Alchemy offers reliable Stellar RPC endpoints and real-time block data streaming via websockets, so you can connect to the Stellar network and build financial applications at scale.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.stellar.org/\",\"token\":\"XLM\"},{\"name\":\"Injective Mainnet\",\"slug\":\"injective\",\"id\":\"injective-mainnet\",\"about\":\"Injective is a Cosmos-SDK L1 purpose-built for finance, offering sub-second block times and zero gas fees for end users. With native support for decentralized exchanges, derivatives, prediction markets, and cross-chain trading, Injective is a leading chain for onchain financial applications.\",\"buildOnAlchemy\":\"Alchemy offers reliable Injective mainnet RPC endpoints and real-time block data streaming via websockets, so you can build financial applications on Injective with performant and accurate onchain data.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.injective.network/\",\"token\":\"INJ\"},{\"name\":\"Injective Testnet\",\"slug\":\"injective-testnet\",\"id\":\"injective-testnet\",\"about\":\"This is the primary testnet for Injective. Developers can test trading flows, financial applications, and cross-chain integrations in a safe environment before deploying to Injective mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Injective testnet RPC endpoints and websockets, so you can test your application with reliable data and prepare for production.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.injective.network/\",\"token\":\"INJ\"},{\"name\":\"Stellar Testnet\",\"slug\":\"stellar-testnet\",\"id\":\"stellar-testnet\",\"about\":\"This is the primary testnet for Stellar. Developers can test payment flows, asset issuance, and smart contract logic in a safe environment before deploying to mainnet.\",\"buildOnAlchemy\":\"Alchemy provides Stellar testnet RPC endpoints and websockets, so you can test your application with reliable data and prepare for production.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://developers.stellar.org/\",\"token\":\"XLM\"},{\"name\":\"Kaia Mainnet\",\"slug\":\"kaia\",\"id\":\"kaia-mainnet\",\"about\":\"Kaia is an EVM-compatible Layer-1 blockchain formed by the merger of Klaytn and Finschia. Built for mass Web3 adoption, Kaia gives developers a high-performance network for consumer apps, payments, DeFi, and other onchain finance use cases.\",\"buildOnAlchemy\":\"Alchemy offers Kaia mainnet RPC endpoints and websockets, so you can access reliable onchain data and stream real-time block events for production applications.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.kaia.io/\",\"token\":\"KAIA\"},{\"name\":\"Kaia Testnet\",\"slug\":\"kaia-testnet\",\"id\":\"kaia-testnet\",\"about\":\"Kaia Testnet is the Kairos public test network for Kaia. Developers can test EVM-compatible smart contracts and app integrations before deploying to Kaia mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Kaia testnet RPC endpoints and websockets, so you can build with reliable testnet data and real-time block streams before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.kaia.io/\",\"token\":\"KAIA\"},{\"name\":\"Katana Bokuto\",\"slug\":\"katana-bokuto\",\"id\":\"katana-bokuto\",\"about\":\"Katana Bokuto is Katana's primary testnet. Developers can use it to test DeFi applications and integrations in Katana's 1-second block environment before deploying to Katana mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Katana Bokuto RPC endpoints and websockets, so you can test with reliable onchain data and real-time block streams before shipping to mainnet.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.katana.network/\",\"token\":\"ETH\"},{\"name\":\"Katana Mainnet\",\"slug\":\"katana\",\"id\":\"katana-mainnet\",\"about\":\"Katana is a DeFi blockchain designed for deep liquidity and sustainable yield. It concentrates liquidity in core applications and recycles network revenue back into the ecosystem, making it a strong fit for lending, borrowing, and trading apps.\",\"buildOnAlchemy\":\"Alchemy offers Katana mainnet RPC endpoints and websockets, so you can access reliable onchain data and real-time block streams for production applications.\",\"category\":\"L2\",\"officialDocsUrl\":\"https://docs.katana.network/\",\"token\":\"ETH\"},{\"name\":\"Bitcoin Cash Mainnet\",\"slug\":\"bitcoin-cash\",\"id\":\"bitcoincash-mainnet\",\"about\":\"Bitcoin Cash is a UTXO Layer-1 blockchain that forked from Bitcoin in 2017. It uses larger blocks for higher throughput, supporting faster and cheaper transactions while preserving Bitcoin's proof-of-work security model.\",\"buildOnAlchemy\":\"Alchemy provides reliable Bitcoin Cash RPC endpoints, so you can access performant, real-time read and write data for one of the longest-running Bitcoin forks.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bitcoincash.org/\",\"token\":\"BCH\"},{\"name\":\"Bitcoin Cash Testnet\",\"slug\":\"bitcoin-cash-testnet\",\"id\":\"bitcoincash-testnet\",\"about\":\"Bitcoin Cash Testnet is a public test environment that mimics Bitcoin Cash mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Bitcoin Cash testnet RPC endpoints, so you can test your application with reliable read/write data before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://docs.bitcoincash.org/\",\"token\":\"BCH\"},{\"name\":\"Litecoin Mainnet\",\"slug\":\"litecoin\",\"id\":\"litecoin-mainnet\",\"about\":\"Litecoin is a UTXO Layer-1 blockchain launched in 2011 as one of the earliest Bitcoin forks. It uses Scrypt proof-of-work and 2.5-minute block times to enable faster, lower-fee transfers than Bitcoin while keeping a similar security model.\",\"buildOnAlchemy\":\"Alchemy offers reliable Litecoin RPC endpoints, so you can connect to the Litecoin network with performant, real-time read and write data.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://litecoin.info/docs\",\"token\":\"LTC\"},{\"name\":\"Litecoin Testnet\",\"slug\":\"litecoin-testnet\",\"id\":\"litecoin-testnet\",\"about\":\"Litecoin Testnet is a public test environment that mimics Litecoin mainnet.\",\"buildOnAlchemy\":\"Alchemy offers Litecoin testnet RPC endpoints, so you can test your application with reliable read/write data before shipping to mainnet.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://litecoin.info/docs\",\"token\":\"LTC\"},{\"name\":\"Dogecoin Mainnet\",\"slug\":\"dogecoin\",\"id\":\"dogecoin-mainnet\",\"about\":\"Dogecoin is a UTXO Layer-1 blockchain that launched in 2013 as a fork of Litecoin. Originally created as a meme cryptocurrency, Dogecoin has grown into one of the most widely-held tokens, using Scrypt proof-of-work and 1-minute block times to enable fast, low-fee transfers.\",\"buildOnAlchemy\":\"Alchemy provides reliable Dogecoin RPC endpoints, so you can access performant, real-time read and write data for the Dogecoin network.\",\"category\":\"L1\",\"officialDocsUrl\":\"https://dogecoin.com/dogepedia/\",\"token\":\"DOGE\"}],\"children\":\"$L47\"}],\"$L48\",\"$L49\"]\n"])</script><script>self.__next_f.push([1,"56:I[328055,[\"/_next/static/immutable/chunks/2xlnno_e6-13s.js\",\"/_next/static/immutable/chunks/22m__1g-7j11b.js\",\"/_next/static/immutable/chunks/1bwshfumb3480.js\",\"/_next/static/immutable/chunks/0lviq-ixr-tea.js\",\"/_next/static/immutable/chunks/3gansv_07ajc5.js\",\"/_next/static/immutable/chunks/2dahy62y1i8ip.js\",\"/_next/static/immutable/chunks/2co60z_h7xovh.js\",\"/_next/static/immutable/chunks/0o_wikt_68w7l.js\",\"/_next/static/immutable/chunks/3dt7o8qb0mu0u.js\",\"/_next/static/immutable/chunks/2bkplcnmrp_3a.js\",\"/_next/static/immutable/chunks/1ilnlulnqgjnu.js\",\"/_next/static/immutable/chunks/1qimlv2ga1c2a.js\",\"/_next/static/immutable/chunks/2wk-rha2zny8r.js\",\"/_next/static/immutable/chunks/0zt1aryund1wf.js\",\"/_next/static/immutable/chunks/1s-yszu4cvyuq.j