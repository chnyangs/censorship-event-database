"></circle></svg><span class="grid flex-1 *:my-auto *:row-start-1 *:col-start-1"><span class="truncate transition-[opacity,translate,color]">Networks</span><span class="truncate transition-[opacity,translate] opacity-0 translate-y-full pointer-events-none"></span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 transition-transform mx-0.5" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div data-state="closed" id="radix-_R_5bsnq6jb_" hidden="" data-toc-popover-content="" class="overflow-hidden"></div></header></div><article id="nd-page" data-full="false" class="flex flex-col w-full max-w-[900px] mx-auto [grid-area:main] px-4 py-6 gap-4 md:px-6 md:pt-8 xl:px-8 xl:pt-14"><div class="flex items-center gap-1.5 text-sm text-fd-muted-foreground"><span class="truncate text-fd-primary font-medium">Using the Web3 API</span></div><div class="flex flex-col gap-2 border-b border-neutral-200 pb-4 md:flex-row md:items-center md:justify-between md:gap-4 dark:border-neutral-800"><div class="flex flex-col gap-2"><h1 id="page-title" class="text-[1.75em] font-semibold">Networks</h1><p class="mb-8 text-lg text-fd-muted-foreground">View all supported chains for 1RPC.</p></div><div class="flex items-center gap-2"><div class="relative"><button type="button" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-white px-3 py-2 text-sm font-medium text-neutral-900 shadow-sm transition hover:shadow-md dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard h-4 w-4" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path></svg>Copy<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div></div><div class="prose flex-1"><h2 id="supported-networks" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#supported-networks">Supported networks</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h2>
<p>This page documents 1RPC.io endpoints for public access and API key users, separated by transport and protocol.</p>
<div class="flex gap-2 my-4 rounded-xl border bg-fd-card p-3 ps-1 text-sm text-fd-card-foreground shadow-md" style="--callout-color:var(--color-fd-info, var(--color-fd-muted))"><div role="none" class="w-0.5 bg-(--callout-color)/50 rounded-sm"></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-5 -me-0.5 fill-(--callout-color) text-fd-card" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="flex flex-col gap-2 min-w-0 flex-1"><div class="text-fd-muted-foreground prose-no-margin empty:hidden"><p>Public endpoints use <code>https://public.1rpc.io/&lt;network&gt;</code>. Endpoints for API key users use the API key as the path prefix, for example <code>https://1rpc.io/&lt;API_KEY&gt;/base/sepolia</code> or <code>wss://1rpc.io/&lt;API_KEY&gt;/dot</code>. See <a href="/using-the-web3-api/payment#plans">Plans</a> for details.</p></div></div></div>
<h3 id="public-endpoints" class="group/heading flex scroll-m-28 flex-row items-center gap-1"><a data-card="" href="#public-endpoints">Public endpoints</a><button aria-label="Copy Anchor Link" class="inline-flex items-center justify-center rounded-md text-sm font-medium duration-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fd-ring hover:bg-fd-accent hover:text-fd-accent-foreground p-1 [&amp;_svg]:size-4 not-prose shrink-0 text-fd-muted-foreground opacity-0 transition-opacity group-hover/heading:opacity-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></h3>
<div class="supported-networks-table"><div class="relative overflow-auto prose-no-margin my-6"><table><thead><tr><th>Network</th><th>Endpoint</th><th>Protocol</th><th>Chain / Network ID</th><th>Currency</th><th>Explorer</th></tr></thead><tbody><tr><td>Ethereum</td><td><a href="https://public.1rpc.io/eth" rel="noreferrer noopener" target="_blank">https://public.1rpc.io/eth</a></td><td>EVM JSON-RPC</td><td>1</td><td>ETH</td><td><a href="https://etherscan.io" rel="noreferrer noopener" target="_blank">https://etherscan.io</a></td></tr><tr><td>Ethereum Sepolia</td><td><a href="https://public.1rpc.io/sepolia" rel="noreferrer noopener" target="_blank">https://public.1rpc.io/sepolia</a></td><td>EVM JSON-RPC</td><td>11155111</td><td>ETH</td><td><a href="https://sepolia.etherscan.io/" rel="noreferrer noopener" target="_blank">https://sepolia.etherscan.io/</a></td></tr><tr><td>Ethereum Hoodi</td><td><a href="https://public.1rpc.io/hoodi" rel="noreferrer noopener" target="_blank">https://public.1rpc.io/hoodi</a></td><td>EVM JSON-RPC</td><td>560048</td><td>ETH</td><td><a href="https://hoodi.etherscan.io" rel="noreferrer noopener" target="_blank">https://hoodi.etherscan.io</a></td></tr><tr><td>BNB Chain</td><td><a href="https://public.1rpc.io/bnb" rel="noreferrer noopener" target="_blank">https://public.1rpc.io/bnb</a></td><td>EVM JSON-RPC</td><td>56</td><td>BNB</td><td><a href="https://bscscan.com" rel="noreferrer noopener" target="_blank">https://bscscan.com</a></td></tr><tr><td>Polygon</td><td><a href="https://public.1rpc.io/matic" rel="noreferrer noopener" target="_blank">https://public.1rpc.io/matic</a></td><td>EVM JSON-RPC</td><td>137</td><td>MATIC</td><td><a href="https://polygonscan.com" rel="noreferrer noopener" target="_blank">https://polygonscan.com</a></td></tr><tr><td>Polygon zkEVM</td><td><a href="https://public.1rpc.io/polygon/zkevm" rel="noreferrer noopener" target="_blank">https://public.1rpc.io/polygon/zkevm</a></td><td>EVM JSON-RPC</td><td>1101</td><td>ETH</td>