                    </div>

                    <div id="CustomABIStatusResult" role="status" aria-live="polite" class="mb-3"></div>

                    <div class="mb-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <label class="form-label mb-0" for="customAbiValue">Custom ABI</label>
                            <span class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnMagicFillCustomABI" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-placement="top" title="Auto-fill with ABI of the most similar verified contract on Ethereum." aria-label="Auto-fill with ABI of the most similar verified contract on Ethereum." data-chain-name="Ethereum">
                                    <i class="far fa-wand-magic-sparkles me-1" aria-hidden="true"></i><span class="btn-text">Magic Fill</span>
                                    <span class="spinner-border spinner-border-sm d-none ms-1" role="status" aria-hidden="true"></span>
                                </button>
                                <a class="small" href="/find-similar-contracts?a=0xdAC17F958D2ee523a2206206994597C13D831ec7&amp;m=low&amp;verified=1&amp;mt=1" target="_blank" rel="noopener noreferrer">Find Similar<i class="far fa-arrow-up-right ms-1"></i></a>
                            </span>
                        </div>
                        <textarea id="customAbiValue" class="form-control py-2 font-monospace" rows="12" maxlength="524288" placeholder="[{...}]" spellcheck="false" required></textarea>
                        <div class="form-text">Apply Custom ABI to enable custom read/write functions for the current session. Save to also enable them for future sessions.</div>
                    </div>

                    
                    <p class="small text-muted mb-4"><a id="customAbiLoginLink" href="/login?ref=address&amp;ret=0xdAC17F958D2ee523a2206206994597C13D831ec7&amp;hash=code">Sign in</a> to save this ABI to your account.</p>
                    
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" data-bs-dismiss="modal" class="btn btn-ghost-white">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnApplyCustomABI">
                        <span class="btn-text">Apply Custom ABI</span>
                        <span class="spinner-border spinner-border-sm d-none ms-2" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    
