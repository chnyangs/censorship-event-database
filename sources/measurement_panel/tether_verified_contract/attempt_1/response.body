    <div id="masterDivAskChat">
        <!-- Ask Etherscan -->
        <div id="ask-etherscan-main" class="position-fixed">
            <div class="d-flex gap-2">
                <div id="divTokenHolderSummary">
                    <div id="divTokenHolderSummary-main" class="d-none" data-ai-chat>
                         <!-- Chat Container -->
                        <div class="js-chat-container card fade d-none shadow mb-2">
