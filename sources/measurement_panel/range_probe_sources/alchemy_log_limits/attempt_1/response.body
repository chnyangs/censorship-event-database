scription\":\"HyperCore private-preview documentation.\"},{\"title\":\"l2Book\",\"path\":\"/chains/websockets/hypercore/streams/l2-book\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"l2BookDiff\",\"path\":\"/chains/websockets/hypercore/streams/l2-book-diff\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"l4BookUpdates\",\"path\":\"/chains/websockets/hypercore/streams/l4-book-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"liquidationFills\",\"path\":\"/chains/websockets/hypercore/streams/liquidation-fills\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"setOracleUpdates\",\"path\":\"/chains/websockets/hypercore/streams/set-oracle-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"tpslUpdates\",\"path\":\"/chains/websockets/hypercore/streams/tpsl-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"trades\",\"path\":\"/chains/websockets/hypercore/streams/trades\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"userFills\",\"path\":\"/chains/websockets/hypercore/streams/user-fills\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"userIsolatedMarginUpdates\",\"path\":\"/chains/websockets/hypercore/streams/user-isolated-margin-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"userLeverageUpdates\",\"path\":\"/chains/websockets/hypercore/streams/user-leverage-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"userNonFundingLedgerUpdates\",\"path\":\"/chains/websockets/hypercore/streams/user-non-funding-ledger-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"userOrderUpdates\",\"path\":\"/chains/websockets/hypercore/streams/user-order-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"}]}],\"hidden\":true}]},{\"title\":\"HyperCore gRPC\",\"type\":\"section\",\"children\":[{\"title\":\"Getting Started\",\"type\":\"section\",\"children\":[{\"title\":\"Overview\",\"path\":\"/chains/hypercore-grpc/getting-started/overview\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"}]},{\"title\":\"API Reference\",\"type\":\"section\",\"children\":[{\"title\":\"StreamBlocks\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-blocks\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"StreamL2Book\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-l2-book\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"StreamL2BookDiff\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-l2-book-diff\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"StreamL4Book\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-l4-book\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"StreamL4BookUpdates\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-l4-book-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"StreamBboBook\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-bbo-book\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"},{\"title\":\"StreamTpslUpdates\",\"path\":\"/chains/hypercore-grpc/api-reference/stream-tpsl-updates\",\"type\":\"page\",\"description\":\"HyperCore private-preview documentation.\"}]}],\"hidden\":true},{\"title\":\"HyperCore Node Peering\",\"type\":\"section\",\"children\":[{\"title\":\"Overview\",\"path\":\"/chains/hypercore-peering/overview\",\"type\":\"page\",\"description\":\"Dedicated peer connections for teams running their own Hyperliquid node.\"}],\"hidden\":true},{\"title\":\"Deploying Markets on Hyperliquid\",\"type\":\"section\",\"children\":[{\"title\":\"Overview\",\"path\":\"/chains/deploying-markets/overview\",\"type\":\"page\",\"description\":\"How HIP-3 perpetual DEXs and HIP-4 outcome markets are deployed on Hyperliquid.\"}],\"hidden\":true},{\"title\":\"Trace API\",\"type\":\"section\",\"children\":[{\"title\":\"Trace API Overview\",\"path\":\"/reference/trace-api-quickstart\",\"type\":\"page\",\"description\":\"The Trace API provides insights into transaction processing and on-chain activity.\"},{\"title\":\"Trace API Endpoints\",\"type\":\"api-section\",\"children\":[{\"title\":\"trace_block\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-block\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns traces created at a given block.\"},{\"title\":\"trace_call\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-call\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Executes a call and returns one or more possible traces.\"},{\"title\":\"trace_filter\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-filter\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns traces matching a given filter.\"},{\"title\":\"trace_get\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-get\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the trace at a given position for a transaction.\"},{\"title\":\"trace_rawTransaction\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-raw-transaction\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Traces a call to eth_sendRawTransaction without executing it, returning the traces.\"},{\"title\":\"trace_replayBlockTransactions\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-replay-block-transactions\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Replays all transactions in a block, returning the requested traces for each transaction.\"},{\"title\":\"trace_replayTransaction\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-replay-transaction\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Traces a call to eth_sendRawTransaction without executing it, returning the traces.\"},{\"title\":\"trace_transaction\",\"path\":\"/chains/trace-api/trace-api-endpoints/trace-transaction\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns all traces of a given transaction.\"}]},{\"title\":\"Trace API Resources\",\"path\":\"/reference/what-are-evm-traces\",\"type\":\"section\",\"children\":[{\"title\":\"Trace API vs. Debug API\",\"path\":\"/reference/trace-api-vs-debug-api\",\"type\":\"page\",\"description\":\"The differences between the Trace API by Openethereum and the Debug API by Geth\"},{\"title\":\"What is trace_transaction?\",\"path\":\"/reference/what-is-trace_transaction\",\"type\":\"page\",\"description\":\"Learn what the trace_transaction method is, how to use it on EVM blockchains, and test an example use case.\"},{\"title\":\"What is trace_block?\",\"path\":\"/reference/what-is-trace_block\",\"type\":\"page\",\"description\":\"Learn what the trace_block method is, how to use it on EVM blockchains, and test an example use case.\"},{\"title\":\"What is trace_filter?\",\"path\":\"/reference/what-is-trace_filter\",\"type\":\"page\",\"description\":\"Learn what the trace_filter method is, how to use it on EVM blockchains, and test an example use case.\"},{\"title\":\"trace_call vs debug_traceCall\",\"path\":\"/reference/trace_call-vs-debug_tracecall\",\"type\":\"page\",\"description\":\"The differences between the trace_call method by OpenEthereum and the debug_traceCall method by Geth\"}]}]},{\"title\":\"Debug API\",\"type\":\"section\",\"children\":[{\"title\":\"Debug API Overview\",\"path\":\"/reference/debug-api-quickstart\",\"type\":\"page\",\"description\":\"The Debug API provides deeper insights into transaction processing and on-chain activity.\"},{\"title\":\"Debug API Endpoints\",\"type\":\"api-section\",\"children\":[{\"title\":\"debug_getRawBlock\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-get-raw-block\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns an RLP-encoded block.\"},{\"title\":\"debug_getRawHeader\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-get-raw-header\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns an RLP-encoded header.\"},{\"title\":\"debug_getRawReceipts\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-get-raw-receipts\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns an array of EIP-2718 binary-encoded receipts.\"},{\"title\":\"debug_traceBlockByHash\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-trace-block-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Replays the block that is already present in the database.\"},{\"title\":\"debug_traceBlockByNumber\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-trace-block-by-number\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Replays the block that is already present in the database.\"},{\"title\":\"debug_traceCall\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-trace-call\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Runs an eth_call within the context of the given block execution using the final state of parent block as the base.\"},{\"title\":\"debug_traceCallMany\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-trace-call-many\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Runs multiple eth_call requests within the context of the given block execution using the final state of the parent block as the base. Each bundle can contain multiple transactions and optional block overrides. Returns nested arrays of traces (outer array per bundle, inner array per transaction).\"},{\"title\":\"debug_traceTransaction\",\"path\":\"/chains/debug-api/debug-api-endpoints/debug-trace-transaction\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Attempts to run the transaction in the exact same manner as it was executed on the network.\"}]}]},{\"title\":\"Yellowstone gRPC\",\"type\":\"section\",\"children\":[{\"title\":\"Getting Started\",\"type\":\"section\",\"children\":[{\"title\":\"Overview\",\"path\":\"/reference/yellowstone-grpc-overview\",\"type\":\"page\",\"description\":\"Overview of Yellowstone gRPC - High-performance real-time Solana data streaming\"},{\"title\":\"Quickstart\",\"path\":\"/reference/yellowstone-grpc-quickstart\",\"type\":\"page\",\"description\":\"Get started with Yellowstone gRPC streaming in minutes\"},{\"title\":\"Historical Replay\",\"path\":\"/reference/yellowstone-grpc-historical-replay\",\"type\":\"page\",\"description\":\"Backfill missing Solana blockchain data with Yellowstone gRPC's historical replay\"}]},{\"title\":\"API Reference\",\"path\":\"/reference/yellowstone-grpc-api-overview\",\"type\":\"section\",\"children\":[{\"title\":\"Subscribe Request\",\"path\":\"/reference/yellowstone-grpc-subscribe-request\",\"type\":\"page\",\"description\":\"Comprehensive guide to the SubscribeRequest structure and configuration\"},{\"title\":\"Subscribe to Slots\",\"path\":\"/reference/yellowstone-grpc-subscribe-slots\",\"type\":\"page\",\"description\":\"Track Solana slot progression and chain state in real-time\"},{\"title\":\"Subscribe to Transactions\",\"path\":\"/reference/yellowstone-grpc-subscribe-transactions\",\"type\":\"page\",\"description\":\"Stream Solana transactions in real-time with powerful filtering options\"},{\"title\":\"Subscribe to Accounts\",\"path\":\"/reference/yellowstone-grpc-subscribe-accounts\",\"type\":\"page\",\"description\":\"Monitor Solana account changes in real-time with account subscriptions\"},{\"title\":\"Subscribe to Blocks\",\"path\":\"/reference/yellowstone-grpc-subscribe-blocks\",\"type\":\"page\",\"description\":\"Stream complete Solana block data in real-time\"}]},{\"title\":\"Resources\",\"type\":\"section\",\"children\":[{\"title\":\"Code Examples\",\"path\":\"/reference/yellowstone-grpc-examples\",\"type\":\"page\",\"description\":\"Practical Rust examples for Yellowstone gRPC\"},{\"title\":\"Best Practices\",\"path\":\"/reference/yellowstone-grpc-best-practices\",\"type\":\"page\",\"description\":\"Essential tips and patterns for production Yellowstone gRPC applications\"}]}]},{\"title\":\"Launch Your Own Chain (Rollups)\",\"type\":\"section\",\"children\":[{\"title\":\"Rollups Overview\",\"path\":\"/rollups\",\"type\":\"page\",\"description\":\"Introduction to Alchemy Rollups: deploy a rollup in minutes, no code required, using our all-in-one infrastructure.\"},{\"title\":\"Supported Frameworks\",\"path\":\"/reference/supported-stacks\",\"type\":\"page\",\"description\":\"List of supported frameworks / stacks for Alchemy Rollups\"},{\"title\":\"Using your Rollup\",\"path\":\"/reference/using-your-rollup\",\"type\":\"page\",\"description\":\"How to connect to your Rollup RPCs, bridge assets, and deploy smart contracts.\"},{\"title\":\"Operating your Rollup\",\"path\":\"/reference/operating-your-rollup\",\"type\":\"page\",\"description\":\"How to monitor \u0026amp; keep your rollup running smoothly after launching with Alchemy.\"},{\"title\":\"Customizing \u0026 Integrations\",\"path\":\"/reference/customizations-integrations\",\"type\":\"page\",\"description\":\"List of available customizations \u0026amp; add-on integrations for your rollup.\"},{\"title\":\"Bridging Assets\",\"path\":\"/reference/bridge-contract-address\",\"type\":\"page\",\"description\":\"The bridge contract address is essential for facilitating communication and asset transfers between Layer 1 (L1) and Layer 2 (L2) networks\"},{\"title\":\"Rollups FAQ\",\"path\":\"/reference/rollups-faq\",\"type\":\"page\",\"description\":\"Frequently asked questions about Alchemy Rollups.\"}]}]},{\"title\":\"Ethereum\",\"type\":\"section\",\"children\":[{\"title\":\"Quickstart\",\"path\":\"/reference/ethereum-api-quickstart\",\"type\":\"page\",\"description\":\"How to get started building on Ethereum using Alchemy\"},{\"title\":\"Ethereum API Overview\",\"path\":\"/ethereum/ethereum-api-overview\",\"type\":\"page\",\"description\":\"Overview of available Ethereum API methods\"},{\"title\":\"Ethereum API Endpoints\",\"type\":\"api-section\",\"children\":[{\"title\":\"erigon_forks\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/erigon-forks\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Get forks\"},{\"title\":\"erigon_getHeaderByHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/erigon-get-header-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Get header by hash\"},{\"title\":\"erigon_getHeaderByNumber\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/erigon-get-header-by-number\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Get header by number\"},{\"title\":\"erigon_getLogsByHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/erigon-get-logs-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Get logs by block hash\"},{\"title\":\"erigon_issuance\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/erigon-issuance\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Get issuance\"},{\"title\":\"eth_accounts\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-accounts\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns a list of addresses owned by the client.\"},{\"title\":\"eth_blobBaseFee\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-blob-base-fee\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the base fee per blob gas in wei for the current block.\"},{\"title\":\"eth_blockNumber\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-block-number\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the number of the most recent block.\"},{\"title\":\"eth_call\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-call\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Executes a new message call immediately without creating a transaction on the blockchain.\"},{\"title\":\"eth_callBundle\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-call-bundle\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Simulates a bundle of signed transactions against a specific block number, including simulating a bundle at the top of the next block. This method allows you to test transaction bundles before submitting them to the network.\\n\"},{\"title\":\"eth_callMany\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-call-many\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Executes a list of transaction bundles without creating transactions on the blockchain. This method is particularly useful for simulating transactions to understand their potential outcomes. It supports simulating transactions at an intermediate state of a block, simulating multiple transactions with sequential dependencies, and overwriting block headers.\\n\"},{\"title\":\"eth_chainId\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-chain-id\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the chain ID of the current network as a hexadecimal string.\"},{\"title\":\"eth_config\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-config\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the node's fork configuration for the current, next, and last known forks, as introduced by EIP-7910. Operators can use this method to verify that a node is correctly configured for the current network state and any scheduled upgrades. Takes no parameters.\"},{\"title\":\"eth_createAccessList\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-create-access-list\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Generates an access list for a transaction.\"},{\"title\":\"eth_estimateGas\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-estimate-gas\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Generates and returns an estimate of how much gas is necessary to allow the transaction to complete.\"},{\"title\":\"eth_feeHistory\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-fee-history\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns historical base fee per gas and priority fee per gas data for a range of blocks.\"},{\"title\":\"eth_fillTransaction\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-fill-transaction\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Fills in default values for a transaction object. This method populates missing fields such as gas, gasPrice, nonce, and chainId based on the current network state and transaction parameters. It returns both the filled transaction object and the RLP-encoded raw transaction data.\\n\\nThis is useful for preparing transactions before signing, as it ensures all required fields are present with appropriate values.\\n\"},{\"title\":\"eth_gasPrice\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-gas-price\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the current price per gas in wei.\"},{\"title\":\"eth_getAccount\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-account\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Retrieve account details (code hash, storage root, balance, nonce) for a given address at a specified block number or tag.\\n\"},{\"title\":\"eth_getAccountInfo\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-account-info\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Retrieves account information including balance, code, and nonce for a given address at a specified block.\"},{\"title\":\"eth_getBalance\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-balance\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the balance of the account of a given address.\"},{\"title\":\"eth_getBlockByHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-block-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about a block by its hash.\"},{\"title\":\"eth_getBlockByNumber\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-block-by-number\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about a block by its number.\"},{\"title\":\"eth_getBlockReceipts\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-block-receipts\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the receipts of a block by number or hash.\"},{\"title\":\"eth_getBlockTransactionCountByHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-block-transaction-count-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the number of transactions in a block from a block matching the given block hash.\"},{\"title\":\"eth_getBlockTransactionCountByNumber\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-block-transaction-count-by-number\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the number of transactions in a block matching the given block number.\"},{\"title\":\"eth_getCode\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-code\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the code at a given address.\"},{\"title\":\"eth_getFilterChanges\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-filter-changes\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Polls for changes in the filter with the given ID (created using eth_newFilter). Returns an array of logs which occurred since the last poll.\"},{\"title\":\"eth_getFilterLogs\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-filter-logs\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns an array of all logs matching the filter with the given ID (created using eth_newFilter).\"},{\"title\":\"eth_getLogs\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-logs\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns an array of all logs matching the specified filter.\"},{\"title\":\"eth_getProof\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-proof\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the Merkle proof for a given account and optionally some storage keys.\"},{\"title\":\"eth_getRawTransactionByHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-raw-transaction-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the raw transaction data (RLP-encoded) for a transaction by its hash.\"},{\"title\":\"eth_getStorageAt\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-storage-at\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the value from a storage position at a given address.\"},{\"title\":\"eth_getTransactionByBlockHashAndIndex\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-transaction-by-block-hash-and-index\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about a transaction by block hash and transaction index position.\"},{\"title\":\"eth_getTransactionByBlockNumberAndIndex\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-transaction-by-block-number-and-index\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about a transaction by block number and transaction index position.\"},{\"title\":\"eth_getTransactionByHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-transaction-by-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about a transaction requested by transaction hash.\"},{\"title\":\"eth_getTransactionBySenderAndNonce\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-transaction-by-sender-and-nonce\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the hash of the transaction sent by the given sender address at the specified nonce, or null if no such transaction exists. Originally introduced by the Otterscan project (as ots_getTransactionBySenderAndNonce) and now exposed under the standard eth_ namespace. Requires an archive-capable backend because the lookup walks historical account state.\"},{\"title\":\"eth_getTransactionCount\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-transaction-count\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the number of transactions sent from an address.\"},{\"title\":\"eth_getTransactionReceipt\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-transaction-receipt\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the receipt of a transaction by transaction hash.\"},{\"title\":\"eth_getUncleByBlockHashAndIndex\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-uncle-by-block-hash-and-index\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about an uncle of a block by hash and uncle index.\"},{\"title\":\"eth_getUncleByBlockNumberAndIndex\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-uncle-by-block-number-and-index\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns information about an uncle of a block by number and uncle index.\"},{\"title\":\"eth_getUncleCountByBlockHash\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-uncle-count-by-block-hash\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the number of uncles in a block matching the given block hash.\"},{\"title\":\"eth_getUncleCountByBlockNumber\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-get-uncle-count-by-block-number\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the number of uncles in a block matching the given block number.\"},{\"title\":\"eth_maxPriorityFeePerGas\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-max-priority-fee-per-gas\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the current maximum priority fee per gas in wei.\"},{\"title\":\"eth_newBlockFilter\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-new-block-filter\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Creates a filter in the node to notify when new blocks arrive.\"},{\"title\":\"eth_newFilter\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-new-filter\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Creates a filter object based on filter options to notify when state changes (logs).\"},{\"title\":\"eth_newPendingTransactionFilter\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-new-pending-transaction-filter\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Creates a filter in the node to notify when new pending transactions arrive.\"},{\"title\":\"eth_protocolVersion\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-protocol-version\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the current protocol version used by the client.\"},{\"title\":\"eth_sendRawTransaction\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-send-raw-transaction\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Submits a raw transaction to the network.\"},{\"title\":\"eth_simulateV1\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-simulate-v-1\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Enables simulation of complex transactions and state changes without modifying the blockchain.\"},{\"title\":\"eth_submitWork\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-submit-work\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Submit a proof-of-work solution (Ethash) consisting of a nonce, the header PoW hash, and the mix digest. Not supported on post-Merge Ethereum clients; many nodes will return JSON-RPC error -32601 (method not found).\\n\"},{\"title\":\"eth_subscribe\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-subscribe\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Subscribe to Ethereum events via WebSocket (WSS required)\"},{\"title\":\"eth_syncing\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-syncing\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns an object with data about the sync status or false if not syncing.\"},{\"title\":\"eth_uninstallFilter\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-uninstall-filter\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Uninstalls a filter with the given ID.\"},{\"title\":\"eth_unsubscribe\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/eth-unsubscribe\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Cancel a WebSocket subscription (WSS required)\"},{\"title\":\"net_listening\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/net-listening\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns true if the client is actively listening for network connections.\"},{\"title\":\"net_version\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/net-version\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the network ID that the client is connected to.\"},{\"title\":\"web3_clientVersion\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/web-3-client-version\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns the current client version.\"},{\"title\":\"web3_sha3\",\"path\":\"/chains/ethereum/ethereum-api-endpoints/web-3-sha-3\",\"method\":\"POST\",\"type\":\"endpoint\",\"description\":\"Returns Keccak-256 (not the standardized SHA3-256) hash of the given data.\"}]},{\"title\":\"Ethereum