      if (countryCode.trim() === 'GB') {
        var banner = document.getElementById('legalBanner');
        if (banner) {
          banner.style.display = 'block';
        }
      }
    })
    .catch(function(err) {
      console.log('GeoIP lookup failed:', err);
    });
})();
