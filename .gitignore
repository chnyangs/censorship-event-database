__pycache__/
*.pyc
.DS_Store
.local/
output/
tmp/
site/

# Large re-downloadable upstream dumps (fetched by scripts/watchers/ofac_sdn_watch.py
# and the OpenSanctions feed). Kept local for analysis; not versioned.
sources/ofac_sdn_diffs/current/sdn.xml
sources/ofac_sdn_diffs/opensanctions/us_ofac_sdn.ftm.json

# Operator-compliance census: clones are re-fetchable from their upstream
# GitHub URLs (candidates.yaml pins the list). Only the candidates list
# and derived artifacts (analysis/operator_census/*) are versioned.
sources/operator_census/*/
!sources/operator_census/candidates.yaml

# The signal-only operator census JSON is part of the release surface.
# Do not commit `--emit-all-commits` output; keep large full streams local
# under output/ or tmp/ if needed.

.claude/
